{
  "name": "openfinance-os-website",
  "version": "1.0.0",
  "description": "Community hub for UAE Open Finance ecosystem",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "collect": "tsx scripts/collect-observatory.ts",
    "collect:dry": "tsx scripts/collect-observatory.ts --dry-run",
    "curate-news": "tsx scripts/curate-news.ts",
    "curate-news:dry": "tsx scripts/curate-news.ts --dry-run",
    "curate-news:cleanup": "tsx scripts/curate-news.ts --cleanup",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run check && npm run format:check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "weekly-digest": "tsx scripts/weekly-digest.ts",
    "weekly-digest:dry": "tsx scripts/weekly-digest.ts --dry-run"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "happy-dom": "^20.11.0",
    "html-validate": "^11.16.2",
    "prettier": "^3.5.3",
    "prettier-plugin-astro": "^1.1.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
