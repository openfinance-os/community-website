{
  "name": "openfinance-os-website",
  "version": "1.0.0",
  "description": "Community hub for UAE Open Finance ecosystem",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "collect": "tsx scripts/collect-observatory.ts",
    "collect:dry": "tsx scripts/collect-observatory.ts --dry-run",
    "curate-news": "tsx scripts/curate-news.ts",
    "curate-news:dry": "tsx scripts/curate-news.ts --dry-run",
    "curate-news:cleanup": "tsx scripts/curate-news.ts --cleanup",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run check && npm run format:check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "astro": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "happy-dom": "^20.8.9",
    "html-validate": "^8.0.0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
