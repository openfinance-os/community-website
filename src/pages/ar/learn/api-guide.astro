---
import PageUpdated from '@components/learn/PageUpdated.astro';
import PageLayout from '@layouts/PageLayout.astro';
import OperatorPointer from '@components/learn/OperatorPointer.astro';
import { arabicDate, arabicPointer } from '@lib/i18n';
import { apiFamilyLabel } from '@lib/taxonomy';
import latest from '../../../../data/observatory/snapshots/production/latest.json';

const families = latest.summary.apiFamilies.length;
const familyNames = latest.summary.apiFamilies.map(apiFamilyLabel).join('، ');
const observedDate = latest.timestamp.slice(0, 10);
---

<PageLayout
  title="واجهات برمجة التطبيقات"
  description="تعرّف على مركز واجهات برمجة التطبيقات في الإمارات، والخدمات التي تتطلب موافقة العميل والتي تعمل ببيانات اعتماد العميل البرمجي، وأين تجد المواصفات."
>
  <div class="guide-page">
    <div class="container">
      <nav class="breadcrumb" aria-label="مسار التنقل">
        <a href="/ar/learn/">تعلّم</a>
        <span>/</span>
        <span>واجهات برمجة التطبيقات</span>
      </nav>

      <header class="page-intro page-header">
        <h1>واجهات برمجة التطبيقات للتمويل المفتوح في الإمارات</h1>
        <PageUpdated date="2026-11-28" lang="ar" />
        <p class="subtitle">
          ما تغطيه الواجهات، وكيف يتوسّط المركز الوصول إليها، وأين تجد المواصفات.
        </p>
      </header>

      <section class="concept">
        <p>
          يعتمد التمويل المفتوح في الإمارات على <strong>مركز مركزي لواجهات برمجة التطبيقات</strong>.
          يستدعي مزوّد خدمة الطرف الثالث المركز، ثم يستدعي المركز المؤسسة المالية عبر واجهة Ozone
          Connect الخاصة بها ويعيد الاستجابة. ويدير المركز الموافقات ويُصدر رموز الوصول ويوفّر
          الواجهات الموجّهة لمزوّدي الطرف الثالث، فلا يستدعي هؤلاء الأنظمة الخلفية للمؤسسة مباشرة.
        </p>
        <p>
          تتطلب مشاركة بيانات العملاء وبدء المدفوعات موافقة العميل. أما خدمات مثل التحقق من اسم
          المستفيد ومعلومات المنتجات ومعلومات أجهزة الصرّاف الآلي فتعمل ببيانات اعتماد العميل البرمجي
          دون رحلة موافقة من العميل النهائي. ويوفّر <strong>FAPI</strong> ملف الأمان الخاص بالواجهات
          المالية، بينما يسجّل <a href="/ar/learn/glossary/#dcr">DCR</a> العميل البرمجي، وهي خطوة
          منفصلة عن مصادقة العميل.
        </p>
        <p>
          تتضمّن لقطة دليل بيئة الإنتاج المرصودة بتاريخ{' '}
          <time datetime={observedDate}>{arabicDate(observedDate)}</time>
          <strong>{families} معرّفات منشورة لعائلات واجهات برمجة التطبيقات</strong>:
          <span lang="en" dir="ltr">
            {familyNames}
          </span>
          . ويعرض
          <a href="/observatory" hreflang="en">
            المرصد
          </a>{' '}
          (بالإنجليزية) الموارد والإصدارات المنشورة. ولا يثبت النشر نجاح التكامل أو توفّر الخدمة أو
          استخدامها الفعلي.
        </p>
      </section>

      <OperatorPointer
        {...arabicPointer}
        intro="راجع المعايير الرسمية وإصدار المواصفات الذي اخترته، بما في ذلك التصحيحات. ويقدّم الموقع المرجعي المجتمعي مواد تقنية قابلة للتصفح (بالإنجليزية):"
        links={[
          {
            label: 'وثائق التمويل المفتوح الرسمية',
            href: 'https://openfinanceuae.atlassian.net/wiki/spaces/OF/overview',
          },
          {
            label: 'مواصفات واجهات برمجة التطبيقات — مرجع مجتمعي',
            href: 'https://nebras-open-finance.com/tech/api-specs/',
          },
          {
            label: 'الأمان وFAPI — مرجع مجتمعي',
            href: 'https://nebras-open-finance.com/tech/tpp-standards/security/fapi/',
          },
          {
            label: 'ملاحظات الإصدارات والتصحيحات — مرجع مجتمعي',
            href: 'https://nebras-open-finance.com/tech/release-notes-and-erratas/',
          },
        ]}
      />
    </div>
  </div>
</PageLayout>

<style>
  .guide-page {
    padding: var(--space-12) var(--space-4) var(--space-16);
  }
  .container {
    max-width: 760px;
    margin: 0 auto;
  }
  .breadcrumb {
    min-width: 0;
    display: flex;
    gap: var(--space-2);
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
  }
  .breadcrumb a {
    color: var(--color-text-secondary);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    color: var(--color-brand-ink);
  }
  .page-header h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 500;
    margin: 0 0 var(--space-2);
    color: var(--color-text);
    letter-spacing: -0.02em;
  }
  .subtitle {
    margin: 0 0 var(--space-8);
    color: var(--color-text-secondary);
    font-size: 1.05rem;
  }
  .concept p {
    color: var(--color-text);
    font-size: 1rem;
    line-height: 1.7;
    margin: 0 0 var(--space-4);
  }
  .concept strong {
    color: var(--color-text);
  }
  :global([data-theme='dark']) .concept p {
    color: var(--color-text-secondary);
  }
</style>
