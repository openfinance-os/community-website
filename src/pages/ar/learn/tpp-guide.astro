---
import PageUpdated from '@components/learn/PageUpdated.astro';
import PageLayout from '@layouts/PageLayout.astro';
import OperatorPointer from '@components/learn/OperatorPointer.astro';
import { arabicPointer } from '@lib/i18n';
---

<PageLayout
  title="مزوّد خدمة الطرف الثالث (TPP)"
  description="ما يفعله مزوّد خدمة الطرف الثالث عبر مركز واجهات برمجة التطبيقات في الإمارات، وأين تجد إرشادات المشاركة والتكامل."
>
  <div class="guide-page">
    <div class="container">
      <nav class="breadcrumb" aria-label="مسار التنقل">
        <a href="/ar/learn/">تعلّم</a>
        <span>/</span>
        <span>مزوّد خدمة الطرف الثالث</span>
      </nav>

      <header class="page-intro page-header">
        <h1>ما هو مزوّد خدمة الطرف الثالث؟</h1>
        <PageUpdated date="2026-11-28" lang="ar" />
        <p class="subtitle">شرح مبسّط، مع روابط إلى الوثائق الرسمية والمراجع التقنية المجتمعية.</p>
      </header>

      <section class="concept">
        <p>
          <strong>مزوّد خدمة الطرف الثالث (TPP)</strong> جهة تستخدم خدمات التمويل المفتوح عبر مركز
          واجهات برمجة التطبيقات المركزي (API Hub). وبعد الحصول على موافقة العميل المطلوبة، يمكنه
          قراءة البيانات المالية أو بدء المدفوعات. وتدعم هذه القدرات تطبيقات إدارة الميزانية، والدفع
          المباشر من الحساب المصرفي عند الشراء، وتجميع الحسابات، والإقراض المبني على التدفقات
          النقدية. ويمكن للمؤسسة المالية المرخّصة (LFI) أن تعمل أيضاً بصفة مزوّد طرف ثالث متى سمحت بذلك
          صلاحياتها وترخيصها.
        </p>
        <p>
          في الإمارات، يسجّل مزوّدو خدمات الطرف الثالث في دليل إطار الثقة، ويحصلون على الاعتماد، ثم
          يتكاملون عبر مركز واجهات برمجة التطبيقات المركزي. ومن الأدوار المعلنة في الدليل:
          <strong>BDSP</strong> (مزوّد مشاركة البيانات المصرفية)، و<strong>BSIP</strong> (مزوّد بدء
          الخدمات المصرفية)، و<strong>ISP</strong> (مزوّد خدمات التأمين). تصف هذه الأدوار صلاحيات،
          وليست تصنيفاً لترخيص المزوّد. ويسجّل
          <a href="/observatory" hreflang="en">
            المرصد
          </a>{' '}
          (بالإنجليزية) ما نرصده من تسجيلات وموارد منشورة في الدليل، ولا يتحقق من أن المزوّد مرخّص
          لخدمة بعينها أو أنه يستخدم واجهة برمجية فعلياً.
        </p>
      </section>

      <OperatorPointer
        {...arabicPointer}
        intro="راجع متطلبات المشاركة الرسمية قبل التخطيط للتكامل. ويقدّم موقع المعايير المجتمعي أدلة تقنية ومراجع للمواصفات (بالإنجليزية):"
        links={[
          {
            label: 'وثائق التمويل المفتوح الرسمية',
            href: 'https://openfinanceuae.atlassian.net/wiki/spaces/OF/overview',
          },
          {
            label: 'معايير مزوّدي خدمات الطرف الثالث — مرجع مجتمعي',
            href: 'https://nebras-open-finance.com/tech/tpp-standards',
          },
          {
            label: 'الاختبار والاعتماد — مرجع مجتمعي',
            href: 'https://nebras-open-finance.com/tech/tpp-standards/production/testing-certification/overview',
          },
          {
            label: 'مواصفات واجهات برمجة التطبيقات — مرجع مجتمعي',
            href: 'https://nebras-open-finance.com/tech/api-specs/',
          },
        ]}
      />
    </div>
  </div>
</PageLayout>

<style>
  .guide-page {
    padding: var(--space-12) var(--space-4) var(--space-16);
  }
  .container {
    max-width: 760px;
    margin: 0 auto;
  }
  .breadcrumb {
    min-width: 0;
    display: flex;
    gap: var(--space-2);
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
  }
  .breadcrumb a {
    color: var(--color-text-secondary);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    color: var(--color-brand-ink);
  }
  .page-header h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 500;
    margin: 0 0 var(--space-2);
    color: var(--color-text);
    letter-spacing: -0.02em;
  }
  .subtitle {
    margin: 0 0 var(--space-8);
    color: var(--color-text-secondary);
    font-size: 1.05rem;
  }
  .concept p {
    color: var(--color-text);
    font-size: 1rem;
    line-height: 1.7;
    margin: 0 0 var(--space-4);
  }
  .concept strong {
    color: var(--color-text);
  }
  :global([data-theme='dark']) .concept p {
    color: var(--color-text-secondary);
  }
</style>
