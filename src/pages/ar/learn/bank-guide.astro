---
import PageUpdated from '@components/learn/PageUpdated.astro';
import PageLayout from '@layouts/PageLayout.astro';
import OperatorPointer from '@components/learn/OperatorPointer.astro';
import { arabicDate, arabicPointer } from '@lib/i18n';
import latest from '../../../../data/observatory/snapshots/production/latest.json';

const withIssuer = latest.summary.liveInProduction;
const total = latest.summary.totalParticipants;
const observedDate = latest.timestamp.slice(0, 10);
---

<PageLayout
  title="المؤسسة المالية المرخّصة (LFI)"
  description="تعرّف على واجهة Ozone Connect لدى المؤسسة المالية المرخّصة، ومصادقة العميل، ومسؤوليات مركز واجهات برمجة التطبيقات المركزي."
>
  <div class="guide-page">
    <div class="container">
      <nav class="breadcrumb" aria-label="مسار التنقل">
        <a href="/ar/learn/">تعلّم</a>
        <span>/</span>
        <span>المؤسسة المالية المرخّصة</span>
      </nav>

      <header class="page-intro page-header">
        <h1>ما هي المؤسسة المالية المرخّصة؟</h1>
        <PageUpdated date="2026-11-28" lang="ar" />
        <p class="subtitle">مسؤوليات المؤسسة، ومسؤوليات المركز، وموارد التكامل.</p>
      </header>

      <section class="concept">
        <p>
          <strong>المؤسسة المالية المرخّصة (LFI)</strong>، كالمصرف أو شركة التأمين، تقدّم البيانات
          المالية أو تنفّذ الخدمات عبر مركز واجهات برمجة التطبيقات المركزي في الإمارات. وتطبّق المؤسسة
          <strong>Ozone Connect</strong>، وهي الواجهة الخلفية التي يستدعيها المركز. وتمرّ الطلبات
          والاستجابات الموجّهة إلى مزوّدي خدمات الطرف الثالث عبر المركز.
        </p>
        <p>
          يصادق العميل على هويته لدى المؤسسة المالية خلال رحلة التفويض. ويعمل المركز خادمَ تفويض وفق
          OIDC/FAPI، ويملك حالة الموافقة ويُصدر رموز الوصول. أما المؤسسة فتعالج الطلبات التي تحقّق
          منها المركز، ولا تُصدر رموز الوصول لمزوّد الطرف الثالث ولا تحتفظ بحالة موافقة مستقلة.
        </p>
        <p>
          الاعتماد وإثبات الجاهزية في بيئة الإنتاج أمران منفصلان عن النشر في الدليل. ففي لقطة بيئة
          الإنتاج المرصودة بتاريخ <time datetime={observedDate}>{arabicDate(observedDate)}</time>،
          <strong>
            ينشر {withIssuer} من أصل {total} معرّف تسجيل
          </strong>{' '}
          جهة إصدار نشطة. ولا تثبت هذه الأرقام عدد المؤسسات العاملة فعلياً. يمكنك استعراض البيانات
          الوصفية في{' '}
          <a href="/observatory" hreflang="en">
            المرصد
          </a>
          ، والنشاط التشغيلي المُعلن في
          <a href="/observatory/watch/" hreflang="en">
            مراقبة المنظومة
          </a>{' '}
          (بالإنجليزية).
        </p>
      </section>

      <OperatorPointer
        {...arabicPointer}
        intro="اعتمد على وثائق التمويل المفتوح الرسمية في المتطلبات الملزِمة. ويشرح الدليل المجتمعي للمؤسسات المالية رحلة التكامل ويربط بالمواد الداعمة (بالإنجليزية):"
        links={[
          {
            label: 'وثائق التمويل المفتوح الرسمية',
            href: 'https://openfinanceuae.atlassian.net/wiki/spaces/OF/overview',
          },
          {
            label: 'مركز واجهات برمجة التطبيقات للمؤسسات المالية — دليل تكامل مجتمعي',
            href: 'https://nebras-open-finance.com/tech/lfi-api-hub/',
          },
          {
            label: 'إطار الثقة — مرجع مجتمعي',
            href: 'https://nebras-open-finance.com/tech/lfi-api-hub/trust-framework/',
          },
          {
            label: 'الاختبار والاعتماد — وثائق رسمية',
            href: 'https://openfinanceuae.atlassian.net/wiki/spaces/OF/pages/124583943',
          },
        ]}
      />
    </div>
  </div>
</PageLayout>

<style>
  .guide-page {
    padding: var(--space-12) var(--space-4) var(--space-16);
  }
  .container {
    max-width: 760px;
    margin: 0 auto;
  }
  .breadcrumb {
    min-width: 0;
    display: flex;
    gap: var(--space-2);
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
  }
  .breadcrumb a {
    color: var(--color-text-secondary);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    color: var(--color-brand-ink);
  }
  .page-header h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 500;
    margin: 0 0 var(--space-2);
    color: var(--color-text);
    letter-spacing: -0.02em;
  }
  .subtitle {
    margin: 0 0 var(--space-8);
    color: var(--color-text-secondary);
    font-size: 1.05rem;
  }
  .concept p {
    color: var(--color-text);
    font-size: 1rem;
    line-height: 1.7;
    margin: 0 0 var(--space-4);
  }
  .concept strong {
    color: var(--color-text);
  }
  :global([data-theme='dark']) .concept p {
    color: var(--color-text-secondary);
  }
</style>
