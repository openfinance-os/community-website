---
import PageLayout from '@layouts/PageLayout.astro';
import EventCard from '@components/events/EventCard.astro';
import EventFilter from '@components/events/EventFilter.astro';
import { getCollection } from 'astro:content';

const allEvents = await getCollection('events');
const now = new Date();

// Separate upcoming and past events
const upcomingEvents = allEvents
  .filter((event) => new Date(event.data.date) >= now)
  .sort((a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime());

const pastEvents = allEvents
  .filter((event) => new Date(event.data.date) < now)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

// Filter types
const types = ['all', 'meetup', 'hackathon', 'webinar', 'conference', 'workshop'];
---

<PageLayout
  title="Events"
  description="Upcoming and past events in the UAE Open Finance community."
>
  <div class="events-page">
    <div class="container">
      <header class="page-header">
        <h1>Events</h1>
        <p class="subtitle">Discover upcoming community events, workshops, and meetups.</p>
      </header>

      <div class="filter-section">
        <EventFilter types={types} />
      </div>

      <section class="upcoming-events">
        <h2 class="section-label">Upcoming</h2>

        {
          upcomingEvents.length > 0 ? (
            <div class="events-grid">
              {upcomingEvents.map((event) => (
                <EventCard
                  title={event.data.title}
                  date={event.data.date}
                  endDate={event.data.endDate}
                  type={event.data.type}
                  location={event.data.location}
                  isOnline={event.data.isOnline}
                  description={event.data.description}
                  slug={event.slug}
                  featured={event.data.featured}
                />
              ))}
            </div>
          ) : (
            <div class="empty-state">
              <div class="empty-illustration" aria-hidden="true">
                <svg viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect
                    x="20"
                    y="30"
                    width="80"
                    height="70"
                    rx="8"
                    stroke="currentColor"
                    stroke-width="2"
                    class="calendar-body"
                  />
                  <path
                    d="M20 50h80"
                    stroke="currentColor"
                    stroke-width="2"
                    class="calendar-line"
                  />
                  <rect
                    x="35"
                    y="38"
                    width="10"
                    height="16"
                    rx="2"
                    fill="currentColor"
                    class="calendar-hook"
                  />
                  <rect
                    x="75"
                    y="38"
                    width="10"
                    height="16"
                    rx="2"
                    fill="currentColor"
                    class="calendar-hook"
                  />
                  <circle
                    cx="45"
                    cy="70"
                    r="6"
                    stroke="currentColor"
                    stroke-width="2"
                    class="calendar-dot"
                  />
                  <circle
                    cx="60"
                    cy="70"
                    r="6"
                    stroke="currentColor"
                    stroke-width="2"
                    class="calendar-dot"
                  />
                  <circle
                    cx="75"
                    cy="70"
                    r="6"
                    stroke="currentColor"
                    stroke-width="2"
                    class="calendar-dot"
                  />
                  <path
                    d="M45 85h30"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    class="calendar-line"
                  />
                  <circle
                    cx="95"
                    cy="85"
                    r="15"
                    fill="var(--color-primary-100)"
                    stroke="var(--color-primary-500)"
                    stroke-width="2"
                    class="badge-circle"
                  />
                  <path
                    d="M90 85l4 4 8-8"
                    stroke="var(--color-primary-600)"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="badge-check"
                  />
                </svg>
              </div>
              <h3 class="empty-title">No upcoming events yet</h3>
              <p class="empty-description">
                The community calendar is waiting for its next event. Check back soon or explore
                what happened before.
              </p>
              <div class="empty-actions">
                {pastEvents.length > 0 && (
                  <button class="action-btn action-secondary scroll-to-past">
                    <svg
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <circle cx="12" cy="12" r="10" />
                      <polyline points="12 6 12 12 16 14" />
                    </svg>
                    View {pastEvents.length} past event{pastEvents.length !== 1 ? 's' : ''}
                  </button>
                )}
                <a
                  href="https://github.com/openfinance-os/community/discussions"
                  class="action-btn action-primary"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="M12 5v14M5 12h14" />
                  </svg>
                  Propose an event
                </a>
              </div>

              <div class="event-suggestions">
                <h4>Events we're looking for</h4>
                <ul>
                  <li>
                    <svg
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                      <circle cx="9" cy="7" r="4" />
                      <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                      <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                    </svg>
                    Community meetups and networking events
                  </li>
                  <li>
                    <svg
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <rect x="2" y="3" width="20" height="14" rx="2" ry="2" />
                      <line x1="8" y1="21" x2="16" y2="21" />
                      <line x1="12" y1="17" x2="12" y2="21" />
                    </svg>
                    Technical webinars and API workshops
                  </li>
                  <li>
                    <svg
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <polygon points="12 2 2 7 12 12 22 7 12 2" />
                      <polyline points="2 17 12 22 22 17" />
                      <polyline points="2 12 12 17 22 12" />
                    </svg>
                    Hackathons and coding challenges
                  </li>
                  <li>
                    <svg
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
                      <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
                    </svg>
                    Educational sessions and training
                  </li>
                </ul>
              </div>
            </div>
          )
        }
      </section>

      {
        pastEvents.length > 0 && (
          <section class="past-events">
            <button class="section-toggle" aria-expanded="false" aria-controls="past-events-list">
              <h2 class="section-label">Past Events</h2>
              <span class="toggle-count">{pastEvents.length}</span>
              <svg
                class="toggle-icon"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <polyline points="6 9 12 15 18 9" />
              </svg>
            </button>

            <div id="past-events-list" class="events-grid past-list" hidden>
              {pastEvents.map((event) => (
                <EventCard
                  title={event.data.title}
                  date={event.data.date}
                  endDate={event.data.endDate}
                  type={event.data.type}
                  location={event.data.location}
                  isOnline={event.data.isOnline}
                  description={event.data.description}
                  slug={event.slug}
                  isPast={true}
                />
              ))}
            </div>
          </section>
        )
      }

      <section class="host-section">
        <h3>Want to host an event?</h3>
        <p>Organize a meetup, workshop, or webinar for the community.</p>
        <a
          href="https://github.com/openfinance-os/community/discussions"
          class="host-link"
          target="_blank"
          rel="noopener noreferrer"
        >
          Propose your event
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M7 17L17 7M17 7H7M17 7v10"></path>
          </svg>
        </a>
      </section>
    </div>
  </div>
</PageLayout>

<style>
  .events-page {
    padding: var(--space-12) var(--space-4);
  }

  .container {
    max-width: 800px;
    margin: 0 auto;
  }

  .page-header {
    margin-bottom: var(--space-8);
  }

  .page-header h1 {
    font-size: 2.25rem;
    font-weight: 700;
    margin-bottom: var(--space-2);
  }

  .subtitle {
    font-size: 1.125rem;
    color: var(--color-gray-600);
  }

  .filter-section {
    margin-bottom: var(--space-8);
  }

  .section-label {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-gray-400);
    margin-bottom: var(--space-4);
  }

  .upcoming-events {
    margin-bottom: var(--space-12);
  }

  .events-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .empty-state {
    padding: var(--space-10) var(--space-6);
    text-align: center;
    background: linear-gradient(135deg, var(--color-gray-50) 0%, var(--color-primary-50) 100%);
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-xl);
  }

  .empty-illustration {
    width: 100px;
    height: 100px;
    margin: 0 auto var(--space-6);
    color: var(--color-gray-300);
  }

  .empty-illustration svg {
    width: 100%;
    height: 100%;
  }

  .empty-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-gray-800);
    margin-bottom: var(--space-2);
  }

  .empty-description {
    font-size: 0.9375rem;
    color: var(--color-gray-500);
    max-width: 360px;
    margin: 0 auto var(--space-6);
    line-height: 1.6;
  }

  .empty-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-items: center;
  }

  @media (min-width: 480px) {
    .empty-actions {
      flex-direction: row;
      justify-content: center;
    }
  }

  .action-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    font-size: 0.875rem;
    font-weight: 500;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all var(--transition-fast);
    text-decoration: none;
    border: none;
  }

  .action-primary {
    background: var(--color-primary-600);
    color: white;
  }

  .action-primary:hover {
    background: var(--color-primary-700);
    text-decoration: none;
  }

  .action-secondary {
    background: white;
    color: var(--color-gray-700);
    border: 1px solid var(--color-gray-300);
  }

  .action-secondary:hover {
    background: var(--color-gray-50);
    border-color: var(--color-gray-400);
  }

  /* Event suggestions */
  .event-suggestions {
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-gray-200);
    text-align: left;
    max-width: 400px;
    margin-left: auto;
    margin-right: auto;
  }

  .event-suggestions h4 {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-gray-400);
    margin-bottom: var(--space-3);
  }

  .event-suggestions ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .event-suggestions li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) 0;
    font-size: 0.875rem;
    color: var(--color-gray-600);
  }

  .event-suggestions li svg {
    flex-shrink: 0;
    color: var(--color-primary-500);
  }

  :global([data-theme='dark']) .event-suggestions {
    border-top-color: var(--color-gray-300);
  }

  :global([data-theme='dark']) .event-suggestions h4 {
    color: var(--color-gray-500);
  }

  :global([data-theme='dark']) .event-suggestions li {
    color: var(--color-gray-400);
  }

  :global([data-theme='dark']) .event-suggestions li svg {
    color: var(--color-primary-400);
  }

  /* Past Events Toggle */
  .past-events {
    margin-bottom: var(--space-12);
  }

  .section-toggle {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    width: 100%;
    padding: var(--space-3) 0;
    background: none;
    border: none;
    border-bottom: 1px solid var(--color-gray-200);
    cursor: pointer;
    margin-bottom: var(--space-4);
  }

  .section-toggle:hover .section-label {
    color: var(--color-gray-600);
  }

  .section-toggle .section-label {
    margin-bottom: 0;
    transition: color var(--transition-fast);
  }

  .toggle-count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: var(--space-1) var(--space-2);
    background: var(--color-gray-100);
    border-radius: var(--radius-full);
    color: var(--color-gray-500);
  }

  .toggle-icon {
    margin-left: auto;
    color: var(--color-gray-400);
    transition: transform var(--transition-fast);
  }

  .section-toggle[aria-expanded='true'] .toggle-icon {
    transform: rotate(180deg);
  }

  .past-list[hidden] {
    display: none;
  }

  /* Host Section */
  .host-section {
    padding: var(--space-6);
    background: var(--color-gray-50);
    border-radius: var(--radius-lg);
    text-align: center;
  }

  .host-section h3 {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: var(--space-2);
  }

  .host-section p {
    font-size: 0.875rem;
    color: var(--color-gray-600);
    margin-bottom: var(--space-4);
  }

  .host-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-primary-600);
  }

  .host-link:hover {
    color: var(--color-primary-700);
  }

  /* Dark mode */
  :global([data-theme='dark']) .page-header h1 {
    color: var(--color-gray-900);
  }

  :global([data-theme='dark']) .subtitle {
    color: var(--color-gray-400);
  }

  :global([data-theme='dark']) .section-label {
    color: var(--color-gray-500);
  }

  :global([data-theme='dark']) .empty-state {
    background: linear-gradient(135deg, var(--color-gray-100) 0%, rgba(15, 118, 110, 0.1) 100%);
    border-color: var(--color-gray-200);
  }

  :global([data-theme='dark']) .empty-illustration {
    color: var(--color-gray-400);
  }

  :global([data-theme='dark']) .empty-title {
    color: var(--color-gray-100);
  }

  :global([data-theme='dark']) .empty-description {
    color: var(--color-gray-400);
  }

  :global([data-theme='dark']) .action-primary {
    background: var(--color-primary-500);
  }

  :global([data-theme='dark']) .action-primary:hover {
    background: var(--color-primary-400);
  }

  :global([data-theme='dark']) .action-secondary {
    background: var(--color-gray-200);
    color: var(--color-gray-100);
    border-color: var(--color-gray-300);
  }

  :global([data-theme='dark']) .action-secondary:hover {
    background: var(--color-gray-300);
    border-color: var(--color-gray-400);
  }

  :global([data-theme='dark']) .section-toggle {
    border-bottom-color: var(--color-gray-300);
  }

  :global([data-theme='dark']) .section-toggle:hover .section-label {
    color: var(--color-gray-300);
  }

  :global([data-theme='dark']) .toggle-count {
    background: var(--color-gray-200);
    color: var(--color-gray-400);
  }

  :global([data-theme='dark']) .toggle-icon {
    color: var(--color-gray-500);
  }

  :global([data-theme='dark']) .host-section {
    background: var(--color-gray-100);
  }

  :global([data-theme='dark']) .host-section h3 {
    color: var(--color-gray-900);
  }

  :global([data-theme='dark']) .host-section p {
    color: var(--color-gray-400);
  }

  :global([data-theme='dark']) .host-link {
    color: var(--color-primary-400);
  }

  :global([data-theme='dark']) .host-link:hover {
    color: var(--color-primary-300);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggle = document.querySelector('.section-toggle');
    const pastList = document.getElementById('past-events-list');
    const scrollToPastBtn = document.querySelector('.scroll-to-past');
    const hasNoUpcoming = document.querySelector('.empty-state') !== null;

    // Toggle past events section
    toggle?.addEventListener('click', () => {
      const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isExpanded));
      pastList?.toggleAttribute('hidden');
    });

    // Scroll to past events button
    scrollToPastBtn?.addEventListener('click', () => {
      if (toggle && pastList) {
        // Expand past events
        toggle.setAttribute('aria-expanded', 'true');
        pastList.removeAttribute('hidden');
        // Scroll to past events section
        toggle.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });

    // Auto-expand past events if no upcoming events
    if (hasNoUpcoming && toggle && pastList) {
      toggle.setAttribute('aria-expanded', 'true');
      pastList.removeAttribute('hidden');
    }
  });
</script>
