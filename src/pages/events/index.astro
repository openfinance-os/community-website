---
import PageLayout from '@layouts/PageLayout.astro';
import EventCard from '@components/events/EventCard.astro';
import EventFilter from '@components/events/EventFilter.astro';
import { getCollection } from 'astro:content';

const allEvents = await getCollection('events');
const now = new Date();

// Separate upcoming and past events
const upcomingEvents = allEvents
  .filter((event) => new Date(event.data.date) >= now)
  .sort((a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime());

const pastEvents = allEvents
  .filter((event) => new Date(event.data.date) < now)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

// Filter types
const types = ['all', 'meetup', 'hackathon', 'webinar', 'conference', 'workshop'];
---

<PageLayout
  title="Events"
  description="Upcoming and past events in the UAE Open Finance community."
>
  <div class="events-page">
    <div class="container">
      <header class="page-header">
        <h1>Events</h1>
        <p class="subtitle">Discover upcoming community events, workshops, and meetups.</p>
      </header>

      <div class="filter-section">
        <EventFilter types={types} />
      </div>

      <section class="upcoming-events">
        <h2 class="section-label">Upcoming</h2>

        {
          upcomingEvents.length > 0 ? (
            <div class="events-grid">
              {upcomingEvents.map((event) => (
                <EventCard
                  title={event.data.title}
                  date={event.data.date}
                  endDate={event.data.endDate}
                  type={event.data.type}
                  location={event.data.location}
                  isOnline={event.data.isOnline}
                  description={event.data.description}
                  slug={event.slug}
                  featured={event.data.featured}
                />
              ))}
            </div>
          ) : (
            <div class="empty-state">
              <p>No upcoming events scheduled.</p>
              <a
                href="https://github.com/openfinance-os/community/discussions"
                class="propose-link"
                target="_blank"
                rel="noopener noreferrer"
              >
                Propose an event
              </a>
            </div>
          )
        }
      </section>

      {
        pastEvents.length > 0 && (
          <section class="past-events">
            <button class="section-toggle" aria-expanded="false" aria-controls="past-events-list">
              <h2 class="section-label">Past Events</h2>
              <span class="toggle-count">{pastEvents.length}</span>
              <svg
                class="toggle-icon"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <polyline points="6 9 12 15 18 9" />
              </svg>
            </button>

            <div id="past-events-list" class="events-grid past-list" hidden>
              {pastEvents.map((event) => (
                <EventCard
                  title={event.data.title}
                  date={event.data.date}
                  endDate={event.data.endDate}
                  type={event.data.type}
                  location={event.data.location}
                  isOnline={event.data.isOnline}
                  description={event.data.description}
                  slug={event.slug}
                  isPast={true}
                />
              ))}
            </div>
          </section>
        )
      }

      <section class="host-section">
        <h3>Want to host an event?</h3>
        <p>Organize a meetup, workshop, or webinar for the community.</p>
        <a
          href="https://github.com/openfinance-os/community/discussions"
          class="host-link"
          target="_blank"
          rel="noopener noreferrer"
        >
          Propose your event
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M7 17L17 7M17 7H7M17 7v10"></path>
          </svg>
        </a>
      </section>
    </div>
  </div>
</PageLayout>

<style>
  .events-page {
    padding: var(--space-12) var(--space-4);
  }

  .container {
    max-width: 800px;
    margin: 0 auto;
  }

  .page-header {
    margin-bottom: var(--space-8);
  }

  .page-header h1 {
    font-size: 2.25rem;
    font-weight: 700;
    margin-bottom: var(--space-2);
  }

  .subtitle {
    font-size: 1.125rem;
    color: var(--color-gray-600);
  }

  .filter-section {
    margin-bottom: var(--space-8);
  }

  .section-label {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-gray-400);
    margin-bottom: var(--space-4);
  }

  .upcoming-events {
    margin-bottom: var(--space-12);
  }

  .events-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .empty-state {
    padding: var(--space-8);
    text-align: center;
    background: var(--color-gray-50);
    border-radius: var(--radius-lg);
  }

  .empty-state p {
    color: var(--color-gray-500);
    margin-bottom: var(--space-3);
  }

  .propose-link {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-primary-600);
  }

  /* Past Events Toggle */
  .past-events {
    margin-bottom: var(--space-12);
  }

  .section-toggle {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    width: 100%;
    padding: var(--space-3) 0;
    background: none;
    border: none;
    border-bottom: 1px solid var(--color-gray-200);
    cursor: pointer;
    margin-bottom: var(--space-4);
  }

  .section-toggle:hover .section-label {
    color: var(--color-gray-600);
  }

  .section-toggle .section-label {
    margin-bottom: 0;
    transition: color var(--transition-fast);
  }

  .toggle-count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: var(--space-1) var(--space-2);
    background: var(--color-gray-100);
    border-radius: var(--radius-full);
    color: var(--color-gray-500);
  }

  .toggle-icon {
    margin-left: auto;
    color: var(--color-gray-400);
    transition: transform var(--transition-fast);
  }

  .section-toggle[aria-expanded='true'] .toggle-icon {
    transform: rotate(180deg);
  }

  .past-list[hidden] {
    display: none;
  }

  /* Host Section */
  .host-section {
    padding: var(--space-6);
    background: var(--color-gray-50);
    border-radius: var(--radius-lg);
    text-align: center;
  }

  .host-section h3 {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: var(--space-2);
  }

  .host-section p {
    font-size: 0.875rem;
    color: var(--color-gray-600);
    margin-bottom: var(--space-4);
  }

  .host-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-primary-600);
  }

  .host-link:hover {
    color: var(--color-primary-700);
  }

  /* Dark mode */
  :global([data-theme='dark']) .page-header h1 {
    color: var(--color-gray-50);
  }

  :global([data-theme='dark']) .subtitle {
    color: var(--color-gray-400);
  }

  :global([data-theme='dark']) .section-label {
    color: var(--color-gray-500);
  }

  :global([data-theme='dark']) .empty-state {
    background: var(--color-gray-100);
  }

  :global([data-theme='dark']) .empty-state p {
    color: var(--color-gray-400);
  }

  :global([data-theme='dark']) .propose-link {
    color: var(--color-primary-400);
  }

  :global([data-theme='dark']) .section-toggle {
    border-bottom-color: var(--color-gray-300);
  }

  :global([data-theme='dark']) .section-toggle:hover .section-label {
    color: var(--color-gray-300);
  }

  :global([data-theme='dark']) .toggle-count {
    background: var(--color-gray-200);
    color: var(--color-gray-400);
  }

  :global([data-theme='dark']) .toggle-icon {
    color: var(--color-gray-500);
  }

  :global([data-theme='dark']) .host-section {
    background: var(--color-gray-100);
  }

  :global([data-theme='dark']) .host-section h3 {
    color: var(--color-gray-50);
  }

  :global([data-theme='dark']) .host-section p {
    color: var(--color-gray-400);
  }

  :global([data-theme='dark']) .host-link {
    color: var(--color-primary-400);
  }

  :global([data-theme='dark']) .host-link:hover {
    color: var(--color-primary-300);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggle = document.querySelector('.section-toggle');
    const pastList = document.getElementById('past-events-list');

    toggle?.addEventListener('click', () => {
      const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isExpanded));
      pastList?.toggleAttribute('hidden');
    });
  });
</script>
