---
import PageLayout from '@layouts/PageLayout.astro';
import LumaCheckout from '@components/events/LumaCheckout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map((event) => ({
    params: { slug: event.slug },
    props: { event },
  }));
}

const { event } = Astro.props;
const { Content } = await event.render();

const typeLabels: Record<string, string> = {
  meetup: 'Meetup',
  hackathon: 'Hackathon',
  webinar: 'Webinar',
  conference: 'Conference',
  workshop: 'Workshop',
};

const typeColors: Record<string, string> = {
  meetup: 'type-blue',
  hackathon: 'type-pink',
  webinar: 'type-green',
  conference: 'type-amber',
  workshop: 'type-purple',
};

const now = new Date();
const isPast = new Date(event.data.date) < now;

// Format date
const formatDate = (d: Date) => {
  return d.toLocaleDateString('en-US', {
    weekday: 'long',
    month: 'long',
    day: 'numeric',
    year: 'numeric',
  });
};

// Format date range for multi-day events
const formatDateRange = (start: Date, end?: Date) => {
  if (end && end.getTime() !== start.getTime()) {
    return `${start.toLocaleDateString('en-US', { month: 'long', day: 'numeric' })} - ${end.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}`;
  }
  return formatDate(start);
};

// Format time
const formatTime = (d: Date) => {
  return d.toLocaleTimeString('en-US', {
    hour: 'numeric',
    minute: '2-digit',
    hour12: true,
  });
};

const eventDate = new Date(event.data.date);
const endDate = event.data.endDate ? new Date(event.data.endDate) : undefined;
const isMultiDay = endDate && endDate.getTime() !== eventDate.getTime();

// Event structured data (JSON-LD)
const eventSchema = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: event.data.title,
  description: event.data.description,
  startDate: eventDate.toISOString(),
  endDate: endDate ? endDate.toISOString() : eventDate.toISOString(),
  eventStatus: isPast ? 'https://schema.org/EventScheduled' : 'https://schema.org/EventScheduled',
  eventAttendanceMode: event.data.isOnline
    ? 'https://schema.org/OnlineEventAttendanceMode'
    : 'https://schema.org/OfflineEventAttendanceMode',
  location: event.data.isOnline
    ? {
        '@type': 'VirtualLocation',
        url: event.data.url || Astro.site?.toString(),
      }
    : {
        '@type': 'Place',
        name: event.data.location,
        address: event.data.location,
      },
  organizer: {
    '@type': 'Organization',
    name: event.data.organizer,
  },
  url: new URL(`/events/${event.slug}`, Astro.site).toString(),
};
---

<PageLayout
  title={event.data.title}
  description={event.data.description}
  articleSchema={eventSchema}
>
  <article class="event-page">
    <div class="container">
      <a href="/updates?tab=events" class="back-link">
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M19 12H5M12 19l-7-7 7-7"></path>
        </svg>
        Back to events
      </a>

      <header class="event-header">
        <div class="event-badges">
          <span class:list={['event-type', typeColors[event.data.type]]}>
            {typeLabels[event.data.type]}
          </span>
          {isPast && <span class="past-badge">Past Event</span>}
        </div>
        <h1>{event.data.title}</h1>
        <p class="event-subtitle">{event.data.description}</p>
      </header>

      <div class="event-info-grid">
        <div class="info-card">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <path d="M16 2v4"></path><path d="M8 2v4"></path><path d="M3 10h18"></path>
          </svg>
          <div class="info-content">
            <span class="info-label">Date & Time</span>
            <span class="info-value">{formatDateRange(eventDate, endDate)}</span>
            {!isMultiDay && <span class="info-secondary">{formatTime(eventDate)}</span>}
          </div>
        </div>
        <div class="info-card">
          {
            event.data.isOnline ? (
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <rect x="2" y="3" width="20" height="14" rx="2" />
                <line x1="8" y1="21" x2="16" y2="21" />
                <line x1="12" y1="17" x2="12" y2="21" />
              </svg>
            ) : (
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                <circle cx="12" cy="10" r="3" />
              </svg>
            )
          }
          <div class="info-content">
            <span class="info-label">Location</span>
            <span class="info-value">{event.data.location}</span>
            {event.data.isOnline && <span class="info-secondary">Virtual Event</span>}
          </div>
        </div>
        <div class="info-card">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
          </svg>
          <div class="info-content">
            <span class="info-label">Organizer</span>
            <span class="info-value">{event.data.organizer}</span>
          </div>
        </div>
      </div>

      {
        !isPast && (event.data.lumaEventId || event.data.url) && (
          <div class="register-section">
            {event.data.lumaEventId ? (
              <LumaCheckout eventId={event.data.lumaEventId} />
            ) : (
              <a
                href={event.data.url}
                class="register-button"
                target="_blank"
                rel="noopener noreferrer"
              >
                Register for this event
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
              </a>
            )}
          </div>
        )
      }

      <div class="divider"></div>

      <div class="event-content prose">
        <Content />
      </div>

      <footer class="event-footer">
        <a href="/updates?tab=events" class="footer-back-link">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M19 12H5M12 19l-7-7 7-7"></path>
          </svg>
          Back to all events
        </a>
      </footer>
    </div>
  </article>
</PageLayout>

<style>
  .event-page {
    padding: var(--space-8) var(--space-4) var(--space-16);
  }

  .container {
    max-width: 720px;
    margin: 0 auto;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-gray-500);
    margin-bottom: var(--space-8);
    transition: color var(--transition-fast);
  }

  .back-link:hover {
    color: var(--color-primary-600);
    text-decoration: none;
  }

  .event-header {
    margin-bottom: var(--space-8);
  }

  .event-badges {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .event-type {
    padding: var(--space-1) var(--space-3);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    border-radius: var(--radius-full);
  }

  .type-blue {
    background: var(--color-primary-50);
    color: var(--color-primary-700);
  }

  .type-pink {
    background: #fce7f3;
    color: #9d174d;
  }

  .type-green {
    background: #dcfce7;
    color: #166534;
  }

  .type-amber {
    background: #fef3c7;
    color: #92400e;
  }

  .type-purple {
    background: #ede9fe;
    color: #5b21b6;
  }

  .past-badge {
    padding: var(--space-1) var(--space-3);
    background: var(--color-gray-100);
    color: var(--color-gray-500);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    border-radius: var(--radius-full);
  }

  .event-header h1 {
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 700;
    color: var(--color-gray-900);
    margin-bottom: var(--space-3);
    line-height: 1.2;
  }

  .event-subtitle {
    font-size: 1.125rem;
    color: var(--color-gray-600);
    line-height: 1.6;
  }

  .event-info-grid {
    display: grid;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }

  @media (min-width: 640px) {
    .event-info-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .info-card {
    display: flex;
    gap: var(--space-3);
    padding: var(--space-4);
    background: white;
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-lg);
  }

  .info-card svg {
    flex-shrink: 0;
    color: var(--color-primary-600);
    margin-top: 2px;
  }

  .info-content {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .info-label {
    font-size: 0.6875rem;
    font-family: var(--font-mono);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-gray-400);
  }

  .info-value {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-gray-900);
  }

  .info-secondary {
    font-size: 0.8125rem;
    color: var(--color-gray-500);
  }

  .register-section {
    margin-bottom: var(--space-8);
  }

  .register-button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    background: var(--color-primary-600);
    color: white;
    font-weight: 600;
    font-size: 0.9375rem;
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .register-button:hover {
    background: var(--color-primary-700);
    transform: translateY(-1px);
    text-decoration: none;
  }

  .divider {
    height: 1px;
    background: var(--color-gray-200);
    margin-bottom: var(--space-8);
  }

  /* Prose styles */
  .prose {
    line-height: 1.7;
    color: var(--color-gray-700);
  }

  .prose :global(h2) {
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--color-gray-900);
    margin-top: var(--space-8);
    margin-bottom: var(--space-4);
  }

  .prose :global(h3) {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-gray-900);
    margin-top: var(--space-6);
    margin-bottom: var(--space-3);
  }

  .prose :global(p) {
    margin-bottom: var(--space-4);
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: var(--space-4);
    padding-left: var(--space-6);
  }

  .prose :global(li) {
    margin-bottom: var(--space-2);
  }

  .prose :global(strong) {
    color: var(--color-gray-900);
    font-weight: 600;
  }

  .prose :global(a) {
    color: var(--color-primary-600);
  }

  .prose :global(a:hover) {
    color: var(--color-primary-700);
  }

  .event-footer {
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-gray-200);
  }

  .footer-back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-primary-600);
  }

  .footer-back-link:hover {
    color: var(--color-primary-700);
  }

  /* Dark mode */
  :global([data-theme='dark']) .info-card {
    background: var(--color-gray-100);
    border-color: var(--color-gray-200);
  }

  :global([data-theme='dark']) .past-badge {
    background: var(--color-gray-200);
    color: var(--color-gray-400);
  }

  :global([data-theme='dark']) .divider {
    background: var(--color-gray-200);
  }
</style>
