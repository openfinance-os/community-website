---
import PageLayout from '@layouts/PageLayout.astro';
import Hero from '@components/home/Hero.astro';
import ValueProposition from '@components/home/ValueProposition.astro';
import LiveDashboard from '@components/home/LiveDashboard.astro';
import LatestNews from '@components/home/LatestNews.astro';
import GetInvolved from '@components/home/GetInvolved.astro';

// Import observatory data
import snapshot from '../../data/observatory/snapshots/latest.json';

// Handle both old flat format and new dual-environment format
const isDualFormat = 'production' in snapshot;
const productionData = isDualFormat ? snapshot.production : snapshot;
const sandboxData = isDualFormat ? snapshot.sandbox : null;
const crossEnvironment = isDualFormat ? snapshot.crossEnvironment : null;

const { summary, timestamp } = productionData;
const { totalParticipants, byStatus, liveInProduction } = summary;
const activeCount = byStatus.Active || 0;

// Calculate ecosystem engagement stats
const ecosystemStats = {
  // Total unique participants across both environments
  totalUnique: crossEnvironment?.totalUniqueParticipants || totalParticipants,
  // Production stats
  production: {
    registered: totalParticipants,
    live: liveInProduction || 0,
  },
  // Sandbox stats
  sandbox: {
    registered: sandboxData?.summary?.totalParticipants || 0,
    live: sandboxData?.summary?.liveInProduction || 0,
  },
  // Cross-environment breakdown
  inBoth: crossEnvironment?.inBothEnvironments?.length || 0,
  productionOnly: crossEnvironment?.productionOnly?.length || 0,
  sandboxOnly: crossEnvironment?.sandboxOnly?.length || 0,
};

// Production count for hero
const productionCount = ecosystemStats.inBoth + ecosystemStats.productionOnly;
---

<PageLayout
  title="Home"
  description="The community home for UAE Open Finance and Open Banking. Real-time ecosystem visibility, developer resources, API guides, and community collaboration for the UAE financial services industry."
  lastUpdated={timestamp}
>
  <Hero
    participantCount={totalParticipants}
    activeCount={activeCount}
    productionCount={productionCount}
  />

  <ValueProposition />

  <LiveDashboard stats={ecosystemStats} lastUpdated={timestamp} />

  <LatestNews limit={4} />

  <GetInvolved />
</PageLayout>
