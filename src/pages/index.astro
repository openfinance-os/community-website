---
import PageLayout from '@layouts/PageLayout.astro';
import Hero from '@components/home/Hero.astro';
import OpenCircuit from '@components/home/OpenCircuit.astro';
import StartingPoints from '@components/home/StartingPoints.astro';
import WorkedExample from '@components/home/WorkedExample.astro';
import ObservatoryPreview from '@components/home/ObservatoryPreview.astro';
import EcosystemRecord from '@components/home/EcosystemRecord.astro';
import LatestNews from '@components/home/LatestNews.astro';
import WatchBriefing from '@components/home/WatchBriefing.astro';
import type { ObservatorySnapshot } from '@lib/types';
// Import observatory data
import snapshot from '../../data/observatory/snapshots/latest.json';

// Handle both old flat format and new dual-environment format
const isDualFormat = 'production' in snapshot;
const productionData = (isDualFormat
  ? snapshot.production
  : snapshot) as unknown as ObservatorySnapshot;
const sandboxData = (isDualFormat
  ? snapshot.sandbox
  : null) as unknown as ObservatorySnapshot | null;
const crossEnvironment = isDualFormat ? snapshot.crossEnvironment : null;

const { summary, timestamp, participants } = productionData;
const { totalParticipants, liveInProduction, apiFamilies } = summary;

// Calculate API family coverage - count participants supporting each API family
const apiFamilyCoverage: Record<string, number> = {};
for (const family of apiFamilies || []) {
  apiFamilyCoverage[family] = participants.filter((p) => p.apiFamilies?.includes(family)).length;
}

// Calculate ecosystem engagement stats
const ecosystemStats = {
  // Total unique participants across both environments
  totalUnique: crossEnvironment?.totalUniqueParticipants || totalParticipants,
  // Production stats
  production: {
    registered: totalParticipants,
    live: liveInProduction || 0,
  },
  // Sandbox stats
  sandbox: {
    registered: sandboxData?.summary?.totalParticipants || 0,
    live: sandboxData?.summary?.liveInProduction || 0,
  },
  // Cross-environment breakdown
  inBoth: crossEnvironment?.inBothEnvironments?.length || 0,
  productionOnly: crossEnvironment?.productionOnly?.length || 0,
  sandboxOnly: crossEnvironment?.sandboxOnly?.length || 0,
  // API Family coverage
  apiFamilies: apiFamilies || [],
  apiFamilyCoverage,
};

const quickLinks = [
  {
    title: 'New to Open Finance?',
    description: 'Start with the basics — understand the UAE Open Finance framework.',
    href: '/learn',
    icon: 'book',
  },
  {
    title: 'Sources & community references',
    description:
      'Official documentation and independent resources, with their roles clearly labelled.',
    href: '/learn#resources',
    icon: 'link',
  },
  {
    title: 'Contribute on GitHub',
    description: 'Help improve this community resource — all contributions welcome.',
    href: 'https://github.com/openfinance-os',
    icon: 'github',
    external: true,
  },
];

const icons: Record<string, string> = {
  book: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>`,
  link: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>`,
  github: `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>`,
};
---

<PageLayout
  title="Home"
  description="The community home for UAE Open Finance and Open Banking. Daily ecosystem observations, developer resources, API guides, and community collaboration for the UAE financial services industry."
  lastUpdated={timestamp}
>
  <Hero
    production={{
      registered: totalParticipants,
      apiFamilies: apiFamilies || [],
      observedAt: timestamp,
    }}
    sandbox={sandboxData
      ? {
          registered: sandboxData.summary.totalParticipants,
          apiFamilies: sandboxData.summary.apiFamilies || [],
          observedAt: sandboxData.timestamp,
        }
      : null}
  />
  <StartingPoints />
  <OpenCircuit />
  <WorkedExample />

  <ObservatoryPreview stats={ecosystemStats} />

  <WatchBriefing />

  <EcosystemRecord />

  <LatestNews limit={4} />

  <section class="quick-links-section">
    <div class="container">
      <h2 class="section-title">Quick Links</h2>
      <div class="quick-links-grid">
        {
          quickLinks.map((link) => (
            <a
              href={link.href}
              class="quick-link-card"
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
            >
              <div class="quick-link-icon" set:html={icons[link.icon]} />
              <div class="quick-link-content">
                <h3 class="quick-link-title">
                  {link.title}
                  {link.external && (
                    <svg
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      class="external-icon"
                    >
                      <path d="M7 17L17 7M17 7H7M17 7v10" />
                    </svg>
                  )}
                </h3>
                <p class="quick-link-description">{link.description}</p>
              </div>
              <div class="quick-link-arrow" aria-hidden="true">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
  <section class="community-section" aria-labelledby="community-title">
    <div class="community-band">
      <div>
        <h2 id="community-title">Better, together.</h2><p>
          OpenFinance-OS belongs to its community. Share a perspective, improve a resource, or help
          build the tools everyone can use.
        </p>
      </div><a href="https://github.com/openfinance-os" target="_blank" rel="noopener noreferrer"
        >Contribute on GitHub <span aria-hidden="true">↗</span></a
      >
    </div>
    <p class="operator-handoff">
      Building or integrating on Al Tareq? Start with the <a
        href="https://openfinanceuae.atlassian.net/wiki/spaces/OF/overview"
        rel="noopener">official documentation</a
      > for standards and onboarding guidance. The <a
        href="https://nebras-open-finance.com/"
        rel="noopener">Nebras community reference</a
      > offers independent technical context.
    </p>
  </section>
</PageLayout>

<style>
  .quick-links-section {
    padding: var(--space-16) var(--space-4);
    background: var(--color-surface);
  }

  .container {
    max-width: 1224px;
    margin: 0 auto;
  }

  .section-title {
    font-size: 2rem;
    font-weight: 500;
    color: var(--color-gray-900);
    margin-bottom: var(--space-6);
  }

  .quick-links-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    .quick-links-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .quick-link-card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-6) var(--space-8);
    background: var(--color-card);
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-xl);
    text-decoration: none;
    color: inherit;
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast),
      transform var(--transition-fast);
  }

  .quick-link-card:hover {
    border-color: var(--color-primary-300);
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px) scale(1.01);
    text-decoration: none;
  }

  .quick-link-card:focus-visible {
    outline: 2px solid var(--color-primary-500);
    outline-offset: 2px;
  }

  .quick-link-icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-primary-50);
    color: var(--color-primary-600);
    border-radius: var(--radius-lg);
  }

  .quick-link-icon :global(svg) {
    width: 20px;
    height: 20px;
  }

  .quick-link-content {
    flex: 1;
    min-width: 0;
  }

  .quick-link-title {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-gray-900);
    margin-bottom: var(--space-1);
  }

  .quick-link-card:hover .quick-link-title {
    color: var(--color-primary-700);
  }

  .external-icon {
    opacity: 0.5;
    flex-shrink: 0;
  }

  .quick-link-description {
    font-size: 0.875rem;
    color: var(--color-gray-600);
    line-height: 1.5;
  }

  .quick-link-arrow {
    flex-shrink: 0;
    color: var(--color-gray-300);
    transition:
      color var(--transition-fast),
      transform var(--transition-fast);
  }

  .quick-link-card:hover .quick-link-arrow {
    color: var(--color-primary-500);
    transform: translateX(4px);
  }

  @media (max-width: 767px) {
    .quick-link-arrow {
      display: none;
    }
  }

  /* Dark mode */
  :global([data-theme='dark']) .quick-links-section {
    background: var(--color-gray-100);
  }

  :global([data-theme='dark']) .section-title {
    color: var(--color-gray-900);
  }

  :global([data-theme='dark']) .quick-link-card {
    background: var(--color-soft);
    border-color: var(--color-gray-300);
  }

  :global([data-theme='dark']) .quick-link-card:hover {
    border-color: var(--color-brand-ink);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    transform: translateY(-2px) scale(1.01);
  }

  :global([data-theme='dark']) .quick-link-icon {
    background: rgba(20, 184, 166, 0.15);
    color: var(--color-brand-ink);
  }

  :global([data-theme='dark']) .quick-link-title {
    color: var(--color-gray-900);
  }

  :global([data-theme='dark']) .quick-link-card:hover .quick-link-title {
    color: var(--color-brand-ink);
  }

  :global([data-theme='dark']) .quick-link-description {
    color: var(--color-text-secondary);
  }

  :global([data-theme='dark']) .quick-link-arrow {
    color: var(--color-text-secondary);
  }

  :global([data-theme='dark']) .quick-link-card:hover .quick-link-arrow {
    color: var(--color-brand-ink);
  }
  .community-section {
    max-width: 1272px;
    margin: 0 auto;
    padding: 0 24px 56px;
  }
  .community-band {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    background: #0c3d3e;
    color: #f1f7f1;
    border-radius: 12px;
    padding: 35px 40px;
  }
  .community-band h2 {
    font-size: 1.75rem;
    font-weight: 500;
    letter-spacing: -0.035em;
    color: #f1f7f1;
    margin-bottom: 9px;
  }
  .community-band p {
    max-width: 600px;
    font-size: 0.9375rem;
    color: #bfd2c7;
    line-height: 1.7;
  }
  .community-band a {
    display: inline-flex;
    align-items: center;
    gap: 18px;
    color: #f1f7f1;
    font-size: 0.875rem;
    flex-shrink: 0;
    border-bottom: 1px solid #6e9181;
    padding: 10px 0;
  }
  .operator-handoff {
    margin: 20px 0 0;
    color: var(--color-text-secondary);
    font-size: 0.8125rem;
    line-height: 1.7;
  }
  .operator-handoff a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (max-width: 700px) {
    .community-section {
      padding: 0 20px 40px;
    }
    .community-band {
      padding: 28px 25px;
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
  }
</style>
