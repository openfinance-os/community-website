---
import PageLayout from '@layouts/PageLayout.astro';
import EventCard from '@components/events/EventCard.astro';
import NewsletterSignup from '@components/common/NewsletterSignup.astro';
import { getCollection } from 'astro:content';

// Get all events
const allEvents = await getCollection('events');

// Separate upcoming and past events
const now = new Date();
const upcomingEvents = allEvents
  .filter((event) => new Date(event.data.date) >= now)
  .sort((a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime());

const pastEvents = allEvents
  .filter((event) => new Date(event.data.date) < now)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

// Filter types for events
const eventTypes = ['all', 'meetup', 'hackathon', 'webinar', 'conference', 'workshop'];
---

<PageLayout
  title="Events"
  description="Events and updates from the UAE Open Finance community."
>
  <div class="updates-page">
    <header class="page-header">
      <div class="header-bg" aria-hidden="true">
        <div class="grid-overlay"></div>
      </div>
      <div class="header-content">
        <h1>Events</h1>
        <p class="header-description">Stay updated with the latest community events</p>
      </div>
    </header>

    <div class="container">
      <div class="filter-section">
        <div class="event-filter" role="group" aria-label="Filter events by type">
          {
            eventTypes.map((type) => (
              <button
                class:list={['filter-btn', { active: type === 'all' }]}
                data-event-type={type}
              >
                {type === 'all' ? 'All' : type.charAt(0).toUpperCase() + type.slice(1)}
              </button>
            ))
          }
        </div>
      </div>

      <section class="upcoming-events">
        <h2 class="section-label">Upcoming</h2>
        {
          upcomingEvents.length > 0 ? (
            <div class="events-grid">
              {upcomingEvents.map((event) => (
                <div data-event-type={event.data.type}>
                  <EventCard
                    title={event.data.title}
                    date={event.data.date}
                    endDate={event.data.endDate}
                    type={event.data.type}
                    location={event.data.location}
                    isOnline={event.data.isOnline}
                    description={event.data.description}
                    slug={event.slug}
                    featured={event.data.featured}
                  />
                </div>
              ))}
            </div>
          ) : (
            <div class="empty-state">
              <div class="empty-illustration" aria-hidden="true">
                <svg viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect
                    x="20"
                    y="30"
                    width="80"
                    height="70"
                    rx="8"
                    stroke="currentColor"
                    stroke-width="2"
                    class="calendar-body"
                  />
                  <path
                    d="M20 50h80"
                    stroke="currentColor"
                    stroke-width="2"
                    class="calendar-line"
                  />
                  <rect
                    x="35"
                    y="38"
                    width="10"
                    height="16"
                    rx="2"
                    fill="currentColor"
                    class="calendar-hook"
                  />
                  <rect
                    x="75"
                    y="38"
                    width="10"
                    height="16"
                    rx="2"
                    fill="currentColor"
                    class="calendar-hook"
                  />
                  <circle
                    cx="45"
                    cy="70"
                    r="6"
                    stroke="currentColor"
                    stroke-width="2"
                    class="calendar-dot"
                  />
                  <circle
                    cx="60"
                    cy="70"
                    r="6"
                    stroke="currentColor"
                    stroke-width="2"
                    class="calendar-dot"
                  />
                  <circle
                    cx="75"
                    cy="70"
                    r="6"
                    stroke="currentColor"
                    stroke-width="2"
                    class="calendar-dot"
                  />
                  <path
                    d="M45 85h30"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    class="calendar-line"
                  />
                </svg>
              </div>
              <h3 class="empty-title">No upcoming events yet</h3>
              <p class="empty-description">Check back soon for new community events!</p>
              <div class="empty-newsletter">
                <NewsletterSignup
                  variant="card"
                  title="Get notified about events"
                  description="Subscribe to be the first to know when new events are announced."
                />
              </div>
            </div>
          )
        }
      </section>

      {
        pastEvents.length > 0 && (
          <section class="past-events">
            <button class="section-toggle" aria-expanded="false" aria-controls="past-events-list">
              <h2 class="section-label">Past Events</h2>
              <span class="toggle-count">{pastEvents.length}</span>
              <svg
                class="toggle-icon"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <polyline points="6 9 12 15 18 9" />
              </svg>
            </button>

            <div id="past-events-list" class="events-grid past-list" hidden>
              {pastEvents.map((event) => (
                <div data-event-type={event.data.type}>
                  <EventCard
                    title={event.data.title}
                    date={event.data.date}
                    endDate={event.data.endDate}
                    type={event.data.type}
                    location={event.data.location}
                    isOnline={event.data.isOnline}
                    description={event.data.description}
                    slug={event.slug}
                    isPast={true}
                  />
                </div>
              ))}
            </div>
          </section>
        )
      }

      <section class="host-section">
        <h3>Want to host an event?</h3>
        <p>Organize a meetup, workshop, or webinar for the community.</p>
        <a
          href="https://github.com/openfinance-os/community/discussions"
          class="host-link"
          target="_blank"
          rel="noopener noreferrer"
        >
          Propose your event
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M7 17L17 7M17 7H7M17 7v10"></path>
          </svg>
        </a>
      </section>
    </div>
  </div>
</PageLayout>

<style>
  .updates-page {
    min-height: 100vh;
  }

  .page-header {
    position: relative;
    padding: var(--space-16) var(--space-4) var(--space-12);
    background: linear-gradient(to bottom, var(--color-gray-900) 0%, var(--color-gray-800) 100%);
    color: white;
    text-align: center;
    overflow: hidden;
  }

  .header-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .grid-overlay {
    position: absolute;
    inset: 0;
    background-image: var(--grid-pattern);
    opacity: 0.3;
  }

  .header-content {
    position: relative;
    max-width: 700px;
    margin: 0 auto;
  }

  .header-content h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    margin-bottom: var(--space-4);
    letter-spacing: -0.02em;
    color: white;
  }

  .header-description {
    font-size: 1.125rem;
    color: rgba(255, 255, 255, 0.8);
    max-width: 500px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .container {
    max-width: 1000px;
    margin: 0 auto;
    padding: var(--space-8) var(--space-4) var(--space-12);
  }

  /* Filters */
  .filter-section {
    margin-bottom: var(--space-6);
  }

  .event-filter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .filter-btn {
    padding: var(--space-2) var(--space-4);
    background: transparent;
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-full);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-gray-600);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .filter-btn:hover {
    border-color: var(--color-primary-300);
    color: var(--color-primary-700);
  }

  .filter-btn.active {
    background: var(--color-primary-600);
    border-color: var(--color-primary-600);
    color: white;
  }

  /* Section Labels */
  .section-label {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-gray-400);
    margin-bottom: var(--space-4);
  }

  /* Events Grid */
  .upcoming-events {
    margin-bottom: var(--space-12);
  }

  .events-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  /* Empty State */
  .empty-state {
    padding: var(--space-10) var(--space-6);
    text-align: center;
    background: linear-gradient(135deg, var(--color-gray-50) 0%, var(--color-primary-50) 100%);
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-xl);
  }

  .empty-illustration {
    width: 100px;
    height: 100px;
    margin: 0 auto var(--space-6);
    color: var(--color-gray-300);
  }

  .empty-illustration svg {
    width: 100%;
    height: 100%;
  }

  .empty-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-gray-800);
    margin-bottom: var(--space-2);
  }

  .empty-description {
    font-size: 0.9375rem;
    color: var(--color-gray-500);
    max-width: 360px;
    margin: 0 auto var(--space-6);
    line-height: 1.6;
  }

  .empty-newsletter {
    margin-top: var(--space-8);
    max-width: 400px;
    margin-left: auto;
    margin-right: auto;
  }

  /* Past Events Toggle */
  .past-events {
    margin-bottom: var(--space-12);
  }

  .section-toggle {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    width: 100%;
    padding: var(--space-3) 0;
    background: none;
    border: none;
    border-bottom: 1px solid var(--color-gray-200);
    cursor: pointer;
    margin-bottom: var(--space-4);
  }

  .section-toggle:hover .section-label {
    color: var(--color-gray-600);
  }

  .section-toggle .section-label {
    margin-bottom: 0;
    transition: color var(--transition-fast);
  }

  .toggle-count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: var(--space-1) var(--space-2);
    background: var(--color-gray-100);
    border-radius: var(--radius-full);
    color: var(--color-gray-500);
  }

  .toggle-icon {
    margin-left: auto;
    color: var(--color-gray-400);
    transition: transform var(--transition-fast);
  }

  .section-toggle[aria-expanded='true'] .toggle-icon {
    transform: rotate(180deg);
  }

  .past-list {
    padding-top: var(--space-4);
  }

  .past-list[hidden] {
    display: none;
  }

  /* Host Section */
  .host-section {
    padding: var(--space-6);
    background: var(--color-gray-50);
    border-radius: var(--radius-lg);
    text-align: center;
  }

  .host-section h3 {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: var(--space-2);
  }

  .host-section p {
    font-size: 0.875rem;
    color: var(--color-gray-600);
    margin-bottom: var(--space-4);
  }

  .host-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-primary-600);
  }

  .host-link:hover {
    color: var(--color-primary-700);
  }

  /* Dark mode */
  :global([data-theme='dark']) .page-header {
    background: linear-gradient(to bottom, #111827 0%, #1f2937 100%);
  }

  :global([data-theme='dark']) .filter-btn {
    border-color: var(--color-gray-300);
    color: var(--color-gray-400);
  }

  :global([data-theme='dark']) .filter-btn:hover {
    border-color: var(--color-primary-400);
    color: var(--color-primary-400);
  }

  :global([data-theme='dark']) .filter-btn.active {
    background: var(--color-primary-500);
    border-color: var(--color-primary-500);
  }

  :global([data-theme='dark']) .section-label {
    color: var(--color-gray-500);
  }

  :global([data-theme='dark']) .empty-state {
    background: linear-gradient(135deg, var(--color-gray-100) 0%, rgba(15, 118, 110, 0.1) 100%);
    border-color: var(--color-gray-200);
  }

  :global([data-theme='dark']) .empty-title {
    color: var(--color-gray-100);
  }

  :global([data-theme='dark']) .empty-description {
    color: var(--color-gray-400);
  }

  :global([data-theme='dark']) .section-toggle {
    border-bottom-color: var(--color-gray-300);
  }

  :global([data-theme='dark']) .toggle-count {
    background: var(--color-gray-200);
    color: var(--color-gray-400);
  }

  :global([data-theme='dark']) .host-section {
    background: var(--color-gray-100);
  }

  :global([data-theme='dark']) .host-section h3 {
    color: var(--color-gray-900);
  }

  :global([data-theme='dark']) .host-section p {
    color: var(--color-gray-400);
  }

  :global([data-theme='dark']) .host-link {
    color: var(--color-primary-400);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Past events toggle
    const toggle = document.querySelector('.section-toggle');
    const pastList = document.getElementById('past-events-list');
    const hasNoUpcoming = document.querySelector('.empty-state') !== null;

    toggle?.addEventListener('click', () => {
      const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isExpanded));
      pastList?.toggleAttribute('hidden');
    });

    // Auto-expand past events if no upcoming events
    if (hasNoUpcoming && toggle && pastList) {
      toggle.setAttribute('aria-expanded', 'true');
      pastList.removeAttribute('hidden');
    }

    // Event filtering
    const eventFilters = document.querySelectorAll('.event-filter [data-event-type]');
    const eventCards = document.querySelectorAll('.events-grid > [data-event-type]');

    eventFilters.forEach((filter) => {
      filter.addEventListener('click', () => {
        const type = filter.getAttribute('data-event-type');

        // Update active state
        document.querySelectorAll('.event-filter .filter-btn').forEach((btn) => {
          btn.classList.remove('active');
        });
        filter.classList.add('active');

        // Filter cards
        eventCards.forEach((card) => {
          const cardType = card.getAttribute('data-event-type');
          if (type === 'all' || cardType === type) {
            (card as HTMLElement).style.display = '';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  });
</script>
