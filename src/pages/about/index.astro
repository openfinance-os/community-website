---
import PageLayout from '@layouts/PageLayout.astro';
---

<PageLayout
  title="About"
  description="About OpenFinance-OS - a community initiative for UAE Open Finance ecosystem visibility."
>
  <div class="about-page">
    <!-- Hero Section -->
    <header class="hero">
      <div class="container">
        <h1>About OpenFinance-OS</h1>
        <p class="hero-subtitle">Independent by design — the neutral record of UAE Open Finance.</p>
        <p class="hero-description">
          We are not official and not affiliated, deliberately. An operator can't be the neutral
          scorekeeper of its own program; an independent community can. That's why this site exists
          alongside the operator's — a community of developers, fintechs, bankers, and enthusiasts
          who believe open ecosystems thrive on transparency.
        </p>
        <div class="hero-cta">
          <a
            href="https://github.com/organizations/openfinance-os/"
            class="btn btn-primary"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
              ></path>
            </svg>
            View on GitHub
          </a>
          <a
            href="https://github.com/openfinance-os/community/discussions"
            class="btn btn-secondary"
            target="_blank"
            rel="noopener noreferrer"
          >
            Join the Discussion
          </a>
        </div>
      </div>
    </header>

    <!-- What We Provide Section -->
    <section class="section values-section">
      <div class="container">
        <h2>What We Provide</h2>
        <p class="section-intro">
          OpenFinance-OS offers resources and tools to help you navigate the UAE Open Finance
          landscape.
        </p>

        <div class="values-grid">
          <div class="value-card">
            <div class="card-icon">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
            </div>
            <h3>Visibility</h3>
            <p>
              Track ecosystem activity through the Observatory dashboard with real-time participant
              data.
            </p>
          </div>

          <div class="value-card">
            <div class="card-icon">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
              </svg>
            </div>
            <h3>Curated News</h3>
            <p>Community-curated news and updates from across the Open Finance ecosystem.</p>
          </div>

          <div class="value-card">
            <div class="card-icon">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
              </svg>
            </div>
            <h3>Resources</h3>
            <p>
              Guides and documentation for developers, fintechs, and banks building on Open Finance.
            </p>
          </div>

          <div class="value-card">
            <div class="card-icon">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
            </div>
            <h3>Community</h3>
            <p>A gathering point for collaboration, discussion, and shared learning.</p>
          </div>

          <div class="value-card">
            <div class="card-icon">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="2" y1="12" x2="22" y2="12"></line>
                <path
                  d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
                ></path>
              </svg>
            </div>
            <h3>Global Context</h3>
            <p>
              International benchmarking to track UAE progress against global Open Banking
              initiatives.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Disclaimer Callout -->
    <section class="section callout-section">
      <div class="container">
        <div class="callout-box">
          <div class="callout-icon">
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="16" x2="12" y2="12"></line>
              <line x1="12" y1="8" x2="12.01" y2="8"></line>
            </svg>
          </div>
          <div class="callout-content">
            <p class="callout-title">
              We are not official. We are not affiliated. We are contributors.
            </p>
            <p class="callout-description">
              OpenFinance-OS is an independent community initiative. We link to official sources—we
              don't replace them.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- What We're Not Section -->
    <section class="section not-section">
      <div class="container">
        <h2>What We're Not</h2>
        <div class="not-grid">
          <div class="not-item">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="15" y1="9" x2="9" y2="15"></line>
              <line x1="9" y1="9" x2="15" y2="15"></line>
            </svg>
            <span>Not an official regulator or scheme operator site</span>
          </div>
          <div class="not-item">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="15" y1="9" x2="9" y2="15"></line>
              <line x1="9" y1="9" x2="15" y2="15"></line>
            </svg>
            <span>Not affiliated with any single bank or TPP</span>
          </div>
          <div class="not-item">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="15" y1="9" x2="9" y2="15"></line>
              <line x1="9" y1="9" x2="15" y2="15"></line>
            </svg>
            <span>Not a commercial platform or vendor showcase</span>
          </div>
          <div class="not-item">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="15" y1="9" x2="9" y2="15"></line>
              <line x1="9" y1="9" x2="15" y2="15"></line>
            </svg>
            <span>Not a replacement for Al Tareq or CBUAE channels</span>
          </div>
        </div>

        <p class="nongoals-intro">
          Concretely, so the two sites never converge, this site does not carry API specifications,
          integration guides, certification or testing docs, service-desk functions, or pricing and
          SLA content. That's the operator's job — we link there. (Independent <em>analysis</em> of public
          operational data, like the weekly Watch, is in scope; duplicating the operator's own presentation
          is not.)
        </p>
      </div>
    </section>

    <!-- Who to use when -->
    <section class="section routing-section">
      <div class="container">
        <h2>Which site do you need?</h2>
        <div class="routing-grid">
          <div class="routing-card">
            <span class="routing-q">Building or integrating?</span>
            <p>
              API specifications, TPP standards, LFI integration guides, certification and the
              service desk are maintained by the Al&nbsp;Tareq operator's team.
            </p>
            <a href="https://nebras-open-finance.com/" rel="noopener" class="routing-link"
              >nebras-open-finance.com →</a
            >
          </div>
          <div class="routing-card here">
            <span class="routing-q">Understanding, tracking, or comparing?</span>
            <p>
              The independent record of the ecosystem, the global comparisons, the community commons
              — and a plain-language on-ramp for newcomers.
            </p>
            <a href="/observatory" class="routing-link">Start with the Observatory →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Governance Section -->
    <section class="section governance-section">
      <div class="container">
        <h2>Governance</h2>
        <div class="governance-content">
          <div class="governance-text">
            <p>
              OpenFinance-OS is community-owned and open source. The codebase is maintained on
              GitHub under the <a
                href="https://github.com/organizations/openfinance-os/"
                target="_blank"
                rel="noopener noreferrer">openfinance-os</a
              > organization.
            </p>
            <p>
              We accept no corporate sponsorship, have no paid placement, and maintain editorial
              independence.
            </p>
          </div>
          <div class="governance-badges">
            <div class="badge">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
              <span>Independent</span>
            </div>
            <div class="badge">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M18 8h1a4 4 0 0 1 0 8h-1"></path>
                <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"></path>
                <line x1="6" y1="1" x2="6" y2="4"></line>
                <line x1="10" y1="1" x2="10" y2="4"></line>
                <line x1="14" y1="1" x2="14" y2="4"></line>
              </svg>
              <span>No Sponsors</span>
            </div>
            <div class="badge">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <polygon
                  points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"
                ></polygon>
              </svg>
              <span>Open Source</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Documentation Section -->
    <section class="section docs-section">
      <div class="container">
        <h2>Documentation</h2>
        <p class="section-intro">Learn more about how we operate and how you can contribute.</p>
        <div class="docs-grid">
          <a
            href="https://github.com/openfinance-os/community-website/blob/main/docs/GOVERNANCE.md"
            class="doc-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="doc-icon">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
                <polyline points="10 9 9 9 8 9"></polyline>
              </svg>
            </span>
            <div>
              <strong>Governance</strong>
              <span>How decisions are made</span>
            </div>
            <svg
              class="arrow-icon"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <line x1="7" y1="17" x2="17" y2="7"></line>
              <polyline points="7 7 17 7 17 17"></polyline>
            </svg>
          </a>
          <a
            href="https://github.com/openfinance-os/community-website/blob/main/docs/CONTRIBUTING.md"
            class="doc-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="doc-icon">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="8.5" cy="7" r="4"></circle>
                <line x1="20" y1="8" x2="20" y2="14"></line>
                <line x1="23" y1="11" x2="17" y2="11"></line>
              </svg>
            </span>
            <div>
              <strong>Contributing</strong>
              <span>How to get involved</span>
            </div>
            <svg
              class="arrow-icon"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <line x1="7" y1="17" x2="17" y2="7"></line>
              <polyline points="7 7 17 7 17 17"></polyline>
            </svg>
          </a>
          <a
            href="https://github.com/openfinance-os/community-website/blob/main/docs/EDITORIAL.md"
            class="doc-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="doc-icon">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M12 19l7-7 3 3-7 7-3-3z"></path>
                <path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"></path>
                <path d="M2 2l7.586 7.586"></path>
                <circle cx="11" cy="11" r="2"></circle>
              </svg>
            </span>
            <div>
              <strong>Editorial Guidelines</strong>
              <span>Content standards</span>
            </div>
            <svg
              class="arrow-icon"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <line x1="7" y1="17" x2="17" y2="7"></line>
              <polyline points="7 7 17 7 17 17"></polyline>
            </svg>
          </a>
          <a
            href="https://github.com/openfinance-os/community-website/blob/main/CODE_OF_CONDUCT.md"
            class="doc-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="doc-icon">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"
                ></path>
              </svg>
            </span>
            <div>
              <strong>Code of Conduct</strong>
              <span>Community standards</span>
            </div>
            <svg
              class="arrow-icon"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <line x1="7" y1="17" x2="17" y2="7"></line>
              <polyline points="7 7 17 7 17 17"></polyline>
            </svg>
          </a>
          <a href="/brand/openfinance-os-brand-guidelines.html" class="doc-link">
            <span class="doc-icon">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <circle cx="13.5" cy="6.5" r="2.5"></circle>
                <path d="M17 3a2.83 2.83 0 0 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path>
              </svg>
            </span>
            <div>
              <strong>Brand Guidelines</strong>
              <span>Visual identity and usage</span>
            </div>
            <svg
              class="arrow-icon"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="section cta-section">
      <div class="container">
        <div class="cta-card">
          <h2>Ready to explore?</h2>
          <p>
            Dive into the Observatory to see real-time ecosystem data, or check out our learning
            resources to get started with UAE Open Finance.
          </p>
          <div class="cta-buttons">
            <a href="/observatory" class="btn btn-accent">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <circle cx="12" cy="12" r="10"></circle>
                <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
              </svg>
              View Observatory
            </a>
            <a href="/learn" class="btn btn-light"> Start Learning </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</PageLayout>

<style>
  .about-page {
    --section-spacing: var(--space-16);
  }

  .container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 var(--space-4);
  }

  /* Hero Section */
  .hero {
    padding: var(--space-16) var(--space-4);
    text-align: center;
    background: linear-gradient(180deg, var(--color-primary-50) 0%, var(--color-surface) 100%);
  }

  .hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: var(--space-4);
    color: var(--color-primary-700);
  }

  .hero-subtitle {
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--color-primary-600);
    max-width: 600px;
    margin: 0 auto var(--space-4);
    line-height: 1.5;
  }

  .hero-description {
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
    max-width: 550px;
    margin: 0 auto var(--space-8);
    line-height: 1.7;
  }

  .hero-cta {
    display: flex;
    gap: var(--space-3);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-6);
    font-weight: 500;
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .btn-primary {
    background: var(--color-gray-900);
    color: white;
  }

  .btn-primary:hover {
    background: var(--color-gray-800);
    text-decoration: none;
  }

  .btn-secondary {
    background: white;
    color: var(--color-text);
    border: 1px solid var(--color-gray-300);
  }

  .btn-secondary:hover {
    background: var(--color-gray-100);
    border-color: var(--color-gray-400);
    text-decoration: none;
  }

  .btn-accent {
    background: var(--color-primary-fill);
    color: white;
  }

  .btn-accent:hover {
    background: var(--color-primary-fill-strong);
    text-decoration: none;
  }

  .btn-light {
    background: rgba(255, 255, 255, 0.2);
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.3);
  }

  .btn-light:hover {
    background: rgba(255, 255, 255, 0.3);
    text-decoration: none;
  }

  .btn:focus-visible {
    outline: 2px solid var(--color-primary-500);
    outline-offset: 2px;
    box-shadow: 0 0 0 4px rgba(15, 118, 110, 0.2);
  }

  /* Sections */
  .section {
    padding: var(--section-spacing) var(--space-4);
  }

  .section h2 {
    font-size: 1.75rem;
    margin-bottom: var(--space-3);
    color: var(--color-text);
  }

  .section-intro {
    color: var(--color-text-secondary);
    margin-bottom: var(--space-8);
    max-width: 600px;
    line-height: 1.6;
  }

  /* Values Grid */
  .values-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-5);
  }

  .value-card {
    background: white;
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    transition: all var(--transition-fast);
  }

  .value-card:hover {
    border-color: var(--color-primary-300);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
