---
import PageLayout from '@layouts/PageLayout.astro';
import Badge from '@components/common/Badge.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const newsEntries = await getCollection('news');
  return newsEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'news'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const typeLabels: Record<string, string> = {
  official: 'Regulatory',
  milestone: 'Ecosystem',
  community: 'Community',
  global: 'International',
  opinion: 'Opinion',
};

const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
};

// NewsArticle structured data (JSON-LD)
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: entry.data.title,
  description: entry.data.description || `${entry.data.title} - OpenFinance-OS News`,
  datePublished: entry.data.date.toISOString(),
  dateModified: entry.data.date.toISOString(),
  author: {
    '@type': 'Person',
    name: entry.data.author
  },
  publisher: {
    '@type': 'Organization',
    name: 'OpenFinance-OS',
    logo: {
      '@type': 'ImageObject',
      url: new URL('/brand/logo-full.svg', Astro.site).toString()
    }
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(`/news/${entry.slug}`, Astro.site).toString()
  }
};
---

<PageLayout
  title={entry.data.title}
  description={entry.data.description || `${entry.data.title} - OpenFinance-OS News`}
  type="article"
  publishedTime={entry.data.date.toISOString()}
  articleSchema={articleSchema}
>
  <article class="article-page">
    <div class="container">
      <header class="article-header">
        <a href="/news" class="back-link">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M19 12H5M12 19l-7-7 7-7"></path>
          </svg>
          Back to News
        </a>

        <div class="article-meta">
          <Badge variant={entry.data.type} size="md">
            {typeLabels[entry.data.type]}
          </Badge>
          <time datetime={entry.data.date.toISOString()}>
            {formatDate(entry.data.date)}
          </time>
          <span class="meta-separator">·</span>
          <span class="author">By {entry.data.author}</span>
        </div>

        <h1>{entry.data.title}</h1>
      </header>

      <div class="article-content">
        <Content />
      </div>

      {
        entry.data.source && (
          <footer class="article-footer">
            <a
              href={entry.data.source}
              target="_blank"
              rel="noopener noreferrer"
              class="source-link"
            >
              View original source
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M7 17L17 7M17 7H7M17 7v10" />
              </svg>
            </a>
          </footer>
        )
      }

      <div class="article-nav">
        <a href="/news" class="nav-link">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M19 12H5M12 19l-7-7 7-7"></path>
          </svg>
          All News
        </a>
      </div>
    </div>
  </article>
</PageLayout>

<style>
  .article-page {
    padding: var(--space-8) var(--space-4) var(--space-16);
    background: var(--color-gray-50);
    min-height: 100vh;
  }

  .container {
    max-width: 720px;
    margin: 0 auto;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-gray-600);
    text-decoration: none;
    margin-bottom: var(--space-6);
    transition: color var(--transition-fast);
  }

  .back-link:hover {
    color: var(--color-primary-600);
    text-decoration: none;
  }

  .article-header {
    margin-bottom: var(--space-8);
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .article-meta time {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-gray-500);
  }

  .meta-separator {
    color: var(--color-gray-300);
  }

  .author {
    font-size: 0.875rem;
    color: var(--color-gray-600);
  }

  .article-header h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    color: var(--color-gray-900);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .article-content {
    background: white;
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    margin-bottom: var(--space-6);
  }

  /* Markdown content styles */
  .article-content :global(h2) {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-gray-900);
    margin-top: var(--space-8);
    margin-bottom: var(--space-4);
  }

  .article-content :global(h3) {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-gray-900);
    margin-top: var(--space-6);
    margin-bottom: var(--space-3);
  }

  .article-content :global(p) {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-gray-700);
    margin-bottom: var(--space-4);
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    margin-bottom: var(--space-4);
    padding-left: var(--space-6);
  }

  .article-content :global(li) {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-gray-700);
    margin-bottom: var(--space-2);
  }

  .article-content :global(a) {
    color: var(--color-primary-600);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .article-content :global(a:hover) {
    color: var(--color-primary-700);
  }

  .article-content :global(strong) {
    font-weight: 600;
    color: var(--color-gray-900);
  }

  .article-content :global(em) {
    color: var(--color-gray-600);
  }

  .article-content :global(blockquote) {
    border-left: 3px solid var(--color-primary-300);
    padding-left: var(--space-4);
    margin: var(--space-6) 0;
    color: var(--color-gray-600);
    font-style: italic;
  }

  .article-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: var(--space-6) 0;
    font-size: 0.9375rem;
  }

  .article-content :global(th),
  .article-content :global(td) {
    padding: var(--space-3);
    text-align: left;
    border-bottom: 1px solid var(--color-gray-200);
  }

  .article-content :global(th) {
    font-weight: 600;
    color: var(--color-gray-900);
    background: var(--color-gray-50);
  }

  .article-content :global(hr) {
    border: none;
    border-top: 1px solid var(--color-gray-200);
    margin: var(--space-8) 0;
  }

  .article-footer {
    margin-bottom: var(--space-8);
  }

  .source-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-5);
    background: white;
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-lg);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-gray-700);
    text-decoration: none;
    transition:
      border-color var(--transition-fast),
      color var(--transition-fast);
  }

  .source-link:hover {
    border-color: var(--color-primary-300);
    color: var(--color-primary-700);
    text-decoration: none;
  }

  .article-nav {
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-gray-200);
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-primary-600);
    text-decoration: none;
  }

  .nav-link:hover {
    color: var(--color-primary-700);
    text-decoration: none;
  }

  @media (max-width: 640px) {
    .article-content {
      padding: var(--space-5);
    }
  }
</style>
