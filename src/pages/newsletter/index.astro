---
import PageLayout from '@layouts/PageLayout.astro';
import NewsletterSignup from '@components/common/NewsletterSignup.astro';
import { NEWSLETTER_PITCH, NEWSLETTER_SOURCES } from '@lib/newsletter';
---

<PageLayout title="Newsletter" description={NEWSLETTER_PITCH}>
  <div class="newsletter-page">
    <div class="container">
      <h1>Newsletter</h1>
      <NewsletterSignup
        source={NEWSLETTER_SOURCES.page}
        variant="page"
        description={NEWSLETTER_PITCH}
      />
    </div>
  </div>
</PageLayout>

<style>
  .newsletter-page {
    min-height: 60vh;
    padding: var(--space-16) var(--space-4) var(--space-20);
    background: var(--color-surface);
  }

  .newsletter-page .container {
    max-width: 40rem;
  }

  .newsletter-page h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    color: var(--color-text);
  }
</style>
