---
import PageLayout from '@layouts/PageLayout.astro';
import NewsletterSignup from '@components/common/NewsletterSignup.astro';
import { NEWSLETTER_SOURCES, SLACK_JOIN_PLACEMENTS } from '@lib/newsletter';
import { assertIssues, sortIssuesNewestFirst } from '@lib/newsletter-archive';
import rawIssues from '@data/newsletter/issues.json';
import SlackJoin from '@components/common/SlackJoin.astro';
import { ISSUE_OG_HEIGHT, ISSUE_OG_WIDTH, NEWSLETTER_OG_PATH } from '@lib/newsletter-images.mjs';

const latestIssue = sortIssuesNewestFirst(assertIssues(rawIssues))[0];
const latestIssuePath = latestIssue
  ? `/newsletter/archive/${latestIssue.slug}`
  : '/newsletter/archive';

const ogAlt =
  'Open Finance OS weekly briefing: the 5-minute weekly on UAE Open Finance, for the people building it.';
const pageDescription = 'The 5-minute weekly on UAE Open Finance, for the people building it';
const leadMagnet =
  'Subscribe and get the UAE Open Finance registry snapshot: every licensed LFI and TPP on one page.';

const faq = [
  {
    question: 'How often does it arrive?',
    answer: 'Once a week. One email, about a five-minute read.',
  },
  {
    question: 'Who writes it?',
    answer:
      'The Open Finance OS community. Issues are written from the public registry and platform data this site already tracks.',
  },
  {
    question: 'Is it vendor-neutral?',
    answer:
      'Yes. Open Finance OS is a community initiative and is not affiliated with, endorsed by, or officially connected to the CBUAE, Al Tareq Platform, Nebras, or any financial institution. The briefing reports the public record; always verify with official sources.',
  },
  {
    question: 'What does it cost?',
    answer: 'Nothing. The briefing is free.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  name: 'Open Finance OS newsletter FAQ',
  description: pageDescription,
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<PageLayout
  title="Newsletter"
  description={pageDescription}
  ogImage={NEWSLETTER_OG_PATH}
  ogImageAlt={ogAlt}
  ogImageWidth={ISSUE_OG_WIDTH}
  ogImageHeight={ISSUE_OG_HEIGHT}
  articleSchema={faqSchema}
>
  <div class="newsletter-page">
    <section class="hero page-intro">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="issue-badge">Issue #1 out now</p>
          <h1>The 5-minute weekly on UAE Open Finance, for the people building it</h1>
          <p class="audience">
            For banks and LFIs, TPPs and fintechs, product teams, and policy people.
          </p>
          <p class="issue-link">
            <a href={latestIssuePath}>Read issue #1</a>
          </p>
          <!-- Confirmed subscribers land on /newsletter/welcome for the registry snapshot. -->
          <NewsletterSignup
            source={NEWSLETTER_SOURCES.page}
            variant="page"
            description={leadMagnet}
          />
          <p class="trust">
            Curated by the Open Finance OS community · Free · Weekly · Unsubscribe anytime
          </p>
          <!--
            TODO: social proof slot. Do not add invented subscriber counts or testimonials.
            When a real quote or a verified count exists, render it here.
          -->
        </div>
        <figure class="hero-art">
          <figcaption>In issue #1</figcaption>
          <ul class="stat-chips">
            <li>
              <strong>12 of 30</strong>
              <span>production registrations publish an authorization server</span>
              <small>Directory snapshot, 28 Oct 2026</small>
            </li>
            <li>
              <strong>1.42M</strong>
              <span>cumulative API calls, Nov 2025 to Sep 2026</span>
              <small>Al Tareq logs via Ecosystem Watch, observed 26 Oct 2026</small>
            </li>
          </ul>
          <a
            class="stat-source"
            href="/news/2026-10-29-12-of-30-uae-open-finance-authorization-servers/"
          >
            How we count these numbers
          </a>
        </figure>
      </div>
    </section>

    <section class="band band-tint" aria-labelledby="why-heading">
      <div class="section-inner">
        <h2 id="why-heading">Why subscribe</h2>
        <p class="section-lead">What changed in the ecosystem this week, with the numbers.</p>
        <p class="why-source">Built from the public registry and platform data this site tracks.</p>
        <ul class="why-list">
          <li>New LFI and TPP registrations</li>
          <li>API call volumes</li>
          <li>Payment success rates</li>
        </ul>
      </div>
    </section>

    <section class="band" aria-labelledby="weekly-heading">
      <div class="section-inner">
        <h2 id="weekly-heading">What you get each week</h2>
        <p class="section-lead">Three kinds of note, in the same short email.</p>
        <div class="points">
          <article class="point">
            <div class="point-icon" aria-hidden="true">
              <svg
                width="28"
                height="28"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
              >
                <path d="M4 5h16v14H4z"></path>
                <path d="M8 9h8M8 13h5"></path>
              </svg>
            </div>
            <h3>UAE Open Finance news</h3>
            <p>Registry changes, bank launches, and the regulatory notes that matter this week.</p>
          </article>
          <article class="point">
            <div class="point-icon" aria-hidden="true">
              <svg
                width="28"
                height="28"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
              >
                <circle cx="6" cy="12" r="2.25"></circle>
                <circle cx="18" cy="7" r="2.25"></circle>
                <circle cx="18" cy="17" r="2.25"></circle>
                <path d="M8.2 11.2 15.6 8.1M8.2 12.8l7.4 3.1"></path>
              </svg>
            </div>
            <h3>Agentic finance</h3>
            <p>
              How an agent, a consent, and a payment rail reach a bank, without the marketing fog.
            </p>
          </article>
          <article class="point">
            <div class="point-icon" aria-hidden="true">
              <svg
                width="28"
                height="28"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
              >
                <path d="M4 19V5"></path>
                <path d="M4 19h16"></path>
                <path d="M8 15v-4M12 15V8M16 15v-6"></path>
              </svg>
            </div>
            <h3>Data and charts</h3>
            <p>Counts and comparisons from the public record, with the dates attached.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="band band-tint" aria-labelledby="agentic-heading">
      <div class="section-inner">
        <h2 id="agentic-heading">As it happens</h2>
        <p class="hook">
          How AI agents will access UAE bank data and payments, explained as it happens.
        </p>
      </div>
    </section>

    <section class="band" aria-labelledby="issue-heading">
      <div class="section-inner">
        <h2 id="issue-heading">Inside an issue</h2>
        <p class="section-lead">A sample of the 29 October briefing. The pictures are the email.</p>
        <figure class="issue-frame">
          <figcaption>Sample issue · Issue #1</figcaption>
          <div class="issue-grid">
            <img
              src="/newsletter/story-registry-light.webp"
              width="2400"
              height="1000"
              alt="UAE registry: 12 of 30 production registrations publish an authorization server. Production directory snapshot, 28 October 2026."
              loading="lazy"
              decoding="async"
            />
            <img
              src="/newsletter/story-calls-light.webp"
              width="2400"
              height="1000"
              alt="Weekly digest: 1.42 million cumulative API calls from November 2025 to September 2026. Al Tareq platform logs via Ecosystem Watch, observed 26 October 2026."
              loading="lazy"
              decoding="async"
            />
            <img
              class="issue-diagram"
              src="/newsletter/agent-access.webp"
              width="1800"
              height="1350"
              alt="Diagram of how an AI agent reaches a UAE bank: the customer gives consent, a licensed TPP acts within it, the Nebras API Hub stores authorization, and the bank returns data or executes the payment. Al Tareq is the customer-facing brand and Aani is the instant payment rail. Simplified community illustration, not an official diagram."
              loading="lazy"
              decoding="async"
            />
            <img
              src="/newsletter/story-nbf-light.webp"
              width="2400"
              height="1000"
              alt="UAE banks: NBF Direct adds Open Finance with multi-bank access."
              loading="lazy"
              decoding="async"
            />
            <img
              src="/newsletter/topics.webp"
              width="1800"
              height="780"
              alt="Bar chart of this issue’s seven stories: three on the UAE ecosystem, two on agentic payments, one on Pay by Bank in Europe, and one on commercial models."
              loading="lazy"
              decoding="async"
            />
          </div>
        </figure>
      </div>
    </section>

    <section class="band band-tint" aria-labelledby="faq-heading">
      <div class="section-inner">
        <h2 id="faq-heading">Questions</h2>
        <div class="faq">
          {faq.map((item) => (
            <details>
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="band" aria-labelledby="join-heading">
      <div class="section-inner">
        <h2 id="join-heading">Join the conversation</h2>
        <p class="section-lead">Talk with the people building UAE Open Finance between issues.</p>
        <SlackJoin placement={SLACK_JOIN_PLACEMENTS.newsletter} />
      </div>
    </section>

    <section class="signup-band" aria-labelledby="cta-heading">
      <div class="section-inner">
        <h2 id="cta-heading">Get the briefing</h2>
        <NewsletterSignup
          source={NEWSLETTER_SOURCES.page}
          variant="band"
          idSuffix="cta"
          description="One email a week. No spam."
        />
      </div>
    </section>
  </div>
</PageLayout>

<style>
  .newsletter-page {
    background: var(--color-card);
    color: var(--color-text);
  }

  .hero,
  .band,
  .signup-band {
    padding: var(--space-16) var(--space-4);
  }

  .hero-grid,
  .section-inner {
    width: 100%;
    max-width: 1080px;
    margin-inline: auto;
  }

  .hero-grid {
    display: grid;
    gap: var(--space-10);
    align-items: center;
  }

  .issue-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: var(--space-4);
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    color: var(--color-text-secondary);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .issue-badge::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--color-accent);
  }

  .newsletter-page h1,
  .newsletter-page h2 {
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: -0.035em;
    color: var(--color-text);
  }

  .newsletter-page h1 {
    max-width: 18em;
    font-size: clamp(1.85rem, 3.2vw, 2.6rem);
    line-height: 1.15;
  }

  .audience {
    max-width: 36rem;
    margin-top: var(--space-4);
    color: var(--color-text-secondary);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .issue-link {
    margin-top: var(--space-4);
  }

  .issue-link a,
  .stat-source {
    color: var(--color-brand-ink);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .issue-link a:focus-visible,
  .stat-source:focus-visible,
  .faq summary:focus-visible {
    outline: 2px solid var(--color-accent-600);
    outline-offset: 3px;
  }

  .trust {
    max-width: 36rem;
    margin-top: var(--space-4);
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .why-source {
    max-width: 40rem;
    margin-bottom: var(--space-5);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .why-list {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .why-list li {
    padding: var(--space-4);
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-brand-ink);
    border-radius: var(--radius-md);
    color: var(--color-text);
    font-weight: 600;
  }

  .hook {
    max-width: 40rem;
    margin-top: var(--space-4);
    color: var(--color-brand-ink);
    font-size: clamp(1.25rem, 2vw, 1.6rem);
    font-weight: 500;
    line-height: 1.4;
  }

  .faq details {
    border-top: 1px solid var(--color-border);
  }

  .faq details:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .faq summary {
    padding: var(--space-4) 0;
    color: var(--color-text);
    font-weight: 600;
    cursor: pointer;
  }

  .faq details p {
    max-width: 42rem;
    margin-bottom: var(--space-4);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .newsletter-page h2 {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    line-height: 1.15;
  }

  .signup-band h2 {
    color: #f1f7f1;
  }

  .hero :global(.newsletter-signup--page) {
    max-width: 36rem;
    margin-top: var(--space-5);
  }

  .point p,
  .section-lead {
    color: var(--color-text-secondary);
  }

  .hero-art {
    margin: 0;
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
  }

  .hero-art figcaption {
    color: var(--color-text-secondary);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .stat-chips {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-4) 0;
    padding: 0;
    list-style: none;
  }

  .stat-chips li {
    min-width: 0;
    padding: var(--space-4);
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .stat-chips strong {
    display: block;
    color: var(--color-brand-ink);
    font-size: 2rem;
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.1;
  }

  .stat-chips span {
    display: block;
    margin-top: var(--space-1);
    color: var(--color-text);
    font-size: 0.9375rem;
  }

  .stat-chips small {
    display: block;
    margin-top: var(--space-2);
    color: var(--color-text-secondary);
    font-size: 0.8125rem;
  }

  .stat-source {
    font-size: 0.875rem;
  }

  .band-tint {
    background: var(--color-surface);
  }

  .section-lead {
    max-width: 38rem;
    margin-top: var(--space-3);
    margin-bottom: var(--space-8);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .points {
    display: grid;
    gap: var(--space-5);
  }

  .point {
    min-width: 0;
    padding: var(--space-6);
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
  }

  .point-icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    margin-bottom: var(--space-4);
    color: var(--color-brand-ink);
    background: var(--color-soft);
    border-radius: var(--radius-lg);
  }

  .point h3 {
    margin-bottom: var(--space-2);
    color: var(--color-text);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .point p {
    line-height: 1.6;
  }

  .issue-frame {
    margin: 0;
    padding: var(--space-5);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
  }

  .issue-frame figcaption {
    margin-bottom: var(--space-5);
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .issue-grid {
    display: grid;
    gap: var(--space-4);
  }

  .issue-grid img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .signup-band {
    background: var(--color-primary);
  }

  .signup-band .section-inner {
    max-width: 720px;
  }

  @media (min-width: 800px) {
    .why-list,
    .points {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .issue-grid {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }

    .issue-grid .issue-diagram {
      grid-column: 1 / -1;
      width: min(100%, 720px);
      margin-inline: auto;
    }
  }

  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(280px, 0.95fr);
      gap: var(--space-12);
    }
  }
</style>
