---
import PageLayout from '@layouts/PageLayout.astro';
import NewsletterSignup from '@components/common/NewsletterSignup.astro';
import MiddleLeapLogo from '@components/common/MiddleLeapLogo.astro';
import { NEWSLETTER_SOURCES, SLACK_JOIN_PLACEMENTS } from '@lib/newsletter';
import SlackJoin from '@components/common/SlackJoin.astro';

const headerAlt = 'Open Finance OS weekly briefing, issue 1, 29 October 2026.';
const pageDescription = 'The 5-minute weekly on UAE open finance, for the people building it';
const leadMagnet =
  'Subscribe and get the UAE open finance registry snapshot: every licensed LFI and TPP on one page.';

const faq = [
  {
    question: 'How often does it arrive?',
    answer: 'Once a week. One email, about a five-minute read.',
  },
  {
    question: 'Who writes it?',
    answer:
      'The Open Finance OS community. Issues are written from the public registry and platform data this site already tracks.',
  },
  {
    question: 'Is it vendor-neutral?',
    answer:
      'Yes. Open Finance OS is not affiliated with the CBUAE, Al Tareq, Nebras, or any bank or TPP. The briefing reports the public record.',
  },
  {
    question: 'What does it cost?',
    answer: 'Nothing. The briefing is free.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  name: 'Open Finance OS newsletter FAQ',
  description: pageDescription,
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<PageLayout
  title="Newsletter"
  description={pageDescription}
  ogImage="/newsletter/header.webp"
  ogImageAlt={headerAlt}
  ogImageWidth={600}
  ogImageHeight={200}
  articleSchema={faqSchema}
>
  <div class="newsletter-page">
    <section class="hero">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="issue-badge">Issue #1 out now</p>
          <h1>The 5-minute weekly on UAE open finance, for the people building it</h1>
          <p class="audience">
            For banks and LFIs, TPPs and fintechs, product teams, and policy people.
          </p>
          <p class="issue-link">
            <a
              href="https://buttondown.com/openfinance-os/archive/"
              target="_blank"
              rel="noopener noreferrer"
            >
              Read issue #1
              <span class="sr-only"> (opens in a new tab)</span>
            </a>
          </p>
          <!-- TODO: deliver the UAE open finance registry snapshot to new subscribers. -->
          <NewsletterSignup
            source={NEWSLETTER_SOURCES.page}
            variant="page"
            description={leadMagnet}
          />
          <p class="trust">
            Curated by the Open Finance OS community · Free · Weekly · Unsubscribe anytime
          </p>
          <p class="founder">
            <span>A community initiative founded by</span>
            <a href="https://www.middleleap.com/" aria-label="MiddleLeap">
              <MiddleLeapLogo />
            </a>
          </p>
          <!--
            TODO: social proof slot. Do not add invented subscriber counts or testimonials.
            When a real quote or a verified count exists, render it here.
          -->
        </div>
        <figure class="hero-art">
          <svg class="hero-arc" viewBox="0 0 480 320" aria-hidden="true">
            <path
              d="M250 46a150 150 0 1 0 58 118"
              fill="none"
              stroke="#0D4F4F"
              stroke-width="18"
              stroke-linecap="round"
            ></path>
            <path d="M118 196h150" stroke="#0D4F4F" stroke-width="14" stroke-linecap="round"></path>
            <circle cx="330" cy="42" r="16" fill="#E8A85C"></circle>
          </svg>
          <ul class="stat-chips">
            <li>
              <strong>12 of 30</strong>
              <span>authorization servers</span>
            </li>
            <li>
              <strong>1.42M</strong>
              <span>API calls</span>
            </li>
          </ul>
        </figure>
      </div>
    </section>

    <section class="band band-tint" aria-labelledby="why-heading">
      <div class="section-inner">
        <h2 id="why-heading">
          <span>Why subscribe</span>
        </h2>
        <p class="section-lead">What changed in the ecosystem this week, with the numbers.</p>
        <p class="why-source">Built from the public registry and platform data this site tracks.</p>
        <ul class="why-list">
          <li>New LFI and TPP registrations</li>
          <li>API call volumes</li>
          <li>Payment success rates</li>
        </ul>
      </div>
    </section>

    <section class="band" aria-labelledby="weekly-heading">
      <div class="section-inner">
        <h2 id="weekly-heading">
          <span>What you get each week</span>
        </h2>
        <p class="section-lead">Three kinds of note, in the same short email.</p>
        <div class="points">
          <article class="point">
            <div class="point-icon" aria-hidden="true">
              <svg
                width="28"
                height="28"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
              >
                <path d="M4 5h16v14H4z"></path>
                <path d="M8 9h8M8 13h5"></path>
              </svg>
            </div>
            <h3>UAE open finance news</h3>
            <p>Registry changes, bank launches, and the regulatory notes that matter this week.</p>
          </article>
          <article class="point">
            <div class="point-icon" aria-hidden="true">
              <svg
                width="28"
                height="28"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
              >
                <circle cx="6" cy="12" r="2.25"></circle>
                <circle cx="18" cy="7" r="2.25"></circle>
                <circle cx="18" cy="17" r="2.25"></circle>
                <path d="M8.2 11.2 15.6 8.1M8.2 12.8l7.4 3.1"></path>
              </svg>
            </div>
            <h3>Agentic finance</h3>
            <p>
              How an agent, a consent, and a payment rail reach a bank, without the marketing fog.
            </p>
          </article>
          <article class="point">
            <div class="point-icon" aria-hidden="true">
              <svg
                width="28"
                height="28"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
              >
                <path d="M4 19V5"></path>
                <path d="M4 19h16"></path>
                <path d="M8 15v-4M12 15V8M16 15v-6"></path>
              </svg>
            </div>
            <h3>Data and charts</h3>
            <p>Counts and comparisons from the public record, with the dates attached.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="band band-tint" aria-labelledby="agentic-heading">
      <div class="section-inner">
        <h2 id="agentic-heading">
          <span>As it happens</span>
        </h2>
        <p class="hook">
          How AI agents will access UAE bank data and payments, explained as it happens.
        </p>
      </div>
    </section>

    <section class="band" aria-labelledby="issue-heading">
      <div class="section-inner">
        <h2 id="issue-heading">
          <span>Inside an issue</span>
        </h2>
        <p class="section-lead">A sample of the 29 October briefing. The pictures are the email.</p>
        <figure class="issue-frame">
          <figcaption>Sample issue · Issue #1</figcaption>
          <div class="issue-grid">
            <img
              src="/newsletter/story-registry-light.webp"
              width="1200"
              height="500"
              alt="UAE registry: 12 of 30 registrations publish an authorization server."
              loading="lazy"
              decoding="async"
            />
            <img
              src="/newsletter/story-calls-light.webp"
              width="1200"
              height="500"
              alt="Weekly digest: 1.42 million cumulative API calls from November 2025 to September 2026."
              loading="lazy"
              decoding="async"
            />
            <img
              class="issue-diagram"
              src="/newsletter/agent-access.webp"
              width="600"
              height="450"
              alt="Diagram of how an AI agent reaches a UAE bank: the customer gives consent, a licensed TPP acts within it, the Nebras API Hub stores authorization, and the bank returns data or executes the payment. AlTareq is the customer-facing brand and Aani is the instant payment rail. Simplified community illustration, not an official diagram."
              loading="lazy"
              decoding="async"
            />
            <img
              src="/newsletter/story-nbf-light.webp"
              width="1200"
              height="500"
              alt="UAE banks: NBF Direct adds open finance with multi-bank access."
              loading="lazy"
              decoding="async"
            />
            <img
              src="/newsletter/topics.webp"
              width="600"
              height="260"
              alt="Bar chart of this issue’s seven stories: three on the UAE ecosystem, two on agentic payments, one on Pay by Bank in Europe, and one on commercial models."
              loading="lazy"
              decoding="async"
            />
          </div>
        </figure>
      </div>
    </section>

    <section class="band band-tint" aria-labelledby="faq-heading">
      <div class="section-inner">
        <h2 id="faq-heading">
          <span>Questions</span>
        </h2>
        <div class="faq">
          {faq.map((item) => (
            <details>
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="band" aria-labelledby="join-heading">
      <div class="section-inner">
        <h2 id="join-heading">
          <span>Join the conversation</span>
        </h2>
        <p class="section-lead">Talk with the people building UAE open finance between issues.</p>
        <SlackJoin placement={SLACK_JOIN_PLACEMENTS.newsletter} />
      </div>
    </section>

    <section class="signup-band" aria-labelledby="cta-heading">
      <div class="section-inner">
        <h2 id="cta-heading">
          <span>Get the briefing</span>
        </h2>
        <NewsletterSignup
          source={NEWSLETTER_SOURCES.page}
          variant="band"
          idSuffix="cta"
          description="One email a week. No spam."
        />
      </div>
    </section>
  </div>
</PageLayout>

<style>
  .newsletter-page {
    background: #fff;
    color: #132c2b;
  }

  .hero,
  .band,
  .signup-band {
    padding: var(--space-16) var(--space-4);
  }

  .hero-grid,
  .section-inner {
    width: 100%;
    max-width: 1080px;
    margin-inline: auto;
  }

  .hero-grid {
    display: grid;
    gap: var(--space-10);
    align-items: center;
  }

  .issue-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: var(--space-4);
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-full);
    background: #fdf6ec;
    color: #7c4c1c;
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .issue-badge::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: #e8a85c;
  }

  .newsletter-page h1,
  .newsletter-page h2 {
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: -0.03em;
    color: #132c2b;
  }

  .newsletter-page h1 {
    max-width: 18em;
    font-size: clamp(1.85rem, 3.2vw, 2.6rem);
    line-height: 1.15;
  }

  .hero h1::after {
    content: '';
    display: block;
    width: 4.5rem;
    height: 3px;
    margin-top: 0.7rem;
    background: #e8a85c;
  }

  .audience {
    max-width: 36rem;
    margin-top: var(--space-4);
    color: #526662;
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .issue-link {
    margin-top: var(--space-4);
  }

  .issue-link a {
    color: #0d4f4f;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .issue-link a:focus-visible {
    outline: 2px solid #e8a85c;
    outline-offset: 3px;
  }

  .trust,
  .founder {
    max-width: 36rem;
    color: #526662;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .trust {
    margin-top: var(--space-4);
  }

  .founder {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    margin-top: var(--space-3);
  }

  .founder a {
    color: inherit;
    text-decoration: none;
  }

  .founder :global(.middleleap-logo) {
    padding: 0;
    gap: 6px;
  }

  .founder :global(.pivot-mark) {
    width: 28px;
    height: 16px;
  }

  .why-source {
    max-width: 40rem;
    margin-bottom: var(--space-5);
    color: #526662;
    line-height: 1.6;
  }

  .why-list {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .why-list li {
    padding: var(--space-4);
    background: #fff;
    border-left: 3px solid #0d4f4f;
    border-radius: var(--radius-md);
    color: #132c2b;
    font-weight: 600;
  }

  .hook {
    max-width: 40rem;
    margin-top: var(--space-4);
    color: #0d4f4f;
    font-size: clamp(1.25rem, 2vw, 1.6rem);
    font-weight: 500;
    line-height: 1.4;
  }

  .faq details {
    border-top: 1px solid #d7ebe4;
  }

  .faq details:last-child {
    border-bottom: 1px solid #d7ebe4;
  }

  .faq summary {
    padding: var(--space-4) 0;
    color: #132c2b;
    font-weight: 600;
    cursor: pointer;
  }

  .faq summary:focus-visible {
    outline: 2px solid #e8a85c;
    outline-offset: 3px;
  }

  .faq details p {
    max-width: 42rem;
    margin-bottom: var(--space-4);
    color: #526662;
    line-height: 1.6;
  }

  .newsletter-page h2 {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
  }

  .newsletter-page h1 span,
  .newsletter-page h2 span {
    border-bottom: 3px solid #e8a85c;
    padding-bottom: 0.12em;
  }

  .signup-band h2 {
    color: #f1f7f1;
  }

  .hero :global(.newsletter-signup--page) {
    max-width: 36rem;
    margin-top: var(--space-5);
  }

  .hero :global(.newsletter-pitch),
  .point p,
  .section-lead {
    color: #526662;
  }

  .hero :global(.newsletter-label),
  .hero :global(.newsletter-thanks),
  .hero :global(.newsletter-thanks-title) {
    color: #132c2b;
  }

  .hero :global(.newsletter-input) {
    color: #132c2b;
    background: #fff;
    border-color: #dce5df;
  }

  .hero-art {
    position: relative;
    min-height: 280px;
    margin: 0;
    padding: var(--space-6);
    background: #f4faf8;
    border: 1px solid #d7ebe4;
    border-radius: var(--radius-2xl);
    overflow: hidden;
  }

  .hero-arc {
    display: block;
    width: min(100%, 420px);
    height: auto;
    margin-inline: auto;
  }

  .stat-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .stat-chips li {
    min-width: 9rem;
    padding: var(--space-3) var(--space-4);
    background: #fff;
    border: 1px solid #d7ebe4;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .stat-chips strong {
    display: block;
    color: #0d4f4f;
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .stat-chips span {
    color: #526662;
    font-size: 0.8125rem;
  }

  .band-tint {
    background: #f0f7f7;
  }

  .section-lead {
    max-width: 38rem;
    margin-top: var(--space-3);
    margin-bottom: var(--space-8);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .points {
    display: grid;
    gap: var(--space-5);
  }

  .point {
    min-width: 0;
    padding: var(--space-6);
    background: #fff;
    border: 1px solid #d7ebe4;
    border-radius: var(--radius-xl);
  }

  .point-icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    margin-bottom: var(--space-4);
    color: #0d4f4f;
    background: #f0f7f7;
    border-radius: var(--radius-lg);
  }

  .point h3 {
    margin-bottom: var(--space-2);
    color: #132c2b;
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .point p {
    line-height: 1.6;
  }

  .issue-frame {
    margin: 0;
    padding: var(--space-5);
    background: #fff;
    border: 1px solid #d7ebe4;
    border-radius: var(--radius-2xl);
  }

  .issue-frame figcaption {
    width: fit-content;
    margin-bottom: var(--space-5);
    padding-bottom: 0.15em;
    border-bottom: 3px solid #e8a85c;
    color: #0d4f4f;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .issue-grid {
    display: grid;
    gap: var(--space-4);
  }

  .issue-grid img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
  }

  .issue-diagram {
    background: #fff;
  }

  .signup-band {
    background: #0d4f4f;
  }

  .signup-band .section-inner {
    max-width: 720px;
  }

  @media (min-width: 800px) {
    .why-list,
    .points {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .issue-grid {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }

    .issue-diagram {
      grid-column: 1 / -1;
      width: min(100%, 720px);
      margin-inline: auto;
    }
  }

  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(280px, 0.95fr);
      gap: var(--space-12);
    }

    .stat-chips {
      position: absolute;
      right: var(--space-5);
      bottom: var(--space-5);
      flex-direction: column;
      margin: 0;
    }
  }
</style>
