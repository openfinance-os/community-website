---
import PageLayout from '@layouts/PageLayout.astro';
import NewsletterSignup from '@components/common/NewsletterSignup.astro';
import Badge from '@components/common/Badge.astro';
import rawIssues from '@data/newsletter/issues.json';
import { NEWSLETTER_PITCH, NEWSLETTER_SOURCES } from '@lib/newsletter';
import {
  assertIssues,
  issueExcerpt,
  issueImage,
  sortIssuesNewestFirst,
} from '@lib/newsletter-archive';

const issues = sortIssuesNewestFirst(assertIssues(rawIssues));
const description = 'Past issues of the weekly UAE open finance briefing.';
const headerAlt = 'Open Finance OS weekly briefing.';

const formatCardDate = (iso: string) =>
  new Date(iso).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  });
---

<PageLayout
  title="Newsletter archive"
  description={description}
  ogImage="/newsletter/header.webp"
  ogImageAlt={headerAlt}
  ogImageWidth={600}
  ogImageHeight={200}
>
  <div class="archive-page">
    <header class="page-intro page-header">
      <div class="header-bg" aria-hidden="true">
        <div class="grid-overlay"></div>
      </div>
      <div class="header-content">
        <h1>Newsletter archive</h1>
        <p class="header-description">{description}</p>
        <p class="feed-link">
          <a href="/newsletter">Subscribe to the next issue</a>
        </p>
      </div>
    </header>

    <section class="archive-section">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">All issues</h2>
          <span class="article-count">
            {issues.length} issue{issues.length === 1 ? '' : 's'}
          </span>
        </div>

        {issues.length === 0 ? (
          <div class="empty-state">
            <p class="empty-title">No issues yet</p>
            <p class="empty-description">The next briefing will appear here after it is sent.</p>
          </div>
        ) : (
          <div class="news-grid">
            {issues.map((issue) => {
              const image = issueImage(issue);
              return (
                <a class="news-card" href={`/newsletter/archive/${issue.slug}`}>
                  {image && <img src={image} alt="" loading="lazy" decoding="async" />}
                  <div class="card-header">
                    <Badge variant="community" size="sm">
                      Newsletter
                    </Badge>
                    <time datetime={issue.publish_date}>{formatCardDate(issue.publish_date)}</time>
                  </div>
                  <h2 class="card-title">{issue.subject}</h2>
                  <p class="card-description">{issueExcerpt(issue)}</p>
                  <div class="card-footer">
                    <span class="author">Open Finance OS Community</span>
                    <span class="read-more">
                      Read issue
                      <svg
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        aria-hidden="true"
                      >
                        <path d="M5 12h14M12 5l7 7-7 7" />
                      </svg>
                    </span>
                  </div>
                </a>
              );
            })}
          </div>
        )}

        <NewsletterSignup
          source={NEWSLETTER_SOURCES.archive}
          variant="card"
          heading="Newsletter"
          description={NEWSLETTER_PITCH}
        />
      </div>
    </section>
  </div>
</PageLayout>

<style>
  .archive-page {
    min-height: 100vh;
  }

  .page-header {
    position: relative;
    padding: var(--space-16) var(--space-4) var(--space-12);
    background: var(--color-surface);
    color: var(--color-text);
    text-align: center;
    overflow: hidden;
  }

  .header-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .grid-overlay {
    position: absolute;
    inset: 0;
    background-image: var(--grid-pattern);
    opacity: 0.3;
  }

  .header-content {
    position: relative;
    max-width: 700px;
    margin: 0 auto;
  }

  .header-content h1 {
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 500;
    margin-bottom: var(--space-4);
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .header-description {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    max-width: 500px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .feed-link {
    margin-top: var(--space-4);
    font-size: 0.875rem;
  }

  .archive-section {
    padding: var(--space-12) var(--space-4);
    background: var(--color-surface);
  }

  .container {
    max-width: 1000px;
    margin: 0 auto;
  }

  .section-header {
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-6);
  }

  .section-title {
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--color-text);
    letter-spacing: -0.01em;
  }

  .article-count {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    background: var(--color-card);
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
  }

  .news-grid {
    min-width: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  .news-card {
    min-width: 0;
    display: flex;
    flex-direction: column;
    padding: var(--space-6) var(--space-8);
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    text-decoration: none;
    color: inherit;
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast),
      transform var(--transition-fast);
  }

  .news-card:hover {
    border-color: var(--color-primary-300);
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
    text-decoration: none;
  }

  .news-card img {
    width: 100%;
    height: auto;
    margin-bottom: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-card);
  }

  .card-header {
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-3);
    margin-bottom: var(--space-3);
  }

  .card-header time {
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }

  .card-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--space-3);
    line-height: 1.4;
  }

  .news-card:hover .card-title {
    color: var(--color-brand-ink);
  }

  .card-description {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-4);
    flex: 1;
  }

  .card-footer {
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
    margin-top: auto;
  }

  .author {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
  }

  .read-more {
    min-width: 0;
    flex-shrink: 0;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-brand-ink);
  }

  .read-more svg {
    transition: transform var(--transition-fast);
  }

  .news-card:hover .read-more svg {
    transform: translateX(4px);
  }

  .empty-state {
    padding: var(--space-10) var(--space-6);
    text-align: center;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
  }

  .empty-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--space-2);
  }

  .empty-description {
    color: var(--color-text-secondary);
  }

  :global([data-theme='dark']) .news-card,
  :global([data-theme='dark']) .article-count,
  :global([data-theme='dark']) .empty-state {
    background: var(--color-soft);
    border-color: var(--color-border);
  }

  :global([data-theme='dark']) .news-card:hover {
    border-color: var(--color-primary-400);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  }
</style>
