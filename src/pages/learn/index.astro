---
import PageLayout from '@layouts/PageLayout.astro';
import Breadcrumb from '@components/common/Breadcrumb.astro';
import EditorialNote from '@components/learn/EditorialNote.astro';

const startingPoints = [
  {
    step: '01 / The essentials',
    type: 'Introduction',
    title: 'What changes when people can choose to share?',
    description:
      'Learn how permission-based access can support useful services, who participates, and where to verify the rules.',
    href: '/learn/getting-started',
    action: 'Read Getting Started',
  },
  {
    step: '02 / In practice',
    type: 'From Commons',
    title: 'Several accounts. One cash view.',
    description:
      'Follow a fictional SME through the customer benefit, the synthetic data, and the questions a real service would need to answer.',
    href: '/commons/sme-multi-bank-cash-flow',
    action: 'Explore the SME example',
  },
  {
    step: '03 / Your proposition',
    type: 'Worksheet',
    title: 'Where do the gaps sit?',
    description:
      'Record the evidence you hold, the unknowns, and the next actions across eight areas of an Open Finance proposition.',
    href: '/learn/readiness',
    action: 'Use the readiness worksheet',
  },
];

const roleGuides = [
  {
    title: 'For banks & financial institutions',
    description: 'Participation context, integration boundaries, and questions for your programme.',
    href: '/learn/bank-guide',
    action: 'Read the bank guide',
  },
  {
    title: 'For third party providers',
    description: 'Understand the participation path, data access, and official requirements.',
    href: '/learn/tpp-guide',
    action: 'Read the TPP guide',
  },
  {
    title: 'For builders',
    description: 'Explore API architecture, synthetic data, and the integration references.',
    href: '/learn/api-guide',
    action: 'Open the API guide',
  },
];

const sources = [
  {
    label: 'Official documentation',
    title: 'UAE Open Finance standards',
    description:
      'Verify participation guidance, technical standards, and testing and certification requirements in the official Confluence space.',
    href: 'https://openfinanceuae.atlassian.net/wiki/spaces/OF/overview?mode=global',
    action: 'Open official documentation',
  },
  {
    label: 'Official specifications',
    title: 'OpenAPI source of truth',
    description:
      'The Nebras API specifications repository is linked from official documentation. Check the published version and any superseding errata.',
    href: 'https://github.com/Nebras-Open-Finance/api-specs/tree/main',
    action: 'Read the API specifications',
  },
  {
    label: 'Official regulatory source',
    title: 'CBUAE framework',
    description:
      'Read the current regulatory framework in the CBUAE Rulebook. The introduction and scope identify Circular 03/2025 as in force.',
    href: 'https://rulebook.centralbank.ae/en/rulebook/introduction-and-scope-2',
    action: 'Check the regulatory scope',
  },
  {
    label: 'Public evidence',
    title: 'Trust Framework Directory',
    description:
      'Inspect published registrations and metadata. Our coverage guide explains what dated directory observations do and do not establish.',
    href: '/observatory/coverage',
    action: 'Understand directory evidence',
  },
  {
    label: 'Community reference',
    title: 'API explanations & examples',
    description:
      'Use the Nebras community documentation for technical orientation. Check versions and requirements against official sources.',
    href: 'https://nebras-open-finance.com/tech/api-specs/',
    action: 'Open the community reference',
  },
  {
    label: 'Community tool',
    title: 'Data Sandbox',
    description:
      'Explore synthetic banking data before working with customer information. This community tool is separate from the official platform sandbox.',
    href: '/commons/data-sandbox',
    action: 'Explore the Data Sandbox',
  },
];
---

<PageLayout
  title="Learn Open Finance"
  description="Understand UAE Open Finance through customer benefits, a synthetic SME example, a readiness worksheet, and clearly labelled official and community resources."
>
  <div class="learn-page">
    <div class="learn-container">
      <Breadcrumb items={[{ label: 'Learn' }]} />
      <header class="page-intro learning-hero">
        <div>
          <p class="eyebrow">Learn / UAE Open Finance</p>
          <h1>Understand the idea.<br />Find your next step.</h1>
          <p class="lead">
            Start with the customer benefit. See a worked example. Then explore the evidence and
            questions behind a real proposition.
          </p>
        </div>
        <aside class="reading-panel" aria-labelledby="reading-path-title">
          <h2 class="eyebrow" id="reading-path-title">A useful first journey</h2>
          <ol class="reading-path">
            <li>
              <span class="step-number" aria-hidden="true">1</span><div>
                <strong>Understand the essentials</strong><p>
                  Permission, participants, and practical possibilities.
                </p>
              </div>
            </li>
            <li>
              <span class="step-number" aria-hidden="true">2</span><div>
                <strong>See the idea in practice</strong><p>
                  A fictional SME with accounts across banks.
                </p>
              </div>
            </li>
            <li>
              <span class="step-number" aria-hidden="true">3</span><div>
                <strong>Map the questions that matter</strong><p>
                  What you know, what is missing, and what comes next.
                </p>
              </div>
            </li>
          </ol>
        </aside>
      </header>

      <section class="learning-section" aria-labelledby="start-title">
        <div class="section-heading">
          <h2 id="start-title">Start here. Go as far as you need.</h2><p>
            Choose an introduction, a practical example, or a working document.
          </p>
        </div>
        <div class="journey-grid">
          {
            startingPoints.map((item, index) => (
              <a href={item.href} class:list={['journey-card', { featured: index === 0 }]}>
                <div class="card-labels">
                  <>
                    <span>{item.step}</span>
                    <span>{item.type}</span>
                  </>
                </div>
                <>
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                </>
                <span class="card-action">
                  {item.action}
                  <span aria-hidden="true">→</span>
                </span>
              </a>
            ))
          }
        </div>
      </section>

      <section class="learning-section" aria-labelledby="roles-title">
        <div class="section-heading">
          <h2 id="roles-title">Go deeper, with your role in mind.</h2><p>
            A guide is an orientation. The official sources remain the authority.
          </p>
        </div>
        <div class="role-guides">
          {
            roleGuides.map((guide, index) => (
              <div class="role-row">
                <span class="resource-number" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <div>
                  <>
                    <h3>{guide.title}</h3>
                    <p>{guide.description}</p>
                  </>
                </div>
                <a class="text-link" href={guide.href}>
                  {guide.action}
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            ))
          }
        </div>
        <div class="glossary-strip">
          <p>
            <strong>A term getting in the way?</strong> Find plain explanations of the language used across
            the ecosystem.
          </p>
          <dl class="glossary-grid">
            <div>
              <dt class="glossary-term">Open Finance</dt>
              <dd>
                Permission-based access to financial data and services through eligible providers.
              </dd>
            </div>
            <div>
              <dt class="glossary-term">LFI</dt>
              <dd>A Licensed Financial Institution, such as a bank or insurer.</dd>
            </div>
            <div>
              <dt class="glossary-term">TPP</dt>
              <dd>
                A Third-Party Provider that accesses data or initiates services within its permitted
                role.
              </dd>
            </div>
          </dl>
          <div class="link-actions">
            <a class="text-link" href="/learn/glossary"
              >Browse the glossary <span aria-hidden="true">→</span></a
            ><a class="text-link" href="/learn/faq"
              >Read the FAQ <span aria-hidden="true">→</span></a
            >
          </div>
        </div>
      </section>

      <section class="learning-section" id="resources" aria-labelledby="sources-title">
        <div class="section-heading">
          <p class="eyebrow">Sources and resources</p><h2 id="sources-title">
            Check the source. Keep the context.
          </h2><p>
            Official requirements, public evidence, and community explanations serve different
            purposes.
          </p>
        </div>
        <div class="source-grid">
          {
            sources.map((source) => (
              <article class="source-card">
                <>
                  <span class="source-label">{source.label}</span>
                  <h3>{source.title}</h3>
                  <p>{source.description}</p>
                </>
                <a
                  class="text-link"
                  href={source.href}
                  rel={source.href.startsWith('https:') ? 'noopener noreferrer' : undefined}
                >
                  {source.action}
                  <span aria-hidden="true">{source.href.startsWith('https:') ? '↗' : '→'}</span>
                </a>
              </article>
            ))
          }
        </div>
        <div class="international-row">
          <div>
            <h3>Looking beyond the UAE?</h3><p>
              Explore international context while keeping each market's rules and infrastructure
              distinct.
            </p>
          </div><a class="text-link" href="/global"
            >Explore the global perspective <span aria-hidden="true">→</span></a
          >
        </div>
      </section>

      <aside class="watch-row" aria-labelledby="keep-learning-title">
        <div>
          <h2 id="keep-learning-title">Keep learning as the ecosystem changes.</h2><p>
            Return to Ecosystem Watch for saved observations, or follow the news feed for articles
            and weekly digests.
          </p>
        </div>
        <div class="link-actions">
          <a class="text-link" href="/observatory/watch"
            >Read Ecosystem Watch <span aria-hidden="true">→</span></a
          ><a class="text-link" href="/rss.xml"
            >News & weekly digests RSS <span aria-hidden="true">→</span></a
          >
        </div>
      </aside>
      <EditorialNote />
    </div>
  </div>
</PageLayout>

<style>
  .learn-page {
    padding: var(--space-8) var(--space-5) var(--space-16);
  }
  .learn-container {
    max-width: 1224px;
    margin: 0 auto;
  }
  .learning-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.85fr);
    gap: var(--space-12);
    padding: var(--space-6) 0 var(--space-12);
    align-items: center;
    border-bottom: 1px solid var(--color-border);
  }
  .learning-hero > *,
  .reading-path div,
  .role-row > *,
  .watch-row > * {
    min-width: 0;
  }
  .eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
  }
  .learning-hero h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1.08;
    letter-spacing: -0.045em;
    margin-bottom: var(--space-6);
  }
  .lead {
    max-width: 39rem;
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin: 0;
  }
  .reading-panel {
    padding: var(--space-8);
    background: var(--color-soft);
    border: 1px solid var(--color-border);
    border-radius: 16px;
  }
  .reading-panel h2 {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
  }
  .reading-path {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-6);
  }
  .reading-path li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
  }
  .step-number {
    flex: 0 0 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background: var(--color-card);
    color: var(--color-brand-ink);
    font-weight: 500;
  }
  .reading-path strong {
    display: block;
    font-weight: 600;
    font-size: 0.9375rem;
  }
  .reading-path p {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    margin: var(--space-1) 0 0;
  }
  .learning-section {
    padding-top: var(--space-16);
    scroll-margin-top: var(--space-8);
  }
  .section-heading {
    margin-bottom: var(--space-8);
  }
  .section-heading h2 {
    font-size: clamp(1.65rem, 3vw, 2.1rem);
    letter-spacing: -0.035em;
    margin-bottom: var(--space-3);
  }
  .section-heading p {
    color: var(--color-text-secondary);
    margin-bottom: 0;
  }
  .section-heading .eyebrow {
    margin-bottom: var(--space-3);
  }
  .journey-grid,
  .source-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
  }
  .journey-card {
    min-width: 0;
    display: flex;
    flex-direction: column;
    padding: var(--space-8);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    background: var(--color-card);
    text-decoration: none;
    color: var(--color-text);
  }
  .journey-card.featured {
    background: var(--color-soft);
  }
  .journey-card:hover {
    text-decoration: none;
    border-color: var(--color-brand-ink);
  }
  .card-labels {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    justify-content: space-between;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-8);
  }
  .journey-card h3 {
    font-size: 1.65rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.035em;
    margin-bottom: var(--space-4);
  }
  .journey-card p {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-8);
  }
  .card-action {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    font-weight: 600;
    color: var(--color-brand-ink);
    font-size: 0.875rem;
  }
  .role-guides {
    border-top: 1px solid var(--color-border);
  }
  .role-row {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-5);
    padding: var(--space-6) 0;
    border-bottom: 1px solid var(--color-border);
  }
  .resource-number {
    color: var(--color-text-secondary);
    font-size: 0.8125rem;
  }
  .role-row h3,
  .international-row h3 {
    font-size: 1.0625rem;
    font-weight: 600;
    margin-bottom: var(--space-1);
  }
  .role-row p,
  .international-row p {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.9375rem;
  }
  .text-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    color: var(--color-brand-ink);
    font-size: 0.875rem;
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .text-link span {
    flex-shrink: 0;
  }
  .glossary-strip {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    justify-content: space-between;
    align-items: center;
    padding: var(--space-6) var(--space-8);
    margin-top: var(--space-8);
    background: var(--color-soft);
    border: 1px solid var(--color-border);
    border-radius: 12px;
  }
  .glossary-strip p {
    flex: 1 1 400px;
    color: var(--color-text-secondary);
    margin: 0;
    font-size: 0.9375rem;
  }
  .glossary-strip strong {
    color: var(--color-text);
    display: block;
    font-weight: 600;
    margin-bottom: var(--space-1);
  }
  .glossary-grid {
    flex: 1 1 100%;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
    margin: 0;
    font-size: 0.875rem;
  }
  .glossary-term {
    color: var(--color-text);
    font-weight: 600;
    margin-bottom: var(--space-2);
  }
  .glossary-grid dd {
    margin: 0;
    color: var(--color-text-secondary);
  }
  @media (max-width: 640px) {
    .glossary-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .link-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
  }
  .source-card {
    min-width: 0;
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 12px;
  }
  .source-label {
    width: fit-content;
    font-size: 0.6875rem;
    font-weight: 600;
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-5);
  }
  .source-card h3 {
    font-size: 1.0625rem;
    font-weight: 600;
    margin-bottom: var(--space-3);
  }
  .source-card p {
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
  }
  .source-card .text-link {
    margin-top: auto;
  }
  .international-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    padding: var(--space-6) 0;
    margin-top: var(--space-4);
  }
  .international-row > div {
    flex: 1 1 400px;
  }
  .watch-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
    gap: var(--space-8);
    padding: var(--space-8);
    margin-top: var(--space-8);
    background: var(--color-soft);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    align-items: center;
  }
  .watch-row h2 {
    font-size: 1.4rem;
    letter-spacing: -0.025em;
    margin-bottom: var(--space-3);
  }
  .watch-row p {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    margin: 0;
  }
  .watch-row .link-actions {
    justify-content: flex-end;
  }
  @media (max-width: 960px) {
    .learning-hero {
      gap: var(--space-8);
    }
    .journey-card {
      padding: var(--space-6);
    }
    .card-labels {
      flex-direction: column;
    }
    .role-row {
      grid-template-columns: 28px minmax(0, 1fr);
    }
    .role-row .text-link {
      grid-column: 2;
    }
  }
  @media (max-width: 700px) {
    .learning-hero,
    .journey-grid,
    .source-grid,
    .watch-row {
      grid-template-columns: minmax(0, 1fr);
    }
    .learning-hero {
      padding-top: var(--space-4);
    }
    .learning-hero h1 {
      font-size: clamp(2.35rem, 9vw, 3.3rem);
    }
    .reading-panel,
    .glossary-strip,
    .watch-row {
      padding: var(--space-6);
    }
    .learning-section {
      padding-top: var(--space-12);
    }
    .card-labels {
      flex-direction: row;
    }
    .journey-card h3 {
      font-size: 1.5rem;
    }
    .watch-row .link-actions {
      justify-content: flex-start;
    }
  }
  @media print {
    .learn-page {
      padding: 0;
    }
    .learning-hero,
    .journey-grid,
    .source-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .journey-card,
    .source-card,
    .reading-panel {
      break-inside: avoid;
    }
  }
</style>
