---
import PageLayout from '@layouts/PageLayout.astro';
import OperatorPointer from '@components/learn/OperatorPointer.astro';
import latest from '../../../data/observatory/snapshots/production/latest.json';

const families = latest.summary.apiFamilies.length;
---

<PageLayout
  title="API Guide"
  description="What the UAE Open Finance APIs are, and where to find the operator's canonical specifications."
>
  <div class="guide-page">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/learn">Learn</a>
        <span>/</span>
        <span>API Guide</span>
      </nav>

      <header class="page-header">
        <h1>The UAE Open Finance APIs</h1>
        <p class="subtitle">
          What the APIs cover conceptually — and where the canonical, machine-readable specs live.
        </p>
      </header>

      <section class="concept">
        <p>
          UAE Open Finance exposes a standardised set of consent-gated APIs so that authorised third
          parties can access data or initiate payments on a customer's behalf. Access is always
          brokered by an explicit, revocable consent and secured with
          <strong>FAPI</strong> (Financial-grade API) profiles — redirect, DCR and CIBA flows through
          the central API Hub.
        </p>
        <p>
          There are currently <strong>{families} API families</strong> live across the ecosystem — Accounts
          (account information), Payments, Confirmation of Payee, and Products — with insurance lines
          rolling out. The <a href="/observatory">Observatory</a> shows which institutions expose which
          families.
        </p>
      </section>

      <OperatorPointer
        intro="The API specifications are authoritative and versioned — they change with each release, so read them at the source rather than a copy:"
        links={[
          { label: 'API specifications', href: 'https://nebras-open-finance.com/tech/api-specs/' },
          {
            label: 'Security & FAPI',
            href: 'https://nebras-open-finance.com/tech/tpp-standards/security/fapi/',
          },
          {
            label: 'Release notes & errata',
            href: 'https://nebras-open-finance.com/tech/release-notes-and-erratas/',
          },
        ]}
      />
    </div>
  </div>
</PageLayout>

<style>
  .guide-page {
    padding: var(--space-12) var(--space-4) var(--space-16);
  }
  .container {
    max-width: 760px;
    margin: 0 auto;
  }
  .breadcrumb {
    display: flex;
    gap: var(--space-2);
    font-size: 0.85rem;
    color: var(--color-gray-500);
    margin-bottom: var(--space-4);
  }
  .breadcrumb a {
    color: var(--color-gray-500);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    color: var(--color-primary-600);
  }
  .page-header h1 {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 3.6vw, 2.3rem);
    font-weight: 700;
    margin: 0 0 var(--space-2);
    color: var(--color-gray-900);
    letter-spacing: -0.02em;
  }
  .subtitle {
    margin: 0 0 var(--space-8);
    color: var(--color-gray-600);
    font-size: 1.05rem;
  }
  .concept p {
    color: var(--color-gray-700);
    font-size: 1rem;
    line-height: 1.7;
    margin: 0 0 var(--space-4);
  }
  .concept strong {
    color: var(--color-gray-900);
  }
  :global([data-theme='dark']) .concept p {
    color: var(--color-gray-300);
  }
</style>
