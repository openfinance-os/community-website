---
import PageLayout from '@layouts/PageLayout.astro';
import OperatorPointer from '@components/learn/OperatorPointer.astro';
import { apiFamilyLabel } from '@lib/taxonomy';
import latest from '../../../data/observatory/snapshots/production/latest.json';

const families = latest.summary.apiFamilies.length;
const familyNames = latest.summary.apiFamilies.map(apiFamilyLabel).join(', ');
const observedDate = latest.timestamp.slice(0, 10);
---

<PageLayout
  title="API Guide"
  description="Understand the UAE API Hub, consented and client-credentials services, and where to find specifications."
>
  <div class="guide-page">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/learn">Learn</a>
        <span>/</span>
        <span>API Guide</span>
      </nav>

      <header class="page-header">
        <h1>The UAE Open Finance APIs</h1>
        <p class="subtitle">
          What the APIs cover, how the Hub mediates access, and where to find specifications.
        </p>
      </header>

      <section class="concept">
        <p>
          UAE Open Finance uses a <strong>central API Hub</strong>. A TPP calls the Hub; the Hub
          calls the financial institution through its Ozone Connect interface and returns the
          response. The Hub manages consent, issues access tokens and provides the TPP-facing APIs.
          TPPs do not call the institution's backend directly.
        </p>
        <p>
          Customer data sharing and payment initiation require customer consent. Services such as
          Confirmation of Payee, product information and ATM information use client credentials
          without an end-customer consent journey. <strong>FAPI</strong> supplies the financial API security
          profile; <a href="/learn/glossary#dcr">DCR</a> registers a client and is a separate step from
          customer authentication.
        </p>
        <p>
          The production directory snapshot observed on <time datetime={observedDate}
            >{observedDate}</time
          >
          contains <strong>{families} published API family identifiers</strong>: {familyNames}. The
          <a href="/observatory">Observatory</a> shows published resources and versions. Publication does
          not establish successful integration, availability or live usage.
        </p>
      </section>

      <OperatorPointer
        intro="Check the official standards and the selected specification version, including errata. The community reference site offers browsable technical material:"
        links={[
          {
            label: 'Official Open Finance documentation',
            href: 'https://openfinanceuae.atlassian.net/wiki/spaces/OF/overview',
          },
          {
            label: 'API specifications — community reference',
            href: 'https://nebras-open-finance.com/tech/api-specs/',
          },
          {
            label: 'Security & FAPI — community reference',
            href: 'https://nebras-open-finance.com/tech/tpp-standards/security/fapi/',
          },
          {
            label: 'Release notes & errata — community reference',
            href: 'https://nebras-open-finance.com/tech/release-notes-and-erratas/',
          },
        ]}
      />
    </div>
  </div>
</PageLayout>

<style>
  .guide-page {
    padding: var(--space-12) var(--space-4) var(--space-16);
  }
  .container {
    max-width: 760px;
    margin: 0 auto;
  }
  .breadcrumb {
    display: flex;
    gap: var(--space-2);
    font-size: 0.85rem;
    color: var(--color-gray-500);
    margin-bottom: var(--space-4);
  }
  .breadcrumb a {
    color: var(--color-gray-500);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    color: var(--color-primary-600);
  }
  .page-header h1 {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 3.6vw, 2.3rem);
    font-weight: 700;
    margin: 0 0 var(--space-2);
    color: var(--color-gray-900);
    letter-spacing: -0.02em;
  }
  .subtitle {
    margin: 0 0 var(--space-8);
    color: var(--color-gray-600);
    font-size: 1.05rem;
  }
  .concept p {
    color: var(--color-gray-700);
    font-size: 1rem;
    line-height: 1.7;
    margin: 0 0 var(--space-4);
  }
  .concept strong {
    color: var(--color-gray-900);
  }
  :global([data-theme='dark']) .concept p {
    color: var(--color-gray-600);
  }
</style>
