---
import PageLayout from '@layouts/PageLayout.astro';
import OperatorPointer from '@components/learn/OperatorPointer.astro';
import latest from '../../../data/observatory/snapshots/production/latest.json';

const live = latest.summary.liveInProduction;
const total = latest.summary.totalParticipants;
---

<PageLayout
  title="Bank / LFI Guide"
  description="What a Licensed Financial Institution's role is in UAE Open Finance, and where to find the operator's integration docs."
>
  <div class="guide-page">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/learn">Learn</a>
        <span>/</span>
        <span>Bank / LFI Guide</span>
      </nav>

      <header class="page-header">
        <h1>What is a Licensed Financial Institution?</h1>
        <p class="subtitle">
          The plain-language version — and a pointer to the operator's integration guide.
        </p>
      </header>

      <section class="concept">
        <p>
          A <strong>Licensed Financial Institution (LFI)</strong> — a bank or insurer regulated by the
          CBUAE — is the data and payment holder in UAE Open Finance. Under Al&nbsp;Tareq, LFIs expose
          standardised, consent-gated APIs so that customers can share their data with, or initiate payments
          through, the third parties they choose. The LFI's job is to publish those APIs securely (FAPI),
          honour consent, and stay available.
        </p>
        <p>
          Going live means connecting through the central API Hub, passing certification, and
          appearing in the trust-framework directory. Today
          <strong>{live} of {total}</strong> registered institutions are live in production — you can
          track the rollout release by release in the <a href="/observatory">Observatory</a> and the
          <a href="/observatory/watch/">weekly Ecosystem Watch</a>.
        </p>
      </section>

      <OperatorPointer
        intro="The integration journey, trust framework, API Hub setup and certification are maintained by the Al Tareq operator. Start there:"
        links={[
          {
            label: 'LFI API Hub — getting started',
            href: 'https://nebras-open-finance.com/tech/lfi-api-hub/getting-started/',
          },
          {
            label: 'Trust framework',
            href: 'https://nebras-open-finance.com/tech/lfi-api-hub/trust-framework/',
          },
          {
            label: 'Testing & certification',
            href: 'https://nebras-open-finance.com/tech/lfi-api-hub/production/testing-certification/overview',
          },
        ]}
      />
    </div>
  </div>
</PageLayout>

<style>
  .guide-page {
    padding: var(--space-12) var(--space-4) var(--space-16);
  }
  .container {
    max-width: 760px;
    margin: 0 auto;
  }
  .breadcrumb {
    display: flex;
    gap: var(--space-2);
    font-size: 0.85rem;
    color: var(--color-gray-500);
    margin-bottom: var(--space-4);
  }
  .breadcrumb a {
    color: var(--color-gray-500);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    color: var(--color-primary-600);
  }
  .page-header h1 {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 3.6vw, 2.3rem);
    font-weight: 700;
    margin: 0 0 var(--space-2);
    color: var(--color-gray-900);
    letter-spacing: -0.02em;
  }
  .subtitle {
    margin: 0 0 var(--space-8);
    color: var(--color-gray-600);
    font-size: 1.05rem;
  }
  .concept p {
    color: var(--color-gray-700);
    font-size: 1rem;
    line-height: 1.7;
    margin: 0 0 var(--space-4);
  }
  .concept strong {
    color: var(--color-gray-900);
  }
  :global([data-theme='dark']) .concept p {
    color: var(--color-gray-600);
  }
</style>
