---
import PageLayout from '@layouts/PageLayout.astro';
import OperatorPointer from '@components/learn/OperatorPointer.astro';
import latest from '../../../data/observatory/snapshots/production/latest.json';

const withIssuer = latest.summary.liveInProduction;
const total = latest.summary.totalParticipants;
const observedDate = latest.timestamp.slice(0, 10);
---

<PageLayout
  title="Bank / LFI Guide"
  description="Understand the LFI's Ozone Connect interface, customer authentication, and the central API Hub's responsibilities."
>
  <div class="guide-page">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/learn">Learn</a>
        <span>/</span>
        <span>Bank / LFI Guide</span>
      </nav>

      <header class="page-header">
        <h1>What is a Licensed Financial Institution?</h1>
        <p class="subtitle">
          The institution's responsibilities, the Hub's responsibilities, and integration resources.
        </p>
      </header>

      <section class="concept">
        <p>
          A <strong>Licensed Financial Institution (LFI)</strong>, such as a bank or insurer,
          provides financial data or executes services through the UAE's central API Hub. The LFI
          implements
          <strong>Ozone Connect</strong>, the backend interface called by the Hub. TPP-facing
          requests and responses pass through the Hub.
        </p>
        <p>
          The customer authenticates with the LFI in the authorization journey. The Hub acts as the
          OIDC/FAPI authorization server, owns consent state and issues access tokens. The LFI
          processes the Hub's validated requests; it does not issue the TPP's access tokens or keep
          an independent consent state.
        </p>
        <p>
          Certification and production live proving are distinct from directory publication. In the
          production snapshot observed on <time datetime={observedDate}>{observedDate}</time>,
          <strong>{withIssuer} of {total} registration IDs</strong> publish an active issuer. These counts
          do not establish how many institutions are live. Explore metadata in the
          <a href="/observatory">Observatory</a> and reported operational activity in the
          <a href="/observatory/watch/">Ecosystem Watch</a>.
        </p>
      </section>

      <OperatorPointer
        intro="Use the official Open Finance documentation for governing requirements. The community LFI guide explains the integration journey and links to supporting material:"
        links={[
          {
            label: 'Official Open Finance documentation',
            href: 'https://openfinanceuae.atlassian.net/wiki/spaces/OF/overview',
          },
          {
            label: 'LFI API Hub — community integration guide',
            href: 'https://nebras-open-finance.com/tech/lfi-api-hub/',
          },
          {
            label: 'Trust framework — community reference',
            href: 'https://nebras-open-finance.com/tech/lfi-api-hub/trust-framework/',
          },
          {
            label: 'Testing & certification — official documentation',
            href: 'https://openfinanceuae.atlassian.net/wiki/spaces/OF/pages/124583943',
          },
        ]}
      />
    </div>
  </div>
</PageLayout>

<style>
  .guide-page {
    padding: var(--space-12) var(--space-4) var(--space-16);
  }
  .container {
    max-width: 760px;
    margin: 0 auto;
  }
  .breadcrumb {
    display: flex;
    gap: var(--space-2);
    font-size: 0.85rem;
    color: var(--color-gray-500);
    margin-bottom: var(--space-4);
  }
  .breadcrumb a {
    color: var(--color-gray-500);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    color: var(--color-primary-600);
  }
  .page-header h1 {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 3.6vw, 2.3rem);
    font-weight: 700;
    margin: 0 0 var(--space-2);
    color: var(--color-gray-900);
    letter-spacing: -0.02em;
  }
  .subtitle {
    margin: 0 0 var(--space-8);
    color: var(--color-gray-600);
    font-size: 1.05rem;
  }
  .concept p {
    color: var(--color-gray-700);
    font-size: 1rem;
    line-height: 1.7;
    margin: 0 0 var(--space-4);
  }
  .concept strong {
    color: var(--color-gray-900);
  }
  :global([data-theme='dark']) .concept p {
    color: var(--color-gray-600);
  }
</style>
