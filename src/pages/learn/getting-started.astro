---
import PageLayout from '@layouts/PageLayout.astro';
import Breadcrumb from '@components/common/Breadcrumb.astro';
import OperatorPointer from '@components/learn/OperatorPointer.astro';

const examples = [
  {
    label: 'An SME cash view',
    title: 'Several bank accounts. Less switching.',
    description:
      'A business could choose to share balances and transactions from its accounts with a service that brings the information into one view.',
    question:
      'Which accounts are covered, how recent is the data, and what happens when access stops?',
    href: '/commons/sme-multi-bank-cash-flow',
    action: 'Explore the synthetic SME example',
  },
  {
    label: 'Pay by bank',
    title: 'A payment from an account you choose.',
    description:
      'At a checkout, a customer could approve a payment from their bank account through an authorised provider. The payment has its own consent and status journey.',
    question:
      'Are the amount and recipient clear, and can the service distinguish a submitted payment from a completed one?',
    href: 'https://openfinanceuae.atlassian.net/wiki/spaces/standardsv2dot1final/pages/702417239/Single%2BInstant%2BPayments',
    action: 'Read the official payment journey',
  },
  {
    label: 'An insurance overview',
    title: 'Policy information in one place.',
    description:
      'A consumer could give permission for a provider to retrieve information about their insurance policies and display it together.',
    question: 'Which policy information is requested, for what purpose, and for how long?',
    href: 'https://openfinanceuae.atlassian.net/wiki/spaces/standardsv2dot1final/pages/702421592/Insurance%2BData%2BSharing',
    action: 'Read official insurance data sharing',
  },
];

const nextSteps = [
  {
    title: 'Understand a real proposition',
    description:
      'Use the worksheet to identify an unknown, its owner, and the next evidence you need.',
    href: '/learn/readiness',
    action: 'Use the readiness worksheet',
  },
  {
    title: 'Explore the data',
    description:
      'Try the community Data Sandbox with synthetic fixtures, then inspect the relevant API contract.',
    href: '/commons/data-sandbox',
    action: 'Explore the Data Sandbox',
  },
  {
    title: 'Follow the ecosystem evidence',
    description:
      'Inspect dated directory observations while keeping registration, publication, and operation distinct.',
    href: '/observatory',
    action: 'Explore the Observatory',
  },
];
---

<PageLayout
  title="Getting Started with UAE Open Finance"
  description="Start with the customer benefit and permission, then understand participants, API Hub architecture, practical scenarios, and the official sources for UAE Open Finance."
>
  <div class="guide-page">
    <div class="guide-container">
      <Breadcrumb items={[{ label: 'Learn', href: '/learn' }, { label: 'Getting Started' }]} />
      <header class="page-intro guide-intro">
        <p class="eyebrow">Getting Started / UAE Open Finance</p>
        <h1>More useful services.<br />Through permission.</h1>
        <p class="lead">
          Open Finance lets a customer choose to share financial information or authorise a service
          through an eligible provider. Start with what that could make possible, then check the
          conditions behind it.
        </p>
        <nav class="guide-jumps" aria-label="On this page">
          <a href="#possibilities">Practical possibilities</a><a href="#permission"
            >Customer permission</a
          ><a href="#participants">Who participates</a><a href="#architecture"
            >How requests travel</a
          ><a href="#next-steps">Your next step</a>
        </nav>
      </header>

      <section class="guide-section" aria-labelledby="idea-title">
        <div class="section-heading">
          <p class="eyebrow">The idea</p><h2 id="idea-title">Start with the customer benefit.</h2>
        </div>
        <div class="prose intro-prose">
          <p>
            A person or business may have financial information spread across several institutions.
            Permission-based access can help a service bring that information together or initiate a
            transaction the customer has chosen.
          </p>
          <p>
            The CBUAE describes Open Finance as a way to give customers greater control and choice
            through consented financial data. That is a purpose for the framework, rather than
            evidence that every possible service is already available. <a
              href="https://centralbank.ae/en/our-operations/fintech-digital-transformation/open-finance/"
              rel="noopener noreferrer">Read the CBUAE overview</a
            >.
          </p>
        </div>
      </section>

      <section class="guide-section" id="possibilities" aria-labelledby="possibilities-title">
        <div class="section-heading">
          <h2 id="possibilities-title">Three practical possibilities.</h2><p>
            Illustrative journeys to make the idea concrete. Availability depends on the provider,
            institution, supported capability, and applicable requirements.
          </p>
        </div>
        <div class="example-grid">
          {
            examples.map((example) => (
              <article class="example-card">
                <>
                  <p class="eyebrow">{example.label}</p>
                  <h3>{example.title}</h3>
                  <p>{example.description}</p>
                </>
                <div class="example-question">
                  <>
                    <strong>A question to carry forward</strong>
                    <p>{example.question}</p>
                  </>
                </div>
                <a
                  class="text-link"
                  href={example.href}
                  rel={example.href.startsWith('https:') ? 'noopener noreferrer' : undefined}
                >
                  {example.action}
                  <span aria-hidden="true">{example.href.startsWith('https:') ? '↗' : '→'}</span>
                </a>
              </article>
            ))
          }
        </div>
      </section>

      <section class="guide-section" id="permission" aria-labelledby="permission-title">
        <div class="section-heading">
          <p class="eyebrow">Customer permission</p><h2 id="permission-title">
            The purpose and boundaries come first.
          </h2>
        </div>
        <div class="permission-grid">
          <div class="prose">
            <p>
              Before considering what to build, be clear about what the customer is agreeing to. A
              data-sharing permission and a payment instruction serve different purposes; one should
              not be treated as permission for the other.
            </p>
            <p>
              Authentication and authorisation are also different. Authentication checks who the
              customer is. Authorisation records the access or action they approve. The supported
              journey may use the institution's channels or the Al Tareq centralised authentication
              and authorisation solution. <a
                href="https://openfinanceuae.atlassian.net/wiki/spaces/APIHubDocsv8/pages/874119173/AlTareq%2BCentralised%2BAuthentication%2Band%2BAuthorization%2BIntegration%2BGuide"
                rel="noopener noreferrer">Check the official integration guidance</a
              >.
            </p>
          </div>
          <aside class="permission-panel" aria-labelledby="permission-questions">
            <h3 id="permission-questions">Make the choice understandable.</h3>
            <ol>
              <li>
                <strong>What is being requested?</strong><span
                  >The information, account, policy, or transaction involved.</span
                >
              </li>
              <li>
                <strong>For what purpose and duration?</strong><span
                  >The benefit, the recipient, and the boundaries of access.</span
                >
              </li>
              <li>
                <strong>What happens afterwards?</strong><span
                  >How to manage consent, recognise its expiry or withdrawal, and get support.</span
                >
              </li>
            </ol>
          </aside>
        </div>
      </section>

      <section class="guide-section" id="participants" aria-labelledby="participants-title">
        <div class="section-heading">
          <h2 id="participants-title">Who participates?</h2><p>
            A few terms explain the roles. The official framework determines the permissions and
            obligations that apply.
          </p>
        </div>
        <dl class="participant-grid">
          <div>
            <dt>Customer</dt><dd>
              The person or business choosing the service and authorising the relevant access or
              action.
            </dd>
          </div>
          <div>
            <dt>Licensed Financial Institution (LFI)</dt><dd>
              An institution, such as a bank or insurer, holding the relevant customer account,
              policy, or financial information.
            </dd>
          </div>
          <div>
            <dt>Third Party Provider (TPP)</dt><dd>
              A provider using the framework's services within its permitted role. An LFI can also
              act as a TPP; check the requirements for the activity.
            </dd>
          </div>
          <div>
            <dt>CBUAE & the framework</dt><dd>
              The regulator and the regulated infrastructure supporting participation, secure
              access, and common interfaces.
            </dd>
          </div>
        </dl>
        <p class="source-note">
          For regulatory scope and participation requirements, use the <a
            href="https://rulebook.centralbank.ae/en/rulebook/introduction-and-scope-2"
            rel="noopener noreferrer">CBUAE Rulebook introduction and scope, Circular 03/2025</a
          >. For terminology, <a href="/learn/glossary">browse the glossary</a>.
        </p>
      </section>

      <section class="guide-section" id="architecture" aria-labelledby="architecture-title">
        <div class="section-heading">
          <p class="eyebrow">The technical shape</p><h2 id="architecture-title">
            The API Hub sits between providers and institutions.
          </h2>
        </div>
        <div
          class="request-flow"
          role="group"
          aria-label="Requests travel from the Third Party Provider through the API Hub to the Licensed Financial Institution; responses return through the Hub."
        >
          <div>
            <span class="flow-label">TPP</span><h3>The customer-facing service</h3><p>
              Uses the TPP-facing Standards APIs.
            </p>
          </div>
          <span class="flow-arrow" aria-hidden="true">↔</span>
          <div class="flow-hub">
            <span class="flow-label">API Hub</span><h3>The mediation point</h3><p>
              Manages consent and access tokens, and routes permitted requests.
            </p>
          </div>
          <span class="flow-arrow" aria-hidden="true">↔</span>
          <div>
            <span class="flow-label">LFI</span><h3>The institution's services</h3><p>
              Implements the Ozone Connect interface for the Hub to call.
            </p>
          </div>
        </div>
        <p class="source-note">
          This is a simplified request and response path, not the full customer authentication
          sequence. TPPs do not call the institution's Ozone Connect backend directly. See the <a
            href="https://openfinanceuae.atlassian.net/wiki/spaces/APIHubDocsv8/pages/452362297/Integration%2BOverview"
            rel="noopener noreferrer">official API Hub integration overview</a
          > and <a
            href="https://github.com/Nebras-Open-Finance/api-specs/tree/main"
            rel="noopener noreferrer">official API specification repository</a
          >.
        </p>
        <aside class="technical-note" aria-labelledby="exceptions-title">
          <h3 id="exceptions-title">Not every API uses a customer consent journey.</h3>
          <p>
            Customer-specific data sharing and payment initiation require the relevant customer
            authorisation. Some API operations instead use a client credentials grant. The official
            Confirmation of Payee API guide, for example, shows client credentials access. That
            technical access does not grant general permission to read a customer's financial data
            or initiate a payment.
          </p>
          <a
            class="text-link"
            href="https://openfinanceuae.atlassian.net/wiki/spaces/standardsv2dot1final/pages/702420679/Confirmation%2Bof%2BPayee%2BAPI%2BGuide"
            rel="noopener noreferrer"
            >Read the official Confirmation of Payee guide <span aria-hidden="true">↗</span></a
          >
        </aside>
        <div class="api-families">
          <h3>What the specifications cover</h3>
          <p>
            Explore bank data sharing, payment initiation, Confirmation of Payee, product
            information, insurance services, and ATM information. API families, supported versions,
            and available services need checking for the proposition and institutions you have in
            mind.
          </p>
          <a class="text-link" href="/learn/api-guide"
            >Go deeper with the API Integration Guide <span aria-hidden="true">→</span></a
          >
        </div>
      </section>

      <aside class="evidence-note" aria-labelledby="evidence-title">
        <p class="eyebrow">When you inspect the ecosystem</p>
        <h2 id="evidence-title">Keep the evidence in its own lane.</h2>
        <p>
          A directory registration, a published API resource, self-certification, go-live approval,
          and observed operational traffic establish different things. A saved directory observation
          cannot tell you that a customer journey is operating successfully today.
        </p>
        <a class="text-link" href="/observatory/methodology"
          >Read the evidence definitions and limits <span aria-hidden="true">→</span></a
        >
      </aside>

      <OperatorPointer
        heading="Building, integrating, or going live?"
        intro="Verify the current regulatory requirements, participation path, technical versions and certification process in official sources. Use community explanations for orientation alongside them."
        links={[
          {
            label: 'Official Open Finance documentation',
            href: 'https://openfinanceuae.atlassian.net/wiki/spaces/OF/overview?mode=global',
          },
          {
            label: 'Official API specifications — Nebras GitHub repository',
            href: 'https://github.com/Nebras-Open-Finance/api-specs/tree/main',
          },
          {
            label: 'TPP standards — community reference',
            href: 'https://nebras-open-finance.com/tech/tpp-standards',
          },
          {
            label: 'LFI API Hub — community integration guide',
            href: 'https://nebras-open-finance.com/tech/lfi-api-hub/',
          },
        ]}
      />

      <section class="guide-section" id="next-steps" aria-labelledby="next-title">
        <div class="section-heading">
          <h2 id="next-title">Choose a useful next step.</h2><p>
            You do not need to become an API specialist to ask a better question.
          </p>
        </div>
        <div class="next-grid">
          {
            nextSteps.map((step) => (
              <a href={step.href} class="next-card">
                <>
                  <h3>{step.title}</h3>
                  <p>{step.description}</p>
                  <span class="card-action">
                    {step.action}
                    <span aria-hidden="true">→</span>
                  </span>
                </>
              </a>
            ))
          }
        </div>
        <div class="role-links">
          <p>Already know your role?</p><a class="text-link" href="/learn/bank-guide"
            >Bank & financial institution guide <span aria-hidden="true">→</span></a
          ><a class="text-link" href="/learn/tpp-guide"
            >TPP guide <span aria-hidden="true">→</span></a
          >
        </div>
        <p class="review-note">
          Source links checked 10 October 2026. Published specifications describe the contract; they
          do not prove that every institution supports every capability. Recheck versions, errata,
          and applicable official guidance before making an implementation decision.
        </p>
      </section>
    </div>
  </div>
</PageLayout>

<style>
  .guide-page {
    padding: var(--space-8) var(--space-5) var(--space-16);
  }
  .guide-container {
    max-width: 1100px;
    margin: 0 auto;
  }
  .guide-intro {
    padding: var(--space-4) 0 var(--space-10);
    border-bottom: 1px solid var(--color-border);
  }
  .eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
  }
  .guide-intro h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1.08;
    letter-spacing: -0.045em;
    margin-bottom: var(--space-6);
  }
  .lead {
    max-width: 720px;
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
  }
  .guide-jumps {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin-top: var(--space-8);
  }
  .guide-jumps a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-brand-ink);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
  }
  .guide-section {
    padding-top: var(--space-12);
    scroll-margin-top: var(--space-8);
  }
  .section-heading {
    margin-bottom: var(--space-6);
  }
  .section-heading h2 {
    font-size: clamp(1.65rem, 3vw, 2.1rem);
    letter-spacing: -0.035em;
    line-height: 1.2;
    margin-bottom: var(--space-3);
  }
  .section-heading > p:not(.eyebrow) {
    max-width: 48rem;
    color: var(--color-text-secondary);
    font-size: 0.9375rem;
    line-height: 1.7;
    margin: 0;
  }
  .prose p {
    color: var(--color-text-secondary);
    line-height: 1.75;
    margin-bottom: var(--space-5);
  }
  .prose p:last-child {
    margin-bottom: 0;
  }
  .intro-prose {
    max-width: 48rem;
  }
  .prose a,
  .source-note a {
    color: var(--color-brand-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .example-grid,
  .next-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
  }
  .example-card,
  .next-card {
    min-width: 0;
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 12px;
  }
  .example-card h3,
  .next-card h3 {
    font-size: 1.35rem;
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.3;
    margin-bottom: var(--space-4);
  }
  .example-card > p:not(.eyebrow),
  .next-card p {
    color: var(--color-text-secondary);
    font-size: 0.9375rem;
    line-height: 1.7;
    margin-bottom: var(--space-5);
  }
  .example-question {
    margin-top: auto;
    padding: var(--space-4) 0;
    border-top: 1px solid var(--color-border);
  }
  .example-question strong {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text);
  }
  .example-question p {
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    line-height: 1.6;
    margin: var(--space-2) 0 0;
  }
  .text-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    color: var(--color-brand-ink);
    font-size: 0.875rem;
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .text-link span {
    flex-shrink: 0;
  }
  .permission-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: var(--space-10);
  }
  .permission-grid > * {
    min-width: 0;
  }
  .permission-panel {
    padding: var(--space-6);
    background: var(--color-soft);
    border: 1px solid var(--color-border);
    border-radius: 12px;
  }
  .permission-panel h3 {
    font-size: 1.125rem;
    margin-bottom: var(--space-5);
  }
  .permission-panel ol {
    display: grid;
    gap: var(--space-4);
    padding-left: var(--space-5);
    margin: 0;
  }
  .permission-panel li {
    padding-left: var(--space-2);
  }
  .permission-panel strong {
    display: block;
    font-size: 0.9375rem;
    font-weight: 600;
  }
  .permission-panel span {
    display: block;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    margin-top: var(--space-1);
  }
  .participant-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }
  .participant-grid > div {
    min-width: 0;
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-card);
  }
  .participant-grid dt {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: var(--space-2);
  }
  .participant-grid dd {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.9375rem;
    line-height: 1.7;
  }
  .source-note {
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    line-height: 1.7;
    margin: var(--space-5) 0 0;
  }
  .request-flow {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 28px minmax(0, 1fr) 28px minmax(0, 1fr);
    align-items: stretch;
    gap: var(--space-2);
  }
  .request-flow > div {
    min-width: 0;
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-card);
  }
  .request-flow .flow-hub {
    background: var(--color-soft);
  }
  .flow-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-brand-ink);
    margin-bottom: var(--space-5);
  }
  .request-flow h3 {
    font-size: 1.0625rem;
    font-weight: 600;
    margin-bottom: var(--space-3);
  }
  .request-flow p {
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    line-height: 1.65;
    margin: 0;
  }
  .flow-arrow {
    align-self: center;
    justify-self: center;
    color: var(--color-brand-ink);
    font-size: 1.4rem;
  }
  .technical-note,
  .evidence-note {
    padding: var(--space-6);
    margin-top: var(--space-8);
    background: var(--color-soft);
    border: 1px solid var(--color-border);
    border-radius: 12px;
  }
  .technical-note h3 {
    font-size: 1.125rem;
    margin-bottom: var(--space-3);
  }
  .technical-note p,
  .evidence-note > p:not(.eyebrow) {
    font-size: 0.9375rem;
    line-height: 1.75;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-3);
  }
  .api-families {
    max-width: 48rem;
    padding-top: var(--space-8);
  }
  .api-families h3 {
    font-size: 1.125rem;
    margin-bottom: var(--space-3);
  }
  .api-families p {
    color: var(--color-text-secondary);
    line-height: 1.75;
    margin-bottom: var(--space-3);
  }
  .evidence-note {
    margin-top: var(--space-12);
  }
  .evidence-note h2 {
    font-size: 1.5rem;
    letter-spacing: -0.025em;
    margin-bottom: var(--space-4);
  }
  .next-card {
    color: var(--color-text);
    text-decoration: none;
  }
  .next-card:hover {
    border-color: var(--color-brand-ink);
    text-decoration: none;
  }
  .card-action {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-brand-ink);
  }
  .role-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    align-items: center;
    padding: var(--space-5) 0;
    margin-top: var(--space-4);
  }
  .role-links p {
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }
  .review-note {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-5);
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin: var(--space-4) 0 0;
  }
  @media (max-width: 800px) {
    .example-grid,
    .next-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .permission-grid {
      gap: var(--space-6);
    }
    .request-flow > div {
      padding: var(--space-5);
    }
  }
  @media (max-width: 600px) {
    .guide-intro h1 {
      font-size: clamp(2.25rem, 9vw, 3.3rem);
    }
    .permission-grid,
    .participant-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .request-flow {
      grid-template-columns: minmax(0, 1fr);
