---
import PageLayout from '@layouts/PageLayout.astro';
import { roleLabels } from '@lib/taxonomy';
import OperatorPointer from '@components/learn/OperatorPointer.astro';
---

<PageLayout
  title="TPP Guide"
  description="What a Third Party Provider does through the UAE API Hub, and where to find participation and integration guidance."
>
  <div class="guide-page">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/learn">Learn</a>
        <span>/</span>
        <span>TPP Guide</span>
      </nav>

      <header class="page-intro page-header">
        <h1>What is a Third Party Provider?</h1>
        <p class="subtitle">
          The plain-language version, with official documentation and community technical
          references.
        </p>
      </header>

      <section class="concept">
        <p>
          A <strong>Third Party Provider (TPP)</strong> consumes Open Finance services through the
          central API Hub. With the required customer consent, it can read financial data or
          initiate payments. These capabilities support budgeting apps, pay-by-bank checkouts,
          account aggregation and lending informed by cash flow. An LFI can also act as a TPP where
          its permissions and licence allow.
        </p>
        <p>
          In the UAE, TPPs register with the trust-framework directory, obtain certification, and
          integrate through the central API Hub. Directory role claims include <strong>BDSP</strong>{' '}
          ({roleLabels.BDSP}),
          <strong>BSIP</strong> ({roleLabels.BSIP}) and <strong>ISP</strong> ({roleLabels.ISP}).
          These claims describe permissions, not a TPP licence classification. The
          <a href="/observatory">Observatory</a> records observed directory registrations and
          published resources; it does not verify whether a provider is licensed for a particular
          proposition or actively using an API.
        </p>
      </section>

      <OperatorPointer
        intro="Check official participation requirements before planning an integration. The community standards site provides technical guides and specification references:"
        links={[
          {
            label: 'Official Open Finance documentation',
            href: 'https://openfinanceuae.atlassian.net/wiki/spaces/OF/overview',
          },
          {
            label: 'TPP Standards — community reference',
            href: 'https://nebras-open-finance.com/tech/tpp-standards',
          },
          {
            label: 'Testing & certification — community reference',
            href: 'https://nebras-open-finance.com/tech/tpp-standards/production/testing-certification/overview',
          },
          {
            label: 'API specifications — community reference',
            href: 'https://nebras-open-finance.com/tech/api-specs/',
          },
        ]}
      />
    </div>
  </div>
</PageLayout>

<style>
  .guide-page {
    padding: var(--space-12) var(--space-4) var(--space-16);
  }
  .container {
    max-width: 760px;
    margin: 0 auto;
  }
  .breadcrumb {
    min-width: 0;
    display: flex;
    gap: var(--space-2);
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
  }
  .breadcrumb a {
    color: var(--color-text-secondary);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    color: var(--color-brand-ink);
  }
  .page-header h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 500;
    margin: 0 0 var(--space-2);
    color: var(--color-text);
    letter-spacing: -0.02em;
  }
  .subtitle {
    margin: 0 0 var(--space-8);
    color: var(--color-text-secondary);
    font-size: 1.05rem;
  }
  .concept p {
    color: var(--color-text);
    font-size: 1rem;
    line-height: 1.7;
    margin: 0 0 var(--space-4);
  }
  .concept strong {
    color: var(--color-text);
  }
  :global([data-theme='dark']) .concept p {
    color: var(--color-text-secondary);
  }
</style>
