---
import PageLayout from '@layouts/PageLayout.astro';
import OperatorPointer from '@components/learn/OperatorPointer.astro';
---

<PageLayout
  title="TPP Guide"
  description="What a Third Party Provider is in UAE Open Finance, and where to find the operator's registration and integration docs."
>
  <div class="guide-page">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/learn">Learn</a>
        <span>/</span>
        <span>TPP Guide</span>
      </nav>

      <header class="page-header">
        <h1>What is a Third Party Provider?</h1>
        <p class="subtitle">
          The plain-language version — and a pointer to the operator's canonical standards.
        </p>
      </header>

      <section class="concept">
        <p>
          A <strong>Third Party Provider (TPP)</strong> is a licensed company that — with the customer's
          consent — reads financial data or initiates payments through the UAE's Open Finance framework
          (Al&nbsp;Tareq), without ever holding the customer's money. TPPs are what turn open finance
          from infrastructure into products: budgeting apps, pay-by-bank checkouts, account aggregation,
          and lending that can see real cash flow.
        </p>
        <p>
          In the UAE, TPPs register with the trust-framework directory, obtain certification, and
          integrate through the central API Hub. Roles include <strong>BDSP</strong> (data access),
          <strong>BSIP</strong> (payment initiation) and <strong>ISP</strong> (information services).
          You can see every registered participant and who is live in the
          <a href="/observatory">Observatory</a>.
        </p>
      </section>

      <OperatorPointer
        intro="Registration requirements, certification steps and the technical standards are maintained by the Al Tareq operator. Start there:"
        links={[
          { label: 'TPP Standards', href: 'https://nebras-open-finance.com/tech/tpp-standards' },
          {
            label: 'Testing & certification',
            href: 'https://nebras-open-finance.com/tech/tpp-standards/production/testing-certification/overview',
          },
          { label: 'API specifications', href: 'https://nebras-open-finance.com/tech/api-specs/' },
        ]}
      />
    </div>
  </div>
</PageLayout>

<style>
  .guide-page {
    padding: var(--space-12) var(--space-4) var(--space-16);
  }
  .container {
    max-width: 760px;
    margin: 0 auto;
  }
  .breadcrumb {
    display: flex;
    gap: var(--space-2);
    font-size: 0.85rem;
    color: var(--color-gray-500);
    margin-bottom: var(--space-4);
  }
  .breadcrumb a {
    color: var(--color-gray-500);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    color: var(--color-primary-600);
  }
  .page-header h1 {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 3.6vw, 2.3rem);
    font-weight: 700;
    margin: 0 0 var(--space-2);
    color: var(--color-gray-900);
    letter-spacing: -0.02em;
  }
  .subtitle {
    margin: 0 0 var(--space-8);
    color: var(--color-gray-600);
    font-size: 1.05rem;
  }
  .concept p {
    color: var(--color-gray-700);
    font-size: 1rem;
    line-height: 1.7;
    margin: 0 0 var(--space-4);
  }
  .concept strong {
    color: var(--color-gray-900);
  }
  :global([data-theme='dark']) .concept p {
    color: var(--color-gray-600);
  }
</style>
