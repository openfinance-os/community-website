---
import PageLayout from '@layouts/PageLayout.astro';

import { glossaryData, glossaryAnchor } from '@lib/glossary';
---

<PageLayout
  title="Open Finance Glossary"
  description="Complete glossary of terms used in UAE Open Finance."
>
  <div class="glossary-page">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/learn">Learn</a>
        <span>/</span>
        <span>Glossary</span>
      </nav>

      <header class="page-header">
        <h1>Open Finance Glossary</h1>
        <p class="subtitle">
          A comprehensive reference of terms and acronyms used in the UAE Open Finance ecosystem.
        </p>
      </header>

      <nav class="letter-nav">
        {glossaryData.map((section) => (
          <a href={`#letter-${section.letter}`}>{section.letter}</a>
        ))}
      </nav>

      <div class="glossary-content">
        {glossaryData.map((section) => (
          <section id={`letter-${section.letter}`} class="letter-section">
            <h2>{section.letter}</h2>
            <dl class="terms-list">
              {section.terms.map((item) => (
                <div class="term-item" id={glossaryAnchor(item.term)}>
                  <dt>
                    <span class="term">{item.term}</span>
                    {item.full && <span class="full-name">{item.full}</span>}
                  </dt>
                  <dd>{item.definition}</dd>
                </div>
              ))}
            </dl>
          </section>
        ))}
      </div>

      <footer class="glossary-footer">
        <p>
          Missing a term?{' '}
          <a
            href="https://github.com/openfinance-os/community/issues"
            target="_blank"
            rel="noopener noreferrer"
          >
            Suggest additions on GitHub
          </a>
        </p>
      </footer>
    </div>
  </div>
</PageLayout>

<style>
  .glossary-page {
    padding: var(--space-8) var(--space-4) var(--space-16);
  }

  .container {
    max-width: 800px;
    margin: 0 auto;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.875rem;
    color: var(--color-gray-500);
    margin-bottom: var(--space-6);
  }

  .breadcrumb a {
    color: var(--color-primary-600);
  }

  .page-header {
    margin-bottom: var(--space-8);
  }

  .page-header h1 {
    font-size: 2.25rem;
    margin-bottom: var(--space-3);
  }

  .subtitle {
    font-size: 1.125rem;
    color: var(--color-gray-600);
  }

  /* Letter Navigation */
  .letter-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: var(--space-4);
    background: var(--color-gray-50);
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-8);
    position: sticky;
    top: 64px;
    z-index: 10;
  }

  .letter-nav a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--color-gray-600);
    background: white;
    border-radius: var(--radius-md);
    text-decoration: none;
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast);
  }

  .letter-nav a:hover {
    background: var(--color-primary-100);
    color: var(--color-primary-700);
    text-decoration: none;
  }

  /* Letter Sections */
  .letter-section {
    margin-bottom: var(--space-10);
    scroll-margin-top: 120px;
  }

  .letter-section h2 {
    font-family: var(--font-mono);
    font-size: 2rem;
    color: var(--color-primary-600);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 2px solid var(--color-primary-100);
  }

  .terms-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .term-item {
    padding: var(--space-4);
    background: white;
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-lg);
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .term-item:hover {
    border-color: var(--color-primary-200);
    box-shadow: var(--shadow-sm);
  }

  .term-item dt {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .term {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-primary-700);
  }

  .full-name {
    font-size: 0.875rem;
    color: var(--color-gray-500);
  }

  .full-name::before {
    content: '— ';
  }

  .term-item dd {
    font-size: 0.9375rem;
    color: var(--color-gray-600);
    line-height: 1.6;
    margin: 0;
  }

  /* Footer */
  .glossary-footer {
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-gray-200);
    text-align: center;
  }

  .glossary-footer p {
    font-size: 0.875rem;
    color: var(--color-gray-500);
  }

  .glossary-footer a {
    color: var(--color-primary-600);
  }

  /* Dark mode */
  :global([data-theme='dark']) .glossary-page {
    background: var(--color-gray-50);
  }

  :global([data-theme='dark']) .page-header h1 {
    color: var(--color-gray-900);
  }

  :global([data-theme='dark']) .subtitle {
    color: var(--color-gray-500);
  }

  :global([data-theme='dark']) .breadcrumb {
    color: var(--color-gray-500);
  }

  :global([data-theme='dark']) .letter-nav {
    background: var(--color-gray-100);
  }

  :global([data-theme='dark']) .letter-nav a {
    background: var(--color-gray-200);
    color: var(--color-gray-500);
  }

  :global([data-theme='dark']) .letter-nav a:hover {
    background: var(--color-primary-900);
    color: var(--color-primary-300);
  }

  :global([data-theme='dark']) .letter-section h2 {
    color: var(--color-primary-400);
    border-bottom-color: var(--color-gray-200);
  }

  :global([data-theme='dark']) .term-item {
    background: var(--color-gray-100);
    border-color: var(--color-gray-200);
  }

  :global([data-theme='dark']) .term-item:hover {
    border-color: var(--color-primary-700);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }

  :global([data-theme='dark']) .term {
    color: var(--color-primary-400);
  }

  :global([data-theme='dark']) .full-name {
    color: var(--color-gray-500);
  }

  :global([data-theme='dark']) .term-item dd {
    color: var(--color-gray-500);
  }

  :global([data-theme='dark']) .glossary-footer {
    border-top-color: var(--color-gray-200);
  }

  :global([data-theme='dark']) .glossary-footer p {
    color: var(--color-gray-500);
  }

  :global([data-theme='dark']) .glossary-footer a {
    color: var(--color-primary-400);
  }
</style>
