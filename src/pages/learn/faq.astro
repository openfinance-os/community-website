---
import PageLayout from '@layouts/PageLayout.astro';
import { roleLabels } from '@lib/taxonomy';
import OperatorPointer from '@components/learn/OperatorPointer.astro';

interface FAQItem {
  question: string;
  answer: string;
}

interface FAQCategory {
  title: string;
  icon: string;
  items: FAQItem[];
}

// Generate FAQPage schema for Google rich results
const generateFAQSchema = (categories: FAQCategory[]) => {
  const allQuestions = categories.flatMap((category) =>
    category.items.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    }))
  );

  return {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: allQuestions,
    name: 'UAE Open Finance FAQ',
    description:
      'Frequently asked questions about UAE Open Finance and Open Banking — what it is, who can participate, and how the ecosystem works.',
  };
};

const faqCategories: FAQCategory[] = [
  {
    title: 'Getting Started',
    icon: 'rocket',
    items: [
      {
        question: 'What is UAE Open Finance?',
        answer:
          'UAE Open Finance is supervised by the Central Bank of the UAE (CBUAE). It enables customers to authorize financial data sharing and payment initiation through participating providers. Banking and insurance services are mediated by a central API Hub.',
      },
      {
        question: 'Who can participate in UAE Open Finance?',
        answer: `Participants include Licensed Financial Institutions (LFIs), such as banks and insurers, and authorized Third Party Providers (TPPs). Technology providers can support integrations. Directory roles such as BDSP (${roleLabels.BDSP}), BSIP (${roleLabels.BSIP}), and ISP (${roleLabels.ISP}) describe permissions rather than a TPP licence category. Eligibility depends on the intended service and current requirements.`,
      },
      {
        question: 'How do I register to participate?',
        answer:
          'Start with the official Open Finance documentation and the onboarding guidance for your organization and intended services. Organization onboarding, Trust Framework access, application registration and certification are separate steps. The Confluence space at openfinanceuae.atlassian.net is a documentation site; creating an account there does not register a participant. Use the verified onboarding instructions to obtain the appropriate directory access.',
      },
      {
        question: 'What is Al Tareq?',
        answer:
          'Al Tareq is the UAE Open Finance brand. Nebras operates the central infrastructure, including the API Hub, under CBUAE oversight. The brand, operator and regulator have different responsibilities.',
      },
      {
        question: 'How do the API Hub and financial institution work together?',
        answer:
          'A TPP calls the API Hub, which routes the request to the financial institution and returns its response. The Hub owns consent state, acts as the OIDC/FAPI authorization server and issues access tokens. The customer authenticates with the institution, whose backend integrates through Ozone Connect. Directory issuer metadata describes a published authorization server; it does not prove a successful integration or live usage.',
      },
    ],
  },
  {
    title: 'About This Site',
    icon: 'community',
    items: [
      {
        question: 'Is this an official CBUAE or Al Tareq website?',
        answer:
          'No. OpenFinance-OS is an independent community initiative. We are not affiliated with CBUAE, Al Tareq, Nebras, or any bank. We aggregate public observations and community resources. Our learning pages label official documentation and community technical references separately.',
      },
      {
        question: 'How can I contribute to this site?',
        answer:
          'We welcome contributions! You can submit content (news articles, Commons resources), contribute code improvements, or provide feedback through our GitHub repository. Visit our Community page to learn more about how to get involved.',
      },
      {
        question: 'Where can I ask questions?',
        answer:
          'For community discussions, visit our GitHub Discussions. For official technical questions, use the Al Tareq support channels. For regulatory questions, contact CBUAE directly.',
      },
    ],
  },
];

// Generate the FAQ schema
const faqSchema = generateFAQSchema(faqCategories);
---

<PageLayout
  title="Frequently Asked Questions"
  description="Common questions about UAE Open Finance and Open Banking — what it is, who can participate, and how the ecosystem works."
  articleSchema={faqSchema}
>
  <div class="faq-page">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/learn">Learn</a>
        <span>/</span>
        <span>FAQ</span>
      </nav>

      <header class="page-intro page-header">
        <h1>Frequently Asked Questions</h1>
        <p class="subtitle">
          The newcomer's questions about the UAE Open Finance ecosystem — what it is, who takes
          part, and how it works. For building and certifying, we link official documentation and
          community technical references.
        </p>
      </header>

      <div class="faq-categories">
        {
          faqCategories.map((category) => (
            <section class="faq-category">
              <h2 class="category-title">
                <span class="category-icon">
                  {category.icon === 'rocket' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z" />
                      <path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z" />
                    </svg>
                  )}
                  {category.icon === 'building' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect x="4" y="2" width="16" height="20" rx="2" />
                      <path d="M9 22v-4h6v4" />
                      <path d="M8 6h.01M16 6h.01M8 10h.01M16 10h.01M8 14h.01M16 14h.01" />
                    </svg>
                  )}
                  {category.icon === 'bank' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M3 21h18M3 7v1a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V7M21 7L12 2 3 7M6 10v9M10 10v9M14 10v9M18 10v9" />
                    </svg>
                  )}
                  {category.icon === 'code' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="m16 18 6-6-6-6M8 6l-6 6 6 6" />
                    </svg>
                  )}
                  {category.icon === 'community' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                      <circle cx="9" cy="7" r="4" />
                      <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />
                    </svg>
                  )}
                </span>
                {category.title}
              </h2>
              <div class="faq-list">
                {category.items.map((item, index) => (
                  <details
                    class="faq-item"
                    id={`faq-${category.title.toLowerCase().replace(/\s+/g, '-')}-${index}`}
                  >
                    <summary class="faq-question">
                      <span class="question-text">{item.question}</span>
                      <span class="expand-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M6 9l6 6 6-6" />
                        </svg>
                      </span>
                    </summary>
                    <div class="faq-answer">
                      <p>{item.answer}</p>
                    </div>
                  </details>
                ))}
              </div>
            </section>
          ))
        }
      </div>

      <OperatorPointer
        heading="Building, integrating or certifying?"
        intro="Use official documentation for participation requirements and governing standards. The community guides explain TPP and LFI integration, authentication and consent:"
        links={[
          {
            label: 'Official Open Finance documentation',
            href: 'https://openfinanceuae.atlassian.net/wiki/spaces/OF/overview',
          },
          {
            label: 'TPP Standards — community reference',
            href: 'https://nebras-open-finance.com/tech/tpp-standards',
          },
          {
            label: 'LFI API Hub — community integration guide',
            href: 'https://nebras-open-finance.com/tech/lfi-api-hub/',
          },
          {
            label: 'Security & FAPI — community reference',
            href: 'https://nebras-open-finance.com/tech/tpp-standards/security/fapi/',
          },
        ]}
      />

      <section class="still-questions">
        <div class="still-questions-content">
          <h2>Still have questions?</h2>
          <p>Can't find what you're looking for? We're here to help.</p>
          <div class="question-actions">
            <a
              href="https://github.com/openfinance-os/community/discussions"
              class="action-button primary"
              target="_blank"
              rel="noopener noreferrer"
            >
              Ask the Community
            </a>
            <a
              href="https://openfinanceuae.atlassian.net/wiki/spaces/OF/overview?mode=global"
              class="action-button secondary"
              target="_blank"
              rel="noopener noreferrer"
            >
              Official Open Finance Documentation
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M7 17L17 7M17 7H7M17 7v10"></path>
              </svg>
            </a>
          </div>
        </div>
      </section>
    </div>
  </div>
</PageLayout>

<style>
  .faq-page {
    padding: var(--space-8) var(--space-4) var(--space-16);
  }

  .container {
    max-width: 800px;
    margin: 0 auto;
  }

  .breadcrumb {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-6);
  }

  .breadcrumb a {
    color: var(--color-brand-ink);
  }

  .page-header {
    margin-bottom: var(--space-12);
  }

  .page-header h1 {
    font-size: clamp(2rem, 4vw, 3.5rem);
    margin-bottom: var(--space-3);
  }

  .subtitle {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    max-width: 600px;
  }

  /* FAQ Categories */
  .faq-categories {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .faq-category {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-8);
  }

  .category-title {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: var(--space-6);
  }

  .category-icon {
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: var(--color-primary-50);
    border-radius: var(--radius-lg);
    color: var(--color-brand-ink);
  }

  .category-icon svg {
    width: 20px;
    height: 20px;
  }

  /* FAQ Items */
  .faq-list {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .faq-item {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .faq-item:hover {
    border-color: var(--color-primary-200);
    box-shadow: var(--shadow-sm);
  }

  .faq-item[open] {
    border-color: var(--color-primary-300);
  }

  .faq-question {
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .question-text {
    font-weight: 500;
    color: var(--color-text);
    line-height: 1.4;
  }

  .expand-icon {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    color: var(--color-text-secondary);
    transition: transform var(--transition-fast);
  }

  .expand-icon svg {
    width: 100%;
    height: 100%;
  }

  .faq-item[open] .expand-icon {
    transform: rotate(180deg);
    color: var(--color-brand-ink);
  }

  .faq-answer {
    padding: 0 var(--space-5) var(--space-5);
    animation: fadeIn 0.2s ease-out;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .faq-answer p {
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  /* Still Have Questions */
  .still-questions {
    margin-top: var(--space-16);
    padding: var(--space-10);
    background: var(--color-primary-50);
    border-radius: var(--radius-xl);
    text-align: center;
  }

  .still-questions h2 {
    font-size: 1.5rem;
    margin-bottom: var(--space-2);
  }

  .still-questions > .still-questions-content > p {
    color: var(--color-text-secondary);
    margin-bottom: var(--space-6);
  }

  .question-actions {
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }

  .action-button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    font-weight: 500;
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      transform var(--transition-fast);
  }

  .action-button:hover {
    text-decoration: none;
    transform: translateY(-1px);
  }

  .action-button.primary {
    background: var(--color-primary-fill);
    color: white;
  }

  .action-button.primary:hover {
    background: var(--color-primary-fill-strong);
  }

  .action-button.secondary {
    background: var(--color-card);
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }

  .action-button.secondary:hover {
    background: var(--color-surface);
    border-color: var(--color-border);
  }

  .action-button:focus-visible {
    outline: 2px solid var(--color-primary-500);
    outline-offset: 2px;
  }

  .action-button.primary:focus-visible {
    box-shadow: 0 0 0 4px rgba(15, 118, 110, 0.3);
  }

  .action-button.secondary:focus-visible {
    box-shadow: 0 0 0 4px rgba(15, 118, 110, 0.2);
  }

  /* Dark mode adjustments */
  :global([data-theme='dark']) .faq-page {
    background: var(--color-surface);
  }

  :global([data-theme='dark']) .page-header h1 {
    color: var(--color-text);
  }

  :global([data-theme='dark']) .subtitle {
    color: var(--color-text-secondary);
  }

  :global([data-theme='dark']) .breadcrumb {
    color: var(--color-text-secondary);
  }

  :global([data-theme='dark']) .faq-category {
    border-top-color: var(--color-border);
  }

  :global([data-theme='dark']) .category-title {
    color: var(--color-text);
  }

  :global([data-theme='dark']) .category-icon {
    background: var(--color-soft);
    color: var(--color-brand-ink);
  }

  :global([data-theme='dark']) .faq-item {
    background: var(--color-soft);
    border-color: var(--color-border);
  }

  :global([data-theme='dark']) .faq-item:hover {
    border-color: var(--color-primary-700);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }

  :global([data-theme='dark']) .faq-item[open] {
    border-color: var(--color-primary-500);
  }

  :global([data-theme='dark']) .question-text {
    color: var(--color-text);
  }

  :global([data-theme='dark']) .expand-icon {
    color: var(--color-text-secondary);
  }

  :global([data-theme='dark']) .faq-item[open] .expand-icon {
    color: var(--color-brand-ink);
  }

  :global([data-theme='dark']) .faq-answer p {
    color: var(--color-text-secondary);
  }

  :global([data-theme='dark']) .still-questions {
    background: var(--color-soft);
  }

  :global([data-theme='dark']) .still-questions h2 {
    color: var(--color-text);
  }

  :global([data-theme='dark']) .still-questions > .still-questions-content > p {
    color: var(--color-text-secondary);
  }

  :global([data-theme='dark']) .action-button.secondary {
    background: var(--color-soft);
    border-color: var(--color-border);
    color: var(--color-text);
  }

  :global([data-theme='dark']) .action-button.secondary:hover {
    background: var(--color-soft);
  }
</style>
