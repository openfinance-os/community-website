---
import PageLayout from '@layouts/PageLayout.astro';
import OperatorPointer from '@components/learn/OperatorPointer.astro';

interface FAQItem {
  question: string;
  answer: string;
}

interface FAQCategory {
  title: string;
  icon: string;
  items: FAQItem[];
}

// Generate FAQPage schema for Google rich results
const generateFAQSchema = (categories: FAQCategory[]) => {
  const allQuestions = categories.flatMap((category) =>
    category.items.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    }))
  );

  return {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: allQuestions,
    name: 'UAE Open Finance FAQ',
    description:
      'Frequently asked questions about UAE Open Finance and Open Banking — what it is, who can participate, and how the ecosystem works.',
  };
};

const faqCategories: FAQCategory[] = [
  {
    title: 'Getting Started',
    icon: 'rocket',
    items: [
      {
        question: 'What is UAE Open Finance?',
        answer:
          'UAE Open Finance is a regulatory framework supervised by the Central Bank of the UAE (CBUAE) that enables secure, standardized sharing of financial data between banks and authorized third-party providers. It allows consumers to share their financial information with apps and services they trust, enabling innovation in financial services.',
      },
      {
        question: 'Who can participate in UAE Open Finance?',
        answer:
          'Participation is open to banks (ASPSPs), licensed third-party providers (TPPs), and technology providers. TPPs include Banking Data Service Providers (BDSPs), Banking Service Initiation Providers (BSIPs), and Information Service Providers (ISPs). All participants must be registered on the Al Tareq platform.',
      },
      {
        question: 'How do I register to participate?',
        answer:
          'Registration is done through the Al Tareq portal at openfinanceuae.atlassian.net. You will need to create an account, submit required documentation, and await approval from Nebras, the scheme operator. The process varies depending on whether you are registering as a TPP or an ASPSP.',
      },
      {
        question: 'What is Al Tareq?',
        answer:
          'Al Tareq is the official UAE Open Finance platform operated by Nebras. It provides the central directory, sandbox environment, and production infrastructure for the ecosystem. All participants must register and be approved on Al Tareq to operate in the UAE Open Finance ecosystem.',
      },
    ],
  },
  {
    title: 'About This Site',
    icon: 'community',
    items: [
      {
        question: 'Is this an official CBUAE or Al Tareq website?',
        answer:
          'No. OpenFinance-OS is a community-driven initiative. We are not affiliated with CBUAE, Al Tareq, Nebras, or any bank. We aggregate publicly available information and provide community resources. For official information, always refer to the Al Tareq portal and CBUAE.',
      },
      {
        question: 'How can I contribute to this site?',
        answer:
          'We welcome contributions! You can submit content (news articles, Commons resources), contribute code improvements, or provide feedback through our GitHub repository. Visit our Community page to learn more about how to get involved.',
      },
      {
        question: 'Where can I ask questions?',
        answer:
          'For community discussions, visit our GitHub Discussions. For official technical questions, use the Al Tareq support channels. For regulatory questions, contact CBUAE directly.',
      },
    ],
  },
];

// Generate the FAQ schema
const faqSchema = generateFAQSchema(faqCategories);
---

<PageLayout
  title="Frequently Asked Questions"
  description="Common questions about UAE Open Finance and Open Banking — what it is, who can participate, and how the ecosystem works."
  articleSchema={faqSchema}
>
  <div class="faq-page">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/learn">Learn</a>
        <span>/</span>
        <span>FAQ</span>
      </nav>

      <header class="page-header">
        <h1>Frequently Asked Questions</h1>
        <p class="subtitle">
          The newcomer's questions about the UAE Open Finance ecosystem — what it is, who takes
          part, and how it works. For building and certifying, we point you to the operator's docs.
        </p>
      </header>

      <div class="faq-categories">
        {
          faqCategories.map((category) => (
            <section class="faq-category">
              <h2 class="category-title">
                <span class="category-icon">
                  {category.icon === 'rocket' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z" />
                      <path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z" />
                    </svg>
                  )}
                  {category.icon === 'building' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect x="4" y="2" width="16" height="20" rx="2" />
                      <path d="M9 22v-4h6v4" />
                      <path d="M8 6h.01M16 6h.01M8 10h.01M16 10h.01M8 14h.01M16 14h.01" />
                    </svg>
                  )}
                  {category.icon === 'bank' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M3 21h18M3 7v1a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V7M21 7L12 2 3 7M6 10v9M10 10v9M14 10v9M18 10v9" />
                    </svg>
                  )}
                  {category.icon === 'code' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="m16 18 6-6-6-6M8 6l-6 6 6 6" />
                    </svg>
                  )}
                  {category.icon === 'community' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                      <circle cx="9" cy="7" r="4" />
                      <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />
                    </svg>
                  )}
                </span>
                {category.title}
              </h2>
              <div class="faq-list">
                {category.items.map((item, index) => (
                  <details
                    class="faq-item"
                    id={`faq-${category.title.toLowerCase().replace(/\s+/g, '-')}-${index}`}
                  >
                    <summary class="faq-question">
                      <span class="question-text">{item.question}</span>
                      <span class="expand-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M6 9l6 6 6-6" />
                        </svg>
                      </span>
                    </summary>
                    <div class="faq-answer">
                      <p>{item.answer}</p>
                    </div>
                  </details>
                ))}
              </div>
            </section>
          ))
        }
      </div>

      <OperatorPointer
        heading="Building, integrating or certifying?"
        intro="Operational questions — TPP certification, ASPSP obligations, authentication, DCR, consent flows and security standards — are answered in the operator's canonical docs, which stay current with each release:"
        links={[
          { label: 'TPP Standards', href: 'https://nebras-open-finance.com/tech/tpp-standards' },
          { label: 'LFI API Hub', href: 'https://nebras-open-finance.com/tech/lfi-api-hub/' },
          {
            label: 'Security & FAPI',
            href: 'https://nebras-open-finance.com/tech/tpp-standards/security/fapi/',
          },
        ]}
      />

      <section class="still-questions">
        <div class="still-questions-content">
          <h2>Still have questions?</h2>
          <p>Can't find what you're looking for? We're here to help.</p>
          <div class="question-actions">
            <a
              href="https://github.com/openfinance-os/community/discussions"
              class="action-button primary"
              target="_blank"
              rel="noopener noreferrer"
            >
              Ask the Community
            </a>
            <a
              href="https://openfinanceuae.atlassian.net/wiki/spaces/OF/overview?mode=global"
              class="action-button secondary"
              target="_blank"
              rel="noopener noreferrer"
            >
              Official Al Tareq Support
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M7 17L17 7M17 7H7M17 7v10"></path>
              </svg>
            </a>
          </div>
        </div>
      </section>
    </div>
  </div>
</PageLayout>

<style>
  .faq-page {
    padding: var(--space-8) var(--space-4) var(--space-16);
  }

  .container {
    max-width: 800px;
    margin: 0 auto;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.875rem;
    color: var(--color-gray-500);
    margin-bottom: var(--space-6);
  }

  .breadcrumb a {
    color: var(--color-primary-600);
  }

  .page-header {
    margin-bottom: var(--space-12);
  }

  .page-header h1 {
    font-size: 2.25rem;
    margin-bottom: var(--space-3);
  }

  .subtitle {
    font-size: 1.125rem;
    color: var(--color-gray-600);
    line-height: 1.6;
    max-width: 600px;
  }

  /* FAQ Categories */
  .faq-categories {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .faq-category {
    border-top: 1px solid var(--color-gray-200);
    padding-top: var(--space-8);
  }

  .category-title {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: var(--space-6);
  }

  .category-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: var(--color-primary-50);
    border-radius: var(--radius-lg);
    color: var(--color-primary-600);
  }

  .category-icon svg {
    width: 20px;
    height: 20px;
  }

  /* FAQ Items */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .faq-item {
    background: white;
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-lg);
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .faq-item:hover {
    border-color: var(--color-primary-200);
    box-shadow: var(--shadow-sm);
  }

  .faq-item[open] {
    border-color: var(--color-primary-300);
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .question-text {
    font-weight: 500;
    color: var(--color-gray-900);
    line-height: 1.4;
  }

  .expand-icon {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    color: var(--color-gray-400);
    transition: transform var(--transition-fast);
  }

  .expand-icon svg {
    width: 100%;
    height: 100%;
  }

  .faq-item[open] .expand-icon {
    transform: rotate(180deg);
    color: var(--color-primary-600);
  }

  .faq-answer {
    padding: 0 var(--space-5) var(--space-5);
    animation: fadeIn 0.2s ease-out;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .faq-answer p {
    color: var(--color-gray-600);
    line-height: 1.7;
    margin: 0;
  }

  /* Still Have Questions */
  .still-questions {
    margin-top: var(--space-16);
    padding: var(--space-10);
    background: var(--color-primary-50);
    border-radius: var(--radius-xl);
    text-align: center;
  }

  .still-questions h2 {
    font-size: 1.5rem;
    margin-bottom: var(--space-2);
  }

  .still-questions > .still-questions-content > p {
    color: var(--color-gray-600);
    margin-bottom: var(--space-6);
  }

  .question-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }

  .action-button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    font-weight: 500;
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      transform var(--transition-fast);
  }

  .action-button:hover {
    text-decoration: none;
    transform: translateY(-1px);
  }

  .action-button.primary {
    background: var(--color-primary-fill);
    color: white;
  }

  .action-button.primary:hover {
    background: var(--color-primary-fill-strong);
  }

  .action-button.secondary {
    background: white;
    color: var(--color-gray-700);
    border: 1px solid var(--color-gray-300);
  }

  .action-button.secondary:hover {
    background: var(--color-gray-50);
    border-color: var(--color-gray-400);
  }

  .action-button:focus-visible {
    outline: 2px solid var(--color-primary-500);
    outline-offset: 2px;
  }

  .action-button.primary:focus-visible {
    box-shadow: 0 0 0 4px rgba(15, 118, 110, 0.3);
  }

  .action-button.secondary:focus-visible {
    box-shadow: 0 0 0 4px rgba(15, 118, 110, 0.2);
  }

  /* Dark mode adjustments */
  :global([data-theme='dark']) .faq-page {
    background: var(--color-gray-50);
  }

  :global([data-theme='dark']) .page-header h1 {
    color: var(--color-gray-900);
  }

  :global([data-theme='dark']) .subtitle {
    color: var(--color-gray-500);
  }

  :global([data-theme='dark']) .breadcrumb {
    color: var(--color-gray-500);
  }

  :global([data-theme='dark']) .faq-category {
    border-top-color: var(--color-gray-200);
  }

  :global([data-theme='dark']) .category-title {
    color: var(--color-gray-900);
  }

  :global([data-theme='dark']) .category-icon {
    background: var(--color-primary-900);
    color: var(--color-primary-400);
  }

  :global([data-theme='dark']) .faq-item {
    background: var(--color-gray-100);
    border-color: var(--color-gray-200);
  }

  :global([data-theme='dark']) .faq-item:hover {
    border-color: var(--color-primary-700);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }

  :global([data-theme='dark']) .faq-item[open] {
    border-color: var(--color-primary-500);
  }

  :global([data-theme='dark']) .question-text {
    color: var(--color-gray-900);
  }

  :global([data-theme='dark']) .expand-icon {
    color: var(--color-gray-500);
  }

  :global([data-theme='dark']) .faq-item[open] .expand-icon {
    color: var(--color-primary-400);
  }

  :global([data-theme='dark']) .faq-answer p {
    color: var(--color-gray-500);
  }

  :global([data-theme='dark']) .still-questions {
    background: var(--color-primary-900);
  }

  :global([data-theme='dark']) .still-questions h2 {
    color: var(--color-gray-900);
  }

  :global([data-theme='dark']) .still-questions > .still-questions-content > p {
    color: var(--color-gray-500);
  }

  :global([data-theme='dark']) .action-button.secondary {
    background: var(--color-gray-100);
    border-color: var(--color-gray-300);
    color: var(--color-gray-900);
  }

  :global([data-theme='dark']) .action-button.secondary:hover {
    background: var(--color-gray-200);
  }
</style>
