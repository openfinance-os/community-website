---
import PageLayout from '@layouts/PageLayout.astro';
import Badge from '@components/common/Badge.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const ideaEntries = await getCollection('ideas');
  return ideaEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'ideas'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const categoryLabels: Record<string, string> = {
  consumer: 'Consumer App',
  business: 'Business Tool',
  developer: 'Developer Tool',
  integration: 'Integration',
  analytics: 'Analytics',
};

const statusLabels: Record<string, string> = {
  idea: 'Idea',
  'in-progress': 'In Progress',
  built: 'Built',
};

const complexityLabels: Record<string, string> = {
  beginner: 'Beginner',
  intermediate: 'Intermediate',
  advanced: 'Advanced',
};

const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
};
---

<PageLayout
  title={entry.data.title}
  description={entry.data.description}
>
  <article class="idea-page">
    <div class="container">
      <header class="idea-header">
        <a href="/ideas" class="back-link">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M19 12H5M12 19l-7-7 7-7"></path>
          </svg>
          Back to Ideas
        </a>

        <div class="idea-meta">
          <div class="meta-badges">
            <Badge variant={entry.data.category} size="md">
              {categoryLabels[entry.data.category]}
            </Badge>
            <Badge variant={entry.data.status} size="md">
              {statusLabels[entry.data.status]}
            </Badge>
            <Badge variant={entry.data.complexity} size="md">
              {complexityLabels[entry.data.complexity]}
            </Badge>
          </div>
          <div class="meta-info">
            <time datetime={entry.data.date.toISOString()}>
              {formatDate(entry.data.date)}
            </time>
            <span class="meta-separator">·</span>
            <span class="author">By {entry.data.author}</span>
          </div>
        </div>

        <h1>{entry.data.title}</h1>
        <p class="idea-description">{entry.data.description}</p>

        {entry.data.apis.length > 0 && (
          <div class="apis-section">
            <span class="apis-label">Required APIs:</span>
            <div class="apis-list">
              {entry.data.apis.map((api) => (
                <span class="api-tag">{api}</span>
              ))}
            </div>
          </div>
        )}

        {(entry.data.demoUrl || entry.data.repoUrl) && (
          <div class="idea-links">
            {entry.data.demoUrl && (
              <a href={entry.data.demoUrl} target="_blank" rel="noopener noreferrer" class="idea-link demo">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polygon points="10 8 16 12 10 16 10 8"></polygon>
                </svg>
                View Demo
              </a>
            )}
            {entry.data.repoUrl && (
              <a href={entry.data.repoUrl} target="_blank" rel="noopener noreferrer" class="idea-link repo">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path>
                </svg>
                View Source
              </a>
            )}
          </div>
        )}
      </header>

      <div class="idea-content">
        <Content />
      </div>

      <div class="idea-nav">
        <a href="/ideas" class="nav-link">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M19 12H5M12 19l-7-7 7-7"></path>
          </svg>
          All Ideas
        </a>
        <a
          href="https://github.com/openfinance-os/community-website/issues/new?template=demo-idea.md&title=[Idea]+Your+idea+title"
          class="nav-link contribute"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 5v14M5 12h14"></path>
          </svg>
          Submit Your Own Idea
        </a>
      </div>
    </div>
  </article>
</PageLayout>

<style>
  .idea-page {
    padding: var(--space-8) var(--space-4) var(--space-16);
    background: var(--color-gray-50);
    min-height: 100vh;
  }

  .container {
    max-width: 800px;
    margin: 0 auto;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-gray-600);
    text-decoration: none;
    margin-bottom: var(--space-6);
    transition: color var(--transition-fast);
  }

  .back-link:hover {
    color: var(--color-primary-600);
    text-decoration: none;
  }

  .idea-header {
    margin-bottom: var(--space-8);
  }

  .idea-meta {
    margin-bottom: var(--space-4);
  }

  .meta-badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .meta-info {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .meta-info time {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-gray-500);
  }

  .meta-separator {
    color: var(--color-gray-300);
  }

  .author {
    font-size: 0.875rem;
    color: var(--color-gray-600);
  }

  .idea-header h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    color: var(--color-gray-900);
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-4);
  }

  .idea-description {
    font-size: 1.125rem;
    color: var(--color-gray-600);
    line-height: 1.6;
    margin-bottom: var(--space-6);
  }

  .apis-section {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
    padding: var(--space-4);
    background: white;
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-lg);
  }

  .apis-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-gray-600);
  }

  .apis-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .api-tag {
    padding: var(--space-1) var(--space-3);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-primary-700);
    background: var(--color-primary-50);
    border-radius: var(--radius-full);
  }

  .idea-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .idea-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-5);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--radius-lg);
    transition:
      background-color var(--transition-fast),
      transform var(--transition-fast);
  }

  .idea-link:hover {
    transform: translateY(-2px);
    text-decoration: none;
  }

  .idea-link.demo {
    background: var(--color-primary-600);
    color: white;
  }

  .idea-link.demo:hover {
    background: var(--color-primary-700);
  }

  .idea-link.repo {
    background: var(--color-gray-800);
    color: white;
  }

  .idea-link.repo:hover {
    background: var(--color-gray-900);
  }

  .idea-content {
    background: white;
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    margin-bottom: var(--space-6);
  }

  /* Markdown content styles */
  .idea-content :global(h2) {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-gray-900);
    margin-top: var(--space-8);
    margin-bottom: var(--space-4);
  }

  .idea-content :global(h3) {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-gray-900);
    margin-top: var(--space-6);
    margin-bottom: var(--space-3);
  }

  .idea-content :global(p) {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-gray-700);
    margin-bottom: var(--space-4);
  }

  .idea-content :global(ul),
  .idea-content :global(ol) {
    margin-bottom: var(--space-4);
    padding-left: var(--space-6);
  }

  .idea-content :global(li) {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-gray-700);
    margin-bottom: var(--space-2);
  }

  .idea-content :global(a) {
    color: var(--color-primary-600);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .idea-content :global(a:hover) {
    color: var(--color-primary-700);
  }

  .idea-content :global(strong) {
    font-weight: 600;
    color: var(--color-gray-900);
  }

  .idea-content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    padding: 0.125rem 0.375rem;
    background: var(--color-gray-100);
    border-radius: var(--radius-sm);
  }

  .idea-content :global(pre) {
    margin: var(--space-6) 0;
    padding: var(--space-4);
    background: var(--color-gray-900);
    border-radius: var(--radius-lg);
    overflow-x: auto;
  }

  .idea-content :global(pre code) {
    padding: 0;
    background: none;
    color: var(--color-gray-100);
  }

  .idea-content :global(blockquote) {
    border-left: 3px solid var(--color-primary-300);
    padding-left: var(--space-4);
    margin: var(--space-6) 0;
    color: var(--color-gray-600);
    font-style: italic;
  }

  .idea-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-gray-200);
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-primary-600);
    text-decoration: none;
  }

  .nav-link:hover {
    color: var(--color-primary-700);
    text-decoration: none;
  }

  .nav-link.contribute {
    color: var(--color-gray-600);
  }

  .nav-link.contribute:hover {
    color: var(--color-gray-900);
  }

  @media (max-width: 640px) {
    .idea-content {
      padding: var(--space-5);
    }
  }

  /* Dark mode */
  :global([data-theme='dark']) .idea-page {
    background: var(--color-gray-100);
  }

  :global([data-theme='dark']) .back-link {
    color: var(--color-gray-400);
  }

  :global([data-theme='dark']) .back-link:hover {
    color: var(--color-primary-400);
  }

  :global([data-theme='dark']) .meta-info time {
    color: var(--color-gray-400);
  }

  :global([data-theme='dark']) .author {
    color: var(--color-gray-400);
  }

  :global([data-theme='dark']) .idea-header h1 {
    color: var(--color-gray-900);
  }

  :global([data-theme='dark']) .idea-description {
    color: var(--color-gray-400);
  }

  :global([data-theme='dark']) .apis-section {
    background: var(--color-gray-200);
    border-color: var(--color-gray-300);
  }

  :global([data-theme='dark']) .apis-label {
    color: var(--color-gray-400);
  }

  :global([data-theme='dark']) .api-tag {
    background: rgba(20, 184, 166, 0.15);
    color: var(--color-primary-400);
  }

  :global([data-theme='dark']) .idea-content {
    background: var(--color-gray-200);
    border-color: var(--color-gray-300);
  }

  :global([data-theme='dark']) .idea-content :global(h2),
  :global([data-theme='dark']) .idea-content :global(h3),
  :global([data-theme='dark']) .idea-content :global(strong) {
    color: var(--color-gray-900);
  }

  :global([data-theme='dark']) .idea-content :global(p),
  :global([data-theme='dark']) .idea-content :global(li) {
    color: var(--color-gray-300);
  }

  :global([data-theme='dark']) .idea-content :global(a) {
    color: var(--color-primary-400);
  }

  :global([data-theme='dark']) .idea-content :global(code) {
    background: var(--color-gray-300);
    color: var(--color-gray-900);
  }

  :global([data-theme='dark']) .idea-nav {
    border-top-color: var(--color-gray-300);
  }

  :global([data-theme='dark']) .nav-link {
    color: var(--color-primary-400);
  }

  :global([data-theme='dark']) .nav-link:hover {
    color: var(--color-primary-300);
  }

  :global([data-theme='dark']) .nav-link.contribute {
    color: var(--color-gray-400);
  }

  :global([data-theme='dark']) .nav-link.contribute:hover {
    color: var(--color-gray-100);
  }
</style>
