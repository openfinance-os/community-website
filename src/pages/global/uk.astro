---
import PageLayout from '@layouts/PageLayout.astro';

const timeline = [
  { year: '2016', event: 'CMA Order mandates open banking for 9 largest banks' },
  { year: '2018', event: 'Open Banking Implementation Entity (OBIE) launches APIs' },
  { year: '2019', event: 'PSD2 Strong Customer Authentication requirements' },
  { year: '2020', event: 'Variable Recurring Payments (VRPs) introduced' },
  { year: '2022', event: 'OBIE transitions to Open Banking Limited' },
  { year: '2023', event: 'Smart Data scheme expands to other sectors' },
  { year: '2024', event: 'Commercial VRPs and premium APIs grow adoption' },
];

const lessons = [
  {
    title: 'Mandatory Standards Work',
    description:
      'The CMA mandate created a single API standard, avoiding the fragmentation seen in PSD2. All nine major banks had to implement the same specifications.',
    relevance: 'UAE follows this model with CBUAE mandating standards via Al Tareq.',
  },
  {
    title: 'Central Directory is Critical',
    description:
      'The Open Banking Directory provides a single source of truth for participant verification and certificate management.',
    relevance: 'Al Tareq serves as the UAE equivalent, ensuring trust between participants.',
  },
  {
    title: 'Adoption Takes Time',
    description:
      'Despite 2018 launch, meaningful consumer adoption only accelerated from 2021 onwards as use cases matured.',
    relevance: 'UAE should plan for a multi-year adoption curve with incremental growth.',
  },
  {
    title: 'Commercial Models Drive Scale',
    description:
      'Free APIs for basic services, premium APIs for enhanced features. VRPs unlocked subscription and sweeping use cases.',
    relevance: 'UAE ecosystem should develop sustainable commercial models early.',
  },
];

const stats = [
  { value: '7M+', label: 'Active users' },
  { value: '600+', label: 'Registered TPPs' },
  { value: '1B+', label: 'API calls/month' },
  { value: '£4B+', label: 'Payments processed' },
];
---

<PageLayout
  title="UK Open Banking"
  description="Learn from the world's most mature open banking ecosystem - history, lessons, and relevance to UAE."
>
  <div class="profile-page">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/global">Global</a>
        <span>/</span>
        <span>United Kingdom</span>
      </nav>

      <header class="page-intro page-header">
        <div class="header-flag">🇬🇧</div>
        <div class="header-text">
          <span class="region-label">The Pioneer</span>
          <h1>UK Open Banking</h1>
          <p class="subtitle">
            The world's first mandated open banking ecosystem, now serving over 7 million users and
            processing billions of API calls monthly.
          </p>
        </div>
      </header>

      <section class="stats-section">
        <div class="stats-grid">
          {stats.map((stat) => (
            <div class="stat-card">
              <span class="stat-value">{stat.value}</span>
              <span class="stat-label">{stat.label}</span>
            </div>
          ))}
        </div>
      </section>

      <section class="overview-section">
        <h2 class="section-title">Overview</h2>
        <div class="overview-content">
          <p>
            UK Open Banking began with the Competition and Markets Authority (CMA) Order in 2016,
            which mandated that the nine largest UK banks must develop and maintain a common API
            standard. The Open Banking Implementation Entity (OBIE) was created to develop and
            maintain these standards.
          </p>
          <p>
            Unlike the EU's PSD2 approach which set principles but allowed varied implementations,
            the UK created a single, detailed specification that all banks had to follow. This
            standardization has been credited with creating a more consistent and developer-friendly
            ecosystem.
          </p>
          <p>
            Today, UK Open Banking is expanding beyond the original CMA9 banks to include building
            societies, payment institutions, and other financial service providers. The ecosystem
            continues to evolve with new use cases like Variable Recurring Payments (VRPs) and
            premium APIs.
          </p>
        </div>
      </section>

      <section class="timeline-section">
        <h2 class="section-title">Timeline</h2>
        <div class="timeline">
          {timeline.map((item, index) => (
            <div class="timeline-item">
              <span class="timeline-year">{item.year}</span>
              <span class="timeline-event">{item.event}</span>
            </div>
          ))}
        </div>
      </section>

      <section class="lessons-section">
        <h2 class="section-title">Lessons for UAE</h2>
        <div class="lessons-grid">
          {lessons.map((lesson) => (
            <div class="lesson-card">
              <h3>{lesson.title}</h3>
              <p class="lesson-description">{lesson.description}</p>
              <div class="lesson-relevance">
                <span class="relevance-label">UAE Relevance</span>
                <p>{lesson.relevance}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section class="resources-section">
        <h2 class="section-title">Official Resources</h2>
        <div class="resources-grid">
          <a
            href="https://www.openbanking.org.uk/"
            class="resource-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="resource-icon">🏛️</span>
            <div>
              <strong>Open Banking Limited</strong>
              <span>Official UK Open Banking website</span>
            </div>
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M7 17L17 7M17 7H7M17 7v10"></path>
            </svg>
          </a>
          <a
            href="https://standards.openbanking.org.uk/"
            class="resource-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="resource-icon">📋</span>
            <div>
              <strong>API Specifications</strong>
              <span>Technical standards documentation</span>
            </div>
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M7 17L17 7M17 7H7M17 7v10"></path>
            </svg>
          </a>
          <a
            href="https://www.openbanking.org.uk/insights/"
            class="resource-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="resource-icon">📊</span>
            <div>
              <strong>Monthly Statistics</strong>
              <span>Ecosystem performance data</span>
            </div>
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M7 17L17 7M17 7H7M17 7v10"></path>
            </svg>
          </a>
        </div>
      </section>

      <nav class="page-nav">
        <a href="/global" class="nav-link prev">
          <span class="nav-direction">← Back</span>
          <span class="nav-page">Global Overview</span>
        </a>
        <a href="/global/eu" class="nav-link next">
          <span class="nav-direction">Next →</span>
          <span class="nav-page">European Union</span>
        </a>
      </nav>
    </div>
  </div>
</PageLayout>

<style>
  .profile-page {
    padding: var(--space-8) var(--space-4) var(--space-16);
  }

  .container {
    max-width: 800px;
    margin: 0 auto;
  }

  .breadcrumb {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-6);
  }

  .breadcrumb a {
    color: var(--color-brand-ink);
  }

  .page-header {
    min-width: 0;
    display: flex;
    align-items: flex-start;
    gap: var(--space-5);
    margin-bottom: var(--space-10);
  }

  .header-flag {
    font-size: 3rem;
    line-height: 1;
  }

  .region-label {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-brand-ink);
    margin-bottom: var(--space-2);
  }

  .page-header h1 {
    font-size: clamp(2rem, 4vw, 3.5rem);
    margin-bottom: var(--space-3);
  }

  .subtitle {
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  /* Stats Section */
  .stats-section {
    margin-bottom: var(--space-12);
  }

  .stats-grid {
    min-width: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .stats-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .stat-card {
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--space-5);
    background: var(--color-primary-50);
    border-radius: var(--radius-xl);
    text-align: center;
  }

  .stat-value {
    font-family: var(--font-mono);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-brand-ink);
  }

  .stat-label {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    margin-top: var(--space-1);
  }

  /* Section Styles */
  .section-title {
    font-size: 1rem;
    font-family: var(--font-sans);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }

  /* Overview */
  .overview-section {
    margin-bottom: var(--space-12);
  }

  .overview-content p {
    color: var(--color-text);
    line-height: 1.8;
    margin-bottom: var(--space-4);
  }

  .overview-content p:last-child {
    margin-bottom: 0;
  }

  /* Timeline */
  .timeline-section {
    margin-bottom: var(--space-12);
  }

  .timeline {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .timeline-item {
    min-width: 0;
    display: flex;
    gap: var(--space-4);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .timeline-item:last-child {
    border-bottom: none;
  }

  .timeline-year {
    flex-shrink: 0;
    width: 60px;
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--color-brand-ink);
  }

  .timeline-event {
    color: var(--color-text);
  }

  /* Lessons */
  .lessons-section {
    margin-bottom: var(--space-12);
  }

  .lessons-grid {
    min-width: 0;
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .lessons-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .lesson-card {
    padding: var(--space-5);
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
  }

  .lesson-card h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--space-2);
  }

  .lesson-description {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-4);
  }

  .lesson-relevance {
    padding: var(--space-3);
    background: var(--color-primary-50);
    border-radius: var(--radius-md);
  }

  .relevance-label {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-brand-ink);
    margin-bottom: var(--space-1);
  }

  .lesson-relevance p {
    font-size: 0.8125rem;
    color: var(--color-brand-ink);
    margin: 0;
    line-height: 1.5;
  }

  /* Resources */
  .resources-section {
    margin-bottom: var(--space-12);
  }

  .resources-grid {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .resource-link {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4);
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition:
      border-color var(--transition-fast),
      background-color var(--transition-fast);
  }

  .resource-link:hover {
    border-color: var(--color-primary-300);
    background: var(--color-surface);
    text-decoration: none;
  }

  .resource-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
  }

  .resource-link div {
    flex: 1;
  }

  .resource-link strong {
    display: block;
    font-size: 0.9375rem;
    color: var(--color-text);
  }

  .resource-link span {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
  }

  .resource-link svg {
    flex-shrink: 0;
    color: var(--color-text-secondary);
  }

  /* Page Navigation */
  .page-nav {
    min-width: 0;
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .nav-link {
    min-width: 0;
    display: flex;
    flex-direction: column;
    padding: var(--space-4);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .nav-link:hover {
    text-decoration: none;
  }

  .nav-link.next {
    text-align: right;
    margin-left: auto;
  }

  .nav-direction {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
  }

  .nav-page {
    font-weight: 500;
    color: var(--color-brand-ink);
  }

  .nav-link:hover .nav-page {
    color: var(--color-brand-ink);
  }

  /* Dark mode */
  :global([data-theme='dark']) .stat-card {
    background: var(--color-primary-100);
  }

  :global([data-theme='dark']) .lesson-card {
    background: var(--color-soft);
    border-color: var(--color-border);
  }

  :global([data-theme='dark']) .lesson-relevance {
    background: var(--color-primary-100);
  }

  :global([data-theme='dark']) .resource-link {
    background: var(--color-soft);
    border-color: var(--color-border);
  }

  :global([data-theme='dark']) .resource-link:hover {
    background: var(--color-soft);
  }
</style>
