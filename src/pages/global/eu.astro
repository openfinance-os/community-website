---
import PageLayout from '@layouts/PageLayout.astro';

const timeline = [
  { year: '2015', event: 'EU adopts the revised Payment Services Directive (PSD2)' },
  { year: 'January 2018', event: 'PSD2 becomes applicable' },
  { year: 'September 2019', event: 'PSD2 strong customer authentication requirements apply' },
  {
    year: 'June 2023',
    event: 'Commission proposes PSD3/PSR payments reform and the separate FiDA framework',
  },
  { year: 'November 2025', event: 'Commission records political agreement on the PSD2 review' },
];

const lessons = [
  {
    title: 'Check the implementation evidence',
    description:
      'A regulatory framework and an interface specification answer different questions from a working customer journey.',
    relevance:
      'For the UAE proposition, identify the relevant standard, then test coverage, version handling and failure cases with partners.',
  },
  {
    title: 'Define the fallback experience',
    description:
      'A missing field, delayed update or failed connection should lead to an understandable, supported next step.',
    relevance:
      'Agree refresh expectations, missing-data behaviour and support ownership for the UAE customer journey.',
  },
  {
    title: 'Test customer understanding',
    description:
      'Technical completion does not tell a team whether a customer understands the permission or benefit.',
    relevance:
      'Test the purpose, data scope, recipient and withdrawal explanation with the intended users.',
  },
  {
    title: 'Keep the legislative tracks separate',
    description:
      'Payment-services reform and broader financial-data access should be followed through their own sources and requirements.',
    relevance:
      'Map the UAE proposition to its specific activities and requirements rather than treating open finance as one undifferentiated service.',
  },
];

const keyDifferences = [
  {
    aspect: 'Starting scope',
    psd2: 'PSD2 payment services, including account information and payment initiation',
    uae: 'CBUAE framework for data sharing and service initiation',
  },
  {
    aspect: 'Technical reference',
    psd2: 'Read legislation, technical rules and the chosen interface specification separately',
    uae: 'Check official technical documentation, the relevant role and version',
  },
  {
    aspect: 'Register purpose',
    psd2: 'EBA central PSD2 register reproduces institution information supplied by national authorities',
    uae: 'Trust Framework participant directory supports participant identity and access',
  },
  {
    aspect: 'Evidence boundary',
    psd2: 'Read the register scope and consult the relevant national authority',
    uae: 'Registration metadata does not establish certification, go-live approval or traffic',
  },
];
---

<PageLayout
  title="European Union: Payments and Financial-data Access"
  description="A sourced introduction to PSD2, PSD3/PSR payments reform and the separate FiDA financial-data access proposal, with practical questions for UAE teams."
>
  <div class="profile-page">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/global">Global</a>
        <span>/</span>
        <span>European Union</span>
      </nav>

      <header class="page-intro page-header">
        <div class="header-flag">🇪🇺</div>
        <div class="header-text">
          <span class="region-label">Payments and financial-data access</span>
          <h1>European Union</h1>
          <p class="subtitle">
            Understand the EU's payment-services framework and the separate proposal for wider
            financial-data access. Use the distinction to ask better questions about a UAE
            proposition.
          </p>
        </div>
      </header>

      <section class="overview-section">
        <h2 class="section-title">Overview</h2>
        <div class="overview-content">
          <p>
            The revised Payment Services Directive (PSD2) is part of the EU payment-services
            framework. It became applicable in January 2018. The{' '}
            <a href="https://finance.ec.europa.eu/consumer-finance-and-payments/payment-services/payment-services_en">
              European Commission's payment-services reference
            </a>{' '}
            links the legislation, technical rules and reform timeline.
          </p>
          <p>
            Keep two reform tracks separate. PSD3 and the Payment Services Regulation (PSR) concern
            payments. The Commission's timeline records political agreement on the PSD2 review on
            <strong>27 November 2025</strong>. That milestone is not a claim that every reform
            requirement is already applicable; check the final legislation and application dates
            before relying on it.
          </p>
          <p>
            The separate{' '}
            <a href="https://finance.ec.europa.eu/digital-finance/framework-financial-data-access_en">
              Financial Data Access (FiDA) proposal
            </a>{' '}
            addresses access to financial data beyond payment accounts. The Commission's reference
            describes proposed rights, obligations and customer-control tools. Read its legislative
            scope and progress separately from the payments reform.
          </p>
        </div>
      </section>

      <section class="comparison-section">
        <h2 class="section-title">EU and UAE: reference points</h2>
        <p class="section-intro">
          This is a scoped reading guide, not a comparison of adoption or implementation quality.
          The frameworks and their registers serve different purposes.
        </p>
        <div class="comparison-table-wrapper">
          <table class="comparison-table">
            <thead>
              <tr>
                <th>Aspect</th>
                <th>EU (PSD2)</th>
                <th>UAE</th>
              </tr>
            </thead>
            <tbody>
              {keyDifferences.map((row) => (
                <tr>
                  <td class="aspect-cell">{row.aspect}</td>
                  <td>{row.psd2}</td>
                  <td class="uae-cell">{row.uae}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="source-note">
          Sources:{' '}
          <a href="https://www.eba.europa.eu/risk-and-data-analysis/data/registers/payment-institutions-register">
            EBA central PSD2 register
          </a>
          ,
          <a href="https://rulebook.centralbank.ae/en/rulebook/open-finance-framework-0">
            CBUAE Framework (C 03/2025)
          </a>
          , and
          <a href="https://openfinanceuae.atlassian.net/wiki/spaces/OF/overview">
            official UAE technical documentation
          </a>
          . The EBA register is distinct from a Trust Framework directory and does not itself confer
          legal rights; authorisation remains with national competent authorities. For UAE
          observation limits, see the <a href="/observatory/methodology">Observatory methodology</a>
          .
        </p>
      </section>

      <section class="timeline-section">
        <h2 class="section-title">Selected policy milestones</h2>
        <div class="timeline">
          {timeline.map((item) => (
            <div class="timeline-item">
              <span class="timeline-year">{item.year}</span>
              <span class="timeline-event">{item.event}</span>
            </div>
          ))}
        </div>
        <p class="source-note">
          Sources: the Commission's{' '}
          <a href="https://finance.ec.europa.eu/consumer-finance-and-payments/payment-services/payment-services_en">
            payment-services timeline
          </a>
          and{' '}
          <a href="https://finance.ec.europa.eu/digital-finance/framework-financial-data-access_en">
            FiDA reference
          </a>
          . Political agreement, formal adoption and entry into application are different stages.
          This selection does not predict an implementation date.
        </p>
      </section>

      <section class="lessons-section">
        <h2 class="section-title">Questions for UAE teams</h2>
        <p class="section-intro">
          OpenFinance-OS interpretation: practical questions to validate locally, rather than
          findings that a regulatory model guarantees a particular outcome.
        </p>
        <div class="lessons-grid">
          {lessons.map((lesson) => (
            <div class="lesson-card">
              <h3>{lesson.title}</h3>
              <p class="lesson-description">{lesson.description}</p>
              <div class="lesson-relevance">
                <span class="relevance-label">UAE Relevance</span>
                <p>{lesson.relevance}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section class="future-section">
        <h2 class="section-title">Two tracks to follow</h2>
        <p class="section-intro">
          The Commission's{' '}
          <a href="https://finance.ec.europa.eu/publications/financial-data-access-and-payments-package_en">
            June 2023 package
          </a>
          sets out the separate payments and financial-data access proposals. Use the linked policy
          references to follow subsequent legislative steps.
        </p>
        <div class="future-content">
          <div class="future-card">
            <h3>PSD3</h3>
            <p>
              The proposed directive is part of the payments reform. Follow its final text and
              transposition requirements through the Commission's payment-services reference.
            </p>
          </div>
          <div class="future-card">
            <h3>Payment Services Regulation (PSR)</h3>
            <p>
              The regulation track accompanies PSD3. Check the published legal text and application
              provisions rather than assuming the political agreement means implementation is
              complete.
            </p>
          </div>
          <div class="future-card">
            <h3>Financial Data Access (FiDA)</h3>
            <p>
              A separate proposal for customer-data access beyond payment accounts, including
              customer control and data-sharing obligations. Its scope and legislative progress need
              their own source review.
            </p>
          </div>
        </div>
      </section>

      <section class="resources-section">
        <h2 class="section-title">Sources and resources</h2>
        <div class="resources-grid">
          <a
            href="https://www.berlin-group.org/"
            class="resource-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="resource-icon">🏛️</span>
            <div>
              <strong>Berlin Group</strong>
              <span>Industry standards reference: NextGenPSD2</span>
            </div>
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M7 17L17 7M17 7H7M17 7v10"></path>
            </svg>
          </a>
          <a
            href="https://www.eba.europa.eu/risk-and-data-analysis/data/registers/payment-institutions-register"
            class="resource-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="resource-icon">📋</span>
            <div>
              <strong>EBA central PSD2 register</strong>
              <span>Official register and scope explanation</span>
            </div>
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M7 17L17 7M17 7H7M17 7v10"></path>
            </svg>
          </a>
          <a
            href="https://finance.ec.europa.eu/consumer-finance-and-payments/payment-services/payment-services_en"
            class="resource-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="resource-icon">📊</span>
            <div>
              <strong>EU payment services</strong>
              <span>Official legislation and PSD3/PSR reform timeline</span>
            </div>
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M7 17L17 7M17 7H7M17 7v10"></path>
            </svg>
          </a>
          <a
            href="https://finance.ec.europa.eu/digital-finance/framework-financial-data-access_en"
            class="resource-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="resource-icon">📋</span>
            <div>
              <strong>Financial Data Access (FiDA)</strong>
              <span>Official proposal reference beyond payment accounts</span>
            </div>
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M7 17L17 7M17 7H7M17 7v10"></path>
            </svg>
          </a>
        </div>
      </section>

      <nav class="page-nav">
        <a href="/global/uk" class="nav-link prev">
          <span class="nav-direction">← Previous</span>
          <span class="nav-page">United Kingdom</span>
        </a>
        <a href="/global/gcc" class="nav-link next">
          <span class="nav-direction">Next →</span>
          <span class="nav-page">GCC Region</span>
        </a>
      </nav>
    </div>
  </div>
</PageLayout>

<style>
  .profile-page {
    padding: var(--space-8) var(--space-4) var(--space-16);
  }

  .container {
    max-width: 800px;
    margin: 0 auto;
  }

  .breadcrumb {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-6);
  }

  .breadcrumb a {
    color: var(--color-brand-ink);
  }

  .page-header {
    min-width: 0;
    display: flex;
    align-items: flex-start;
    gap: var(--space-5);
    margin-bottom: var(--space-10);
  }

  .header-flag {
    font-size: 3rem;
    line-height: 1;
  }

  .region-label {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-brand-ink);
    margin-bottom: var(--space-2);
  }

  .page-header h1 {
    font-size: clamp(2rem, 4vw, 3.5rem);
    margin-bottom: var(--space-3);
  }

  .subtitle {
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  /* Section Styles */
  .section-title {
    font-size: 1rem;
    font-family: var(--font-sans);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }

  /* Overview */
  .overview-section {
    margin-bottom: var(--space-12);
  }

  .overview-content p {
    color: var(--color-text);
    line-height: 1.8;
    margin-bottom: var(--space-4);
  }

  .overview-content p:last-child {
    margin-bottom: 0;
  }

  .section-intro,
  .source-note {
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-bottom: var(--space-5);
  }

  .source-note {
    font-size: 0.875rem;
    margin-top: var(--space-4);
    overflow-wrap: anywhere;
  }

  /* Comparison Table */
  .comparison-section {
    margin-bottom: var(--space-12);
  }

  .comparison-table-wrapper {
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-card);
  }

  .comparison-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  .comparison-table th {
    text-align: left;
    padding: var(--space-4);
    background: var(--color-surface);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-secondary);
    border-bottom: 1px solid var(--color-border);
  }

  .comparison-table td {
    padding: var(--space-4);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text);
    vertical-align: top;
  }

  .comparison-table tbody tr:last-child td {
    border-bottom: none;
  }

  .aspect-cell {
    font-weight: 500;
    color: var(--color-text);
  }

  .uae-cell {
    color: var(--color-brand-ink);
  }

  /* Timeline */
  .timeline-section {
    margin-bottom: var(--space-12);
  }

  .timeline {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .timeline-item {
    min-width: 0;
    display: flex;
    gap: var(--space-4);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .timeline-item:last-child {
    border-bottom: none;
  }

  .timeline-year {
    flex-shrink: 0;
    width: 60px;
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--color-brand-ink);
  }

  .timeline-event {
    color: var(--color-text);
  }

  /* Lessons */
  .lessons-section {
    margin-bottom: var(--space-12);
  }

  .lessons-grid {
    min-width: 0;
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .lessons-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .lesson-card {
    padding: var(--space-5);
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
  }

  .lesson-card h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--space-2);
  }

  .lesson-description {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-4);
  }

  .lesson-relevance {
    padding: var(--space-3);
    background: var(--color-primary-50);
    border-radius: var(--radius-md);
  }

  .relevance-label {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-brand-ink);
    margin-bottom: var(--space-1);
  }

  .lesson-relevance p {
    font-size: 0.8125rem;
    color: var(--color-brand-ink);
    margin: 0;
    line-height: 1.5;
  }

  /* Future Section */
  .future-section {
    margin-bottom: var(--space-12);
  }

  .future-content {
    min-width: 0;
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .future-content {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .future-card {
    padding: var(--space-5);
    background: var(--color-surface);
    border-radius: var(--radius-xl);
  }

  .future-card h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-brand-ink);
    margin-bottom: var(--space-2);
  }

  .future-card p {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  /* Resources */
  .resources-section {
    margin-bottom: var(--space-12);
  }

  .resources-grid {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .resource-link {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4);
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition:
      border-color var(--transition-fast),
      background-color var(--transition-fast);
  }

  .resource-link:hover {
    border-color: var(--color-primary-300);
    background: var(--color-surface);
    text-decoration: none;
  }

  .resource-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
  }

  .resource-link div {
    flex: 1;
  }

  .resource-link strong {
    display: block;
    font-size: 0.9375rem;
    color: var(--color-text);
  }

  .resource-link span {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
  }

  .resource-link svg {
    flex-shrink: 0;
    color: var(--color-text-secondary);
  }

  /* Page Navigation */
  .page-nav {
    min-width: 0;
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .nav-link {
    min-width: 0;
    display: flex;
    flex-direction: column;
    padding: var(--space-4);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .nav-link:hover {
    text-decoration: none;
  }

  .nav-link.next {
    text-align: right;
    margin-left: auto;
  }

  .nav-direction {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
  }

  .nav-page {
    font-weight: 500;
    color: var(--color-brand-ink);
  }

  .nav-link:hover .nav-page {
    color: var(--color-brand-ink);
  }

  /* Dark mode */
  :global([data-theme='dark']) .comparison-table-wrapper {
    background: var(--color-soft);
    border-color: var(--color-border);
  }

  :global([data-theme='dark']) .comparison-table th {
    background: var(--color-soft);
    border-color: var(--color-border);
  }

  :global([data-theme='dark']) .comparison-table td {
    border-color: var(--color-border);
  }

  :global([data-theme='dark']) .lesson-card {
    background: var(--color-soft);
    border-color: var(--color-border);
  }

  :global([data-theme='dark']) .lesson-relevance {
    background: var(--color-primary-100);
  }

  :global([data-theme='dark']) .future-card {
    background: var(--color-soft);
  }

  :global([data-theme='dark']) .resource-link {
    background: var(--color-soft);
    border-color: var(--color-border);
  }

  :global([data-theme='dark']) .resource-link:hover {
    background: var(--color-soft);
  }
</style>
