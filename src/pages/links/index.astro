---
import PageLayout from '@layouts/PageLayout.astro';

interface Link {
  title: string;
  description: string;
  url: string;
  type: 'official' | 'developer' | 'reference';
}

const officialLinks: Link[] = [
  {
    title: 'Al Tareq Portal',
    description: 'The official UAE Open Finance platform operated by Nebras for participant onboarding and management',
    url: 'https://altareq.openfinance.ae',
    type: 'official',
  },
  {
    title: 'CBUAE Open Finance',
    description: 'Central Bank of UAE regulatory framework, guidelines, and policy documents for Open Finance',
    url: 'https://www.centralbank.ae',
    type: 'official',
  },
  {
    title: 'Trust Framework Directory',
    description: 'Browse and verify registered TPPs, ASPSPs, and other ecosystem participants',
    url: 'https://data.directory.openfinance.ae',
    type: 'official',
  },
];

const developerLinks: Link[] = [
  {
    title: 'API Documentation',
    description: 'Technical documentation, API specifications, and integration guides for Open Finance APIs',
    url: 'https://openfinanceuae.atlassian.net/wiki/spaces/tfdocsv7/pages/362840092',
    type: 'developer',
  },
  {
    title: 'OpenFinance Hackathon',
    description: 'Community hackathon for building innovative solutions on UAE Open Finance APIs',
    url: 'https://openfinance-hackathon.com',
    type: 'developer',
  },
  {
    title: 'Hackathon Documentation',
    description: 'Technical guides, API references, starter templates, and code examples',
    url: 'https://docs.openfinance-hackathon.com',
    type: 'developer',
  },
];

const internationalLinks: Link[] = [
  {
    title: 'UK Open Banking',
    description: 'Standards, APIs, and implementation guides from the UK Open Banking Implementation Entity',
    url: 'https://www.openbanking.org.uk',
    type: 'reference',
  },
  {
    title: 'Open Finance Brazil',
    description: 'Brazilian Open Finance ecosystem with comprehensive banking and finance data sharing',
    url: 'https://openfinancebrasil.org.br',
    type: 'reference',
  },
  {
    title: 'Open Conversations',
    description: 'Global news, analysis, and insights about open finance developments worldwide',
    url: 'https://www.open-conversations.org',
    type: 'reference',
  },
  {
    title: 'Australia CDR',
    description: 'Consumer Data Right framework enabling secure data sharing across banking and energy sectors',
    url: 'https://www.cdr.gov.au',
    type: 'reference',
  },
  {
    title: 'India Account Aggregator',
    description: 'Financial data sharing ecosystem enabling consent-based data access across institutions',
    url: 'https://sahamati.org.in',
    type: 'reference',
  },
  {
    title: 'Open Banking Europe',
    description: 'PSD2 implementation resources and European open banking standards and best practices',
    url: 'https://www.openbankingeurope.eu',
    type: 'reference',
  },
];

const sections = [
  { id: 'uae-official', label: 'UAE Official', links: officialLinks },
  { id: 'developer', label: 'Developer', links: developerLinks },
  { id: 'international', label: 'International', links: internationalLinks },
];

const typeLabels: Record<string, string> = {
  official: 'Official',
  developer: 'Developer',
  reference: 'Reference',
};

const typeColors: Record<string, string> = {
  official: 'type-blue',
  developer: 'type-green',
  reference: 'type-amber',
};
---

<PageLayout title="Links" description="Official resources and links for UAE Open Finance.">
  <div class="links-page">
    <div class="container">
      <header class="page-header">
        <h1>Official Resources</h1>
        <p>
          Curated links to official documentation, regulatory resources, and international
          references.
        </p>
      </header>

      <nav class="quick-nav" aria-label="Jump to section">
        {sections.map((section) => (
          <a href={`#${section.id}`} class="nav-pill">
            {section.label}
          </a>
        ))}
      </nav>

      {sections.map((section) => (
        <section class="link-section" id={section.id}>
          <h2>{section.label}</h2>
          <div class="link-grid">
            {section.links.map((link) => (
              <a href={link.url} class="link-card" target="_blank" rel="noopener noreferrer">
                <div class="card-header">
                  <h3>{link.title}</h3>
                  <span class:list={['type-badge', typeColors[link.type]]}>
                    {typeLabels[link.type]}
                  </span>
                </div>
                <p>{link.description}</p>
                <span class="link-url">{new URL(link.url).hostname} →</span>
              </a>
            ))}
          </div>
        </section>
      ))}

      <footer class="page-footer">
        <p>
          See an outdated link? <a
            href="https://github.com/openfinance-os/community/issues"
            target="_blank"
            rel="noopener noreferrer">Open an issue on GitHub</a
          >
        </p>
      </footer>
    </div>
  </div>
</PageLayout>

<style>
  .links-page {
    padding: var(--space-12) var(--space-4);
  }

  .container {
    max-width: 900px;
    margin: 0 auto;
  }

  .page-header {
    margin-bottom: var(--space-8);
  }

  .page-header h1 {
    font-size: 2.25rem;
    margin-bottom: var(--space-3);
  }

  .page-header p {
    color: var(--color-gray-600);
    font-size: 1.125rem;
  }

  /* Quick Navigation */
  .quick-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-10);
  }

  .nav-pill {
    padding: var(--space-2) var(--space-4);
    background: transparent;
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-full);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-gray-600);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .nav-pill:hover {
    border-color: var(--color-primary-300);
    color: var(--color-primary-600);
    text-decoration: none;
  }

  /* Link Sections */
  .link-section {
    margin-bottom: var(--space-10);
    scroll-margin-top: var(--space-8);
  }

  .link-section h2 {
    font-size: 1rem;
    font-family: var(--font-mono);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-gray-500);
    margin-bottom: var(--space-4);
    padding-left: var(--space-3);
    border-left: 3px solid var(--color-primary-500);
  }

  .link-grid {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .link-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Link Cards */
  .link-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-5) var(--space-6);
    background: white;
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast),
      transform var(--transition-fast);
  }

  .link-card:hover {
    border-color: var(--color-primary-300);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
    text-decoration: none;
  }

  .card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .link-card h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-gray-900);
    line-height: 1.4;
  }

  .link-card:hover h3 {
    color: var(--color-primary-700);
  }

  .type-badge {
    flex-shrink: 0;
    padding: var(--space-1) var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    border-radius: var(--radius-full);
  }

  .type-blue {
    background: var(--color-primary-50);
    color: var(--color-primary-700);
  }

  .type-green {
    background: #dcfce7;
    color: #166534;
  }

  .type-amber {
    background: #fef3c7;
    color: #92400e;
  }

  .link-card p {
    color: var(--color-gray-600);
    font-size: 0.875rem;
    line-height: 1.5;
    margin-bottom: var(--space-3);
    flex-grow: 1;
  }

  .link-url {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-primary-600);
    transition: text-decoration var(--transition-fast);
  }

  .link-card:hover .link-url {
    text-decoration: underline;
  }

  /* Footer */
  .page-footer {
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-gray-200);
    text-align: center;
  }

  .page-footer p {
    font-size: 0.875rem;
    color: var(--color-gray-500);
  }

  .page-footer a {
    color: var(--color-primary-600);
  }

  /* Dark mode */
  :global([data-theme='dark']) .link-card {
    background: var(--color-gray-100);
    border-color: var(--color-gray-200);
  }

  :global([data-theme='dark']) .link-card:hover {
    border-color: var(--color-gray-300);
  }

  :global([data-theme='dark']) .link-card h3 {
    color: var(--color-gray-50);
  }

  :global([data-theme='dark']) .link-card:hover h3 {
    color: var(--color-primary-400);
  }

  :global([data-theme='dark']) .link-card p {
    color: var(--color-gray-400);
  }

  :global([data-theme='dark']) .nav-pill {
    border-color: var(--color-gray-300);
    color: var(--color-gray-400);
  }

  :global([data-theme='dark']) .nav-pill:hover {
    border-color: var(--color-primary-400);
    color: var(--color-primary-400);
  }
</style>
