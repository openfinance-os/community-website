---
import PageLayout from '@layouts/PageLayout.astro';

const officialLinks = [
  {
    title: 'Al Tareq Portal',
    description: 'The official UAE Open Finance platform operated by Nebras',
    url: 'https://altareq.openfinance.ae',
  },
  {
    title: 'CBUAE Open Finance',
    description: 'Central Bank of UAE Open Finance regulatory framework',
    url: 'https://www.centralbank.ae',
  },
  {
    title: 'Trust Framework Directory',
    description: 'Public registry of registered participants',
    url: 'https://data.directory.openfinance.ae',
  },
];

const developerLinks = [
  {
    title: 'API Documentation',
    description: 'Technical documentation for Open Finance APIs',
    url: 'https://openfinanceuae.atlassian.net/wiki/spaces/tfdocsv7/pages/362840092',
  },
];

const internationalLinks = [
  {
    title: 'UK Open Banking',
    description: 'Open Banking Implementation Entity (OBIE)',
    url: 'https://www.openbanking.org.uk',
  },
  {
    title: 'Open Finance Brazil',
    description: 'Brazilian Open Finance ecosystem',
    url: 'https://openfinancebrasil.org.br',
  },
];
---

<PageLayout title="Links" description="Official resources and links for UAE Open Finance.">
  <div class="links-page">
    <div class="container">
      <header class="page-header">
        <h1>Official Resources</h1>
        <p>Curated links to official documentation, regulatory resources, and international references.</p>
      </header>

      <section class="link-section">
        <h2>UAE Official</h2>
        <div class="link-grid">
          {officialLinks.map((link) => (
            <a href={link.url} class="link-card" target="_blank" rel="noopener noreferrer">
              <h3>{link.title}</h3>
              <p>{link.description}</p>
              <span class="link-url">{new URL(link.url).hostname} →</span>
            </a>
          ))}
        </div>
      </section>

      <section class="link-section">
        <h2>Developer Resources</h2>
        <div class="link-grid">
          {developerLinks.map((link) => (
            <a href={link.url} class="link-card" target="_blank" rel="noopener noreferrer">
              <h3>{link.title}</h3>
              <p>{link.description}</p>
              <span class="link-url">{new URL(link.url).hostname} →</span>
            </a>
          ))}
        </div>
      </section>

      <section class="link-section">
        <h2>International References</h2>
        <div class="link-grid">
          {internationalLinks.map((link) => (
            <a href={link.url} class="link-card" target="_blank" rel="noopener noreferrer">
              <h3>{link.title}</h3>
              <p>{link.description}</p>
              <span class="link-url">{new URL(link.url).hostname} →</span>
            </a>
          ))}
        </div>
      </section>

      <footer class="page-footer">
        <p>See an outdated link? <a href="https://github.com/openfinance-os/community/issues" target="_blank" rel="noopener noreferrer">Open an issue on GitHub</a></p>
      </footer>
    </div>
  </div>
</PageLayout>

<style>
  .links-page {
    padding: var(--space-12) var(--space-4);
  }

  .container {
    max-width: 900px;
    margin: 0 auto;
  }

  .page-header {
    margin-bottom: var(--space-12);
  }

  .page-header h1 {
    font-size: 2.25rem;
    margin-bottom: var(--space-3);
  }

  .page-header p {
    color: var(--color-gray-600);
    font-size: 1.125rem;
  }

  .link-section {
    margin-bottom: var(--space-10);
  }

  .link-section h2 {
    font-size: 1rem;
    font-family: var(--font-mono);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-gray-500);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-gray-200);
  }

  .link-grid {
    display: grid;
    gap: var(--space-4);
  }

  .link-card {
    display: block;
    padding: var(--space-6) var(--space-8);
    background: white;
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-xl);
    text-decoration: none;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast), transform var(--transition-fast);
  }

  .link-card:hover {
    border-color: var(--color-primary-300);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
    text-decoration: none;
  }

  .link-card h3 {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-gray-900);
    margin-bottom: var(--space-1);
  }

  .link-card:hover h3 {
    color: var(--color-primary-700);
  }

  .link-card p {
    color: var(--color-gray-600);
    font-size: 0.9375rem;
    margin-bottom: var(--space-2);
  }

  .link-url {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-primary-600);
  }

  .page-footer {
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-gray-200);
    text-align: center;
  }

  .page-footer p {
    font-size: 0.875rem;
    color: var(--color-gray-500);
  }

  .page-footer a {
    color: var(--color-primary-600);
  }
</style>
