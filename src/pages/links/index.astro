---
import PageLayout from '@layouts/PageLayout.astro';

interface Link {
  title: string;
  description: string;
  url: string;
  type: 'official' | 'developer' | 'reference';
}

const officialLinks: Link[] = [
  {
    title: 'CBUAE Open Finance Rulebook',
    description:
      'Central Bank of UAE regulatory framework, guidelines, and policy documents for Open Finance',
    url: 'https://rulebook.centralbank.ae/en/rulebook/open-finance-regulation-0',
    type: 'official',
  },
  {
    title: 'Open Finance Portal',
    description:
      'Official documentation, technical specifications, and implementation guides for UAE Open Finance',
    url: 'https://openfinanceuae.atlassian.net/wiki/spaces/OF/overview',
    type: 'official',
  },
  {
    title: 'Nebras Operating Entity',
    description:
      'The official UAE Open Finance scheme operator responsible for ecosystem governance and participant management',
    url: '#',
    type: 'official',
  },
];

const developerLinks: Link[] = [
  {
    title: 'API Documentation',
    description:
      'Technical documentation, API specifications, and integration guides for Open Finance APIs',
    url: 'https://openfinanceuae.atlassian.net/wiki/spaces/tfdocsv7/pages/362840092',
    type: 'developer',
  },
  {
    title: 'OpenFinance Hackathon',
    description: 'Community hackathon for building innovative solutions on UAE Open Finance APIs',
    url: 'https://openfinance-hackathon.com',
    type: 'developer',
  },
  {
    title: 'Hackathon Documentation',
    description: 'Technical guides, API references, starter templates, and code examples',
    url: 'https://docs.openfinance-hackathon.com',
    type: 'developer',
  },
];

const internationalLinks: Link[] = [
  {
    title: 'UK Open Banking',
    description:
      'Standards, APIs, and implementation guides from the UK Open Banking Implementation Entity',
    url: 'https://www.openbanking.org.uk',
    type: 'reference',
  },
  {
    title: 'Open Finance Brazil',
    description:
      'Brazilian Open Finance ecosystem with comprehensive banking and finance data sharing',
    url: 'https://openfinancebrasil.org.br',
    type: 'reference',
  },
  {
    title: 'Open Conversations',
    description: 'Global news, analysis, and insights about open finance developments worldwide',
    url: 'https://www.open-conversations.org',
    type: 'reference',
  },
  {
    title: 'Australia CDR',
    description:
      'Consumer Data Right framework enabling secure data sharing across banking and energy sectors',
    url: 'https://www.cdr.gov.au',
    type: 'reference',
  },
  {
    title: 'India Account Aggregator',
    description:
      'Financial data sharing ecosystem enabling consent-based data access across institutions',
    url: 'https://sahamati.org.in',
    type: 'reference',
  },
  {
    title: 'Open Banking Europe',
    description:
      'PSD2 implementation resources and European open banking standards and best practices',
    url: 'https://www.openbankingeurope.eu',
    type: 'reference',
  },
];

const sections = [
  { id: 'uae-official', label: 'UAE Official', links: officialLinks },
  { id: 'developer', label: 'Developer', links: developerLinks },
  { id: 'international', label: 'International', links: internationalLinks },
];

const typeLabels: Record<string, string> = {
  official: 'Official',
  developer: 'Developer',
  reference: 'Reference',
};

const typeColors: Record<string, string> = {
  official: 'type-blue',
  developer: 'type-green',
  reference: 'type-amber',
};
---

<PageLayout title="Links" description="Official resources and links for UAE Open Finance.">
  <div class="links-page">
    <div class="container">
      <header class="page-header">
        <h1>Official Resources</h1>
        <p>
          Curated links to official documentation, regulatory resources, and international
          references.
        </p>
      </header>

      <nav class="quick-nav" aria-label="Jump to section">
        {
          sections.map((section) => (
            <a href={`#${section.id}`} class="nav-pill">
              {section.label}
            </a>
          ))
        }
      </nav>

      {
        sections.map((section) => (
          <section class="link-section" id={section.id}>
            <h2>{section.label}</h2>
            <div class="link-grid">
              {section.links.map((link) => (
                <a
                  href={link.url === '#' ? undefined : link.url}
                  class:list={['link-card', { placeholder: link.url === '#' }]}
                  target={link.url === '#' ? undefined : '_blank'}
                  rel={link.url === '#' ? undefined : 'noopener noreferrer'}
                >
                  <div class="card-header">
                    <h3>{link.title}</h3>
                    <span class:list={['type-badge', typeColors[link.type]]}>
                      {typeLabels[link.type]}
                    </span>
                  </div>
                  <p>{link.description}</p>
                  <span class="link-url">
                    {link.url === '#' ? 'Coming soon' : new URL(link.url).hostname}
                  </span>
                </a>
              ))}
            </div>
          </section>
        ))
      }

      <footer class="page-footer">
        <p>
          See an outdated link? <a
            href="https://github.com/openfinance-os/community/issues"
            target="_blank"
            rel="noopener noreferrer">Open an issue on GitHub</a
          >
        </p>
      </footer>
    </div>
  </div>
</PageLayout>

<style>
  .links-page {
    padding: var(--space-16) var(--space-6);
  }

  .container {
    max-width: 1000px;
    margin: 0 auto;
  }

  .page-header {
    margin-bottom: var(--space-12);
  }

  .page-header h1 {
    font-size: 2.25rem;
    margin-bottom: var(--space-4);
  }

  .page-header p {
    color: var(--color-gray-600);
    font-size: 1.125rem;
  }

  /* Quick Navigation */
  .quick-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-12);
  }

  .nav-pill {
    padding: var(--space-3) var(--space-6);
    background: transparent;
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-full);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-gray-600);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .nav-pill:hover {
    border-color: var(--color-primary-300);
    color: var(--color-primary-600);
    text-decoration: none;
  }

  /* Link Sections */
  .link-section {
    margin-bottom: var(--space-16);
    scroll-margin-top: var(--space-8);
  }

  .link-section h2 {
    font-size: 1.0625rem;
    font-family: var(--font-mono);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-gray-600);
    margin-bottom: var(--space-6);
    padding-left: var(--space-4);
    border-left: 4px solid var(--color-primary-500);
  }

  .link-grid {
    display: grid;
    gap: var(--space-8);
  }

  @media (min-width: 640px) {
    .link-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Link Cards */
  .link-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-6) var(--space-8);
    background: white;
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-xl);
    text-decoration: none;
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast),
      transform var(--transition-fast);
  }

  .link-card:hover {
    border-color: var(--color-primary-300);
    box-shadow: var(--shadow-lg);
    transform: translateY(-3px);
    text-decoration: none;
  }

  .card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-3);
  }

  .link-card h3 {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-gray-900);
    line-height: 1.4;
  }

  .link-card:hover h3 {
    color: var(--color-primary-700);
  }

  .type-badge {
    flex-shrink: 0;
    padding: var(--space-1) var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    border-radius: var(--radius-full);
  }

  .type-blue {
    background: var(--color-primary-50);
    color: var(--color-primary-700);
  }

  .type-green {
    background: #dcfce7;
    color: #166534;
  }

  .type-amber {
    background: #fef3c7;
    color: #92400e;
  }

  .link-card p {
    color: var(--color-gray-600);
    font-size: 0.875rem;
    line-height: 1.5;
    margin-bottom: var(--space-4);
    flex-grow: 1;
  }

  .link-url {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-primary-600);
  }

  .link-url::after {
    content: '→';
    display: inline-block;
    transition: transform var(--transition-fast);
  }

  .link-card:hover .link-url::after {
    transform: translateX(4px);
  }

  /* Placeholder cards */
  .link-card.placeholder {
    opacity: 0.7;
    cursor: default;
  }

  .link-card.placeholder:hover {
    transform: none;
    box-shadow: none;
    border-color: var(--color-gray-200);
  }

  .link-card.placeholder .link-url::after {
    content: '';
  }

  /* Footer */
  .page-footer {
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-gray-200);
    text-align: center;
  }

  .page-footer p {
    font-size: 0.875rem;
    color: var(--color-gray-500);
  }

  .page-footer a {
    color: var(--color-primary-600);
  }

  /* Dark mode */
  :global([data-theme='dark']) .link-card {
    background: var(--color-gray-100);
    border-color: var(--color-gray-200);
  }

  :global([data-theme='dark']) .link-card:hover {
    border-color: var(--color-gray-300);
  }

  :global([data-theme='dark']) .link-card h3 {
    color: var(--color-gray-900);
  }

  :global([data-theme='dark']) .link-card:hover h3 {
    color: var(--color-primary-400);
  }

  :global([data-theme='dark']) .link-card p {
    color: var(--color-gray-400);
  }

  :global([data-theme='dark']) .nav-pill {
    border-color: var(--color-gray-300);
    color: var(--color-gray-400);
  }

  :global([data-theme='dark']) .nav-pill:hover {
    border-color: var(--color-primary-400);
    color: var(--color-primary-400);
  }

  :global([data-theme='dark']) .page-header p {
    color: var(--color-gray-400);
  }

  :global([data-theme='dark']) .link-section h2 {
    color: var(--color-gray-400);
  }

  :global([data-theme='dark']) .type-blue {
    background: rgba(59, 130, 246, 0.2);
    color: var(--color-primary-400);
  }

  :global([data-theme='dark']) .type-green {
    background: rgba(34, 197, 94, 0.2);
    color: #4ade80;
  }

  :global([data-theme='dark']) .type-amber {
    background: rgba(245, 158, 11, 0.2);
    color: #fbbf24;
  }

  :global([data-theme='dark']) .link-url {
    color: var(--color-primary-400);
  }

  :global([data-theme='dark']) .page-footer {
    border-top-color: var(--color-gray-200);
  }

  :global([data-theme='dark']) .page-footer p {
    color: var(--color-gray-400);
  }

  :global([data-theme='dark']) .page-footer a {
    color: var(--color-primary-400);
  }
</style>
