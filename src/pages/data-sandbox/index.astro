---
import PageLayout from '@layouts/PageLayout.astro';
import Breadcrumb from '@components/common/Breadcrumb.astro';
import SandboxExplorer from '@components/sandbox/SandboxExplorer.astro';
import { formatDay, sampleSource } from '@lib/sandbox-samples';

const SANDBOX_URL = 'https://data-sandbox.openfinance-os.org/';
const MCP_URL = 'https://mcp.openfinance-os.org/mcp';
const INTEGRATE_URL = 'https://data-sandbox.openfinance-os.org/src/integrate.html';

const uses = [
  {
    title: 'Learn the shapes first',
    body: 'Read what accounts, balances, transactions and policies look like before you start formal onboarding or write a line of integration code.',
  },
  {
    title: 'Plan for missing fields',
    body: 'Switch between Rich, Median and Sparse profiles to see the same customer with fewer optional fields filled in, and check that your idea still works.',
  },
  {
    title: 'Demo without credentials',
    body: 'Show a proposition to colleagues or partners using fictional customers. No bank login, no certificate and no customer data involved.',
  },
  {
    title: 'Repeat a test exactly',
    body: 'The same persona, profile and seed always give the same bundle, so a test or a screenshot can be reproduced later.',
  },
];

const coverage = [
  { value: '38', label: 'fictional customers', note: '29 with banking data, 17 with insurance' },
  { value: '12', label: 'Bank Data Sharing endpoints', note: 'accounts to statements' },
  { value: '30', label: 'insurance endpoints', note: 'across seven lines of cover' },
  { value: '3', label: 'completeness profiles', note: 'Rich, Median and Sparse' },
];

const shortCommit = sampleSource.commit.slice(0, 7);
---

<PageLayout
  title="Explore the Data Sandbox"
  description="Pick a fictional customer and read sample UAE Open Finance accounts, transactions and insurance payloads. Synthetic data, no credentials, nothing to install."
>
  <div class="sandbox-page">
    <div class="container">
      <Breadcrumb items={[{ label: 'Commons', href: '/commons' }, { label: 'Data Sandbox' }]} />

      <header class="page-intro sandbox-intro">
        <p class="eyebrow">Data Sandbox · Synthetic data only</p>
        <h1>See the data before you build on it.</h1>
        <p class="lede">
          Open Finance lets a customer share their financial data with a licensed service. Pick a
          fictional customer below and read what that service would receive. Nothing here is a real
          person, a real account or a real bank response.
        </p>
      </header>

      <section aria-labelledby="try-title">
        <div class="section-head">
          <h2 id="try-title">Pick a customer, then a payload</h2>
          <p>Three of the 38 personas, on the Median profile.</p>
        </div>
        <SandboxExplorer />
        <p class="fineprint">
          Sample taken from the Data Sandbox at revision{' '}
          <a
            href={`${sampleSource.repository}/tree/${sampleSource.commit}`}
            rel="noopener noreferrer"
          >
            <code>{shortCommit}</code>
          </a>
          , corpus {sampleSource.corpusVersion}. Amounts and dates are fixed to the corpus reference
          date of {formatDay(sampleSource.referenceDate)}, so a balance here is not a live balance.
          Banking payloads follow standards {sampleSource.spec.banking.version}; insurance follows{' '}
          {sampleSource.spec.insurance.version}.
        </p>
      </section>

      <section aria-labelledby="uses-title">
        <div class="section-head">
          <h2 id="uses-title">What it helps with</h2>
        </div>
        <ul class="uses">
          {uses.map((use, index) => (
            <li>
              <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <h3>{use.title}</h3>
              <p>{use.body}</p>
            </li>
          ))}
        </ul>
      </section>

      <section class="full" aria-labelledby="full-title">
        <div class="full-copy">
          <h2 id="full-title">There is more in the full sandbox</h2>
          <p>
            The full explorer runs in your browser. It marks every field as mandatory, optional or
            conditional straight from the published specification, compares profiles side by side
            and exports the bundle as JSON or CSV.
          </p>
          <div class="actions">
            <a class="primary" href={SANDBOX_URL} rel="noopener">
              Open the full sandbox <span aria-hidden="true">↗</span>
            </a>
            <a href="/commons/data-sandbox">Read the detailed notes</a>
          </div>
        </div>
        <dl class="coverage">
          {coverage.map((item) => (
            <div>
              <dd>{item.value}</dd>
              <dt>
                {item.label}
                <span>{item.note}</span>
              </dt>
            </div>
          ))}
        </dl>
      </section>

      <section class="mcp" id="mcp" aria-labelledby="mcp-title">
        <div>
          <h2 id="mcp-title">Use it from an AI assistant</h2>
          <p>
            The Data Sandbox also runs as a hosted MCP server, so Claude, ChatGPT or any other MCP
            client can pick a fictional customer and read the same payloads. It needs no sign-in,
            and every response is marked as synthetic.
          </p>
          <div class="actions">
            <a href={INTEGRATE_URL} rel="noopener">
              See all five ways to get the data <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
        <div class="mcp-connect">
          <p class="mcp-label">Server address (Streamable HTTP)</p>
          <code>{MCP_URL}</code>
          <p class="mcp-label">Claude Code</p>
          <code>claude mcp add --transport http of-data-sandbox {MCP_URL}</code>
        </div>
      </section>

      <aside class="boundary" aria-labelledby="boundary-title">
        <h2 id="boundary-title">What this is not</h2>
        <p>
          The Data Sandbox is a community tool. It is not the official API Hub sandbox, it does not
          connect to a bank, and a fixture does not establish conformance or certification. For
          integration testing, follow the{' '}
          <a
            href="https://openfinanceuae.atlassian.net/wiki/spaces/OF/pages/195788812/API+Hub+Sandbox+User+Guide"
            rel="noopener noreferrer"
          >
            official API Hub Sandbox User Guide
          </a>
          . Code is MIT and the synthetic data is CC0.
        </p>
      </aside>
    </div>
  </div>
</PageLayout>

<style>
  .sandbox-page {
    padding: var(--space-8) 0 var(--space-20);
  }
  .sandbox-intro {
    padding: var(--space-8) 0 var(--space-10);
    margin-bottom: var(--space-10);
  }
  .eyebrow {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-secondary);
    margin-bottom: 16px;
  }
  h1 {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    line-height: 1.08;
    max-width: 780px;
    margin-bottom: 20px;
  }
  .lede {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    max-width: 680px;
  }
  section,
  .boundary {
    margin-bottom: var(--space-16);
  }
  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }
  h2 {
    font-size: 1.75rem;
    font-weight: 500;
    letter-spacing: -0.03em;
  }
  .section-head p {
    color: var(--color-text-secondary);
    font-size: 0.875rem;
  }
  .fineprint {
    margin-top: 14px;
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    max-width: 860px;
  }
  .fineprint a {
    color: var(--color-brand-ink);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  .uses {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
  }
  .uses li {
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: var(--color-card);
    padding: 22px;
  }
  .uses span {
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    color: var(--color-text-secondary);
  }
  .uses h3 {
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 14px 0 8px;
  }
  .uses p {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
  }
  .full {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 48px;
    align-items: center;
    padding: 36px;
    border-radius: 12px;
    background: var(--color-soft);
    border: 1px solid var(--color-border);
  }
  .full-copy p {
    margin: 14px 0 22px;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .actions a {
    display: inline-flex;
    gap: 12px;
    align-items: center;
    border-radius: 8px;
    padding: 13px 18px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text);
    border: 1px solid var(--color-border);
    background: var(--color-card);
    text-decoration: none;
  }
  .actions a:hover {
    border-color: var(--color-text-secondary);
    text-decoration: none;
  }
  .actions a.primary {
    background: var(--color-primary-fill);
    border-color: var(--color-primary-fill);
    color: #fff;
  }
  .actions a.primary:hover {
    background: var(--color-primary-fill-strong);
  }
  .coverage {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin: 0;
  }
  .coverage > div {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 18px;
    display: flex;
    flex-direction: column;
  }
  .coverage dd {
    margin: 0;
    font-size: 2rem;
    font-weight: 500;
    letter-spacing: -0.04em;
    color: var(--color-brand-ink);
  }
  .coverage dt {
    font-size: 0.875rem;
    font-weight: 600;
    margin-top: 4px;
  }
  .coverage dt span {
    display: block;
    font-weight: 400;
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    margin-top: 2px;
  }
  .mcp {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 48px;
    align-items: center;
    scroll-margin-top: 96px;
  }
  .mcp > div > p {
    margin: 14px 0 22px;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }
  .mcp-connect {
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: var(--color-card);
    padding: 20px;
    min-width: 0;
  }
  .mcp-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    margin: 0 0 6px;
  }
  .mcp-connect code {
    display: block;
    overflow-wrap: anywhere;
    font-size: 0.8125rem;
    line-height: 1.6;
    padding: 10px 12px;
    border-radius: 6px;
    background: var(--color-soft);
    margin-bottom: 16px;
  }
  .mcp-connect code:last-child {
    margin-bottom: 0;
  }
  .boundary {
    border-left: 3px solid var(--color-accent-600);
    padding: 4px 0 4px 20px;
    max-width: 780px;
  }
  .boundary h2 {
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-bottom: 8px;
  }
  .boundary p {
    line-height: 1.7;
    color: var(--color-text-secondary);
  }
  .boundary a {
    color: var(--color-brand-ink);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  @media (max-width: 960px) {
    .uses {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .full {
      grid-template-columns: 1fr;
      gap: 28px;
      padding: 24px;
    }
    .mcp {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
  @media (max-width: 560px) {
    .uses {
      grid-template-columns: 1fr;
    }
  }
</style>
