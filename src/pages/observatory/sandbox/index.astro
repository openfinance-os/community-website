---
import PageLayout from '@layouts/PageLayout.astro';
import ObservatoryNav from '@components/observatory/ObservatoryNav.astro';
import { apiFamilyLabel, roleLabels } from '@lib/taxonomy';
import StatCard from '@components/observatory/StatCard.astro';
import DonutChart from '@components/observatory/DonutChart.astro';
import ParticipantCard from '@components/observatory/ParticipantCard.astro';
import EnvironmentToggle from '@components/observatory/EnvironmentToggle.astro';
import AuthCapabilitiesChart from '@components/observatory/AuthCapabilitiesChart.astro';
import HistoricalTrendsChart from '@components/observatory/HistoricalTrendsChart.astro';

// Import dual environment snapshot
import { getObservatorySnapshot } from '@lib/observatory-data';

// Import historical data
import historyDataRaw from '../../../../data/observatory/history.json';
interface DataPoint {
  date: string;
  totalParticipants: number;
  liveInProduction: number;
  byRole: Record<string, number>;
  byCity: Record<string, number>;
  apiFamilyCoverage: Record<string, number>;
  tppCount: number;
  shariahCompliantCount: number;
}

interface HistoryData {
  dataPoints: DataPoint[];
  milestones: Array<{ date: string; event: string; participantName?: string }>;
  productionHistory?: DataPoint[];
  sandboxHistory?: DataPoint[];
}

const historyData = (historyDataRaw || {
  dataPoints: [],
  milestones: [],
}) as unknown as HistoryData;

// Import participant profiles for enriched data
import participantProfiles from '../../../../data/participants/profiles.json';

// This page shows SANDBOX environment
const currentEnv = 'sandbox';

const isDualFormat = true;
const productionSnapshot = getObservatorySnapshot('production');
const sandboxSnapshot = getObservatorySnapshot('sandbox');
const snapshot = sandboxSnapshot;

const { summary, participants, timestamp, trends } = snapshot;

// Handle both old and new summary format
const totalParticipants = summary.totalParticipants || 0;
const byRole = summary.byRole || {};
const apiFamilies = summary.apiFamilies || [];

// Recalculate byCity using profile fallbacks for Unknown cities
const profiles = participantProfiles as Record<string, any>;
const byCityRecalculated: Record<string, number> = {};

for (const participant of participants) {
  let city = participant.city;

  // Use profile headquarters as fallback if city is Unknown
  if (city === 'Unknown') {
    const profile =
      profiles[participant.name] ||
      profiles[participant.shortName] ||
      Object.values(profiles).find(
        (p: any) =>
          p.shortName === participant.shortName ||
          p.fullName === participant.legalName ||
          participant.name.includes(p.shortName)
      );

    if (profile?.headquarters?.city) {
      city = profile.headquarters.city;
    }
  }

  byCityRecalculated[city] = (byCityRecalculated[city] || 0) + 1;
}

const byCity = byCityRecalculated;

// New enhanced metrics (with fallbacks for old format)
const liveInProduction =
  summary.liveInProduction ?? participants.filter((p: any) => p.hasAuthServer).length;
const shariahCompliantCount =
  summary.shariahCompliantCount ?? participants.filter((p: any) => p.isShariahCompliant).length;
const multiRoleCount =
  summary.multiRoleCount ?? participants.filter((p: any) => p.roles?.length > 1).length;
const byAuthCapabilities = summary.byAuthCapabilities || { ciba: 0, dcr: 0, redirect: 0 };

// Aggregate by Company Type using profile data
const byType: Record<string, number> = {};
const byOwnership: Record<string, number> = {};

for (const participant of participants) {
  const profile =
    profiles[participant.name] ||
    profiles[participant.shortName] ||
    Object.values(profiles).find(
      (p: any) =>
        p.shortName === participant.shortName ||
        p.fullName === participant.legalName ||
        participant.name.includes(p.shortName)
    );

  // Aggregate by type
  const type = profile?.type || 'unknown';
  byType[type] = (byType[type] || 0) + 1;

  // Aggregate by ownership
  const ownership = profile?.ownership || 'Unknown';
  byOwnership[ownership] = (byOwnership[ownership] || 0) + 1;
}

// Role chart data
const roleColors = {
  LFI: 'var(--color-primary-500)',
  BDSP: 'var(--color-accent-500)',
  BSIP: '#3b82f6',
  ISP: '#8b5cf6',
  TPP: '#ef4444',
} as const;

const roleData = Object.entries(byRole).map(([label, value]) => ({
  label,
  value: value as number,
  color: (roleColors as any)[label] || 'var(--color-gray-400)',
}));

// City chart data
const cityColors = {
  'Abu Dhabi': 'var(--color-primary-600)',
  Dubai: 'var(--color-accent-500)',
  London: '#6366f1',
  Riyadh: '#f59e0b',
  Sharjah: '#10b981',
  Ajman: '#8b5cf6',
  'Ras Al Khaimah': '#ec4899',
  Fujairah: '#14b8a6',
  'Umm Al Qaiwain': '#f97316',
} as const;

const cityData = Object.entries(byCity).map(([label, value]) => ({
  label,
  value: value as number,
  color: (cityColors as any)[label] || 'var(--color-gray-400)',
}));

// Type chart data
const typeColors = {
  'commercial-bank': '#0d9488',
  'islamic-bank': '#059669',
  'digital-bank': '#6366f1',
  'international-bank': '#3b82f6',
  fintech: '#8b5cf6',
  payments: '#ec4899',
  insurance: '#f59e0b',
  exchange: '#f97316',
  infrastructure: '#64748b',
  unknown: '#9ca3af',
} as const;

const typeLabels: Record<string, string> = {
  'commercial-bank': 'Commercial Banks',
  'islamic-bank': 'Islamic Banks',
  'digital-bank': 'Digital Banks',
  'international-bank': 'International Banks',
  fintech: 'Fintechs',
  payments: 'Payment Services',
  insurance: 'Insurance',
  exchange: 'Exchange Houses',
  infrastructure: 'Infrastructure',
  unknown: 'Other',
};

const typeData = Object.entries(byType)
  .sort((a, b) => b[1] - a[1])
  .map(([key, value]) => ({
    label: typeLabels[key] || key,
    value: value as number,
    color: (typeColors as any)[key] || 'var(--color-gray-400)',
  }));

// Ownership chart data
const ownershipColors = {
  Government: '#0d9488',
  Private: '#6366f1',
  Public: '#f59e0b',
  'State-owned': '#059669',
  Unknown: '#9ca3af',
} as const;

const ownershipData = Object.entries(byOwnership)
  .sort((a, b) => b[1] - a[1])
  .map(([label, value]) => ({
    label,
    value: value as number,
    color: (ownershipColors as any)[label] || 'var(--color-gray-400)',
  }));

// Format timestamp
const formatDate = (dateStr: string) => {
  return new Date(dateStr).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
    timeZone: 'UTC',
  });
};
---

<PageLayout
  title="Observatory - Sandbox"
  description="Sandbox environment visibility for UAE Open Finance ecosystem. Track test participants and API coverage in the sandbox environment."
  lastUpdated={timestamp}
>
  <ObservatoryNav current="sandbox" />
  <div class="observatory-page">
    <header class="page-intro page-header sandbox-header">
      <div class="header-content">
        <div class="header-badge sandbox-badge">
          <span class="sandbox-indicator"></span>
          <span>Sandbox Environment</span>
        </div>
        <h1>Observatory</h1>
        <p class="header-description">Sandbox environment for testing and development</p>
      </div>
      <div class="header-meta">
        <div class="header-controls">
          {isDualFormat && (
            <EnvironmentToggle
              currentEnvironment={currentEnv}
              productionCount={productionSnapshot?.summary?.totalParticipants || 0}
              sandboxCount={sandboxSnapshot?.summary?.totalParticipants || 0}
            />
          )}
        </div>
        <div class="header-info">
          <p class="last-updated">
            Last updated: <time datetime={timestamp}>{formatDate(timestamp)}</time> UTC
          </p>
          <div class="header-links">
            <a href="/observatory/methodology" class="header-link">
              How we calculate this
            </a>
            <a
              href="https://github.com/openfinance-os/community/issues"
              class="header-link"
              target="_blank"
              rel="noopener noreferrer"
            >
              See an error?
            </a>
          </div>
        </div>
      </div>
    </header>

    <p class="measurement-note">
      Each registration is a directory ID, not a deduplicated legal entity. An active authorization
      server with an issuer is published metadata, not evidence of traffic or verified availability.
      Capability and Shariah indicators reflect source declarations.{' '}
      <a href="/observatory/methodology">Definitions and limitations</a>.
    </p>

    <section class="stats-section">
      <div class="stats-grid">
        <StatCard
          value={totalParticipants}
          label="Registrations"
          sublabel="Sandbox directory IDs"
          icon="participants"
          trendValue={trends?.participantChange}
        />
        <StatCard
          value={liveInProduction}
          label="Registrations With Issuer"
          sublabel="Registrations with an active issuer"
          icon="active"
        />
        <StatCard
          value={shariahCompliantCount}
          label="Directory Shariah Flag"
          sublabel="Flag declared true in source"
          icon="shariah"
        />
        <StatCard
          value={apiFamilies.length}
          label="API Families"
          sublabel="Published active resource families"
          icon="api"
        />
      </div>
    </section>

    <!-- Additional Stats Row -->
    <section class="stats-section secondary-stats">
      <div class="stats-grid-secondary">
        <StatCard
          value={multiRoleCount}
          label="Multi-Role"
          sublabel="Participants with 2+ roles"
          icon="participants"
        />
        <StatCard
          value="N/A"
          label="TPP Population"
          sublabel="Role claims do not classify licences"
          icon="tpp"
        />
        <StatCard
          value={byAuthCapabilities.dcr}
          label="Declared DCR"
          sublabel="Dynamic Client Registration"
          icon="auth"
        />
        <StatCard
          value={byAuthCapabilities.ciba}
          label="Declared CIBA"
          sublabel="Backchannel Authentication"
          icon="auth"
        />
      </div>
    </section>

    <section class="charts-section">
      <div class="charts-grid">
        <div class="chart-card">
          <h2 class="chart-title">
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
            Participant Roles
          </h2>
          <p class="chart-description">Distribution of roles in sandbox</p>
          <div class="chart-container">
            <DonutChart
              data={roleData}
              size={180}
              strokeWidth={24}
              centerValue={totalParticipants}
              centerLabel="Total"
            />
          </div>
          <div class="role-legend">
            <div class="role-item">
              <strong>LFI</strong> — {roleLabels.LFI} (banks)
            </div>
            <div class="role-item">
              <strong>BDSP</strong> — {roleLabels.BDSP}
            </div>
            <div class="role-item">
              <strong>BSIP</strong> — {roleLabels.BSIP}
            </div>
            <div class="role-item">
              <strong>ISP</strong> — {roleLabels.ISP}
            </div>
            <div class="role-item">
              <strong>TPP</strong> — {roleLabels.TPP}
            </div>
          </div>
        </div>

        <div class="chart-card">
          <h2 class="chart-title">
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M3 21h18"></path>
              <path d="M5 21V7l8-4v18"></path>
              <path d="M19 21V11l-6-4"></path>
            </svg>
            Geographic Distribution
          </h2>
          <p class="chart-description">Sandbox participants by location</p>
          <div class="chart-container">
            <DonutChart data={cityData} size={180} strokeWidth={24} showLegend={true} />
          </div>
        </div>

        <div class="chart-card">
          <h2 class="chart-title">
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
              <path d="M3 9h18"></path>
              <path d="M9 21V9"></path>
            </svg>
            Company Types
          </h2>
          <p class="chart-description">Institution categories in sandbox</p>
          <div class="chart-container">
            <DonutChart data={typeData} size={180} strokeWidth={24} showLegend={true} />
          </div>
        </div>

        <div class="chart-card">
          <h2 class="chart-title">
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
              <path d="M2 17l10 5 10-5"></path>
              <path d="M2 12l10 5 10-5"></path>
            </svg>
            Ownership Structure
          </h2>
          <p class="chart-description">Government vs private sector</p>
          <div class="chart-container">
            <DonutChart data={ownershipData} size={180} strokeWidth={24} showLegend={true} />
          </div>
        </div>

        <div class="chart-card api-matrix-card">
          <h2 class="chart-title">
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="16 18 22 12 16 6"></polyline>
              <polyline points="8 6 2 12 8 18"></polyline>
            </svg>
            API Coverage
          </h2>
          <p class="chart-description">API families in sandbox</p>
          <div class="api-matrix">
            {apiFamilies.map((api: string) => {
              const count = participants.filter((p: any) => p.apiFamilies?.includes(api)).length;
              const percentage =
                totalParticipants > 0 ? Math.round((count / totalParticipants) * 100) : 0;
              return (
                <div class="api-row">
                  <span class="api-name">{apiFamilyLabel(api)}</span>
                  <div class="api-bar-container">
                    <div class="api-bar" style={`width: ${percentage}%`} />
                  </div>
                  <span class="api-count">
                    {count}/{totalParticipants}
                  </span>
                </div>
              );
            })}
          </div>
        </div>
      </div>
    </section>

    <!-- Authorization Capabilities Section -->
    <section class="capabilities-section">
      <div class="capabilities-grid">
        <AuthCapabilitiesChart
          cibaCount={byAuthCapabilities.ciba}
          dcrCount={byAuthCapabilities.dcr}
          redirectCount={byAuthCapabilities.redirect}
          totalParticipants={totalParticipants}
        />

        <HistoricalTrendsChart
          dataPoints={historyData.sandboxHistory || []}
          milestones={(historyData.milestones || []).filter((m: any) =>
            m.event?.includes('sandbox')
          )}
        />
      </div>
    </section>

    <section class="participants-section">
      <header class="section-header">
        <div class="section-header-top">
          <div>
            <h2>Sandbox Participants</h2>
            <p>
              <span id="filtered-count">{participants.length}</span> of {participants.length}{' '}
              registered test institutions
            </p>
          </div>
        </div>
        <div class="filter-bar">
          <div class="filter-bar-inner">
            <div class="search-field">
              <svg
                class="search-field-icon"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.35-4.35"></path>
              </svg>
              <input
                type="text"
                id="participant-search"
                class="search-field-input"
                placeholder="Search participants..."
                autocomplete="off"
              />
            </div>
            <div class="filter-divider"></div>
            <div class="filter-group">
              <div class="filter-field">
                <label class="filter-label" for="filter-type">
                  Type
                </label>
                <select id="filter-type" class="filter-dropdown">
                  <option value="">All</option>
                  <option value="commercial-bank">Commercial Bank</option>
                  <option value="islamic-bank">Islamic Bank</option>
                  <option value="international-bank">International Bank</option>
                  <option value="digital-bank">Digital Bank</option>
                  <option value="fintech">Fintech</option>
                  <option value="payments">Payments</option>
                  <option value="insurance">Insurance</option>
                  <option value="exchange">Exchange</option>
                  <option value="infrastructure">Infrastructure</option>
                </select>
              </div>
              <div class="filter-field">
                <label class="filter-label" for="filter-city">
                  Location
                </label>
                <select id="filter-city" class="filter-dropdown">
                  <option value="">All</option>
                  <option value="Abu Dhabi">Abu Dhabi</option>
                  <option value="Dubai">Dubai</option>
                  <option value="Sharjah">Sharjah</option>
                  <option value="Ajman">Ajman</option>
                  <option value="Fujairah">Fujairah</option>
                  <option value="Ras Al Khaimah">Ras Al Khaimah</option>
                  <option value="Umm Al Qaiwain">Umm Al Qaiwain</option>
                  <option value="London">London</option>
                </select>
              </div>
              <div class="filter-field">
                <label class="filter-label" for="filter-status">
                  Status
                </label>
                <select id="filter-status" class="filter-dropdown">
                  <option value="">All</option>
                  <option value="live">Auth server published</option>
                  <option value="registered">Registered only</option>
                </select>
              </div>
            </div>
          </div>
        </div>
      </header>
      <div class="participants-grid" id="participants-grid">
        {participants.map((participant: any) => {
          const profile = (participantProfiles as any)[participant.name];
          const displayCity =
            participant.city === 'Unknown' && profile?.headquarters?.city
              ? profile.headquarters.city
              : participant.city;
          return (
            <div
              class="participant-card-wrapper"
              data-name={participant.name.toLowerCase()}
              data-legal-name={participant.legalName?.toLowerCase() || ''}
              data-type={profile?.type || ''}
              data-city={displayCity}
              data-is-live={participant.hasAuthServer}
              data-participant-name={participant.name}
              data-participant-short-name={participant.shortName}
              data-participant-city={displayCity}
              data-participant-roles={participant.roles.join(', ')}
            >
              <ParticipantCard
                id={participant.id}
                name={participant.name}
                legalName={participant.legalName}
                shortName={participant.shortName}
                status={participant.status}
                roles={participant.roles}
                city={participant.city}
                apiFamilies={participant.apiFamilies}
                hasAuthServer={participant.hasAuthServer}
                isShariahCompliant={participant.isShariahCompliant}
                isLive={participant.hasAuthServer}
                profile={profile}
                environment="sandbox"
              />
            </div>
          );
        })}
      </div>
    </section>

    <footer class="page-footer">
      <div class="disclaimer sandbox-disclaimer">
        <h3>Sandbox Environment</h3>
        <p>
          This view shows data from the
          <a
            href="https://data.sandbox.directory.openfinance.ae"
            target="_blank"
            rel="noopener noreferrer"
          >
            UAE Open Finance Sandbox Trust Framework Directory
          </a>
          . The sandbox environment is used for testing and development purposes.
        </p>
        <p>
          <strong>This is not production data.</strong> For production directory observations, view
          the
          <a href="/observatory">Production Observatory</a>.
        </p>
      </div>
    </footer>
  </div>
</PageLayout>

<style>
  .measurement-note {
    max-width: 1000px;
    margin: var(--space-6) 0;
    color: var(--color-text-secondary);
    font-size: 0.875rem;
  }
  .observatory-page {
    padding-bottom: var(--space-16);
  }

  /* Shared Clear signal introduction. */
  .page-header {
    background: var(--color-surface);
    color: var(--color-text);
    padding: var(--space-12) var(--space-4);
    position: relative;
    overflow: hidden;
  }

  .page-header.sandbox-header {
    background: var(--color-surface);
  }

  .page-header::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: none;
    pointer-events: none;
  }

  .header-content {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
  }

  .header-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    background: var(--color-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-4);
  }

  .sandbox-badge {
    background: var(--color-soft);
    border-color: var(--color-border);
  }

  .sandbox-indicator {
    width: 8px;
    height: 8px;
    background: #fbbf24;
    border-radius: 50%;
  }

  .page-header h1 {
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 500;
    color: var(--color-text);
    margin-bottom: var(--space-2);
  }

  .header-description {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    max-width: 500px;
  }

  .header-meta {
    position: relative;
    max-width: 1200px;
    margin: var(--space-6) auto 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .header-controls {
    min-width: 0;
    display: flex;
    justify-content: flex-start;
  }

  .header-info {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  @media (min-width: 640px) {
    .header-info {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .last-updated {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
  }

  .last-updated time {
    color: var(--color-text-secondary);
  }

  .header-links {
    min-width: 0;
    display: flex;
    gap: var(--space-4);
  }

  .header-link {
    font-size: 0.875rem;
    color: var(--color-brand-ink);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .header-link:hover {
    color: var(--color-brand-ink);
    text-decoration: underline;
  }

  .stats-section {
    max-width: 1200px;
    margin: calc(-1 * var(--space-8)) auto 0;
    padding: 0 var(--space-4);
    position: relative;
    z-index: 10;
  }

  .stats-section.secondary-stats {
    margin-top: var(--space-6);
  }

  .stats-grid {
    min-width: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .stats-grid-secondary {
    min-width: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

