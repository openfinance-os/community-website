---
import PageLayout from '@layouts/PageLayout.astro';
import ObservatoryNav from '@components/observatory/ObservatoryNav.astro';
import ParticipantTimeline from '@components/observatory/ParticipantTimeline.astro';
import { getObservatorySnapshot } from '@lib/observatory-data';
import Breadcrumb from '@components/common/Breadcrumb.astro';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { participantPaths, participantUrl } from '@lib/participant-identity';
import { describeApiFamilies, roleLabels } from '@lib/taxonomy';
import type { TransformedParticipant } from '../../../../scripts/types/participant';

// Load participant data

const snapshot = getObservatorySnapshot('production');

// Load profiles for enhanced data
const profilesPath = join(process.cwd(), 'data/participants/profiles.json');
let profiles: Record<string, any> = {};
try {
  profiles = JSON.parse(readFileSync(profilesPath, 'utf-8'));
} catch {
  // Profiles are optional
}

export function getStaticPaths() {
  const snapshot = getObservatorySnapshot('production');
  return participantPaths(snapshot.participants, 'production');
}

interface Props {
  matches: TransformedParticipant[];
  redirectTo?: string;
}

const { matches, redirectTo } = Astro.props;
if (redirectTo) return Astro.redirect(redirectTo, 301);
const participant = matches[0];
const profile =
  profiles[participant.name] ||
  profiles[participant.shortName] ||
  profiles[participant.legalName] ||
  null;
const environment = 'production';

// Find related participants (same type or location)
const currentType = profile?.type || 'unknown';
const currentCity = profile?.headquarters?.city || participant.city;

// Get all participants from snapshot for related section
const relatedParticipants: Array<{ name: string; shortName: string; type: string; slug: string }> =
  snapshot.participants
    .filter((p: any) => {
      if (p.id === participant.id) return false;
      const pProfile = profiles[p.name] || profiles[p.shortName] || null;
      const pType = pProfile?.type || 'unknown';
      const pCity = pProfile?.headquarters?.city || p.city;

      // Match by type or city
      return pType === currentType || pCity === currentCity;
    })
    .slice(0, 4)
    .map((p: any) => {
      const pProfile = profiles[p.name] || profiles[p.shortName] || null;
      return {
        name: p.name,
        shortName: p.shortName || p.name,
        type: pProfile?.typeLabel || pProfile?.type || 'Participant',
        slug: p.id,
      };
    });

const allApiFamilies = describeApiFamilies(participant.apiFamilies);
const roleDescriptions = roleLabels;

// Type badge colors
const typeColors: Record<string, string> = {
  'commercial-bank': 'type-blue',
  'islamic-bank': 'type-teal',
  'digital-bank': 'type-purple',
  'international-bank': 'type-amber',
  fintech: 'type-pink',
  infrastructure: 'type-gray',
  payments: 'type-green',
  insurance: 'type-indigo',
};

// Country flags
const countryFlags: Record<string, string> = {
  AE: '🇦🇪',
  GB: '🇬🇧',
  US: '🇺🇸',
};

const displayCity =
  participant.city === 'Unknown' && profile?.headquarters?.city
    ? profile.headquarters.city
    : participant.city;

const hqFlag = profile?.headquarters?.countryCode
  ? countryFlags[profile.headquarters.countryCode] || '🌍'
  : '🇦🇪';

// Generate structured data for SEO
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: participant.name,
  legalName: participant.legalName,
  address: {
    '@type': 'PostalAddress',
    addressLocality: displayCity,
    addressCountry: 'AE',
  },
  ...(profile?.website && { url: profile.website }),
  ...(profile?.description && { description: profile.description }),
};
---

<PageLayout
  title={participant.name}
  description={profile?.description ||
    `${participant.name} - UAE Open Finance participant. ${participant.roles.join(', ')}`}
  articleSchema={matches.length === 1 ? structuredData : undefined}
>
  <ObservatoryNav />
  {
    matches.length > 1 ? (
      <section class="participant-page">
        <div class="container">
          <h1>{participant.name}: choose a registration</h1>
          <p>
            The directory contains multiple registrations with this display name. Each has its own
            ID and role claims.
          </p>
          <ul class="registration-choices">
            {matches.map((registration: any) => (
              <li>
                <a href={participantUrl(registration, environment)}>
                  {registration.legalName || registration.name}
                </a>
                <p>
                  Roles: {registration.roles.join(', ')} · ID: <code>{registration.id}</code>
                </p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    ) : (
      <div class="participant-page">
        <div class="container">
          <Breadcrumb
            items={[{ label: 'Observatory', href: '/observatory' }, { label: participant.name }]}
          />

          <div class="page-grid">
            <div class="main-content">
              <header class="participant-header">
                <div class="header-badges">
                  {profile?.typeLabel ? (
                    <div
                      class:list={['type-badge', typeColors[profile.type || ''] || 'type-default']}
                    >
                      {profile.typeLabel}
                    </div>
                  ) : null}
                  {participant.hasAuthServer ? (
                    <div class="status-badge live">
                      <span class="status-dot" />
                      Authorization server published
                    </div>
                  ) : (
                    <div class="status-badge registered">Registered only</div>
                  )}
                  {participant.isShariahCompliant && (
                    <div class="shariah-badge">Directory Shariah flag</div>
                  )}
                </div>

                <h1 class="participant-name">{participant.name}</h1>
                <p class="legal-name">{participant.legalName}</p>
                <p>
                  Registration ID: <code>{participant.id}</code>
                </p>
                <p class="description">
                  Directory observation: {snapshot.timestamp.slice(0, 10)} UTC. Published metadata
                  does not verify live traffic or API availability.
                </p>

                {profile?.description && <p class="description">{profile.description}</p>}

                {profile?.marketPosition && <p class="market-position">{profile.marketPosition}</p>}
                <p>
                  <a href={`/observatory/coverage/?compare=${environment}:${participant.id}`}>
                    Compare this registration
                  </a>
                </p>
              </header>
              <ParticipantTimeline id={participant.id} environment={environment} />

              <section class="section">
                <h2 class="section-title">Roles & Capabilities</h2>
                <div class="roles-grid">
                  {participant.roles.map((role) => (
                    <div class="role-card">
                      <div class="role-header">
                        <span class="role-name">{role}</span>
                        <span class="role-active">Active</span>
                      </div>
                      {roleDescriptions[role] && (
                        <p class="role-description">{roleDescriptions[role]}</p>
                      )}
                    </div>
                  ))}
                </div>
              </section>

              <section class="section">
                <h2 class="section-title">API Coverage</h2>
                <div class="api-grid">
                  {allApiFamilies.map((api) => {
                    const isActive = participant.apiFamilies.includes(api.key);
                    const resources =
                      participant.apiResources?.filter((r: any) => r.family === api.key) || [];
                    return (
                      <div class:list={['api-card', { active: isActive }]}>
                        <div class="api-header">
                          <span class="api-indicator" />
                          <span class="api-name">{api.label}</span>
                        </div>
                        <p class="api-description">{api.description}</p>
                        {resources.map((resource: any) => (
                          <div class="api-details">
                            <span class="api-version">v{resource.version}</span>
                            <span class="api-status">
                              {resource.certificationStatus || 'Certification not declared'}
                            </span>
                            <span>
                              {resource.familyComplete
                                ? 'Family declared complete'
                                : 'Family not declared complete'}
                            </span>
                          </div>
                        ))}
                        {!isActive && <p class="api-description">Not published in this snapshot</p>}
                      </div>
                    );
                  })}
                </div>
              </section>

              {participant.hasAuthServer && (
                <section class="section">
                  <h2 class="section-title">Declared Authorization Capabilities</h2>
                  <p>
                    Indicators reflect directory declarations; unmarked capabilities are not
                    declared true and have not been tested.
                  </p>
                  <div class="auth-grid">
                    <div
                      class:list={[
                        'auth-item',
                        { active: participant.authCapabilities?.supportsRedirect },
                      ]}
                    >
                      <span class="auth-indicator" />
                      <div class="auth-content">
                        <span class="auth-name">Redirect</span>
                        <span class="auth-description">Traditional OAuth redirect flow</span>
                      </div>
                    </div>
                    <div
                      class:list={[
                        'auth-item',
                        { active: participant.authCapabilities?.supportsCiba },
                      ]}
                    >
                      <span class="auth-indicator" />
                      <div class="auth-content">
                        <span class="auth-name">CIBA</span>
                        <span class="auth-description">
                          Client Initiated Backchannel Authentication
                        </span>
                      </div>
                    </div>
                    <div
                      class:list={[
                        'auth-item',
                        { active: participant.authCapabilities?.supportsDCR },
                      ]}
                    >
                      <span class="auth-indicator" />
                      <div class="auth-content">
                        <span class="auth-name">DCR</span>
                        <span class="auth-description">Dynamic Client Registration</span>
                      </div>
                    </div>
                  </div>
                </section>
              )}
            </div>

            <aside class="sidebar">
              <div class="info-card">
                <h3 class="info-title">Details</h3>
                <dl class="info-list">
                  <div class="info-item">
                    <dt>Location</dt>
                    <dd>
                      <span class="flag">{hqFlag}</span>
                      {displayCity}, UAE
                    </dd>
                  </div>
                  {profile?.parentCompany && (
                    <div class="info-item">
                      <dt>Parent Company</dt>
                      <dd>
                        <span class="flag">
                          {countryFlags[profile.parentCompany.countryCode] || '🌍'}
                        </span>
                        {profile.parentCompany.name}
                      </dd>
                    </div>
                  )}
                  {profile?.founded && (
                    <div class="info-item">
                      <dt>Founded</dt>
                      <dd>{profile.founded}</dd>
                    </div>
                  )}
                  {participant.registrationNumber && participant.registrationNumber !== 'N/A' && (
                    <div class="info-item">
                      <dt>Registration</dt>
                      <dd class="mono">{participant.registrationNumber}</dd>
                    </div>
                  )}
                  {participant.authServerCount !== undefined && participant.authServerCount > 0 && (
                    <div class="info-item">
                      <dt>Auth Servers</dt>
                      <dd>{participant.authServerCount}</dd>
                    </div>
                  )}
                  {profile?.ownership && (
                    <div class="info-item">
                      <dt>Ownership</dt>
                      <dd>{profile.ownership}</dd>
                    </div>
                  )}
                </dl>
              </div>

              {profile?.website && (
                <a
                  href={profile.website}
                  class="website-btn"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <circle cx="12" cy="12" r="10" />
                    <line x1="2" y1="12" x2="22" y2="12" />
                    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                  </svg>
                  Visit Website
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="M7 17L17 7M17 7H7M17 7v10" />
                  </svg>
                </a>
              )}

              {relatedParticipants.length > 0 && (
                <div class="related-section">
                  <h3 class="info-title">Related Participants</h3>
                  <ul class="related-list">
                    {relatedParticipants.map(
                      (related: {
                        name: string;
                        shortName: string;
                        type: string;
                        slug: string;
                      }) => (
                        <li>
                          <a href={`/observatory/participant/${related.slug}`} class="related-link">
                            <span class="related-name">{related.shortName}</span>
                            <span class="related-type">{related.type}</span>
                          </a>
                        </li>
                      )
                    )}
                  </ul>
                </div>
              )}

              <a href="/observatory" class="back-link">
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M19 12H5M12 19l-7-7 7-7" />
                </svg>
                Back to Observatory
              </a>
            </aside>
          </div>
        </div>
      </div>
    )
  }
</PageLayout>

<style>
  .registration-choices li {
    margin: var(--space-6) 0;
  }
  code {
    overflow-wrap: anywhere;
  }
  .participant-page {
    padding: var(--space-8) var(--space-4) var(--space-16);
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .page-grid {
    min-width: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    margin-top: var(--space-6);
  }

  @media (min-width: 900px) {
    .page-grid {
      grid-template-columns: 1fr 300px;
    }
  }

  /* Header */
  .participant-header {
    margin-bottom: var(--space-8);
  }

  .header-badges {
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .type-badge {
    display: inline-flex;
    align-items: center;
    padding: 4px 12px;
    border-radius: var(--radius-full);
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .type-blue {
    background: var(--color-primary-50);
    color: var(--color-brand-ink);
  }

  .type-teal {
    background: #ccfbf1;
    color: #0f766e;
  }

  .type-purple {
    background: #ede9fe;
    color: #5b21b6;
  }

  .type-amber {
    background: #fef3c7;
    color: #92400e;
  }

  .type-pink {
    background: #fce7f3;
    color: #9d174d;
  }

  .type-gray {
    background: var(--color-soft);
    color: var(--color-text-secondary);
  }

  .type-green {
    background: #dcfce7;
    color: #166534;
  }

  .type-indigo {
    background: #e0e7ff;
    color: #3730a3;
  }

  .type-default {
    background: var(--color-soft);
    color: var(--color-text-secondary);
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    border-radius: var(--radius-full);
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .status-badge.live {
    background: var(--color-primary-50);
    color: var(--color-success-text);
  }

  .status-badge.registered {
    background: var(--color-soft);
    color: var(--color-text-secondary);
    border: 1px dashed var(--color-border);
  }

  .status-dot {
    width: 6px;
    height: 6px;
    background: var(--color-success);
    border-radius: 50%;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }

  .shariah-badge {
    display: inline-flex;
    padding: 4px 12px;
    background: #ccfbf1;
    color: #0f766e;
    border-radius: var(--radius-full);
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .participant-name {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-2);
  }

  .legal-name {
    font-size: 1rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
  }

  .description {
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    max-width: 600px;
  }

  .market-position {
    margin-top: var(--space-3);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-brand-ink);
  }

  /* Sections */
  .section {
    margin-bottom: var(--space-8);
  }

  .section-title {
    font-size: 0.75rem;
    font-family: var(--font-sans);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
  }

  /* Roles */
  .roles-grid {
    min-width: 0;
    display: grid;
    gap: var(--space-3);
  }

  .role-card {
    padding: var(--space-4);
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
  }

  .role-header {
    min-width: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-2);
  }

  .role-name {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .role-active {
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--color-success-text);
    background: rgba(16, 185, 129, 0.1);
    padding: 2px 8px;
    border-radius: var(--radius-full);
  }

  .role-description {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  /* API Coverage */
  .api-grid {
    min-width: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-3);
  }

  .api-card {
    padding: var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition: all var(--transition-fast);
  }

  .api-card.active {
    background: var(--color-card);
    border-color: var(--color-primary-200);
    opacity: 1;
  }

  .api-header {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .api-indicator {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 2px solid var(--color-border);
    background: transparent;
  }

  .api-card.active .api-indicator {
    background: var(--color-primary-500);
    border-color: var(--color-primary-500);
  }

  .api-name {
    font-weight: 600;
    color: var(--color-text);
  }

  .api-description {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-2);
  }

  .api-details {
    min-width: 0;
    display: flex;
    gap: var(--space-2);
    font-size: 0.6875rem;
    font-family: var(--font-sans);
  }

  .api-version {
    background: var(--color-primary-50);
    color: var(--color-brand-ink);
    padding: 2px 6px;
    border-radius: var(--radius-sm);
  }

  .api-status {
    color: var(--color-text-secondary);
  }

  /* Auth Capabilities */
  .auth-grid {
    min-width: 0;
    display: grid;
    gap: var(--space-3);
  }

  .auth-item {
    min-width: 0;
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4);
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
  }

  .auth-item.active {
    background: var(--color-card);
    border-color: var(--color-primary-200);
    opacity: 1;
  }

  .auth-indicator {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 2px solid var(--color-border);
    margin-top: 4px;
    flex-shrink: 0;
  }

  .auth-item.active .auth-indicator {
    background: var(--color-primary-500);
    border-color: var(--color-primary-500);
  }

  .auth-content {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .auth-name {
    font-weight: 600;
    color: var(--color-text);
  }

  .auth-description {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
  }

  /* Sidebar */
  .sidebar {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .info-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
  }

  .info-title {
    font-size: 0.75rem;
    font-family: var(--font-sans);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
  }

  .info-list {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .info-item {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .info-item dt {
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-secondary);
  }

  .info-item dd {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text);
  }

  .info-item .flag {
    font-size: 1rem;
  }

  .info-item .mono {
    font-family: var(--font-sans);
    font-size: 0.75rem;
  }

  .website-btn {
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    background: var(--color-primary-fill);
    color: white;
    font-weight: 500;
    font-size: 0.875rem;
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .website-btn:hover {
    background: var(--color-primary-fill-strong);
    text-decoration: none;
    transform: translateY(-1px);
  }

  .back-link {
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
