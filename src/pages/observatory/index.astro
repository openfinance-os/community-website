<script>
  // Participant filtering with URL persistence
  const searchInput = document.getElementById('participant-search') as HTMLInputElement;
  const typeFilter = document.getElementById('filter-type') as HTMLSelectElement;
  const cityFilter = document.getElementById('filter-city') as HTMLSelectElement;
  const statusFilter = document.getElementById('filter-status') as HTMLSelectElement;
  const participantsGrid = document.getElementById('participants-grid');
  const filteredCountEl = document.getElementById('filtered-count');

  // Read filters from URL on page load
  function loadFiltersFromURL() {
    const params = new URLSearchParams(window.location.search);
    const search = params.get('search');
    const type = params.get('type');
    const city = params.get('city');
    const status = params.get('status');

    if (search && searchInput) searchInput.value = search;
    if (type && typeFilter) typeFilter.value = type;
    if (city && cityFilter) cityFilter.value = city;
    if (status && statusFilter) statusFilter.value = status;

    // Apply filters if any URL params exist
    if (search || type || city || status) {
      filterParticipants(false); // Don't update URL, we're loading from it
    }
  }

  // Update URL with current filters
  function updateURL() {
    const params = new URLSearchParams();

    if (searchInput?.value) params.set('search', searchInput.value);
    if (typeFilter?.value) params.set('type', typeFilter.value);
    if (cityFilter?.value) params.set('city', cityFilter.value);
    if (statusFilter?.value) params.set('status', statusFilter.value);

    const newURL = params.toString()
      ? `${window.location.pathname}?${params.toString()}`
      : window.location.pathname;

    // Use replaceState to avoid creating history entries for every filter change
    window.history.replaceState({}, '', newURL);
  }

  function filterParticipants(shouldUpdateURL = true) {
    if (!participantsGrid) return;

    const searchTerm = searchInput?.value.toLowerCase() || '';
    const selectedType = typeFilter?.value || '';
    const selectedCity = cityFilter?.value || '';
    const selectedStatus = statusFilter?.value || '';

    const cards = participantsGrid.querySelectorAll('.participant-card-wrapper');
    let visibleCount = 0;

    cards.forEach((card) => {
      const el = card as HTMLElement;
      const name = el.dataset.name || '';
      const legalName = el.dataset.legalName || '';
      const type = el.dataset.type || '';
      const city = el.dataset.city || '';
      const isLive = el.dataset.isLive === 'true';

      // Check search match
      const matchesSearch =
        !searchTerm || name.includes(searchTerm) || legalName.includes(searchTerm);

      // Check type filter
      const matchesType = !selectedType || type === selectedType;

      // Check city filter
      const matchesCity = !selectedCity || city === selectedCity;

      // Check status filter
      const matchesStatus =
        !selectedStatus ||
        (selectedStatus === 'live' && isLive) ||
        (selectedStatus === 'registered' && !isLive);

      if (matchesSearch && matchesType && matchesCity && matchesStatus) {
        el.classList.remove('hidden');
        visibleCount++;
      } else {
        el.classList.add('hidden');
      }
    });

    // Update count
    if (filteredCountEl) {
      filteredCountEl.textContent = visibleCount.toString();
    }

    // Show no results message if needed
    const existingNoResults = participantsGrid.querySelector('.no-results');
    if (visibleCount === 0 && !existingNoResults) {
      const noResults = document.createElement('div');
      noResults.className = 'no-results';
      noResults.innerHTML = `
        <div class="no-results-icon">🔍</div>
        <p>No participants match your filters</p>
      `;
      participantsGrid.appendChild(noResults);
    } else if (visibleCount > 0 && existingNoResults) {
      existingNoResults.remove();
    }

    // Update URL with current filters
    if (shouldUpdateURL) {
      updateURL();
    }
  }

  // Add event listeners
  searchInput?.addEventListener('input', () => filterParticipants());
  typeFilter?.addEventListener('change', () => filterParticipants());
  cityFilter?.addEventListener('change', () => filterParticipants());
  statusFilter?.addEventListener('change', () => filterParticipants());

  // Load filters from URL on page load
  loadFiltersFromURL();

  // Handle browser back/forward navigation
  window.addEventListener('popstate', () => {
    loadFiltersFromURL();
  });
</script>
