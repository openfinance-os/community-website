---
import PageLayout from '@layouts/PageLayout.astro';
import ObservatoryNav from '@components/observatory/ObservatoryNav.astro';
import ObservatoryBand from '@components/observatory/ObservatoryBand.astro';
import EcosystemPulse from '@components/observatory/EcosystemPulse.astro';
import WatchBriefing from '@components/home/WatchBriefing.astro';
---

<PageLayout
  title="Latest Ecosystem Briefing"
  description="The latest saved UAE Open Finance Watch summary, with its observation date, operational cutoff and links to the full evidence."
>
  <ObservatoryNav current="briefing" />
  <div class="briefing-page">
    <header class="briefing-header">
      <ObservatoryBand
        art="field"
        eyebrow="Latest saved Watch run"
        title="Ecosystem briefing"
        lede="Standards, operations and adoption in one dated view. The full Watch provides the underlying sources and reporting windows."
        focus="60% 70%"
      />
    </header>
    <WatchBriefing />
    <EcosystemPulse heading="The figures behind this week's briefing" />
  </div>
</PageLayout>
<style>
  .briefing-header {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 16px var(--space-6);
  }
  .briefing-page :global(.briefing-inner) {
    max-width: 1168px;
  }
</style>
