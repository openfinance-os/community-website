---
import { getLocaleFromPath, getDirection, getLocalizedPath, type Locale } from '../i18n/utils';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  articleSchema?: object;
  locale?: Locale;
}

// Detect locale from URL path
const detectedLocale = getLocaleFromPath(Astro.url.pathname);

const {
  title,
  description = 'The community home for UAE Open Finance',
  ogImage = '/og-image.png',
  type = 'website',
  publishedTime,
  modifiedTime,
  articleSchema,
  locale = detectedLocale,
} = Astro.props;

const direction = getDirection(locale);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);

// Organization structured data (JSON-LD)
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'OpenFinance-OS',
  url: Astro.site?.toString() || 'https://openfinance-os.org',
  logo: new URL('/brand/logo-full.svg', Astro.site).toString(),
  description: 'Community-owned platform providing visibility into the UAE Open Finance ecosystem',
  sameAs: ['https://github.com/openfinance-os'],
};

// WebSite structured data for search
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'OpenFinance-OS',
  url: Astro.site?.toString() || 'https://openfinance-os.org',
  description: 'The community home for UAE Open Finance',
  publisher: {
    '@type': 'Organization',
    name: 'OpenFinance-OS',
  },
};
---

<!doctype html>
<html lang={locale} dir={direction}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="OpenFinance-OS News" href="/rss.xml" />

    <!-- SEO -->
    <title>{title} | OpenFinance-OS</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Hreflang for language alternatives -->
    <link
      rel="alternate"
      hreflang="en"
      href={new URL(getLocalizedPath(Astro.url.pathname, 'en'), Astro.site)}
    />
    <link
      rel="alternate"
      hreflang="ar"
      href={new URL(getLocalizedPath(Astro.url.pathname, 'ar'), Astro.site)}
    />
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(getLocalizedPath(Astro.url.pathname, 'en'), Astro.site)}
    />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="OpenFinance-OS" />
    <meta property="og:type" content={type} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    {
      articleSchema && (
        <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
      )
    }

    <!-- Fonts - Brand: DM Sans + Fraunces + IBM Plex Sans Arabic for RTL -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:wght@600;700&family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- Analytics (PostHog) - product analytics with session replay -->
    <script is:inline>
      !(function (t, e) {
        var o, n, p, r;
        e.__SV ||
          (window.posthog && window.posthog.__loaded) ||
