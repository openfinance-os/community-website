---
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  articleSchema?: object;
  keywords?: string[];
  robots?: string;
}

const {
  title,
  description = 'The community home for UAE Open Finance and Open Banking. Ecosystem visibility, resources, and community collaboration for the UAE financial services industry.',
  ogImage = '/og-image.png',
  type = 'website',
  publishedTime,
  modifiedTime,
  articleSchema,
  keywords = [],
  robots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
} = Astro.props;

const canonicalPath =
  Astro.url.pathname === '/' || /\.[a-z0-9]+$/i.test(Astro.url.pathname)
    ? Astro.url.pathname
    : Astro.url.pathname.endsWith('/')
      ? Astro.url.pathname
      : `${Astro.url.pathname}/`;
const canonicalURL = new URL(canonicalPath, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
const isHome = canonicalPath === '/';
const documentTitle = `${title} | OpenFinance-OS`;
const ogImageType = ogImageURL.pathname.endsWith('.png')
  ? 'image/png'
  : ogImageURL.pathname.endsWith('.webp')
    ? 'image/webp'
    : ogImageURL.pathname.endsWith('.jpg') || ogImageURL.pathname.endsWith('.jpeg')
      ? 'image/jpeg'
      : undefined;

const jsonLd = (data: unknown) => JSON.stringify(data).replace(/</g, '\\u003c');

// Default keywords for SEO - always include core terms
const defaultKeywords = [
  'UAE Open Finance',
  'Open Banking UAE',
  'Open Finance',
  'Open Banking',
  'UAE fintech',
  'CBUAE',
  'Al Tareq',
  'financial APIs',
  'banking APIs',
  'PSD2 UAE',
  'Third Party Providers',
  'TPP',
  'ASPSP',
  'financial data sharing',
  'UAE financial services',
  'Open Finance ecosystem',
  'fintech UAE',
  'banking innovation UAE',
];
const allKeywords = [...new Set([...keywords, ...defaultKeywords])];

// Organization structured data (JSON-LD)
const siteOrigin = new URL('/', Astro.site).toString();

// Organization and WebSite are emitted only on the home page.
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'OpenFinance-OS',
  url: siteOrigin,
  logo: {
    '@type': 'ImageObject',
    url: new URL('/brand/logo-icon-512.png', Astro.site).toString(),
    width: 512,
    height: 512,
  },
  description:
    'Community-owned platform providing visibility into the UAE Open Finance and Open Banking ecosystem. Resources for developers, banks, and fintechs.',
  sameAs: ['https://github.com/openfinance-os'],
  knowsAbout: [
    'UAE Open Finance',
    'Open Banking',
    'Financial APIs',
    'CBUAE regulations',
    'Fintech',
  ],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'OpenFinance-OS',
  alternateName: ['OpenFinance-OS', 'UAE Open Finance Hub', 'Open Banking UAE'],
  url: siteOrigin,
  description,
  publisher: {
    '@type': 'Organization',
    name: 'OpenFinance-OS',
  },
};

// Generate BreadcrumbList schema from current path
const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbItems = [
  {
    '@type': 'ListItem',
    position: 1,
    name: 'Home',
    item: siteOrigin,
  },
];

let currentPath = '';
pathSegments.forEach((segment, index) => {
  currentPath += `/${segment}`;
  const name = segment
    .split('-')
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');
  const crumbPath = /\.[a-z0-9]+$/i.test(currentPath) ? currentPath : `${currentPath}/`;
  breadcrumbItems.push({
    '@type': 'ListItem',
    position: index + 2,
    name: name,
    item: new URL(crumbPath, Astro.site).toString(),
  });
});

const breadcrumbSchema =
  pathSegments.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbItems,
      }
    : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Fresh URLs replace cached icons from the previous identity. -->
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/brand/favicon-16.png?v=clear-signal-2.3"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/brand/favicon-32.png?v=clear-signal-2.3"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      sizes="any"
      href="/brand/logo-favicon.svg?v=clear-signal-2.3"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      sizes="any"
      media="(prefers-color-scheme: dark)"
      href="/brand/logo-icon-dark.svg?v=clear-signal-2.3"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/brand/apple-touch-icon.png?v=clear-signal-2.3"
    />
    <link rel="alternate" type="application/rss+xml" title="OpenFinance-OS News" href="/rss.xml" />

    <!-- SEO -->
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={allKeywords.join(', ')} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Additional SEO meta tags -->
    <meta name="author" content="OpenFinance-OS Community" />
    <meta name="robots" content={robots} />
    <meta name="geo.region" content="AE" />
    <meta name="geo.placename" content="United Arab Emirates" />
    <meta name="language" content="English" />

    <!-- Open Graph -->
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="OpenFinance-OS" />
    <meta property="og:type" content={type} />
    <meta property="og:image" content={ogImageURL} />
    {ogImageType && <meta property="og:image:type" content={ogImageType} />}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="OpenFinance-OS - The community home for UAE Open Finance and Open Banking"
    />
    <meta property="og:locale" content="en_US" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {type === 'article' && <meta property="article:section" content="Open Finance" />}
    {type === 'article' && <meta property="article:tag" content="UAE Open Finance" />}
    {type === 'article' && <meta property="article:tag" content="Open Banking" />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta
      name="twitter:image:alt"
      content="OpenFinance-OS - UAE Open Finance and Open Banking community platform"
    />

    <!-- Structured Data (JSON-LD) -->
    {isHome && (
      <script is:inline type="application/ld+json" set:html={jsonLd(organizationSchema)} />
    )}
    {isHome && <script is:inline type="application/ld+json" set:html={jsonLd(websiteSchema)} />}
    {breadcrumbSchema && (
      <script is:inline type="application/ld+json" set:html={jsonLd(breadcrumbSchema)} />
    )}
    {articleSchema && (
      <script is:inline type="application/ld+json" set:html={jsonLd(articleSchema)} />
    )}

    <!-- DM Sans is served locally; monospace is reserved for technical content. -->
    <link rel="preload" href="/fonts/dm-sans-regular.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/dm-sans-medium.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- Shared analytics also covers the standalone Watcher endpoint. -->
    <script is:inline src="/analytics/posthog.js"></script>
    <!-- Theme initialization - prevent flash of wrong theme.
         Always resolve to an explicit data-theme (stored choice, else the
         system preference) so component-level [data-theme='dark'] rules
         apply in system-dark mode too, not only after the toggle is used. -->
    <script is:inline>
      (function () {
        var theme = null;
        try {
          theme = localStorage.getItem('theme');
        } catch (e) {
          theme = null;
        }
        if (theme !== 'dark' && theme !== 'light') {
          theme =
            window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        }
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    <slot />

    <!-- Enhanced Analytics (UTM, scroll depth, engagement, performance) -->
    <script>
      import { initEnhancedAnalytics } from '../scripts/enhanced-analytics';
      initEnhancedAnalytics();
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
