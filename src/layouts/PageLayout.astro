---
import BaseLayout from './BaseLayout.astro';
import Header from '@components/common/Header.astro';
import Footer from '@components/common/Footer.astro';
import LanguageSwitch from '@components/common/LanguageSwitch.astro';
import { pageLang } from '@lib/i18n';

interface Props {
  title: string;
  description?: string;
  lastUpdated?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  articleSchema?: object;
  robots?: string;
  breadcrumbCurrent?: string;
}

const {
  title,
  description,
  lastUpdated,
  ogImage,
  ogImageAlt,
  ogImageWidth,
  ogImageHeight,
  type,
  publishedTime,
  modifiedTime,
  articleSchema,
  robots,
  breadcrumbCurrent,
} = Astro.props;
// Site chrome stays English. Arabic editions set the language and direction on
// the main content only, so the header and footer keep their layout.
const lang = pageLang(Astro.url.pathname);
---

<BaseLayout
  title={title}
  description={description}
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
  ogImageWidth={ogImageWidth}
  ogImageHeight={ogImageHeight}
  type={type}
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  articleSchema={articleSchema}
  robots={robots}
  breadcrumbCurrent={breadcrumbCurrent}
>
  <a href="#main-content" class="skip-link">
    Skip to main content
  </a>
  <div class="page-wrapper">
    <Header />
    <main
      id="main-content"
      class="main-content"
      lang={lang === 'ar' ? 'ar' : undefined}
      dir={lang === 'ar' ? 'rtl' : undefined}
    >
      <LanguageSwitch />
      <slot />
    </main>
    <Footer lastUpdated={lastUpdated} />
  </div>
</BaseLayout>

<style>
  .skip-link {
    position: absolute;
    top: -100%;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1000;
    padding: var(--space-3) var(--space-6);
    background: var(--color-primary-fill);
    color: white;
    font-weight: 600;
    font-size: 0.875rem;
    text-decoration: none;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    transition: top var(--transition-fast);
  }

  .skip-link:focus {
    top: var(--space-4);
    outline: 2px solid var(--color-primary-300);
    outline-offset: 2px;
  }

  .page-wrapper {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .main-content {
    flex: 1;
  }
</style>
