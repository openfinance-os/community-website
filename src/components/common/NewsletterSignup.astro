---
interface Props {
  variant?: 'inline' | 'card';
  title?: string;
  description?: string;
}

const {
  variant = 'inline',
  title = 'Stay updated',
  description = 'Get the latest news and updates from the UAE Open Finance community.',
} = Astro.props;
---

<div class:list={['newsletter-signup', `newsletter-${variant}`]}>
  <div class="newsletter-content">
    <h3 class="newsletter-title">{title}</h3>
    <p class="newsletter-description">{description}</p>
  </div>
  <form class="newsletter-form" action="#" method="POST">
    <div class="form-group">
      <label for="newsletter-email" class="sr-only">Email address</label>
      <input
        type="email"
        id="newsletter-email"
        name="email"
        placeholder="Enter your email"
        required
        autocomplete="email"
        class="email-input"
      />
      <button type="submit" class="submit-btn">
        <span class="btn-text">Subscribe</span>
        <svg
          class="btn-icon"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M5 12h14M12 5l7 7-7 7"></path>
        </svg>
      </button>
    </div>
    <p class="newsletter-note">
      <svg
        width="12"
        height="12"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
      </svg>
      No spam. Unsubscribe anytime.
    </p>
  </form>
  <div class="newsletter-success" hidden>
    <svg
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
      <polyline points="22 4 12 14.01 9 11.01"></polyline>
    </svg>
    <span>Thanks for subscribing!</span>
  </div>
</div>

<script>
  // Handle newsletter form submission
  document.querySelectorAll('.newsletter-form').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formEl = e.target as HTMLFormElement;
      const emailInput = formEl.querySelector('.email-input') as HTMLInputElement;
      const successMsg = formEl.parentElement?.querySelector('.newsletter-success');

      if (!emailInput?.value) return;

      // Simulate success (in production, this would send to a newsletter service)
      formEl.setAttribute('hidden', '');
      successMsg?.removeAttribute('hidden');

      // Reset after 5 seconds
      setTimeout(() => {
        formEl.removeAttribute('hidden');
        successMsg?.setAttribute('hidden', '');
        emailInput.value = '';
      }, 5000);
    });
  });
</script>

<style>
  .newsletter-signup {
    position: relative;
  }

  /* Card variant */
  .newsletter-card {
    padding: var(--space-6);
    background: linear-gradient(135deg, var(--color-primary-50) 0%, var(--color-gray-50) 100%);
    border: 1px solid var(--color-primary-100);
    border-radius: var(--radius-xl);
  }

  .newsletter-card .newsletter-content {
    text-align: center;
    margin-bottom: var(--space-4);
  }

  .newsletter-card .newsletter-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-gray-900);
    margin-bottom: var(--space-2);
  }

  .newsletter-card .newsletter-description {
    font-size: 0.9375rem;
    color: var(--color-gray-600);
  }

  /* Inline variant (for footer) */
  .newsletter-inline {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .newsletter-inline .newsletter-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-gray-700);
    margin-bottom: var(--space-1);
  }

  .newsletter-inline .newsletter-description {
    font-size: 0.8125rem;
    color: var(--color-gray-500);
  }

  /* Form styles */
  .newsletter-form {
    width: 100%;
  }

  .form-group {
    display: flex;
    gap: var(--space-2);
  }

  .email-input {
    flex: 1;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-lg);
    font-size: 0.9375rem;
    background: white;
    color: var(--color-gray-900);
    transition: all var(--transition-fast);
  }

  .email-input::placeholder {
    color: var(--color-gray-400);
  }

  .email-input:focus {
    outline: none;
    border-color: var(--color-primary-400);
    box-shadow: 0 0 0 3px rgba(20, 184, 166, 0.15);
  }

  .submit-btn {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    background: var(--color-primary-600);
    color: white;
    border: none;
    border-radius: var(--radius-lg);
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: all var(--transition-fast);
    white-space: nowrap;
  }

  .submit-btn:hover {
    background: var(--color-primary-700);
    transform: translateY(-1px);
  }

  .submit-btn:active {
    transform: translateY(0);
  }

  .btn-icon {
    display: none;
  }

  @media (max-width: 480px) {
    .form-group {
      flex-direction: column;
    }

    .btn-text {
      display: none;
    }

    .btn-icon {
      display: block;
    }

    .submit-btn {
      justify-content: center;
    }
  }

  .newsletter-note {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin-top: var(--space-2);
    font-size: 0.75rem;
    color: var(--color-gray-400);
  }

  /* Success message */
  .newsletter-success {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-4);
    color: var(--color-success-600);
    font-weight: 500;
  }

  /* Dark mode */
  :global([data-theme='dark']) .newsletter-card {
    background: linear-gradient(135deg, rgba(20, 184, 166, 0.1) 0%, var(--color-gray-100) 100%);
    border-color: var(--color-gray-200);
  }

  :global([data-theme='dark']) .newsletter-card .newsletter-title {
    color: var(--color-gray-100);
  }

  :global([data-theme='dark']) .newsletter-card .newsletter-description {
    color: var(--color-gray-400);
  }

  :global([data-theme='dark']) .newsletter-inline .newsletter-title {
    color: var(--color-gray-200);
  }

  :global([data-theme='dark']) .email-input {
    background: var(--color-gray-200);
    border-color: var(--color-gray-300);
    color: var(--color-gray-100);
  }

  :global([data-theme='dark']) .email-input::placeholder {
    color: var(--color-gray-500);
  }

  :global([data-theme='dark']) .email-input:focus {
    border-color: var(--color-primary-400);
  }

  :global([data-theme='dark']) .submit-btn {
    background: var(--color-primary-500);
  }

  :global([data-theme='dark']) .submit-btn:hover {
    background: var(--color-primary-400);
  }

  :global([data-theme='dark']) .newsletter-success {
    color: var(--color-success-400);
  }
</style>
