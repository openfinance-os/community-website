---
import { SLACK_JOIN_URL, type SlackJoinPlacement } from '../../lib/newsletter';

interface Props {
  placement: SlackJoinPlacement;
  label?: string;
  variant?: 'link' | 'button';
}

const { placement, label = 'Join the community on Slack', variant = 'link' } = Astro.props;
---

<a
  class:list={['slack-join', variant === 'button' && 'slack-join--button']}
  href={SLACK_JOIN_URL}
  data-slack-join={placement}
  target="_blank"
  rel="noopener noreferrer"
>
  {label}
  <span class="sr-only"> (opens in a new tab)</span>
</a>

<style>
  .slack-join {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-brand-ink);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .slack-join:focus-visible {
    outline: 2px solid var(--color-accent-600);
    outline-offset: 3px;
  }

  .slack-join--button {
    justify-content: center;
    padding: 0.75rem 1.15rem;
    border: 1px solid var(--color-brand-ink);
    border-radius: var(--radius-lg);
    background: var(--color-card);
    color: var(--color-brand-ink);
    text-decoration: none;
  }

  .slack-join--button:hover {
    background: var(--color-soft);
    color: var(--color-brand-ink);
    text-decoration: none;
  }
</style>
