---
import { SLACK_JOIN_URL, type SlackJoinPlacement } from '../../lib/newsletter';

interface Props {
  placement: SlackJoinPlacement;
  label?: string;
}

const { placement, label = 'Join the community on Slack' } = Astro.props;
---

<a
  class="slack-join"
  href={SLACK_JOIN_URL}
  data-slack-join={placement}
  target="_blank"
  rel="noopener noreferrer"
>
  {label}
  <span class="sr-only"> (opens in a new tab)</span>
</a>

<style>
  .slack-join {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: #0d4f4f;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .slack-join:focus-visible {
    outline: 2px solid #e8a85c;
    outline-offset: 3px;
  }
</style>
