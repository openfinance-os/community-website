---
import MiddleLeapLogo from './MiddleLeapLogo.astro';
import NewsletterSignup from './NewsletterSignup.astro';
import { NEWSLETTER_SOURCES } from '../../lib/newsletter';

interface Props {
  lastUpdated?: string;
}

const { lastUpdated } = Astro.props;

const quickLinks = [
  { label: 'Observatory', href: '/observatory' },
  { label: 'Updates', href: '/updates' },
  { label: 'Learn', href: '/learn' },
  { label: 'Community', href: '/community' },
  { label: 'About', href: '/about' },
  { label: 'Newsletter', href: '/newsletter' },
];

const resources = [
  {
    label: 'Brand Guidelines',
    href: '/brand/openfinance-os-brand-guidelines.html',
    external: false,
  },
  {
    label: 'Official Open Finance docs',
    href: 'https://openfinanceuae.atlassian.net/wiki/spaces/OF/overview?mode=global',
    external: true,
  },
  { label: 'CBUAE', href: 'https://www.centralbank.ae', external: true },
  { label: 'GitHub', href: 'https://github.com/openfinance-os', external: true },
  { label: 'News RSS', href: '/rss.xml', external: false },
];

const formatDate = (dateStr: string) => {
  return new Date(dateStr).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
    timeZone: 'UTC',
  });
};

const getRelativeTime = (dateStr: string) => {
  const now = new Date();
  const date = new Date(dateStr);
  const diffMs = now.getTime() - date.getTime();
  const diffMins = Math.floor(diffMs / 60000);
  const diffHours = Math.floor(diffMs / 3600000);
  const diffDays = Math.floor(diffMs / 86400000);

  if (diffMins < 1) return 'just now';
  if (diffMins < 60) return `${diffMins} minute${diffMins === 1 ? '' : 's'} ago`;
  if (diffHours < 24) return `${diffHours} hour${diffHours === 1 ? '' : 's'} ago`;
  if (diffDays === 1) return 'yesterday';
  if (diffDays < 7) return `${diffDays} days ago`;
  return null; // Fall back to absolute date for older timestamps
};

const relativeTime = lastUpdated ? getRelativeTime(lastUpdated) : null;
---

<footer class="footer">
  <div class="footer-grid">
    <div class="footer-brand">
      <a href="/" class="footer-logo">
        <img
          src="/brand/logo-icon-dark.svg"
          alt=""
          width="28"
          height="28"
          class="footer-logo-img"
        />
        <span>OpenFinance-OS</span>
      </a>
      <p class="footer-tagline">Built by the community, for the community.</p>
      <p class="footer-description">
        A grassroots initiative to make the UAE Open Finance ecosystem visible, accessible, and
        welcoming.
      </p>
    </div>

    <div class="footer-links">
      <h2 class="footer-heading">Quick Links</h2>
      <ul class="footer-list">
        {quickLinks.map((link) => (
          <li>
            <a href={link.href} class="footer-link">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="footer-links">
      <h2 class="footer-heading">Resources</h2>
      <ul class="footer-list">
        {resources.map((link) => (
          <li>
            <a
              href={link.href}
              class="footer-link"
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
            >
              {link.label}
              {link.external && (
                <svg
                  width="12"
                  height="12"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path d="M7 17L17 7M17 7H7M17 7v10" />
                </svg>
              )}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="footer-links">
      <h2 class="footer-heading">Connect</h2>
      <ul class="footer-list">
        <li>
          <a
            href="https://github.com/openfinance-os"
            class="footer-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path>
            </svg>
            GitHub
          </a>
        </li>
        <li>
          <a
            href="https://github.com/openfinance-os/community-website/discussions"
            class="footer-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            Discussions
            <svg
              width="12"
              height="12"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M7 17L17 7M17 7H7M17 7v10"></path>
            </svg>
          </a>
        </li>
      </ul>
    </div>
  </div>

  <NewsletterSignup
    source={NEWSLETTER_SOURCES.footer}
    variant="footer"
    heading="Newsletter"
    description="Weekly UAE open finance briefing. One email, no spam."
  />

  <div class="footer-bottom">
    <div class="footer-bottom-inner">
      <p class="footer-meta">
        <span class="founder-credit">
          <span>A community initiative founded by</span>
          <a href="https://www.middleleap.com/" aria-label="MiddleLeap">
            <MiddleLeapLogo tone="dark" />
          </a>
        </span>
        <span class="meta-label">Open source under MIT License</span>
        {lastUpdated && (
          <>
            <span class="meta-separator" aria-hidden="true">
              ·
            </span>
            <span class="meta-timestamp" data-timestamp={lastUpdated}>
              Data updated: {relativeTime && <span class="relative-time">{relativeTime}</span>}
              {relativeTime && <span class="time-separator"> · </span>}
              <time datetime={lastUpdated}>{formatDate(lastUpdated)} UTC</time>
            </span>
          </>
        )}
      </p>
      <p class="footer-disclaimer">
        OpenFinance-OS is a community initiative and is not affiliated with, endorsed by, or
        officially connected to the CBUAE, Al Tareq Platform, or any financial institution. Always
        verify information with official sources.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: #0c3d3e;
    color: #cce4d8;
    margin-top: auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-12) var(--space-4);
  }

  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .footer-grid {
      grid-template-columns: 2fr repeat(3, 1fr);
      gap: var(--space-12);
    }

    .footer-links {
      padding-left: var(--space-6);
      border-left: 1px solid #365a55;
    }
  }

  .footer-brand {
    max-width: 280px;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
    color: #f1f7f1;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer-logo:hover {
    color: #cce4d8;
    text-decoration: none;
  }

  .footer-logo-img {
    border-radius: var(--radius-md);
  }

  .footer-tagline {
    margin-top: var(--space-4);
    font-size: 0.875rem;
    font-weight: 500;
    color: #f1f7f1;
  }

  .footer-description {
    margin-top: var(--space-2);
    font-size: 0.875rem;
    line-height: 1.6;
    color: #c1d5ce;
  }

  .footer-heading {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #adc1b9;
    margin-bottom: var(--space-4);
  }

  .footer-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.875rem;
    line-height: 1.6;
    color: #cce4d8;
    text-decoration: none;
    transition:
      color var(--transition-fast),
      text-decoration var(--transition-fast);
    position: relative;
  }

  .footer-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 0;
    height: 1px;
    background: var(--color-primary-400);
    transition: width var(--transition-fast);
  }

  .footer-link:hover {
    color: #f1f7f1;
    text-decoration: none;
  }

  .footer-link:hover::after {
    width: 100%;
  }

  .footer-link svg {
    opacity: 0.6;
  }

  .footer-bottom {
    border-top: 1px solid #365a55;
    background: rgba(0, 0, 0, 0.2);
  }

  .footer-bottom-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  @media (min-width: 640px) {
    .footer-bottom-inner {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .footer-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: #adc1b9;
  }

  .meta-separator {
    color: #adc1b9;
  }

  .founder-credit {
    flex-basis: 100%;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    column-gap: 4px;
  }

  .founder-credit a {
    color: inherit;
    display: inline-flex;
    text-decoration: none;
  }

  .meta-timestamp time {
    color: #c1d5ce;
  }

  .relative-time {
    color: #cce4d8;
    font-weight: 500;
  }

  .time-separator {
    color: #adc1b9;
  }

  .footer-disclaimer {
    font-size: 0.75rem;
    color: #adc1b9;
  }
</style>

<script>
  function getRelativeTime(dateStr: string): string | null {
    const now = new Date();
    const date = new Date(dateStr);
    const diffMs = now.getTime() - date.getTime();
    const diffMins = Math.floor(diffMs / 60000);
    const diffHours = Math.floor(diffMs / 3600000);
    const diffDays = Math.floor(diffMs / 86400000);

    if (diffMins < 1) return 'just now';
    if (diffMins < 60) return `${diffMins} minute${diffMins === 1 ? '' : 's'} ago`;
    if (diffHours < 24) return `${diffHours} hour${diffHours === 1 ? '' : 's'} ago`;
    if (diffDays === 1) return 'yesterday';
    if (diffDays < 7) return `${diffDays} days ago`;
    return null;
  }

  function updateRelativeTime() {
    const timestampEl = document.querySelector('.meta-timestamp[data-timestamp]');
    if (!timestampEl) return;

    const timestamp = timestampEl.getAttribute('data-timestamp');
    if (!timestamp) return;

    const relativeEl = timestampEl.querySelector('.relative-time');
    const separatorEl = timestampEl.querySelector('.time-separator');
    const relative = getRelativeTime(timestamp);

    if (relativeEl && relative) {
      relativeEl.textContent = relative;
    } else if (!relativeEl && relative) {
      // Create elements if they don't exist but we now need them
      const newRelative = document.createElement('span');
      newRelative.className = 'relative-time';
      newRelative.textContent = relative;

      const newSeparator = document.createElement('span');
      newSeparator.className = 'time-separator';
      newSeparator.textContent = ' · ';

      const timeEl = timestampEl.querySelector('time');
      if (timeEl) {
        timestampEl.insertBefore(newSeparator, timeEl);
        timestampEl.insertBefore(newRelative, newSeparator);
      }
    } else if (relativeEl && !relative) {
      // Remove relative time if timestamp is too old
      relativeEl.remove();
      separatorEl?.remove();
    }
  }

  // Update every minute
  setInterval(updateRelativeTime, 60000);
</script>
