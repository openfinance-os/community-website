          </svg>
        </button>
      </div>
      <button class="search-close" aria-label="Close search">
        <kbd>ESC</kbd>
      </button>
    </div>

    <div class="search-body">
      <div class="search-results" hidden>
        <div class="results-section results-participants" hidden>
