<!-- Inject search index as a data attribute for client-side access -->
<script
  id="search-index-data"
  type="application/json"
  set:html={JSON.stringify(searchIndex).replace(/</g, '\\u003c')}
/>

<script>
  // PostHog tracking helpers
  function trackSearchEvent(event: string, properties?: Record<string, unknown>): void {
    if (typeof window !== 'undefined' && (window as any).posthog) {
      (window as any).posthog.capture(event, {
        ...properties,
        page_url: window.location.pathname,
      });
    }
  }

  // Initialize search dialog
  const trigger = document.querySelector('.search-trigger');
  const dialog = document.querySelector('.search-dialog') as HTMLDialogElement | null;
  const input = document.querySelector('.search-input') as HTMLInputElement | null;
  const clearBtn = document.querySelector('.search-clear');
  const closeBtn = document.querySelector('.search-close');
  const resultsContainer = document.querySelector('.search-results');
  const emptyState = document.querySelector('.search-empty');
  const initialState = document.querySelector('.search-initial');

  // Searchable data types
  interface SearchItem {
    type: 'participant' | 'news' | 'page' | 'resource';
    title: string;
    description?: string;
    url: string;
    meta?: string;
    searchTerms?: string[];
  }

  // Load pre-built search index from embedded data
  let preloadedIndex: {
    participants: SearchItem[];
    news: SearchItem[];
    commons: SearchItem[];
    concepts: SearchItem[];
  } = { participants: [], news: [], commons: [], concepts: [] };

  try {
    const indexScript = document.getElementById('search-index-data');
    if (indexScript?.textContent) {
      preloadedIndex = JSON.parse(indexScript.textContent);
    }
  } catch (e) {
    console.warn('Could not parse search index:', e);
  }

  // Pages data (static)
  const pages: SearchItem[] = [
    {
      type: 'page',
      title: 'API Coverage & Comparison',
      description:
        'Filter published families and versions, compare registrations and export dated CSV evidence',
      url: '/observatory/coverage/',
    },
    {
      type: 'page',
      title: 'Latest Saved Ecosystem Briefing',
      description: 'Dated Watch summary with standards, operations, adoption and source links',
      url: '/observatory/briefing/',
    },
    {
      type: 'page',
      title: 'Ecosystem Watch',
      description: 'Dated activity, standards, deadlines and alerts',
      url: '/observatory/watch/',
    },
    {
      type: 'page',
      title: 'Directory Methodology',
      description:
        'Registration counts, published authorization servers, declarations and limitations',
      url: '/observatory/methodology',
    },
    {
      type: 'page',
      title: 'Observatory',
      description: 'Explore UAE Open Finance participants',
      url: '/observatory',
    },
    { type: 'page', title: 'Updates', description: 'News and updates', url: '/updates' },
    { type: 'page', title: 'Learn', description: 'Guides and documentation', url: '/learn' },
    {
      type: 'page',
      title: 'Getting Started',
      description: 'Introduction to UAE Open Finance',
      url: '/learn/getting-started',
    },
    {
      type: 'page',
      title: 'API Guide',
      description: 'Technical API documentation',
      url: '/learn/api-guide',
    },
    {
      type: 'page',
      title: 'Bank Guide',
      description: 'Guide for banks and ASPSPs',
      url: '/learn/bank-guide',
    },
    {
      type: 'page',
      title: 'TPP Guide',
      description: 'Guide for third-party providers',
      url: '/learn/tpp-guide',
    },
    {
      type: 'page',
      title: 'Glossary',
      description: 'Open Finance terminology',
      url: '/learn/glossary',
    },
    { type: 'page', title: 'FAQ', description: 'Frequently asked questions', url: '/learn/faq' },
    {
      type: 'page',
      title: 'Global Perspective',
      description: 'International Open Banking standards',
      url: '/global',
    },
    {
      type: 'page',
      title: 'Community',
      description: 'Connect with the community',
      url: '/community',
    },
    { type: 'page', title: 'About', description: 'About OpenFinance-OS', url: '/about' },
    { type: 'page', title: 'Commons', description: 'Shared community resources', url: '/commons' },
  ];

  // Combine all searchable data
  const searchData: SearchItem[] = [
    ...preloadedIndex.participants,
    ...preloadedIndex.news,
    ...preloadedIndex.commons,
    ...preloadedIndex.concepts,
    ...pages,
  ];

  // Fuzzy matching function - checks if query matches with some tolerance
  function fuzzyMatch(text: string, query: string): { match: boolean; score: number } {
    if (!text || !query) return { match: false, score: 0 };

    const lowerText = text.toLowerCase();
    const lowerQuery = query.toLowerCase();

    // Exact match
    if (lowerText === lowerQuery) return { match: true, score: 100 };

    // Contains match
    if (lowerText.includes(lowerQuery)) {
      // Boost score if it starts with the query
      if (lowerText.startsWith(lowerQuery)) return { match: true, score: 90 };
      return { match: true, score: 70 };
    }

    // Word-boundary match (e.g., searching "ADCB" matches "Abu Dhabi Commercial Bank")
    const words = lowerText.split(/\s+/);
    const queryWords = lowerQuery.split(/\s+/);

    // Check if any word starts with any query word
    for (const queryWord of queryWords) {
      if (queryWord.length < 2) continue;
      for (const word of words) {
        if (word.startsWith(queryWord)) {
          return { match: true, score: 60 };
        }
      }
    }

    // Check acronym match (e.g., "ADCB" for "Abu Dhabi Commercial Bank")
    if (lowerQuery.length >= 2 && lowerQuery.length <= 6) {
      const initials = words
        .map((w) => w.charAt(0))
        .join('')
        .toLowerCase();
      if (initials.includes(lowerQuery)) {
        return { match: true, score: 75 };
      }
    }

    // Simple typo tolerance: allow 1 character difference for queries of 4+ chars
    if (lowerQuery.length >= 4) {
      for (const word of words) {
        if (word.length >= lowerQuery.length - 1) {
          let differences = 0;
          const minLen = Math.min(word.length, lowerQuery.length);
          for (let i = 0; i < minLen; i++) {
            if (word[i] !== lowerQuery[i]) differences++;
          }
          differences += Math.abs(word.length - lowerQuery.length);
          if (differences <= 1) {
            return { match: true, score: 40 };
          }
        }
      }
    }

    return { match: false, score: 0 };
  }

  // Search function with fuzzy matching
  function search(query: string): SearchItem[] {
    if (!query.trim()) return [];
    const q = query.toLowerCase().trim();

    // Score each item
    const scored = searchData
      .map((item) => {
        let bestScore = 0;

        // Check title
        const titleResult = fuzzyMatch(item.title, q);
        if (titleResult.match) bestScore = Math.max(bestScore, titleResult.score);

        // Check description
        if (item.description) {
          const descResult = fuzzyMatch(item.description, q);
          if (descResult.match) bestScore = Math.max(bestScore, descResult.score * 0.8);
        }

        // Check meta
        if (item.meta) {
          const metaResult = fuzzyMatch(item.meta, q);
          if (metaResult.match) bestScore = Math.max(bestScore, metaResult.score * 0.6);
        }

        // Check search terms (for pre-indexed items)
        if (item.searchTerms) {
          for (const term of item.searchTerms) {
            const termResult = fuzzyMatch(term, q);
            if (termResult.match) bestScore = Math.max(bestScore, termResult.score * 0.9);
          }
        }

        return { item, score: bestScore };
      })
      .filter((x) => x.score > 0)
      .sort((a, b) => b.score - a.score)
      .slice(0, 15);

    return scored.map((x) => x.item);
  }

  // Render results
  function renderResults(results: SearchItem[]) {
    const participantsList = document.querySelector('.participants-list');
    const newsList = document.querySelector('.news-list');
    const pagesList = document.querySelector('.pages-list');
    const resourcesList = document.querySelector('.resources-list');
    const participantsSection = document.querySelector('.results-participants');
    const newsSection = document.querySelector('.results-news');
    const pagesSection = document.querySelector('.results-pages');
    const resourcesSection = document.querySelector('.results-resources');

    if (!participantsList || !newsList || !pagesList) return;

    // Clear previous results
    participantsList.innerHTML = '';
    newsList.innerHTML = '';
    pagesList.innerHTML = '';
    if (resourcesList) resourcesList.innerHTML = '';

    const participants = results.filter((r) => r.type === 'participant');
    const news = results.filter((r) => r.type === 'news');
    const pageResults = results.filter((r) => r.type === 'page');
    const resources = results.filter((r) => r.type === 'resource');

    // Show/hide sections based on results
    participantsSection?.toggleAttribute('hidden', participants.length === 0);
    newsSection?.toggleAttribute('hidden', news.length === 0);
    pagesSection?.toggleAttribute('hidden', pageResults.length === 0);
    resourcesSection?.toggleAttribute('hidden', resources.length === 0);

    // Helper to create result item with tracking
    function createResultItem(item: SearchItem, index: number): HTMLLIElement {
      const li = document.createElement('li');
      const link = document.createElement('a');
      link.href = item.url;
      link.className = 'result-item';
      link.dataset.type = item.type;
      link.dataset.title = item.title;
      link.dataset.position = String(index);
      const title = document.createElement('span');
      title.className = 'result-title';
      title.textContent = item.title;
      link.appendChild(title);
      for (const [text, className] of [
        [item.description, 'result-desc'],
        [item.meta, 'result-meta'],
      ]) {
        if (!text) continue;
        const span = document.createElement('span');
        span.className = className || '';
        span.textContent = text;
        link.appendChild(span);
      }
      li.appendChild(link);
      // Add click tracking
      li.querySelector('a')?.addEventListener('click', () => {
        trackSearchEvent('search_result_clicked', {
          result_type: item.type,
          result_title: item.title,
          result_url: item.url,
          position: index,
          query: input?.value || '',
        });
      });
      return li;
    }

    // Render participants
    participants.forEach((item, index) => {
      participantsList.appendChild(createResultItem(item, index));
    });

    // Render news
    news.forEach((item, index) => {
      newsList.appendChild(createResultItem(item, participants.length + index));
    });

    // Render pages
    pageResults.forEach((item, index) => {
      pagesList.appendChild(createResultItem(item, participants.length + news.length + index));
    });

    // Render resources (commons)
    if (resourcesList) {
      resources.forEach((item, index) => {
        resourcesList.appendChild(
          createResultItem(item, participants.length + news.length + pageResults.length + index)
        );
      });
    }
  }

  // Update UI based on search state
  function updateSearchUI(query: string, results: SearchItem[]) {
    if (!query.trim()) {
      resultsContainer?.setAttribute('hidden', '');
      emptyState?.setAttribute('hidden', '');
      initialState?.removeAttribute('hidden');
      clearBtn?.setAttribute('hidden', '');
    } else if (results.length === 0) {
      resultsContainer?.setAttribute('hidden', '');
      emptyState?.removeAttribute('hidden');
      initialState?.setAttribute('hidden', '');
      clearBtn?.removeAttribute('hidden');
    } else {
      resultsContainer?.removeAttribute('hidden');
      emptyState?.setAttribute('hidden', '');
      initialState?.setAttribute('hidden', '');
      clearBtn?.removeAttribute('hidden');
      renderResults(results);
    }
  }

  // Debounce helper
  function debounce<T extends (...args: any[]) => void>(fn: T, delay: number): T {
    let timeoutId: ReturnType<typeof setTimeout>;
    return ((...args: Parameters<T>) => {
      clearTimeout(timeoutId);
      timeoutId = setTimeout(() => fn(...args), delay);
    }) as T;
  }

  // Track search with longer debounce to capture intent, not keystrokes
  let lastTrackedQuery = '';
  const trackSearchQuery = debounce((query: string, resultsCount: number) => {
    const trimmed = query.trim();
    // Only track if query is meaningful and different from last tracked
    if (trimmed.length >= 3 && trimmed !== lastTrackedQuery) {
      lastTrackedQuery = trimmed;
      trackSearchEvent('search_query', {
        query: trimmed,
        query_length: trimmed.length,
        results_count: resultsCount,
      });
    }
  }, 800); // Longer debounce for tracking to capture final intent

  // Handle search input
  const handleSearch = debounce((query: string) => {
    const results = search(query);
    updateSearchUI(query, results);
    // Track with longer debounce
    trackSearchQuery(query, results.length);
  }, 150);

  // Open dialog
  function openSearch(trigger: 'button' | 'keyboard' = 'button') {
    dialog?.showModal();
    input?.focus();
    document.body.style.overflow = 'hidden';
    trackSearchEvent('search_opened', { trigger });
  }

  // Close dialog
  function closeSearch() {
    dialog?.close();
    if (input) input.value = '';
    updateSearchUI('', []);
    document.body.style.overflow = '';
  }

  // Event listeners
  trigger?.addEventListener('click', () => openSearch('button'));
  closeBtn?.addEventListener('click', closeSearch);
  clearBtn?.addEventListener('click', () => {
    if (input) input.value = '';
    updateSearchUI('', []);
    input?.focus();
  });

  input?.addEventListener('input', (e) => {
    const target = e.target as HTMLInputElement;
    handleSearch(target.value);
  });

  // Close on backdrop click
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) closeSearch();
  });

  // Keyboard shortcuts
  document.addEventListener('keydown', (e) => {
    // Ctrl/Cmd + K to open search
    if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
      e.preventDefault();
      if (dialog?.open) {
        closeSearch();
      } else {
        openSearch('keyboard');
      }
    }

    // ESC to close
    if (e.key === 'Escape' && dialog?.open) {
      closeSearch();
    }
  });

  // Handle result navigation with keyboard
  input?.addEventListener('keydown', (e) => {
    const items = document.querySelectorAll('.result-item');
    if (!items.length) return;

    const currentIndex = Array.from(items).findIndex((item) => item === document.activeElement);

    if (e.key === 'ArrowDown') {
      e.preventDefault();
      const nextIndex = currentIndex < items.length - 1 ? currentIndex + 1 : 0;
      (items[nextIndex] as HTMLElement).focus();
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      const prevIndex = currentIndex > 0 ? currentIndex - 1 : items.length - 1;
      (items[prevIndex] as HTMLElement).focus();
    }
  });

  // Track quick link clicks
  document.querySelectorAll('.quick-link').forEach((link) => {
    link.addEventListener('click', () => {
      const href = link.getAttribute('href') || '';
      const title =
        link.querySelector('svg + *:not(span)')?.textContent?.trim() ||
        link.textContent?.trim().split('\n')[0] ||
        '';
      trackSearchEvent('quick_link_clicked', {
        link_name: title,
        link_url: href,
      });
    });
  });
</script>

