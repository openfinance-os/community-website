---
import Badge from '@components/common/Badge.astro';

interface Props {
  title: string;
  date: Date;
  category: 'consumer' | 'business' | 'developer' | 'integration' | 'analytics';
  status: 'idea' | 'in-progress' | 'built';
  complexity: 'beginner' | 'intermediate' | 'advanced';
  author: string;
  description: string;
  apis: string[];
  slug: string;
  demoUrl?: string;
  repoUrl?: string;
}

const { title, date, category, status, complexity, author, description, apis, slug, demoUrl, repoUrl } = Astro.props;

const categoryLabels: Record<string, string> = {
  consumer: 'Consumer App',
  business: 'Business Tool',
  developer: 'Developer Tool',
  integration: 'Integration',
  analytics: 'Analytics',
};

const statusLabels: Record<string, string> = {
  idea: 'Idea',
  'in-progress': 'In Progress',
  built: 'Built',
};

const complexityLabels: Record<string, string> = {
  beginner: 'Beginner',
  intermediate: 'Intermediate',
  advanced: 'Advanced',
};

const formatDate = (d: Date) => {
  return d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
};
---

<a href={`/ideas/${slug}`} class="idea-card" data-category={category} data-status={status}>
  <div class="card-header">
    <div class="card-badges">
      <Badge variant={category} size="sm">{categoryLabels[category]}</Badge>
      <Badge variant={status} size="sm">{statusLabels[status]}</Badge>
    </div>
    <Badge variant={complexity} size="sm">{complexityLabels[complexity]}</Badge>
  </div>

  <h3 class="card-title">{title}</h3>

  <p class="card-description">{description}</p>

  {apis.length > 0 && (
    <div class="card-apis">
      <span class="apis-label">APIs:</span>
      <span class="apis-list">{apis.join(', ')}</span>
    </div>
  )}

  <div class="card-footer">
    <div class="footer-left">
      <span class="author">By {author}</span>
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
    </div>
    <div class="footer-right">
      {demoUrl && (
        <span class="has-demo" title="Has live demo">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <polygon points="10 8 16 12 10 16 10 8"></polygon>
          </svg>
        </span>
      )}
      {repoUrl && (
        <span class="has-repo" title="Has source code">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path>
          </svg>
        </span>
      )}
      <span class="read-more">
        View idea
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"></path>
        </svg>
      </span>
    </div>
  </div>
</a>

<style>
  .idea-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
    background: white;
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-xl);
    text-decoration: none;
    color: inherit;
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast),
      transform var(--transition-fast);
  }

  .idea-card:hover {
    border-color: var(--color-primary-300);
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
    text-decoration: none;
  }

  .card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .card-badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .card-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-gray-900);
    margin-bottom: var(--space-2);
    line-height: 1.4;
  }

  .idea-card:hover .card-title {
    color: var(--color-primary-700);
  }

  .card-description {
    font-size: 0.875rem;
    color: var(--color-gray-600);
    line-height: 1.6;
    margin-bottom: var(--space-3);
    flex: 1;
  }

  .card-apis {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: 0.75rem;
    margin-bottom: var(--space-4);
    padding: var(--space-2) var(--space-3);
    background: var(--color-gray-50);
    border-radius: var(--radius-md);
  }

  .apis-label {
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--color-gray-500);
  }

  .apis-list {
    font-family: var(--font-mono);
    color: var(--color-gray-700);
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-gray-100);
    margin-top: auto;
  }

  .footer-left {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .author {
    font-size: 0.8125rem;
    color: var(--color-gray-500);
  }

  .footer-left time {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-gray-400);
  }

  .footer-left time::before {
    content: '·';
    margin-right: var(--space-2);
    color: var(--color-gray-300);
  }

  .footer-right {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .has-demo,
  .has-repo {
    display: flex;
    align-items: center;
    color: var(--color-gray-400);
  }

  .read-more {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-primary-600);
  }

  .idea-card:hover .read-more {
    color: var(--color-primary-700);
  }

  .idea-card:hover .read-more svg {
    transform: translateX(4px);
  }

  .read-more svg {
    transition: transform var(--transition-fast);
  }

  /* Dark mode */
  :global([data-theme='dark']) .idea-card {
    background: var(--color-gray-100);
    border-color: var(--color-gray-200);
  }

  :global([data-theme='dark']) .idea-card:hover {
    border-color: var(--color-primary-400);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  }

  :global([data-theme='dark']) .card-title {
    color: var(--color-gray-900);
  }

  :global([data-theme='dark']) .idea-card:hover .card-title {
    color: var(--color-primary-400);
  }

  :global([data-theme='dark']) .card-description {
    color: var(--color-gray-400);
  }

  :global([data-theme='dark']) .card-apis {
    background: var(--color-gray-200);
  }

  :global([data-theme='dark']) .apis-label {
    color: var(--color-gray-400);
  }

  :global([data-theme='dark']) .apis-list {
    color: var(--color-gray-300);
  }

  :global([data-theme='dark']) .card-footer {
    border-top-color: var(--color-gray-300);
  }

  :global([data-theme='dark']) .author {
    color: var(--color-gray-500);
  }

  :global([data-theme='dark']) .read-more {
    color: var(--color-primary-400);
  }

  :global([data-theme='dark']) .idea-card:hover .read-more {
    color: var(--color-primary-300);
  }
</style>
