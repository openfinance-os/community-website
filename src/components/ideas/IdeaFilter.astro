---
interface Props {
  categories: string[];
  statuses: string[];
  categoryLabels: Record<string, string>;
  statusLabels: Record<string, string>;
}

const { categories, statuses, categoryLabels, statusLabels } = Astro.props;
---

<div class="idea-filter">
  <div class="filter-group">
    <span class="filter-label">Category:</span>
    <div class="filter-buttons" role="tablist" aria-label="Filter ideas by category">
      {
        categories.map((cat) => (
          <button
            class:list={['filter-btn', { active: cat === 'all' }]}
            data-filter-category={cat}
            role="tab"
            id={`idea-cat-${cat}`}
            aria-selected={cat === 'all' ? 'true' : 'false'}
            aria-controls="ideas-grid"
            tabindex={cat === 'all' ? 0 : -1}
          >
            {cat === 'all' ? 'All' : categoryLabels[cat] || cat}
          </button>
        ))
      }
    </div>
  </div>
  <div class="filter-group">
    <span class="filter-label">Status:</span>
    <div class="filter-buttons" role="tablist" aria-label="Filter ideas by status">
      {
        statuses.map((status) => (
          <button
            class:list={['filter-btn', 'status-btn', { active: status === 'all' }]}
            data-filter-status={status}
            role="tab"
            id={`idea-status-${status}`}
            aria-selected={status === 'all' ? 'true' : 'false'}
            aria-controls="ideas-grid"
            tabindex={status === 'all' ? 0 : -1}
          >
            {status === 'all' ? 'All' : statusLabels[status] || status}
          </button>
        ))
      }
    </div>
  </div>
</div>

<script>
  const categoryButtons = document.querySelectorAll('.idea-filter [data-filter-category]');
  const statusButtons = document.querySelectorAll('.idea-filter [data-filter-status]');
  const ideasGrid = document.getElementById('ideas-grid');
  const ideaCards = ideasGrid?.querySelectorAll('.idea-card');

  let activeCategory = 'all';
  let activeStatus = 'all';

  function filterCards() {
    ideaCards?.forEach((card) => {
      const cardCategory = card.getAttribute('data-category');
      const cardStatus = card.getAttribute('data-status');

      const matchesCategory = activeCategory === 'all' || cardCategory === activeCategory;
      const matchesStatus = activeStatus === 'all' || cardStatus === activeStatus;

      if (matchesCategory && matchesStatus) {
        (card as HTMLElement).style.display = 'flex';
      } else {
        (card as HTMLElement).style.display = 'none';
      }
    });
  }

  function activateCategoryTab(button: Element) {
    activeCategory = button.getAttribute('data-filter-category') || 'all';

    categoryButtons.forEach((btn) => {
      btn.classList.remove('active');
      btn.setAttribute('aria-selected', 'false');
      btn.setAttribute('tabindex', '-1');
    });
    button.classList.add('active');
    button.setAttribute('aria-selected', 'true');
    button.setAttribute('tabindex', '0');
    (button as HTMLElement).focus();

    filterCards();
  }

  function activateStatusTab(button: Element) {
    activeStatus = button.getAttribute('data-filter-status') || 'all';

    statusButtons.forEach((btn) => {
      btn.classList.remove('active');
      btn.setAttribute('aria-selected', 'false');
      btn.setAttribute('tabindex', '-1');
    });
    button.classList.add('active');
    button.setAttribute('aria-selected', 'true');
    button.setAttribute('tabindex', '0');
    (button as HTMLElement).focus();

    filterCards();
  }

  categoryButtons.forEach((button) => {
    button.addEventListener('click', () => activateCategoryTab(button));

    button.addEventListener('keydown', (e) => {
      const buttons = Array.from(categoryButtons);
      const index = buttons.indexOf(button);
      let newIndex = index;

      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
        e.preventDefault();
        newIndex = (index + 1) % buttons.length;
      } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        e.preventDefault();
        newIndex = (index - 1 + buttons.length) % buttons.length;
      } else if (e.key === 'Home') {
        e.preventDefault();
        newIndex = 0;
      } else if (e.key === 'End') {
        e.preventDefault();
        newIndex = buttons.length - 1;
      }

      if (newIndex !== index) {
        activateCategoryTab(buttons[newIndex]);
      }
    });
  });

  statusButtons.forEach((button) => {
    button.addEventListener('click', () => activateStatusTab(button));

    button.addEventListener('keydown', (e) => {
      const buttons = Array.from(statusButtons);
      const index = buttons.indexOf(button);
      let newIndex = index;

      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
        e.preventDefault();
        newIndex = (index + 1) % buttons.length;
      } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        e.preventDefault();
        newIndex = (index - 1 + buttons.length) % buttons.length;
      } else if (e.key === 'Home') {
        e.preventDefault();
        newIndex = 0;
      } else if (e.key === 'End') {
        e.preventDefault();
        newIndex = buttons.length - 1;
      }

      if (newIndex !== index) {
        activateStatusTab(buttons[newIndex]);
      }
    });
  });
</script>

<style>
  .idea-filter {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .filter-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .filter-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-gray-600);
    min-width: 70px;
  }

  .filter-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .filter-btn {
    padding: var(--space-2) var(--space-4);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-gray-600);
    background: white;
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-full);
    cursor: pointer;
    transition:
      color var(--transition-fast),
      background-color var(--transition-fast),
      border-color var(--transition-fast);
  }

  .filter-btn:hover {
    color: var(--color-gray-900);
    border-color: var(--color-gray-300);
  }

  .filter-btn.active {
    color: var(--color-primary-700);
    background: var(--color-primary-50);
    border-color: var(--color-primary-200);
  }

  /* Dark mode */
  :global([data-theme='dark']) .filter-label {
    color: var(--color-gray-400);
  }

  :global([data-theme='dark']) .filter-btn {
    background: var(--color-gray-200);
    border-color: var(--color-gray-300);
    color: var(--color-gray-400);
  }

  :global([data-theme='dark']) .filter-btn:hover {
    color: var(--color-gray-100);
    border-color: var(--color-gray-400);
  }

  :global([data-theme='dark']) .filter-btn.active {
    color: var(--color-primary-400);
    background: rgba(20, 184, 166, 0.15);
    border-color: var(--color-primary-500);
  }
</style>
