---
interface Profile {
  shortName?: string;
  fullName?: string;
  description?: string;
  founded?: number;
  headquarters?: {
    city: string;
    country: string;
    countryCode: string;
  };
  parentCompany?: {
    name: string;
    headquarters: string;
    countryCode: string;
  };
  type?: string;
  typeLabel?: string;
  ownership?: string;
  ownershipDetail?: string;
  marketPosition?: string;
  website?: string | null;
  specializations?: string[];
}

interface Props {
  name: string;
  legalName: string;
  status: string;
  roles: string[];
  city: string;
  apiFamilies: string[];
  hasAuthServer: boolean;
  isShariahCompliant: boolean;
  isLive?: boolean;
  profile?: Profile;
}

const { name, legalName, status, roles, city, apiFamilies, hasAuthServer, isShariahCompliant, isLive = true, profile } =
  Astro.props;

// API families configuration
const allApiFamilies = [
  { key: 'accounts', label: 'Accounts' },
  { key: 'payments', label: 'Payments' },
  { key: 'cop', label: 'CoP' },
  { key: 'products', label: 'Products' },
];

// Country flags
const countryFlags: Record<string, string> = {
  'AE': '🇦🇪',
  'GB': '🇬🇧',
  'US': '🇺🇸',
};

// Type badge colors
const typeColors: Record<string, string> = {
  'commercial-bank': 'type-blue',
  'islamic-bank': 'type-teal',
  'digital-bank': 'type-purple',
  'international-bank': 'type-amber',
  'fintech': 'type-pink',
  'infrastructure': 'type-gray',
  'payments': 'type-green',
  'insurance': 'type-indigo',
};

const isInternational = profile?.parentCompany || (profile?.headquarters?.countryCode && profile.headquarters.countryCode !== 'AE');
const hqFlag = profile?.headquarters?.countryCode ? countryFlags[profile.headquarters.countryCode] || '🌍' : '🇦🇪';
const parentFlag = profile?.parentCompany?.countryCode ? countryFlags[profile.parentCompany.countryCode] : null;

// Use profile city as fallback when API returns "Unknown"
const displayCity = city === 'Unknown' && profile?.headquarters?.city
  ? profile.headquarters.city
  : city;
---

<article class="participant-card">
  <!-- Corner decoration (matches StatCard) -->
  <div class="card-decoration" aria-hidden="true"></div>

  <!-- Header: Type Badge + Location -->
  <header class="card-header">
    <div class="header-left">
      {profile?.typeLabel ? (
        <div class:list={['type-badge', typeColors[profile.type || ''] || 'type-default']}>
          {isInternational && parentFlag && <span class="type-flag">{parentFlag}</span>}
          {profile.typeLabel}
        </div>
      ) : isLive ? (
        <div class="status-badge live">
          <span class="status-dot" />
          <span class="status-text">Live</span>
        </div>
      ) : (
        <div class="status-badge registered">
          <span class="status-text">Registered</span>
        </div>
      )}
    </div>
    <div class="location">
      <svg
        width="12"
        height="12"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
        <circle cx="12" cy="10" r="3"></circle>
      </svg>
      <span>{displayCity}</span>
    </div>
  </header>

  <!-- Name Section -->
  <div class="name-section">
    <h3 class="institution-name">{name}</h3>
    <p class="legal-name">{legalName}</p>
  </div>

  <!-- Description (if profile available) -->
  {profile?.description && (
    <p class="description">{profile.description}</p>
  )}

  <!-- Parent Company (for international banks) -->
  {profile?.parentCompany && (
    <div class="parent-company">
      <span class="parent-label">HQ:</span>
      <span class="parent-value">{profile.parentCompany.headquarters}</span>
    </div>
  )}

  <!-- Market Position (if notable) -->
  {profile?.marketPosition && (
    <div class="market-position">
      {profile.marketPosition}
    </div>
  )}

  <!-- Roles -->
  <div class="roles-section">
    <span class="roles-label">Roles</span>
    <p class="roles-list">
      {
        roles.map((role, index) => (
          <>
            <span class="role">{role}</span>
            {index < roles.length - 1 && <span class="role-separator">·</span>}
          </>
        ))
      }
    </p>
  </div>

  <!-- API Coverage -->
  <div class="api-section">
    <span class="api-label">API Coverage</span>
    <div class="api-indicators">
      {
        allApiFamilies.map((api) => {
          const isActive = apiFamilies.includes(api.key);
          return (
            <div class="api-item" class:list={[{ active: isActive }]}>
              <span class="api-dot" />
              <span class="api-name">{api.label}</span>
            </div>
          );
        })
      }
    </div>
  </div>

  <!-- Footer -->
  <footer class="card-footer">
    {isShariahCompliant && (
      <span class="shariah-badge">Islamic Banking</span>
    )}
    {profile?.website && (
      <a href={profile.website} class="website-link" target="_blank" rel="noopener noreferrer">
        Visit website
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M7 17L17 7M17 7H7M17 7v10"></path>
        </svg>
      </a>
    )}
  </footer>
</article>

<style>
  .participant-card {
    position: relative;
    background: white;
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    overflow: hidden;
    transition:
      border-color var(--transition-fast),
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .participant-card:hover {
    border-color: var(--color-primary-200);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  /* Corner decoration - matches StatCard */
  .card-decoration {
    position: absolute;
    top: 0;
    right: 0;
    width: 80px;
    height: 80px;
    background: radial-gradient(circle at top right, var(--color-primary-50) 0%, transparent 70%);
    pointer-events: none;
  }

  /* Header */
  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  /* Type Badge */
  .type-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 10px;
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .type-flag {
    font-size: 0.75rem;
  }

  .type-blue {
    background: var(--color-primary-50);
    color: var(--color-primary-700);
  }

  .type-teal {
    background: #ccfbf1;
    color: #0f766e;
  }

  .type-purple {
    background: #ede9fe;
    color: #5b21b6;
  }

  .type-amber {
    background: #fef3c7;
    color: #92400e;
  }

  .type-pink {
    background: #fce7f3;
    color: #9d174d;
  }

  .type-gray {
    background: var(--color-gray-100);
    color: var(--color-gray-600);
  }

  .type-green {
    background: #dcfce7;
    color: #166534;
  }

  .type-indigo {
    background: #e0e7ff;
    color: #3730a3;
  }

  .type-default {
    background: var(--color-gray-100);
    color: var(--color-gray-600);
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    background: var(--color-gray-100);
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-gray-500);
  }

  .status-badge.live {
    background: var(--color-primary-50);
    color: var(--color-success);
  }

  .status-badge.registered {
    background: var(--color-gray-100);
    color: var(--color-gray-500);
    border: 1px dashed var(--color-gray-300);
  }

  .status-dot {
    width: 6px;
    height: 6px;
    background: var(--color-success);
    border-radius: 50%;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.6;
      transform: scale(0.9);
    }
  }

  .location {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-gray-500);
  }

  .location svg {
    color: var(--color-gray-400);
  }

  /* Name Section */
  .name-section {
    margin-bottom: var(--space-3);
  }

  .institution-name {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-gray-900);
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin-bottom: 2px;
  }

  .legal-name {
    font-size: 0.8125rem;
    color: var(--color-gray-400);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Description */
  .description {
    font-size: 0.8125rem;
    color: var(--color-gray-600);
    line-height: 1.5;
    margin-bottom: var(--space-3);
  }

  /* Parent Company */
  .parent-company {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.75rem;
    margin-bottom: var(--space-3);
    padding: var(--space-2) var(--space-3);
    background: var(--color-gray-50);
    border-radius: var(--radius-md);
  }

  .parent-label {
    font-weight: 600;
    color: var(--color-gray-500);
  }

  .parent-value {
    color: var(--color-gray-700);
  }

  /* Market Position */
  .market-position {
    font-size: 0.6875rem;
    font-family: var(--font-mono);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-primary-600);
    margin-bottom: var(--space-4);
  }

  /* Roles Section */
  .roles-section {
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-gray-100);
  }

  .roles-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-gray-400);
    margin-bottom: var(--space-2);
  }

  .roles-list {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-gray-700);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }

  .role {
    color: var(--color-gray-700);
  }

  .role-separator {
    color: var(--color-gray-300);
  }

  /* API Section */
  .api-section {
    margin-bottom: var(--space-3);
  }

  .api-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-gray-400);
    margin-bottom: var(--space-2);
  }

  .api-indicators {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .api-item {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .api-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1.5px solid var(--color-gray-300);
    background: transparent;
    transition: all var(--transition-fast);
  }

  .api-item.active .api-dot {
    background: var(--color-primary-500);
    border-color: var(--color-primary-500);
  }

  .api-name {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-gray-400);
    transition: color var(--transition-fast);
  }

  .api-item.active .api-name {
    color: var(--color-gray-600);
  }

  /* Footer */
  .card-footer {
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-gray-100);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
  }

  .card-footer:empty {
    display: none;
  }

  .shariah-badge {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-primary-600);
    background: var(--color-primary-50);
    padding: 4px 8px;
    border-radius: var(--radius-sm);
  }

  .website-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-primary-600);
    text-decoration: none;
    margin-left: auto;
  }

  .website-link:hover {
    color: var(--color-primary-700);
    text-decoration: underline;
  }

  /* Dark mode */
  :global([data-theme='dark']) .participant-card {
    background: var(--color-gray-100);
    border-color: var(--color-gray-200);
  }

  :global([data-theme='dark']) .participant-card:hover {
    border-color: var(--color-primary-400);
  }

  :global([data-theme='dark']) .card-decoration {
    background: radial-gradient(circle at top right, var(--color-primary-900) 0%, transparent 70%);
  }

  :global([data-theme='dark']) .institution-name {
    color: var(--color-gray-50);
  }

  :global([data-theme='dark']) .legal-name {
    color: var(--color-gray-500);
  }

  :global([data-theme='dark']) .description {
    color: var(--color-gray-400);
  }

  :global([data-theme='dark']) .parent-company {
    background: var(--color-gray-200);
  }

  :global([data-theme='dark']) .parent-label {
    color: var(--color-gray-400);
  }

  :global([data-theme='dark']) .parent-value {
    color: var(--color-gray-300);
  }

  :global([data-theme='dark']) .roles-section {
    border-bottom-color: var(--color-gray-200);
  }

  :global([data-theme='dark']) .roles-label,
  :global([data-theme='dark']) .api-label {
    color: var(--color-gray-500);
  }

  :global([data-theme='dark']) .role {
    color: var(--color-gray-300);
  }

  :global([data-theme='dark']) .role-separator {
    color: var(--color-gray-500);
  }

  :global([data-theme='dark']) .api-dot {
    border-color: var(--color-gray-500);
  }

  :global([data-theme='dark']) .api-name {
    color: var(--color-gray-500);
  }

  :global([data-theme='dark']) .api-item.active .api-name {
    color: var(--color-gray-300);
  }

  :global([data-theme='dark']) .card-footer {
    border-top-color: var(--color-gray-200);
  }

  /* Responsive */
  @media (max-width: 480px) {
    .participant-card {
      padding: var(--space-4);
    }

    .institution-name {
      font-size: 1.25rem;
    }

    .api-indicators {
      gap: var(--space-2);
    }

    .description {
      display: none;
    }
  }
</style>
