---
import { participantUrl } from '@lib/participant-identity';
import { describeApiFamilies } from '@lib/taxonomy';
interface Profile {
  shortName?: string;
  fullName?: string;
  description?: string;
  founded?: number;
  headquarters?: {
    city: string;
    country: string;
    countryCode: string;
  };
  parentCompany?: {
    name: string;
    headquarters: string;
    countryCode: string;
  };
  type?: string;
  typeLabel?: string;
  ownership?: string;
  ownershipDetail?: string;
  marketPosition?: string;
  website?: string | null;
  specializations?: string[];
}

interface Props {
  id: string;
  name: string;
  legalName: string;
  shortName: string;
  status: string;
  roles: string[];
  city: string;
  apiFamilies: string[];
  hasAuthServer: boolean;
  isShariahCompliant: boolean;
  isLive?: boolean;
  profile?: Profile;
  environment?: 'production' | 'sandbox';
}

const {
  id,
  name,
  legalName,
  shortName,
  status,
  roles,
  city,
  apiFamilies,
  hasAuthServer,
  isShariahCompliant,
  isLive = hasAuthServer,
  profile,
  environment = 'production',
} = Astro.props;

const slug = id;
const detailUrl = participantUrl({ id }, environment);
const allApiFamilies = describeApiFamilies(apiFamilies);

// Country flags
const countryFlags: Record<string, string> = {
  AE: '🇦🇪',
  GB: '🇬🇧',
  US: '🇺🇸',
};

// Type badge colors
const typeColors: Record<string, string> = {
  'commercial-bank': 'type-blue',
  'islamic-bank': 'type-teal',
  'digital-bank': 'type-purple',
  'international-bank': 'type-amber',
  fintech: 'type-pink',
  infrastructure: 'type-gray',
  payments: 'type-green',
  insurance: 'type-indigo',
};

const isInternational =
  profile?.parentCompany ||
  (profile?.headquarters?.countryCode && profile.headquarters.countryCode !== 'AE');
const hqFlag = profile?.headquarters?.countryCode
  ? countryFlags[profile.headquarters.countryCode] || '🌍'
  : '🇦🇪';
const parentFlag = profile?.parentCompany?.countryCode
  ? countryFlags[profile.parentCompany.countryCode]
  : null;

// Use profile city as fallback when API returns "Unknown"
const displayCity =
  city === 'Unknown' && profile?.headquarters?.city ? profile.headquarters.city : city;
---

<a
  href={detailUrl}
  class="participant-card-link"
  data-name={name}
  data-slug={slug}
  data-environment={environment}
  data-type={profile?.type || ''}
>
  <article class="participant-card">
    <!-- Corner decoration (matches StatCard) -->
    <div class="card-decoration" aria-hidden="true"></div>

    <!-- Header: Type Badge + Location -->
    <header class="card-header">
      <div class="header-left">
        {profile?.typeLabel ? (
          <div class:list={['type-badge', typeColors[profile.type || ''] || 'type-default']}>
            {isInternational && parentFlag && <span class="type-flag">{parentFlag}</span>}
            {profile.typeLabel}
          </div>
        ) : isLive ? (
          <div class="status-badge live">
            <span class="status-dot" />
            <span class="status-text">Auth server published</span>
          </div>
        ) : (
          <div class="status-badge registered">
            <span class="status-text">Registered</span>
          </div>
        )}
      </div>
      <div class="location">
        <svg
          width="12"
          height="12"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        <span>{displayCity}</span>
      </div>
    </header>

    <!-- Name Section -->
    <div class="name-section">
      <h3 class="institution-name">{name}</h3>
      <p class="legal-name">{legalName}</p>
    </div>

    <!-- Description -->
    {profile?.description ? (
      <div class="description-wrapper">
        <p class="description">{profile.description}</p>
        <span class="read-more">Read more →</span>
      </div>
    ) : (
      <div class="description-wrapper">
        <p class="description placeholder">
          Recently registered participant – profile coming soon.
        </p>
      </div>
    )}

    <!-- Parent Company (for international banks) -->
    {profile?.parentCompany && (
      <div class="parent-company">
        <span class="parent-label">HQ:</span>
        <span class="parent-value">{profile.parentCompany.headquarters}</span>
      </div>
    )}

    <!-- Market Position (if notable) -->
    {profile?.marketPosition && <div class="market-position">{profile.marketPosition}</div>}

    <!-- Roles -->
    <div class="roles-section">
      <span class="roles-label">Roles</span>
      <p class="roles-list">
        {roles.map((role, index) => (
          <>
            <span class="role">{role}</span>
            {index < roles.length - 1 && <span class="role-separator">·</span>}
          </>
        ))}
      </p>
    </div>

    <!-- API Coverage -->
    <div class="api-section">
      <span class="api-label">API Coverage</span>
      <div class="api-indicators">
        {allApiFamilies.map((api) => {
          const isActive = apiFamilies.includes(api.key);
          return (
            <div
              class="api-item"
              class:list={[{ active: isActive }]}
              title={isActive ? 'Published in directory' : 'Not published in this snapshot'}
            >
              <span class="api-dot" />
              <span class="api-name">{api.label}</span>
            </div>
          );
        })}
      </div>
    </div>

    <!-- Footer -->
    <footer class="card-footer">
      {isShariahCompliant && <span class="shariah-badge">Directory Shariah flag</span>}
      {profile?.website && (
        <span class="website-link" data-href={profile.website} data-participant={name}>
          Visit website
          <svg
            width="12"
            height="12"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M7 17L17 7M17 7H7M17 7v10" />
          </svg>
        </span>
      )}
    </footer>
  </article>
</a>

<style>
  .participant-card-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .participant-card-link:hover {
    text-decoration: none;
  }

  .participant-card {
    position: relative;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-6) var(--space-8);
    overflow: hidden;
    transition:
      border-color var(--transition-fast),
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .participant-card:hover {
    border-color: var(--color-primary-200);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  /* Corner decoration - matches StatCard */
  .card-decoration {
    position: absolute;
    top: 0;
    right: 0;
    width: 80px;
    height: 80px;
    background: radial-gradient(circle at top right, var(--color-primary-50) 0%, transparent 70%);
    pointer-events: none;
  }

  /* Header */
  .card-header {
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .header-left {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  /* Type Badge */
  .type-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    font-family: var(--font-sans);
    font-size: 0.625rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .type-flag {
    font-size: 0.75rem;
  }

  .type-blue {
    background: var(--color-primary-50);
    color: var(--color-brand-ink);
  }

  .type-teal {
    background: #ccfbf1;
    color: #0f766e;
  }

  .type-purple {
    background: #ede9fe;
    color: #5b21b6;
  }

  .type-amber {
    background: #fef3c7;
    color: #92400e;
  }

  .type-pink {
    background: #fce7f3;
    color: #9d174d;
  }

  .type-gray {
    background: var(--color-soft);
    color: var(--color-text-secondary);
  }

  .type-green {
    background: #dcfce7;
    color: #166534;
  }

  .type-indigo {
    background: #e0e7ff;
    color: #3730a3;
  }

  .type-default {
    background: var(--color-soft);
    color: var(--color-text-secondary);
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    background: var(--color-soft);
    border-radius: var(--radius-full);
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-secondary);
  }

  .status-badge.live {
    background: var(--color-primary-50);
    color: var(--color-success-text);
  }

  .status-badge.registered {
    background: var(--color-soft);
    color: var(--color-text-secondary);
    border: 1px dashed var(--color-border);
  }

  .status-dot {
    width: 6px;
    height: 6px;
    background: var(--color-success);
    border-radius: 50%;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.6;
      transform: scale(0.9);
    }
  }

  .location {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .location svg {
    color: var(--color-text-secondary);
  }

  /* Name Section */
  .name-section {
    margin-bottom: var(--space-3);
  }

  .institution-name {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin-bottom: 2px;
  }

  .legal-name {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Description */
  .description-wrapper {
    margin-bottom: var(--space-3);
  }

  .description {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin-bottom: var(--space-1);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .description.placeholder {
    font-style: italic;
    color: var(--color-text-secondary);
  }

  .read-more {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-brand-ink);
    transition: color var(--transition-fast);
  }

  .participant-card:hover .read-more {
    color: var(--color-brand-ink);
  }

  /* Parent Company */
  .parent-company {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.75rem;
    margin-bottom: var(--space-3);
    padding: var(--space-2) var(--space-3);
    background: var(--color-surface);
    border-radius: var(--radius-md);
  }

  .parent-label {
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .parent-value {
    color: var(--color-text);
  }

  /* Market Position */
  .market-position {
    font-size: 0.6875rem;
    font-family: var(--font-sans);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-brand-ink);
    margin-bottom: var(--space-4);
  }

  /* Roles Section */
  .roles-section {
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .roles-label {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.625rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-2);
  }

  .roles-list {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text);
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }

  .role {
    color: var(--color-text);
  }

  .role-separator {
    color: var(--color-text-secondary);
  }

  /* API Section */
  .api-section {
    margin-bottom: var(--space-3);
  }

  .api-label {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.625rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-2);
  }

  .api-indicators {
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .api-item {
    min-width: 0;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .api-dot {
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1.5px solid var(--color-border);
    background: transparent;
    transition: all var(--transition-fast);
  }

  .api-item.active .api-dot {
    flex-shrink: 0;
    background: var(--color-primary-500);
    border-color: var(--color-primary-500);
  }

  .api-name {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
  }

  .api-item.active .api-name {
    color: var(--color-text-secondary);
  }

  /* Footer */
  .card-footer {
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
    min-width: 0;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
    gap: var(--space-3);
  }

  .card-footer:empty {
    display: none;
  }

  .shariah-badge {
    font-family: var(--font-sans);
    font-size: 0.625rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-brand-ink);
    background: var(--color-primary-50);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
  }

  .website-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-brand-ink);
    text-decoration: none;
    margin-left: auto;
    cursor: pointer;
  }

  .website-link:hover {
    color: var(--color-brand-ink);
    text-decoration: underline;
  }

  .website-link:focus {
    outline: 2px solid var(--color-primary-400);
    outline-offset: 2px;
    border-radius: 2px;
  }

  /* Dark mode */
  :global([data-theme='dark']) .participant-card {
    background: var(--color-soft);
    border-color: var(--color-border);
  }

  :global([data-theme='dark']) .participant-card:hover {
    border-color: var(--color-primary-400);
  }

  :global([data-theme='dark']) .card-decoration {
    background: radial-gradient(circle at top right, var(--color-primary-900) 0%, transparent 70%);
  }

  :global([data-theme='dark']) .institution-name {
    color: var(--color-text);
  }

  :global([data-theme='dark']) .legal-name {
    color: var(--color-text-secondary);
  }

  :global([data-theme='dark']) .description {
    color: var(--color-text-secondary);
  }

  :global([data-theme='dark']) .description.placeholder {
    color: var(--color-text-secondary);
  }

  :global([data-theme='dark']) .read-more {
    color: var(--color-brand-ink);
  }

  :global([data-theme='dark']) .participant-card:hover .read-more {
    color: var(--color-brand-ink);
  }

  :global([data-theme='dark']) .parent-company {
    background: var(--color-soft);
  }

  :global([data-theme='dark']) .parent-label {
    color: var(--color-text-secondary);
  }

  :global([data-theme='dark']) .parent-value {
    color: var(--color-text-secondary);
  }

  :global([data-theme='dark']) .roles-section {
    border-bottom-color: var(--color-border);
  }

  :global([data-theme='dark']) .roles-label,
  :global([data-theme='dark']) .api-label {
    color: var(--color-text-secondary);
  }

  :global([data-theme='dark']) .role {
    color: var(--color-text-secondary);
  }

  :global([data-theme='dark']) .role-separator {
    color: var(--color-text-secondary);
  }

  :global([data-theme='dark']) .api-dot {
    flex-shrink: 0;
    border-color: var(--color-border);
  }

  :global([data-theme='dark']) .api-name {
    color: var(--color-text-secondary);
  }

  :global([data-theme='dark']) .api-item.active .api-name {
    color: var(--color-text-secondary);
  }

  :global([data-theme='dark']) .card-footer {
    border-top-color: var(--color-border);
  }

  /* Responsive */
  @media (max-width: 480px) {
    .participant-card {
      padding: var(--space-5);
    }

    .institution-name {
      font-size: 1.25rem;
    }

    .api-indicators {
      gap: var(--space-2);
    }

    .description {
      -webkit-line-clamp: 1;
    }

    .read-more {
      display: none;
    }
  }
</style>

<script>
  // Guard against duplicate initialization
  (function initParticipantCardTracking() {
    const key = 'participant-card-tracking';
    if ((window as any).__analyticsInitialized?.[key]) return;
    (window as any).__analyticsInitialized = (window as any).__analyticsInitialized || {};
    (window as any).__analyticsInitialized[key] = true;

    // PostHog tracking helper
    function trackParticipantEvent(event: string, properties?: Record<string, unknown>): void {
      if ((window as any).posthog) {
        (window as any).posthog.capture(event, {
          ...properties,
          page_url: window.location.pathname,
        });
      }
    }

    // Safe URL hostname extraction
    function safeGetHostname(url: string): string | null {
      try {
        return new URL(url).hostname;
      } catch {
        return null;
      }
    }

    // Track participant card clicks
    document.querySelectorAll('.participant-card-link').forEach((card) => {
      card.addEventListener('click', (e) => {
        // Don't track if clicking on the website link (that has its own tracking)
        if ((e.target as HTMLElement).closest('.website-link')) return;

        const name = card.getAttribute('data-name') || '';
        const slug = card.getAttribute('data-slug') || '';
        const environment = card.getAttribute('data-environment') || 'production';
        const participantType = card.getAttribute('data-type') || '';

        trackParticipantEvent('participant_viewed', {
          name,
          slug,
          environment,
          participant_type: participantType,
        });
      });
    });

    // Track website link clicks
    document.querySelectorAll('.website-link').forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();

        const href = link.getAttribute('data-href') || '';
        const participantName = link.getAttribute('data-participant') || '';

        if (href) {
          const domain = safeGetHostname(href);
          trackParticipantEvent('participant_website_clicked', {
            participant_name: participantName,
            website_url: href,
            domain: domain || 'unknown',
          });

          window.open(href, '_blank');
        }
      });
    });
  })();
</script>
