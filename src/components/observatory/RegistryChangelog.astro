---
/**
 * Registry changelog — the full record of production-registry changes,
 * grouped by month, derived from the daily snapshots.
 * Rendered on /observatory (anchor #changelog).
 */
import {
  getRegistryChangelog,
  getTrackingSince,
  type ChangelogEvent,
} from '@lib/registry-changelog';
import RegistryEvent from './RegistryEvent.astro';

const all = getRegistryChangelog();
const trackingSince = getTrackingSince();

// Group by calendar month, preserving newest-first order.
const groups: { key: string; label: string; events: ChangelogEvent[] }[] = [];
for (const e of all) {
  const key = e.date.slice(0, 7);
  let g = groups.find((x) => x.key === key);
  if (!g) {
    g = {
      key,
      label: new Date(`${key}-01T00:00:00Z`).toLocaleDateString('en-GB', {
        month: 'long',
        year: 'numeric',
        timeZone: 'UTC',
      }),
      events: [],
    };
    groups.push(g);
  }
  g.events.push(e);
}
---

<section class="changelog-section" id="changelog" aria-labelledby="changelog-title">
  <header class="changelog-header">
    <h2 id="changelog-title">Registry changelog</h2>
    <p class="changelog-sub">
      Every registration, authorization-server and role change in the production registry —{' '}
      {all.length} events observed by diffing daily snapshots since {trackingSince}. Dates are when
      a change was observed, not necessarily when it took effect. The 8 October 2026 collector
      update expanded family coverage; those additions can reflect a measurement correction rather
      than a new deployment.
    </p>
  </header>

  {all.length === 0 ? (
    <p class="changelog-empty">No registry changes recorded yet.</p>
  ) : (
    <div class="changelog-groups">
      {groups.map((g) => (
        <div class="changelog-group">
          <h3 class="group-label">{g.label}</h3>
          <ol class="group-events">
            {g.events.map((e, index) => (
              <li class="cl-entry">
                <RegistryEvent event={e} id={`changelog-${g.key}-${index}`} />
              </li>
            ))}
          </ol>
        </div>
      ))}
    </div>
  )}
</section>

<style>
  .changelog-section {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-12) var(--space-4);
    scroll-margin-top: var(--space-16);
  }

  .changelog-header {
    margin-bottom: var(--space-8);
  }
  .changelog-header h2 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 500;
    margin: 0 0 var(--space-2);
    color: var(--color-text);
  }
  .changelog-sub {
    margin: 0;
    max-width: 68ch;
    font-size: 0.9rem;
    color: var(--color-text-secondary);
  }
  .changelog-empty {
    color: var(--color-text-secondary);
  }

  .changelog-groups {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
  .group-label {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }
  .group-events {
    list-style: none;
    margin: 0;
    padding: 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .cl-entry {
    min-width: 0;
    padding: var(--space-3) 0;
  }
</style>
