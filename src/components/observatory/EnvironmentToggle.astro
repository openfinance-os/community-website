---
interface Props {
  currentEnvironment: 'production' | 'sandbox';
  productionCount?: number;
  sandboxCount?: number;
}

const { currentEnvironment, productionCount = 0, sandboxCount = 0 } = Astro.props;
---

<div class="environment-toggle" data-current={currentEnvironment}>
  <div class="toggle-label">Environment</div>
  <div class="toggle-buttons">
    <a
      href="/observatory"
      class:list={['toggle-btn', { active: currentEnvironment === 'production' }]}
      aria-current={currentEnvironment === 'production' ? 'page' : undefined}
    >
      <span class="env-indicator production"></span>
      <span class="env-name">Production</span>
      {productionCount > 0 && <span class="env-count">{productionCount}</span>}
    </a>
    <a
      href="/observatory/sandbox"
      class:list={['toggle-btn', { active: currentEnvironment === 'sandbox' }]}
      aria-current={currentEnvironment === 'sandbox' ? 'page' : undefined}
    >
      <span class="env-indicator sandbox"></span>
      <span class="env-name">Sandbox</span>
      {sandboxCount > 0 && <span class="env-count">{sandboxCount}</span>}
    </a>
  </div>
</div>

<style>
  /* Theme-aware environment selector in the shared page introduction. */
  .environment-toggle {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .toggle-label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .toggle-buttons {
    min-width: 0;
    display: flex;
    background: var(--color-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    padding: 3px;
    gap: 2px;
    backdrop-filter: blur(4px);
  }

  .toggle-btn {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    background: transparent;
    border: none;
    border-radius: var(--radius-full);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: all 0.2s ease;
    text-decoration: none;
    position: relative;
  }

  .toggle-btn:hover:not(.active) {
    background: var(--color-card);
    color: var(--color-brand-ink);
  }

  .toggle-btn.active {
    background: var(--color-card);
    color: var(--color-brand-ink);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .env-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    position: relative;
  }

  .env-indicator.production {
    background: var(--color-success);
  }

  .env-indicator.sandbox {
    background: var(--color-warning);
  }

  /* Pulse animation for active production indicator */
  .toggle-btn.active .env-indicator.production::after {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: 50%;
    border: 2px solid var(--color-success);
    animation: pulse-ring 2s ease-out infinite;
  }

  @keyframes pulse-ring {
    0% {
      transform: scale(1);
      opacity: 0.8;
    }
    100% {
      transform: scale(1.8);
      opacity: 0;
    }
  }

  .env-count {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 600;
    padding: 2px 6px;
    background: var(--color-card);
    border-radius: var(--radius-full);
  }

  .toggle-btn.active .env-count {
    background: #d1e5e5;
    color: #0a3d3d;
  }

  @media (max-width: 640px) {
    .environment-toggle {
      flex-direction: column;
      align-items: flex-start;
    }

    .toggle-buttons {
      width: 100%;
    }

    .toggle-btn {
      flex: 1;
      justify-content: center;
    }
  }
</style>

<script>
  // Guard against duplicate initialization
  (function initEnvironmentToggleTracking() {
    const key = 'environment-toggle-tracking';
    if ((window as any).__analyticsInitialized?.[key]) return;
    (window as any).__analyticsInitialized = (window as any).__analyticsInitialized || {};
    (window as any).__analyticsInitialized[key] = true;

    // Track environment toggle clicks
    document.querySelectorAll('.environment-toggle .toggle-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        if ((window as any).posthog) {
          const toggle = btn.closest('.environment-toggle');
          const currentEnv = toggle?.getAttribute('data-current') || 'production';
          const href = btn.getAttribute('href') || '';
          const newEnv = href.includes('sandbox') ? 'sandbox' : 'production';

          // Only track if switching to a different environment
          if (newEnv !== currentEnv) {
            (window as any).posthog.capture('environment_switched', {
              new_environment: newEnv,
              previous_environment: currentEnv,
              page_url: window.location.pathname,
            });
          }
        }
      });
    });
  })();
</script>
