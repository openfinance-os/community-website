---
interface Props {
  currentEnvironment: 'production' | 'sandbox';
  productionCount?: number;
  sandboxCount?: number;
}

const { currentEnvironment, productionCount = 0, sandboxCount = 0 } = Astro.props;
---

<div class="environment-toggle" data-current={currentEnvironment}>
  <div class="toggle-label">Environment</div>
  <div class="toggle-buttons">
    <a
      href="/observatory"
      class:list={['toggle-btn', { active: currentEnvironment === 'production' }]}
      aria-current={currentEnvironment === 'production' ? 'page' : undefined}
    >
      <span class="env-indicator production"></span>
      <span class="env-name">Production</span>
      {productionCount > 0 && <span class="env-count">{productionCount}</span>}
    </a>
    <a
      href="/observatory/sandbox"
      class:list={['toggle-btn', { active: currentEnvironment === 'sandbox' }]}
      aria-current={currentEnvironment === 'sandbox' ? 'page' : undefined}
    >
      <span class="env-indicator sandbox"></span>
      <span class="env-name">Sandbox</span>
      {sandboxCount > 0 && <span class="env-count">{sandboxCount}</span>}
    </a>
  </div>
</div>

<style>
  .environment-toggle {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .toggle-label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-primary-200);
  }

  .toggle-buttons {
    display: flex;
    background: rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg);
    padding: 2px;
    gap: 2px;
  }

  .toggle-btn {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    background: transparent;
    border: none;
    border-radius: var(--radius-md);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-primary-200);
    cursor: pointer;
    transition: all var(--transition-fast);
    text-decoration: none;
  }

  .toggle-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    color: white;
  }

  .toggle-btn.active {
    background: white;
    color: var(--color-primary-900);
  }

  .env-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .env-indicator.production {
    background: var(--color-success);
  }

  .env-indicator.sandbox {
    background: var(--color-warning);
  }

  .toggle-btn.active .env-indicator.production {
    background: var(--color-success);
  }

  .toggle-btn.active .env-indicator.sandbox {
    background: var(--color-warning);
  }

  .env-count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0 var(--space-1);
    background: rgba(0, 0, 0, 0.1);
    border-radius: var(--radius-sm);
  }

  .toggle-btn.active .env-count {
    background: var(--color-primary-100);
  }

  @media (max-width: 640px) {
    .environment-toggle {
      flex-direction: column;
      align-items: flex-start;
    }

    .toggle-buttons {
      width: 100%;
    }

    .toggle-btn {
      flex: 1;
      justify-content: center;
    }
  }
</style>

