---
/**
 * Reading guide over the specimen-field illustration. The illustration is
 * decorative: its objects and glows do not map to registrations or status.
 */
import { Image } from 'astro:assets';
import field from '../../../public/media/observatory-field.webp';
---

<section class="evidence-band" data-theme="dark" aria-labelledby="evidence-title">
  <div class="band-art" aria-hidden="true">
    <Image
      src={field}
      widths={[640, 960, 1280, 1600]}
      sizes="(max-width: 1200px) 100vw, 1200px"
      format="webp"
      quality={74}
      alt=""
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="band-inner">
    <div class="band-lead">
      <span class="eyebrow">How to read this page</span>
      <h2 id="evidence-title">A registration is a record, not a running service.</h2>
      <div class="band-actions">
        <a href="/observatory/methodology" class="primary">
          Definitions and limitations
        </a>
        <a href="/observatory/data">Open the datasets</a>
      </div>
    </div>
    <ol class="band-points">
      <li>
        <b>Registration</b>
        <span>
          A directory ID. One legal entity can hold several, so counts are not deduplicated.
        </span>
      </li>
      <li>
        <b>Issuer</b>
        <span>
          An active authorization server with an issuer is published metadata, not evidence of
          traffic or verified availability.
        </span>
      </li>
      <li>
        <b>Flags and families</b>
        <span>Capability, Shariah and API family indicators repeat what the source declares.</span>
      </li>
    </ol>
  </div>
</section>

<style>
  .evidence-band {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: var(--radius-2xl);
    border: 1px solid #2f4944;
    background: #071f20;
    color: var(--color-text);
  }

  .band-art {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .band-art :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 70%;
  }

  .band-art::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, #071f20e6 0%, #071f2099 45%, #071f2059 100%);
  }

  .band-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-8);
    padding: var(--space-10) var(--space-8);
    align-items: end;
  }

  @media (min-width: 900px) {
    .band-inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: var(--space-12);
      padding: var(--space-14) var(--space-12);
    }
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
  }

  .eyebrow::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #e39a3c;
  }

  h2 {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--color-text);
    max-width: 14em;
  }

  .band-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    align-items: center;
    margin-top: var(--space-6);
  }

  .band-actions a {
    font-size: 0.875rem;
    color: var(--color-text);
    text-underline-offset: 4px;
  }

  .band-actions a.primary {
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-lg);
    background: #f1f7f1;
    color: #0b2c30;
    font-weight: 500;
    text-decoration: none;
  }

  .band-actions a.primary:hover {
    background: #ffffff;
  }

  .band-points {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    background: #0f34376b;
    border: 1px solid #cfe6dc2e;
    border-radius: var(--radius-xl);
    box-shadow: 0 1px 0 #ffffff14 inset;
    backdrop-filter: blur(16px) saturate(1.2);
    -webkit-backdrop-filter: blur(16px) saturate(1.2);
  }

  .band-points li {
    display: grid;
    grid-template-columns: 132px minmax(0, 1fr);
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
  }

  .band-points li + li {
    border-top: 1px solid #cfe6dc24;
  }

  .band-points b {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text);
  }

  .band-points span {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  @media (max-width: 560px) {
    .band-inner {
      padding: var(--space-8) var(--space-4);
    }

    .band-points li {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
</style>
