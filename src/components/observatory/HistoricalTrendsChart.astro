---
// Define inline type to avoid import issues
interface DataPoint {
  date: string;
  totalParticipants: number;
  liveInProduction: number;
  byRole: Record<string, number>;
  byCity: Record<string, number>;
  apiFamilyCoverage: Record<string, number>;
  tppCount: number;
  shariahCompliantCount: number;
}

interface Props {
  dataPoints: DataPoint[];
  milestones?: Array<{
    date: string;
    event: string;
    participantName?: string;
  }>;
}

const { dataPoints, milestones = [] } = Astro.props;

// Get last 30 data points for display
const displayData = dataPoints.slice(-30);

// Calculate min/max for scaling
const maxParticipants = Math.max(...displayData.map((d) => d.totalParticipants), 1);
const minParticipants = Math.min(...displayData.map((d) => d.totalParticipants), 0);

// SVG dimensions
const width = 600;
const height = 200;
const padding = { top: 20, right: 20, bottom: 40, left: 50 };
const chartWidth = width - padding.left - padding.right;
const chartHeight = height - padding.top - padding.bottom;

// Generate path data
function getPathData(points: DataPoint[]): string {
  if (points.length === 0) return '';

  const xStep = chartWidth / Math.max(points.length - 1, 1);
  const yScale = (val: number) =>
    chartHeight -
    ((val - minParticipants) / (maxParticipants - minParticipants || 1)) * chartHeight;

  return points
    .map((point, i) => {
      const x = padding.left + i * xStep;
      const y = padding.top + yScale(point.totalParticipants);
      return `${i === 0 ? 'M' : 'L'} ${x} ${y}`;
    })
    .join(' ');
}

// Generate area path
function getAreaPath(points: DataPoint[]): string {
  if (points.length === 0) return '';

  const xStep = chartWidth / Math.max(points.length - 1, 1);
  const yScale = (val: number) =>
    chartHeight -
    ((val - minParticipants) / (maxParticipants - minParticipants || 1)) * chartHeight;

  const linePath = points.map((point, i) => {
    const x = padding.left + i * xStep;
    const y = padding.top + yScale(point.totalParticipants);
    return `${i === 0 ? 'M' : 'L'} ${x} ${y}`;
  });

  const lastX = padding.left + (points.length - 1) * xStep;
  const baseline = padding.top + chartHeight;

  return `${linePath.join(' ')} L ${lastX} ${baseline} L ${padding.left} ${baseline} Z`;
}

// Get Y-axis labels
const yLabels = [];
const step = Math.ceil((maxParticipants - minParticipants) / 4) || 1;
for (let i = 0; i <= 4; i++) {
  yLabels.push(Math.round(minParticipants + i * step));
}

// Get X-axis labels (first, middle, last)
const xLabels =
  displayData.length > 0
    ? [
        { x: padding.left, label: displayData[0]?.date.slice(5) || '' },
        {
          x: padding.left + chartWidth / 2,
          label: displayData[Math.floor(displayData.length / 2)]?.date.slice(5) || '',
        },
        {
          x: padding.left + chartWidth,
          label: displayData[displayData.length - 1]?.date.slice(5) || '',
        },
      ]
    : [];

// Recent milestones
const recentMilestones = milestones.slice(-5);

// Calculate growth
const growth =
  displayData.length >= 2
    ? displayData[displayData.length - 1].totalParticipants - displayData[0].totalParticipants
    : 0;

// Generate descriptive aria-label for accessibility
const latestCount =
  displayData.length > 0 ? displayData[displayData.length - 1].totalParticipants : 0;
const earliestCount = displayData.length > 0 ? displayData[0].totalParticipants : 0;
const dateRange =
  displayData.length > 0
    ? `from ${displayData[0].date} to ${displayData[displayData.length - 1].date}`
    : '';
const trendAriaLabel = `Ecosystem growth chart showing ${latestCount} total participants ${dateRange}. ${growth > 0 ? `Growth of ${growth} participants` : growth < 0 ? `Decline of ${Math.abs(growth)} participants` : 'No change'} over the period.`;
---

<div class="historical-trends">
  <div class="header">
    <h3 class="section-title">
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
      </svg>
      Ecosystem Growth
    </h3>
    {
      displayData.length >= 2 && (
        <div
          class:list={[
            'growth-badge',
            {
              positive: growth > 0,
              negative: growth < 0,
              neutral: growth === 0,
            },
          ]}
          title={`Change in registered participants over the last ${displayData.length} days of data collection`}
        >
          {growth > 0 ? (
            <>
              <svg
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="18 15 12 9 6 15" />
              </svg>
              +{growth}
            </>
          ) : growth < 0 ? (
            <>
              <svg
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9" />
              </svg>
              {growth}
            </>
          ) : (
            <>
              <svg
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <line x1="5" y1="12" x2="19" y2="12" />
              </svg>
              No change
            </>
          )}
          <span class="period-label">30d</span>
        </div>
      )
    }
  </div>

  {
    displayData.length > 1 ? (
      <div class="chart-container">
        <svg
          viewBox={`0 0 ${width} ${height}`}
          class="trend-chart"
          role="img"
          aria-label={trendAriaLabel}
        >
          {/* Grid lines */}
          {yLabels.map((_, i) => (
            <line
              x1={padding.left}
              y1={padding.top + (i * chartHeight) / 4}
              x2={padding.left + chartWidth}
              y2={padding.top + (i * chartHeight) / 4}
              class="grid-line"
            />
          ))}

          {/* Area fill */}
          <path d={getAreaPath(displayData)} class="area-fill" />

          {/* Line */}
          <path d={getPathData(displayData)} class="trend-line" />

          {/* Data points */}
          {displayData.map((point, i) => {
            const xStep = chartWidth / Math.max(displayData.length - 1, 1);
            const yScale = (val: number) =>
              chartHeight -
              ((val - minParticipants) / (maxParticipants - minParticipants || 1)) * chartHeight;
            const x = padding.left + i * xStep;
            const y = padding.top + yScale(point.totalParticipants);

            return (
              <circle
                cx={x}
                cy={y}
                r="3"
                class="data-point"
                data-date={point.date}
                data-value={point.totalParticipants}
              />
            );
          })}

          {/* Y-axis labels */}
          {yLabels.map((label, i) => (
            <text
              x={padding.left - 10}
              y={padding.top + chartHeight - (i * chartHeight) / 4 + 4}
              class="axis-label y-label"
            >
              {label}
            </text>
          ))}

          {/* X-axis labels */}
          {xLabels.map(({ x, label }) => (
            <text x={x} y={height - 10} class="axis-label x-label">
              {label}
            </text>
          ))}
        </svg>
      </div>
    ) : (
      <div class="no-data">
        <div class="no-data-icon">
          <svg
            width="48"
            height="48"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12" />
          </svg>
        </div>
        <p class="no-data-title">Building Historical Data</p>
        <p class="no-data-description">
          Trend charts will appear after multiple days of data collection. Check back soon to see
          ecosystem growth over time.
        </p>
        <div class="no-data-meta">
          <span class="collection-status">
            <span class="status-dot" />
            Data collection active
          </span>
        </div>
      </div>
    )
  }

  {
    recentMilestones.length > 0 && (
      <div class="milestones">
        <h4 class="milestones-title">Recent Milestones</h4>
        <div class="milestones-list">
          {recentMilestones.map((milestone) => (
            <div class="milestone-item">
              <span class="milestone-date">{milestone.date}</span>
              <span class="milestone-event">{milestone.event}</span>
            </div>
          ))}
        </div>
      </div>
    )
  }
</div>

<style>
  .historical-trends {
    background: white;
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
  }

  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-4);
  }

  .section-title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-gray-900);
    margin: 0;
  }

  .section-title svg {
    color: var(--color-primary-500);
  }

  .growth-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-md);
    cursor: help;
  }

  .growth-badge svg {
    flex-shrink: 0;
  }

  .growth-badge .period-label {
    font-size: 0.625rem;
    font-weight: 500;
    opacity: 0.7;
    margin-left: var(--space-1);
    padding-left: var(--space-1);
    border-left: 1px solid currentColor;
  }

  .growth-badge.positive {
    color: var(--color-success);
    background: rgba(16, 185, 129, 0.1);
  }

  .growth-badge.negative {
    color: var(--color-gray-500);
    background: var(--color-gray-100);
  }

  .growth-badge.neutral {
    color: var(--color-gray-500);
    background: var(--color-gray-100);
  }

  .chart-container {
    margin-bottom: var(--space-4);
  }

  .trend-chart {
    width: 100%;
    height: auto;
  }

  .grid-line {
    stroke: var(--color-gray-100);
    stroke-width: 1;
  }

  .area-fill {
    fill: url(#areaGradient);
    opacity: 0.3;
  }

  .trend-line {
    fill: none;
    stroke: var(--color-primary-500);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .data-point {
    fill: var(--color-primary-500);
    stroke: white;
    stroke-width: 2;
    cursor: pointer;
    transition: r var(--transition-fast);
  }

  .data-point:hover {
    r: 5;
  }

  .axis-label {
    font-family: var(--font-mono);
    font-size: 10px;
    fill: var(--color-gray-500);
  }

  .y-label {
    text-anchor: end;
  }

  .x-label {
    text-anchor: middle;
  }

  .no-data {
    padding: var(--space-8) var(--space-6);
    text-align: center;
    background: var(--color-gray-50);
    border-radius: var(--radius-lg);
    border: 1px dashed var(--color-gray-200);
  }

  .no-data-icon {
    display: flex;
    justify-content: center;
    margin-bottom: var(--space-4);
    color: var(--color-gray-300);
  }

  .no-data-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-gray-700);
    margin-bottom: var(--space-2);
  }

  .no-data-description {
    font-size: 0.8125rem;
    color: var(--color-gray-500);
    line-height: 1.5;
    max-width: 280px;
    margin: 0 auto var(--space-4);
  }

  .no-data-meta {
    display: flex;
    justify-content: center;
  }

  .collection-status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-success);
    background: rgba(16, 185, 129, 0.1);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
  }

  .collection-status .status-dot {
    width: 6px;
    height: 6px;
    background: var(--color-success);
    border-radius: 50%;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }

  .milestones {
    border-top: 1px solid var(--color-gray-100);
    padding-top: var(--space-4);
    margin-top: var(--space-4);
  }

  .milestones-title {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-gray-700);
    margin-bottom: var(--space-3);
  }

  .milestones-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .milestone-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: 0.8125rem;
  }

  .milestone-date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-gray-500);
    min-width: 80px;
  }

  .milestone-event {
    color: var(--color-gray-700);
  }

  /* Add gradient definition */
  .trend-chart {
    overflow: visible;
  }

  /* Dark mode */
  :global([data-theme='dark']) .historical-trends {
    background: var(--color-gray-100);
    border-color: var(--color-gray-200);
  }

  :global([data-theme='dark']) .section-title {
    color: var(--color-gray-900);
  }

  :global([data-theme='dark']) .grid-line {
    stroke: var(--color-gray-200);
  }

  :global([data-theme='dark']) .axis-label {
    fill: var(--color-gray-400);
  }

  :global([data-theme='dark']) .data-point {
    stroke: var(--color-gray-100);
  }

  :global([data-theme='dark']) .no-data {
    background: var(--color-gray-200);
    border-color: var(--color-gray-300);
  }

  :global([data-theme='dark']) .no-data-icon {
    color: var(--color-gray-500);
  }

  :global([data-theme='dark']) .no-data-title {
    color: var(--color-gray-300);
  }

  :global([data-theme='dark']) .no-data-description {
    color: var(--color-gray-400);
  }

  :global([data-theme='dark']) .milestones {
    border-top-color: var(--color-gray-200);
  }

  :global([data-theme='dark']) .milestones-title {
    color: var(--color-gray-300);
  }

  :global([data-theme='dark']) .milestone-date {
    color: var(--color-gray-400);
  }

  :global([data-theme='dark']) .milestone-event {
    color: var(--color-gray-300);
  }
</style>

<svg width="0" height="0" style="position: absolute;">
  <defs>
    <linearGradient id="areaGradient" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color: var(--color-primary-500); stop-opacity: 0.4"></stop>
      <stop offset="100%" style="stop-color: var(--color-primary-500); stop-opacity: 0"></stop>
    </linearGradient>
  </defs>
</svg>
