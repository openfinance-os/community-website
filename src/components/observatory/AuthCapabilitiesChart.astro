---
interface Props {
  cibaCount: number;
  dcrCount: number;
  redirectCount: number;
  totalParticipants: number;
}

const { cibaCount, dcrCount, redirectCount, totalParticipants } = Astro.props;

const capabilities = [
  {
    name: 'CIBA',
    fullName: 'Client Initiated Backchannel Authentication',
    count: cibaCount,
    percentage: totalParticipants ? Math.round((cibaCount / totalParticipants) * 100) : 0,
    description: 'Decoupled authentication for enhanced security',
  },
  {
    name: 'DCR',
    fullName: 'Dynamic Client Registration',
    count: dcrCount,
    percentage: totalParticipants ? Math.round((dcrCount / totalParticipants) * 100) : 0,
    description: 'Automated TPP onboarding capability',
  },
  {
    name: 'Redirect',
    fullName: 'OAuth Redirect Flow',
    count: redirectCount,
    percentage: totalParticipants ? Math.round((redirectCount / totalParticipants) * 100) : 0,
    description: 'Standard OAuth 2.0 redirect authentication',
  },
];
---

<div class="auth-capabilities">
  <h3 class="section-title">
    <svg
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
      <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
    </svg>
    Declared Authorization Capabilities
  </h3>
  <p class="section-description">
    Directory flags declared true. Unmarked capabilities have not been tested.
  </p>

  <div class="capabilities-list">
    {capabilities.map((cap) => (
      <div class:list={['capability-item', { 'zero-state': cap.percentage === 0 }]}>
        <div class="capability-header">
          <div class="capability-name">
            <span class="name-abbr">{cap.name}</span>
            <span class="name-full">{cap.fullName}</span>
          </div>
          <div class="capability-stats">
            <span class="stat-count">
              {cap.count}/{totalParticipants}
            </span>
            <span class="stat-percentage">{cap.percentage}%</span>
          </div>
        </div>
        <div class="capability-bar-container">
          <div class="capability-bar" style={`width: ${Math.max(cap.percentage, 0)}%`} />
        </div>
        <div class="capability-description">
          {cap.percentage === 0 ? 'Not declared true in the directory' : cap.description}
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .auth-capabilities {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
  }

  .section-title {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--space-1);
  }

  .section-title svg {
    color: var(--color-brand-ink);
  }

  .section-description {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-6);
  }

  .capabilities-list {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .capability-item {
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .capability-item:last-child {
    padding-bottom: 0;
    border-bottom: none;
  }

  .capability-header {
    min-width: 0;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: var(--space-2);
  }

  .capability-name {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .name-abbr {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .name-full {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }

  .capability-stats {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .stat-count {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
  }

  .stat-percentage {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-brand-ink);
  }

  .capability-bar-container {
    height: 6px;
    background: var(--color-soft);
    border-radius: var(--radius-full);
    overflow: hidden;
    margin-bottom: var(--space-2);
  }

  .capability-bar {
    height: 100%;
    background: linear-gradient(90deg, var(--color-primary-500), var(--color-primary-400));
    border-radius: var(--radius-full);
    transition: width 0.6s ease-out;
  }

  .capability-description {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }

  /* Zero state styling for 0% capabilities */
  .capability-item.zero-state .name-abbr {
    color: var(--color-text-secondary);
  }

  .capability-item.zero-state .stat-percentage {
    color: var(--color-text-secondary);
  }

  .capability-item.zero-state .capability-bar-container {
    background: repeating-linear-gradient(
      -45deg,
      var(--color-soft),
      var(--color-soft) 4px,
      var(--color-surface) 4px,
      var(--color-surface) 8px
    );
  }

  .capability-item.zero-state .capability-description {
    font-style: italic;
    color: var(--color-text-secondary);
  }

  /* Dark mode */
  :global([data-theme='dark']) .auth-capabilities {
    background: var(--color-soft);
    border-color: var(--color-border);
  }

  :global([data-theme='dark']) .section-title {
    color: var(--color-text);
  }

  :global([data-theme='dark']) .section-description {
    color: var(--color-text-secondary);
  }

  :global([data-theme='dark']) .capability-item {
    border-bottom-color: var(--color-border);
  }

  :global([data-theme='dark']) .name-abbr {
    color: var(--color-text);
  }

  :global([data-theme='dark']) .name-full {
    color: var(--color-text-secondary);
  }

  :global([data-theme='dark']) .stat-count {
    color: var(--color-text-secondary);
  }

  :global([data-theme='dark']) .capability-bar-container {
    background: var(--color-soft);
  }

  :global([data-theme='dark']) .capability-description {
    color: var(--color-text-secondary);
  }

  :global([data-theme='dark']) .capability-item.zero-state .name-abbr {
    color: var(--color-text-secondary);
  }

  :global([data-theme='dark']) .capability-item.zero-state .capability-bar-container {
    background: repeating-linear-gradient(
      -45deg,
      var(--color-soft),
      var(--color-soft) 4px,
      var(--color-soft) 4px,
      var(--color-soft) 8px
    );
  }

  :global([data-theme='dark']) .capability-item.zero-state .capability-description {
    color: var(--color-text-secondary);
  }
</style>
