---
interface Props {
  cibaCount: number;
  dcrCount: number;
  redirectCount: number;
  totalParticipants: number;
}

const { cibaCount, dcrCount, redirectCount, totalParticipants } = Astro.props;

const capabilities = [
  {
    name: 'CIBA',
    fullName: 'Client Initiated Backchannel Authentication',
    count: cibaCount,
    percentage: Math.round((cibaCount / totalParticipants) * 100),
    description: 'Decoupled authentication for enhanced security',
  },
  {
    name: 'DCR',
    fullName: 'Dynamic Client Registration',
    count: dcrCount,
    percentage: Math.round((dcrCount / totalParticipants) * 100),
    description: 'Automated TPP onboarding capability',
  },
  {
    name: 'Redirect',
    fullName: 'OAuth Redirect Flow',
    count: redirectCount,
    percentage: Math.round((redirectCount / totalParticipants) * 100),
    description: 'Standard OAuth 2.0 redirect authentication',
  },
];
---

<div class="auth-capabilities">
  <h3 class="section-title">
    <svg
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
      <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
    </svg>
    Authorization Capabilities
  </h3>
  <p class="section-description">Technical capabilities supported by participants</p>

  <div class="capabilities-list">
    {
      capabilities.map((cap) => (
        <div class="capability-item">
          <div class="capability-header">
            <div class="capability-name">
              <span class="name-abbr">{cap.name}</span>
              <span class="name-full">{cap.fullName}</span>
            </div>
            <div class="capability-stats">
              <span class="stat-count">
                {cap.count}/{totalParticipants}
              </span>
              <span class="stat-percentage">{cap.percentage}%</span>
            </div>
          </div>
          <div class="capability-bar-container">
            <div class="capability-bar" style={`width: ${cap.percentage}%`} />
          </div>
          <div class="capability-description">{cap.description}</div>
        </div>
      ))
    }
  </div>
</div>

<style>
  .auth-capabilities {
    background: white;
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
  }

  .section-title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-gray-900);
    margin-bottom: var(--space-1);
  }

  .section-title svg {
    color: var(--color-primary-500);
  }

  .section-description {
    font-size: 0.8125rem;
    color: var(--color-gray-500);
    margin-bottom: var(--space-6);
  }

  .capabilities-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .capability-item {
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-gray-100);
  }

  .capability-item:last-child {
    padding-bottom: 0;
    border-bottom: none;
  }

  .capability-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: var(--space-2);
  }

  .capability-name {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .name-abbr {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-gray-900);
  }

  .name-full {
    font-size: 0.75rem;
    color: var(--color-gray-500);
  }

  .capability-stats {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .stat-count {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-gray-600);
  }

  .stat-percentage {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-primary-600);
  }

  .capability-bar-container {
    height: 6px;
    background: var(--color-gray-100);
    border-radius: var(--radius-full);
    overflow: hidden;
    margin-bottom: var(--space-2);
  }

  .capability-bar {
    height: 100%;
    background: linear-gradient(90deg, var(--color-primary-500), var(--color-primary-400));
    border-radius: var(--radius-full);
    transition: width 0.6s ease-out;
  }

  .capability-description {
    font-size: 0.75rem;
    color: var(--color-gray-500);
  }
</style>
