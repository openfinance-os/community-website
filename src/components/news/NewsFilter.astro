---
interface Props {
  types: string[];
  typeLabels: Record<string, string>;
}

const { types, typeLabels } = Astro.props;
---

<div class="news-filter">
  <div class="filter-buttons" role="tablist" aria-label="Filter news by type">
    {
      types.map((type, index) => (
        <button
          class:list={['filter-btn', { active: type === 'all' }]}
          data-filter={type}
          role="tab"
          id={`news-tab-${type}`}
          aria-selected={type === 'all' ? 'true' : 'false'}
          aria-controls="news-grid"
          tabindex={type === 'all' ? 0 : -1}
        >
          {type === 'all' ? 'All' : typeLabels[type] || type}
        </button>
      ))
    }
  </div>
</div>

<script>
  const filterButtons = document.querySelectorAll('.news-filter .filter-btn');
  const newsGrid = document.getElementById('news-grid');
  const newsCards = newsGrid?.querySelectorAll('.news-card');

  function activateTab(button: Element) {
    const filter = button.getAttribute('data-filter');

    // Update active state and tabindex
    filterButtons.forEach((btn) => {
      btn.classList.remove('active');
      btn.setAttribute('aria-selected', 'false');
      btn.setAttribute('tabindex', '-1');
    });
    button.classList.add('active');
    button.setAttribute('aria-selected', 'true');
    button.setAttribute('tabindex', '0');
    (button as HTMLElement).focus();

    // Filter cards
    newsCards?.forEach((card) => {
      const cardType = card.getAttribute('data-type');
      if (filter === 'all' || cardType === filter) {
        (card as HTMLElement).style.display = 'flex';
      } else {
        (card as HTMLElement).style.display = 'none';
      }
    });
  }

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => activateTab(button));

    // Keyboard navigation for tabs
    button.addEventListener('keydown', (e) => {
      const buttons = Array.from(filterButtons);
      const index = buttons.indexOf(button);
      let newIndex = index;

      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
        e.preventDefault();
        newIndex = (index + 1) % buttons.length;
      } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        e.preventDefault();
        newIndex = (index - 1 + buttons.length) % buttons.length;
      } else if (e.key === 'Home') {
        e.preventDefault();
        newIndex = 0;
      } else if (e.key === 'End') {
        e.preventDefault();
        newIndex = buttons.length - 1;
      }

      if (newIndex !== index) {
        activateTab(buttons[newIndex]);
      }
    });
  });
</script>

<style>
  .news-filter {
    margin-bottom: var(--space-8);
  }

  .filter-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .filter-btn {
    padding: var(--space-2) var(--space-4);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-gray-600);
    background: white;
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-full);
    cursor: pointer;
    transition:
      color var(--transition-fast),
      background-color var(--transition-fast),
      border-color var(--transition-fast);
  }

  .filter-btn:hover {
    color: var(--color-gray-900);
    border-color: var(--color-gray-300);
  }

  .filter-btn.active {
    color: var(--color-primary-700);
    background: var(--color-primary-50);
    border-color: var(--color-primary-200);
  }
</style>
