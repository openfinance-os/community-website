---
import Badge from '@components/common/Badge.astro';

interface Props {
  title: string;
  date: Date;
  type: 'official' | 'milestone' | 'community' | 'global' | 'opinion';
  author: string;
  description?: string;
  slug: string;
}

const { title, date, type, author, description, slug } = Astro.props;

const typeLabels: Record<string, string> = {
  official: 'Regulatory',
  milestone: 'Ecosystem',
  community: 'Community',
  global: 'International',
  opinion: 'Opinion',
};

const formatDate = (d: Date) => {
  return d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
};
---

<a href={`/news/${slug}`} class="news-card" data-type={type}>
  <div class="card-header">
    <Badge variant={type} size="sm">{typeLabels[type]}</Badge>
    <time datetime={date.toISOString()}>{formatDate(date)}</time>
  </div>

  <h3 class="card-title">{title}</h3>

  {description && (
    <p class="card-description">{description}</p>
  )}

  <div class="card-footer">
    <span class="author">By {author}</span>
    <span class="read-more">
      Read more
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
    </span>
  </div>
</a>

<style>
  .news-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
    background: white;
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-xl);
    text-decoration: none;
    color: inherit;
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast),
      transform var(--transition-fast);
  }

  .news-card:hover {
    border-color: var(--color-primary-300);
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
    text-decoration: none;
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-3);
  }

  .card-header time {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-gray-500);
  }

  .card-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-gray-900);
    margin-bottom: var(--space-2);
    line-height: 1.4;
  }

  .news-card:hover .card-title {
    color: var(--color-primary-700);
  }

  .card-description {
    font-size: 0.875rem;
    color: var(--color-gray-600);
    line-height: 1.6;
    margin-bottom: var(--space-4);
    flex: 1;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-gray-100);
    margin-top: auto;
  }

  .author {
    font-size: 0.8125rem;
    color: var(--color-gray-500);
  }

  .read-more {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-primary-600);
  }

  .news-card:hover .read-more {
    color: var(--color-primary-700);
  }

  .news-card:hover .read-more svg {
    transform: translateX(4px);
  }

  .read-more svg {
    transition: transform var(--transition-fast);
  }
</style>
