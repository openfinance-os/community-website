---
import Badge from '@components/common/Badge.astro';

interface Props {
  title: string;
  date: Date;
  type: 'official' | 'milestone' | 'community' | 'global' | 'opinion';
  region: 'uae' | 'mena' | 'global';
  author: string;
  description?: string;
  slug: string;
  source?: string;
  external?: boolean;
}

const { title, date, type, region, author, description, slug, source, external } = Astro.props;

const href = external && source ? source : `/news/${slug}`;
const isExternal = external && source;

// Extract readable source name from URL for external articles
const getSourceName = (url: string): string => {
  try {
    const hostname = new URL(url).hostname.replace('www.', '');
    // Map common domains to readable names
    const domainNames: Record<string, string> = {
      'gulfbusiness.com': 'Gulf Business',
      'gulfnews.com': 'Gulf News',
      'zawya.com': 'Zawya',
      'whitecase.com': 'White & Case',
      'rulebook.centralbank.ae': 'CBUAE',
      'centralbank.ae': 'CBUAE',
      'khaleejtimes.com': 'Khaleej Times',
      'arabianbusiness.com': 'Arabian Business',
      'thenationalnews.com': 'The National',
    };
    return domainNames[hostname] || hostname;
  } catch {
    return 'External';
  }
};

const sourceName = isExternal && source ? getSourceName(source) : null;

const typeLabels: Record<string, string> = {
  official: 'Regulatory',
  milestone: 'Ecosystem',
  community: 'Community',
  global: 'International',
  opinion: 'Opinion',
};

const regionLabels: Record<string, string> = {
  uae: 'UAE',
  mena: 'MENA',
  global: 'Global',
};

// Map region to badge variant (global needs different key to avoid collision with type)
const regionVariant = region === 'global' ? 'region-global' : region;

const formatDate = (d: Date) => {
  return d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
};
---

<a
  href={href}
  class="news-card"
  data-type={type}
  data-region={region}
  data-title={title}
  data-slug={slug}
  data-external={isExternal ? 'true' : 'false'}
  data-source={source || ''}
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noopener noreferrer' : undefined}
>
  <div class="card-header">
    <div class="badges">
      <Badge variant={type} size="sm">{typeLabels[type]}</Badge>
      <Badge variant={regionVariant} size="sm">{regionLabels[region]}</Badge>
    </div>
    <time datetime={date.toISOString()}>{formatDate(date)}</time>
  </div>

  <h3 class="card-title">{title}</h3>

  {description && <p class="card-description">{description}</p>}

  <div class="card-footer">
    <span class="author">{isExternal ? `via ${sourceName}` : `By ${author}`}</span>
    <span class="read-more">
      {isExternal ? 'View source' : 'Read more'}
      {
        isExternal ? (
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M7 17L17 7M17 7H7M17 7v10" />
          </svg>
        ) : (
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        )
      }
    </span>
  </div>
</a>

<style>
  .news-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-6) var(--space-8);
    background: white;
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-xl);
    text-decoration: none;
    color: inherit;
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast),
      transform var(--transition-fast);
  }

  .news-card:hover {
    border-color: var(--color-primary-300);
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
    text-decoration: none;
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-3);
  }

  .card-header time {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-gray-500);
  }

  .badges {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .card-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-gray-900);
    margin-bottom: var(--space-3);
    line-height: 1.4;
  }

  .news-card:hover .card-title {
    color: var(--color-primary-700);
  }

  .card-description {
    font-size: 0.875rem;
    color: var(--color-gray-600);
    line-height: 1.6;
    margin-bottom: var(--space-4);
    flex: 1;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-gray-100);
    margin-top: auto;
  }

  .author {
    font-size: 0.8125rem;
    color: var(--color-gray-500);
  }

  .read-more {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-primary-600);
  }

  .news-card:hover .read-more {
    color: var(--color-primary-700);
  }

  .news-card:hover .read-more svg {
    transform: translateX(4px);
  }

  .read-more svg {
    transition: transform var(--transition-fast);
  }

  /* Dark mode */
  :global([data-theme='dark']) .news-card {
    background: var(--color-gray-100);
    border-color: var(--color-gray-200);
  }

  :global([data-theme='dark']) .news-card:hover {
    border-color: var(--color-primary-400);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  }

  :global([data-theme='dark']) .card-header time {
    color: var(--color-gray-400);
  }

  :global([data-theme='dark']) .card-title {
    color: var(--color-gray-900);
  }

  :global([data-theme='dark']) .news-card:hover .card-title {
    color: var(--color-primary-400);
  }

  :global([data-theme='dark']) .card-description {
    color: var(--color-gray-400);
  }

  :global([data-theme='dark']) .card-footer {
    border-top-color: var(--color-gray-300);
  }

  :global([data-theme='dark']) .author {
    color: var(--color-gray-500);
  }

  :global([data-theme='dark']) .read-more {
    color: var(--color-primary-400);
  }

  :global([data-theme='dark']) .news-card:hover .read-more {
    color: var(--color-primary-300);
  }
</style>

<script>
  // Guard against duplicate initialization
  (function initNewsCardTracking() {
    const key = 'news-card-tracking';
    if ((window as any).__analyticsInitialized?.[key]) return;
    (window as any).__analyticsInitialized = (window as any).__analyticsInitialized || {};
    (window as any).__analyticsInitialized[key] = true;

    // Track news card clicks
    document.querySelectorAll('.news-card').forEach((card) => {
      card.addEventListener('click', () => {
        if ((window as any).posthog) {
          const title = card.getAttribute('data-title') || '';
          const slug = card.getAttribute('data-slug') || '';
          const type = card.getAttribute('data-type') || '';
          const region = card.getAttribute('data-region') || '';
          const isExternal = card.getAttribute('data-external') === 'true';
          const source = card.getAttribute('data-source') || '';

          (window as any).posthog.capture('news_article_clicked', {
            title,
            slug,
            type,
            region,
            is_external: isExternal,
            source: isExternal ? source : 'internal',
            page_url: window.location.pathname,
          });
        }
      });
    });
  })();
</script>
