---
interface Props {
  types: string[];
  typeLabels?: Record<string, string>;
}

const { types, typeLabels = {} } = Astro.props;

const defaultLabels: Record<string, string> = {
  all: 'All',
  meetup: 'Meetup',
  hackathon: 'Hackathon',
  webinar: 'Webinar',
  conference: 'Conference',
  workshop: 'Workshop',
};

const labels = { ...defaultLabels, ...typeLabels };
---

<div class="event-filter" role="tablist" aria-label="Filter events by type">
  {
    types.map((type) => (
      <button
        class:list={['filter-pill', { active: type === 'all' }]}
        data-filter={type}
        role="tab"
        id={`event-tab-${type}`}
        aria-selected={type === 'all' ? 'true' : 'false'}
        aria-controls="events-content"
        tabindex={type === 'all' ? 0 : -1}
      >
        {labels[type] || type}
      </button>
    ))
  }
</div>

<style>
  .event-filter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .filter-pill {
    padding: var(--space-2) var(--space-4);
    background: transparent;
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-full);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-gray-600);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .filter-pill:hover {
    border-color: var(--color-gray-300);
    color: var(--color-gray-900);
  }

  .filter-pill.active {
    background: var(--color-primary-600);
    border-color: var(--color-primary-600);
    color: white;
  }

  .filter-pill.active:hover {
    background: var(--color-primary-700);
    border-color: var(--color-primary-700);
  }

  /* Dark mode */
  :global([data-theme='dark']) .filter-pill {
    border-color: var(--color-gray-300);
    color: var(--color-gray-400);
  }

  :global([data-theme='dark']) .filter-pill:hover {
    border-color: var(--color-gray-400);
    color: var(--color-gray-200);
  }

  :global([data-theme='dark']) .filter-pill.active {
    background: var(--color-primary-500);
    border-color: var(--color-primary-500);
    color: white;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // PostHog tracking helper
    function trackFilterEvent(event: string, properties?: Record<string, unknown>): void {
      if (typeof window !== 'undefined' && (window as any).posthog) {
        (window as any).posthog.capture(event, {
          ...properties,
          page_url: window.location.pathname,
        });
      }
    }

    const filterContainer = document.querySelector('.event-filter');
    const pills = filterContainer?.querySelectorAll('.filter-pill');
    const eventCards = document.querySelectorAll('.event-card');
    let activeFilter = 'all';

    function activateTab(pill: Element) {
      if (!pills) return;
      const filter = pill.getAttribute('data-filter');
      const previousFilter = activeFilter;

      // Update active state and tabindex
      pills.forEach((p) => {
        p.classList.remove('active');
        p.setAttribute('aria-selected', 'false');
        p.setAttribute('tabindex', '-1');
      });
      pill.classList.add('active');
      pill.setAttribute('aria-selected', 'true');
      pill.setAttribute('tabindex', '0');
      (pill as HTMLElement).focus();

      // Track filter change
      if (filter && filter !== previousFilter) {
        activeFilter = filter;
        trackFilterEvent('filter_applied', {
          filter_type: 'event_type',
          filter_value: filter,
          previous_value: previousFilter,
        });
      }

      // Filter cards
      eventCards.forEach((card) => {
        const cardType = card.getAttribute('data-type');
        if (filter === 'all' || cardType === filter) {
          (card as HTMLElement).style.display = '';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });

      // Update empty state visibility
      const upcomingSection = document.querySelector('.upcoming-events');
      const pastSection = document.querySelector('.past-events');

      [upcomingSection, pastSection].forEach((section) => {
        if (section) {
          const visibleCards = section.querySelectorAll(
            '.event-card:not([style*="display: none"])'
          );
          const emptyState = section.querySelector('.empty-state');
          if (emptyState) {
            (emptyState as HTMLElement).style.display = visibleCards.length === 0 ? '' : 'none';
          }
        }
      });
    }

    pills?.forEach((pill) => {
      pill.addEventListener('click', () => activateTab(pill));

      // Keyboard navigation for tabs
      pill.addEventListener('keydown', (e) => {
        const ke = e as KeyboardEvent;
        if (!pills) return;
        const pillsArray = Array.from(pills);
        const index = pillsArray.indexOf(pill);
        let newIndex = index;

        if (ke.key === 'ArrowRight' || ke.key === 'ArrowDown') {
          ke.preventDefault();
          newIndex = (index + 1) % pillsArray.length;
        } else if (ke.key === 'ArrowLeft' || ke.key === 'ArrowUp') {
          ke.preventDefault();
          newIndex = (index - 1 + pillsArray.length) % pillsArray.length;
        } else if (ke.key === 'Home') {
          ke.preventDefault();
          newIndex = 0;
        } else if (ke.key === 'End') {
          ke.preventDefault();
          newIndex = pillsArray.length - 1;
        }

        if (newIndex !== index) {
          activateTab(pillsArray[newIndex]);
        }
      });
    });
  });
</script>
