---
import { Image } from 'astro:assets';
import poster from '../../../public/media/shared-horizon-poster.webp';
const heightRatio = poster.height / poster.width;
---

<div
  class="hero-film"
  data-hero-film
  style={`--film-ratio: ${poster.width} / ${poster.height}; --film-rise: ${heightRatio * 0.46}; --film-max-offset: ${1600 * heightRatio * 0.46 - 164}px; --film-mobile-offset: ${118 - 700 * heightRatio * 0.46}px`}
>
  <div class="hero-film-media" aria-hidden="true">
    <div class="hero-film-scene">
      <Image
        class="hero-film-poster"
        src={poster}
        widths={[480, 640, 960, 1280, 1600, 1920]}
        sizes="(max-width: 700px) 700px, (max-width: 1600px) 100vw, 1600px"
        format="webp"
        quality={78}
        alt=""
        width={poster.width}
        height={poster.height}
        loading="eager"
        decoding="async"
      />
      <video
        id="shared-horizon-video"
        class="hero-film-video"
        data-src="/media/shared-horizon-hero.mp4"
        width={poster.width}
        height={poster.height}
        preload="none"
        muted
        playsinline
        loop
        tabindex="-1"
      ></video>
    </div>
    <div class="hero-film-protection"></div>
  </div>
</div>

<script>
  const film = document.querySelector<HTMLElement>('[data-hero-film]');
  const video = film?.querySelector<HTMLVideoElement>('video');

  if (film && video) {
    const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
    const connection = (
      navigator as Navigator & {
        connection?: EventTarget & { saveData?: boolean };
      }
    ).connection;
    let inView = !('IntersectionObserver' in window);
    let failed = false;

    const automaticPlaybackAllowed = () => !motionPreference.matches && !connection?.saveData;
    const playbackAllowed = () =>
      !failed && inView && !document.hidden && automaticPlaybackAllowed();

    const play = async () => {
      if (!playbackAllowed() || !video.paused) return;
      // Keep motion-reduced and data-saving visits on the still without fetching the film.
      if (!video.getAttribute('src')) video.src = video.dataset.src!;
      video.muted = true;
      try {
        await video.play();
      } catch {
        film.classList.remove('has-video');
      }
    };

    const syncPlayback = () => {
      if (!playbackAllowed()) {
        video.pause();
        if (!automaticPlaybackAllowed()) film.classList.remove('has-video');
      } else {
        void play();
      }
    };

    video.addEventListener('playing', () => {
      if (!playbackAllowed()) {
        video.pause();
        return;
      }
      film.classList.add('has-video');
    });
    video.addEventListener('error', () => {
      failed = true;
      film.classList.remove('has-video');
      video.pause();
    });
    motionPreference.addEventListener('change', syncPlayback);
    connection?.addEventListener?.('change', syncPlayback);
    document.addEventListener('visibilitychange', syncPlayback);

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        ([entry]) => {
          inView = entry.isIntersecting;
          syncPlayback();
        },
        { threshold: 0.05 }
      ).observe(film);
    }

    syncPlayback();
  }
</script>

<style>
  .hero-film {
    --film-blend: normal;
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .hero-film-media {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--color-surface);
  }
  .hero-film-scene {
    position: absolute;
    left: 50%;
    /* Align the abstract arch with the shore room below the directory caption. */
    bottom: calc(-1 * clamp(0px, calc(100vw * var(--film-rise) - 164px), var(--film-max-offset)));
    width: min(100%, 1600px);
    aspect-ratio: var(--film-ratio);
    transform: translateX(-50%);
    mix-blend-mode: var(--film-blend);
    mask-image:
      linear-gradient(180deg, transparent, #000 70px),
      linear-gradient(90deg, transparent, #000 3%, #000 97%, transparent);
    mask-composite: intersect;
  }
  .hero-film-poster,
  .hero-film-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
  }
  .hero-film-video {
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .has-video .hero-film-video {
    opacity: 1;
  }
  .hero-film-protection {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        var(--color-surface),
        color-mix(in srgb, var(--color-surface) 72%, transparent) 30%,
        transparent 58%
      ),
      linear-gradient(
        180deg,
        var(--color-surface),
        color-mix(in srgb, var(--color-surface) 40%, transparent) 28%,
        transparent 58%
      );
  }
  :global([data-theme='dark']) .hero-film {
    --film-blend: soft-light;
  }
  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme='light'])) .hero-film {
      --film-blend: soft-light;
    }
  }
  @media (max-width: 700px) {
    .hero-film-scene {
      left: auto;
      right: 0;
      bottom: var(--film-mobile-offset);
      width: 700px;
      transform: none;
    }
    .hero-film-protection {
      background: linear-gradient(
        180deg,
        var(--color-surface) 55%,
        color-mix(in srgb, var(--color-surface) 86%, transparent) 76%,
        transparent 94%
      );
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-film-video {
      transition: none;
    }
  }
</style>
