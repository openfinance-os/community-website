---
import { Image } from 'astro:assets';
import poster from '../../../public/media/shared-horizon-poster.webp';
const heightRatio = poster.height / poster.width;
---

<div
  class="hero-film"
  data-hero-film
  style={`--film-ratio: ${poster.width} / ${poster.height}; --film-rise: ${heightRatio * 0.46}; --film-max-offset: ${1600 * heightRatio * 0.46 - 164}px; --film-mobile-offset: ${118 - 700 * heightRatio * 0.46}px`}
>
  <div class="hero-film-media" aria-hidden="true">
    <div class="hero-film-scene">
      <Image
        class="hero-film-poster"
        src={poster}
        widths={[480, 640, 960, 1280, 1600, 1920]}
        sizes="(max-width: 700px) 700px, (max-width: 1600px) 100vw, 1600px"
        format="webp"
        quality={78}
        alt=""
        width={poster.width}
        height={poster.height}
        loading="eager"
        decoding="async"
      />
      <video
        id="shared-horizon-video"
        class="hero-film-video"
        data-src="/media/shared-horizon-hero.mp4"
        width={poster.width}
        height={poster.height}
        preload="none"
        muted
        playsinline
        loop
        tabindex="-1"
      ></video>
    </div>
    <div class="hero-film-protection"></div>
  </div>
  <button
    class="hero-film-control"
    data-hero-film-control
    type="button"
    aria-controls="shared-horizon-video"
    hidden
  >
    <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
      <path data-hero-film-icon d="M5 3 13 8 5 13Z"></path>
    </svg>
    <span data-hero-film-label>Play background film</span>
  </button>
</div>

<script>
  const film = document.querySelector<HTMLElement>('[data-hero-film]');
  const video = film?.querySelector<HTMLVideoElement>('video');
  const control = film?.querySelector<HTMLButtonElement>('[data-hero-film-control]');
  const label = film?.querySelector<HTMLElement>('[data-hero-film-label]');
  const icon = film?.querySelector<SVGPathElement>('[data-hero-film-icon]');

  if (film && video && control && label && icon) {
    const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
    const mobilePreference = window.matchMedia('(max-width: 700px)');
    const connection = (
      navigator as Navigator & {
        connection?: EventTarget & { saveData?: boolean };
      }
    ).connection;
    let inView = !('IntersectionObserver' in window);
    let userPaused = false;
    let explicitlyRequested = false;
    let failed = false;

    const automaticPlaybackAllowed = () =>
      !motionPreference.matches && !mobilePreference.matches && !connection?.saveData;

    const playbackAllowed = () =>
      !failed &&
      inView &&
      !document.hidden &&
      !userPaused &&
      (automaticPlaybackAllowed() || explicitlyRequested);

    const updateControl = () => {
      const playing = !video.paused;
      label.textContent = playing ? 'Pause background film' : 'Play background film';
      icon.setAttribute('d', playing ? 'M4 3h3v10H4Zm5 0h3v10H9Z' : 'M5 3 13 8 5 13Z');
    };

    const play = async () => {
      if (!playbackAllowed() || !video.paused) return;
      // A data attribute keeps mobile, motion-reduced and data-saving visits unfetched.
      if (!video.getAttribute('src')) video.src = video.dataset.src!;
      video.muted = true;
      try {
        await video.play();
      } catch {
        film.classList.remove('has-video');
        updateControl();
      }
    };

    const syncPlayback = () => {
      if (!playbackAllowed()) {
        video.pause();
        if (!automaticPlaybackAllowed() && !explicitlyRequested) {
          film.classList.remove('has-video');
        }
      } else {
        void play();
      }
    };

    const preferenceChanged = () => {
      // A new device or preference setting takes precedence over an earlier manual play.
      explicitlyRequested = false;
      syncPlayback();
    };

    video.addEventListener('playing', () => {
      if (!playbackAllowed()) {
        video.pause();
        return;
      }
      film.classList.add('has-video');
      updateControl();
    });
    video.addEventListener('pause', updateControl);
    video.addEventListener('error', () => {
      failed = true;
      film.classList.remove('has-video');
      video.pause();
      control.hidden = true;
    });
    control.addEventListener('click', () => {
      if (!video.paused) {
        userPaused = true;
        explicitlyRequested = false;
        video.pause();
      } else {
        userPaused = false;
        explicitlyRequested = true;
        syncPlayback();
      }
    });
    motionPreference.addEventListener('change', preferenceChanged);
    mobilePreference.addEventListener('change', preferenceChanged);
    connection?.addEventListener?.('change', preferenceChanged);
    document.addEventListener('visibilitychange', syncPlayback);

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        ([entry]) => {
          inView = entry.isIntersecting;
          syncPlayback();
        },
        { threshold: 0.05 }
      ).observe(film);
    }

    control.hidden = false;
    syncPlayback();
  }
</script>

<style>
  .hero-film {
    --film-blend: normal;
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .hero-film-media {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--color-surface);
  }
  .hero-film-scene {
    position: absolute;
    left: 50%;
    /* Align the abstract arch with the shore room below the directory caption. */
    bottom: calc(-1 * clamp(0px, calc(100vw * var(--film-rise) - 164px), var(--film-max-offset)));
    width: min(100%, 1600px);
    aspect-ratio: var(--film-ratio);
    transform: translateX(-50%);
    mix-blend-mode: var(--film-blend);
    mask-image:
      linear-gradient(180deg, transparent, #000 70px),
      linear-gradient(90deg, transparent, #000 3%, #000 97%, transparent);
    mask-composite: intersect;
  }
  .hero-film-poster,
  .hero-film-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
  }
  .hero-film-video {
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .has-video .hero-film-video {
    opacity: 1;
  }
  .hero-film-protection {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        var(--color-surface),
        color-mix(in srgb, var(--color-surface) 72%, transparent) 30%,
        transparent 58%
      ),
      linear-gradient(
        180deg,
        var(--color-surface),
        color-mix(in srgb, var(--color-surface) 40%, transparent) 28%,
        transparent 58%
      );
  }
  .hero-film-control {
    position: absolute;
    left: max(24px, calc((100% - 1224px) / 2));
    bottom: 24px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 8px 12px;
    color: var(--color-text);
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: 0.75rem;
    pointer-events: auto;
    cursor: pointer;
  }
  .hero-film-control[hidden] {
    display: none;
  }
  .hero-film-control:hover {
    border-color: var(--color-brand-ink);
  }
  .hero-film-control:focus-visible {
    outline: 2px solid var(--color-brand-ink);
    outline-offset: 3px;
  }
  :global([data-theme='dark']) .hero-film {
    --film-blend: soft-light;
  }
  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme='light'])) .hero-film {
      --film-blend: soft-light;
    }
  }
  @media (max-width: 700px) {
    .hero-film-scene {
      left: auto;
      right: 0;
      bottom: var(--film-mobile-offset);
      width: 700px;
      transform: none;
    }
    .hero-film-protection {
      background: linear-gradient(
        180deg,
        var(--color-surface) 55%,
        color-mix(in srgb, var(--color-surface) 86%, transparent) 76%,
        transparent 94%
      );
    }
    .hero-film-control {
      left: auto;
      right: 20px;
      bottom: 14px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-film-video {
      transition: none;
    }
  }
</style>
