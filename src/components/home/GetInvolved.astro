---
// No props needed - static content
---

<section class="get-involved">
  <div class="container">
    <div class="content-wrapper">
      <div class="text-content">
        <h2 class="section-title">Get Involved</h2>
        <p class="section-description">
          OpenFinance-OS is community-driven and open source. Whether you're a developer, fintech professional, or banking expert — there's a place for you here.
        </p>

        <div class="involvement-options">
          <a
            href="https://github.com/organizations/openfinance-os/"
            class="option-card"
            target="_blank"
            rel="noopener noreferrer"
          >
            <div class="option-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path
                  d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
                ></path>
              </svg>
            </div>
            <div class="option-content">
              <span class="option-title">Contribute Code</span>
              <span class="option-description">Submit PRs, report issues, or help with documentation</span>
            </div>
            <div class="option-arrow">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M7 17L17 7M17 7H7M17 7v10"></path>
              </svg>
            </div>
          </a>

          <a
            href="https://github.com/openfinance-os/community/discussions"
            class="option-card"
            target="_blank"
            rel="noopener noreferrer"
          >
            <div class="option-icon discussion-icon">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
              </svg>
            </div>
            <div class="option-content">
              <span class="option-title">Join Discussions</span>
              <span class="option-description">Share ideas, ask questions, and connect with others</span>
            </div>
            <div class="option-arrow">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M7 17L17 7M17 7H7M17 7v10"></path>
              </svg>
            </div>
          </a>

          <a href="/commons" class="option-card">
            <div class="option-icon commons-icon">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="12" y1="18" x2="12" y2="12"></line>
                <line x1="9" y1="15" x2="15" y2="15"></line>
              </svg>
            </div>
            <div class="option-content">
              <span class="option-title">Share Knowledge</span>
              <span class="option-description">Contribute guides, tutorials, or research to the Commons</span>
            </div>
            <div class="option-arrow">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7"></path>
              </svg>
            </div>
          </a>
        </div>
      </div>

      <div class="visual-content">
        <div class="community-card">
          <div class="community-badge">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polygon
                points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"
              ></polygon>
            </svg>
            Open Source
          </div>
          <h3>Built by the Community</h3>
          <p>
            This site is 100% community-owned. No corporate sponsors. No paid placements. Just people who care about open ecosystems.
          </p>
          <div class="principles">
            <div class="principle">
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
              >
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>Independent</span>
            </div>
            <div class="principle">
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
              >
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>Transparent</span>
            </div>
            <div class="principle">
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
              >
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>Community-first</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .get-involved {
    padding: var(--space-16) var(--space-4);
    background: var(--color-gray-50);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .content-wrapper {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: start;
  }

  @media (min-width: 1024px) {
    .content-wrapper {
      grid-template-columns: 1.2fr 1fr;
      gap: var(--space-12);
    }
  }

  .section-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-gray-900);
    margin-bottom: var(--space-3);
  }

  .section-description {
    font-size: 1rem;
    color: var(--color-gray-600);
    line-height: 1.6;
    margin-bottom: var(--space-6);
    max-width: 520px;
  }

  .involvement-options {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .option-card {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    background: white;
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-xl);
    text-decoration: none;
    color: inherit;
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast),
      transform var(--transition-fast);
  }

  .option-card:hover {
    border-color: var(--color-primary-300);
    box-shadow: var(--shadow-md);
    transform: translateX(4px);
    text-decoration: none;
  }

  .option-card:focus-visible {
    outline: 2px solid var(--color-primary-500);
    outline-offset: 2px;
  }

  .option-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: var(--color-gray-900);
    color: white;
    border-radius: var(--radius-lg);
  }

  .discussion-icon {
    background: var(--color-primary-600);
  }

  .commons-icon {
    background: var(--color-accent-500);
  }

  .option-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .option-title {
    font-weight: 600;
    color: var(--color-gray-900);
    font-size: 0.9375rem;
  }

  .option-card:hover .option-title {
    color: var(--color-primary-700);
  }

  .option-description {
    font-size: 0.8125rem;
    color: var(--color-gray-500);
  }

  .option-arrow {
    flex-shrink: 0;
    color: var(--color-gray-400);
    transition:
      color var(--transition-fast),
      transform var(--transition-fast);
  }

  .option-card:hover .option-arrow {
    color: var(--color-primary-500);
    transform: translate(2px, -2px);
  }

  /* Visual Content / Community Card */
  .visual-content {
    display: flex;
    align-items: flex-start;
    justify-content: center;
  }

  @media (min-width: 1024px) {
    .visual-content {
      padding-top: var(--space-8);
    }
  }

  .community-card {
    padding: var(--space-8);
    background: linear-gradient(135deg, var(--color-primary-700) 0%, var(--color-primary-800) 100%);
    border-radius: var(--radius-2xl);
    color: white;
    max-width: 380px;
  }

  .community-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    background: rgba(255, 255, 255, 0.15);
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    font-weight: 500;
    margin-bottom: var(--space-4);
  }

  .community-card h3 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: var(--space-3);
  }

  .community-card p {
    font-size: 0.9375rem;
    opacity: 0.9;
    line-height: 1.6;
    margin-bottom: var(--space-5);
  }

  .principles {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .principle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: 0.8125rem;
    font-weight: 500;
    opacity: 0.9;
  }

  .principle svg {
    color: var(--color-accent-300);
  }

  /* Dark mode */
  :global([data-theme='dark']) .get-involved {
    background: var(--color-gray-100);
  }

  :global([data-theme='dark']) .section-title {
    color: var(--color-gray-900);
  }

  :global([data-theme='dark']) .section-description {
    color: var(--color-gray-400);
  }

  :global([data-theme='dark']) .option-card {
    background: var(--color-gray-200);
    border-color: var(--color-gray-300);
  }

  :global([data-theme='dark']) .option-card:hover {
    border-color: var(--color-primary-400);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.25);
  }

  :global([data-theme='dark']) .option-icon {
    background: var(--color-gray-100);
    color: var(--color-gray-900);
  }

  :global([data-theme='dark']) .discussion-icon {
    background: var(--color-primary-600);
    color: white;
  }

  :global([data-theme='dark']) .commons-icon {
    background: var(--color-accent-500);
    color: white;
  }

  :global([data-theme='dark']) .option-title {
    color: var(--color-gray-900);
  }

  :global([data-theme='dark']) .option-card:hover .option-title {
    color: var(--color-primary-400);
  }

  :global([data-theme='dark']) .option-description {
    color: var(--color-gray-500);
  }

  :global([data-theme='dark']) .option-arrow {
    color: var(--color-gray-500);
  }

  :global([data-theme='dark']) .option-card:hover .option-arrow {
    color: var(--color-primary-400);
  }
</style>
