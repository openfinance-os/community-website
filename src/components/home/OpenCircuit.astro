    overflow: hidden;
  }
  .circuit-copy {
    padding: 60px 48px;
    align-self: center;
    position: relative;
    z-index: 1;
  }
  .circuit-people {
    color: #c1d5ce;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    margin-bottom: 24px;
  }
  h2 {
    font-size: clamp(2rem, 3.1vw, 2.75rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    color: #f2f5ef;
    line-height: 1.1;
    margin-bottom: 22px;
  }
  .circuit-description {
    color: #c1d5ce;
    font-size: 0.9375rem;
    line-height: 1.7;
    max-width: 36ch;
    margin-bottom: 26px;
  }
  .circuit-copy a {
    display: inline-flex;
    gap: 18px;
    color: #e8a85c;
    font-size: 0.875rem;
    text-underline-offset: 4px;
  }
  .hero-circuit {
    position: relative;
    min-height: 400px;
  }
  .circuit-media {
    position: absolute;
    inset: 0 0 65px;
    overflow: hidden;
  }
  .circuit-poster,
  .circuit-video {
    position: absolute;
    inset: 0 auto 0 -60%;
    width: 160%;
    max-width: none;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }
  .circuit-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, #082e30, transparent 20%);
    pointer-events: none;
  }
  .circuit-video {
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .has-video .circuit-video {
    opacity: 1;
  }
  .circuit-caption {
    position: absolute;
    left: 28px;
    right: 28px;
    bottom: 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    color: #c1d5ce;
    font-size: 0.75rem;
  }
  .circuit-control {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 8px 12px;
    border: 1px solid #c1d5ce66;
    border-radius: var(--radius-md);
    background: #082e30;
    color: #f2f5ef;
    font-size: 0.75rem;
    cursor: pointer;
  }
  .circuit-control[hidden] {
    display: none;
  }
  .circuit-control:hover {
    border-color: #e8a85c;
    color: #f5c989;
  }
  .circuit-control:focus-visible {
    outline-color: #e8a85c;
    outline-offset: 4px;
  }
  @media (max-width: 760px) {
    .open-circuit {
      padding: 0 20px 40px;
    }
    .circuit-inner {
      grid-template-columns: 1fr;
    }
    .circuit-copy {
      padding: 32px 28px 0;
    }
    .circuit-description {
      max-width: 48ch;
    }
    .hero-circuit {
      min-height: 320px;
    }
    .circuit-media {
      bottom: 70px;
    }
    .circuit-caption {
      left: 24px;
      right: 24px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .circuit-video {
      transition: none;
    }
  }
</style>
