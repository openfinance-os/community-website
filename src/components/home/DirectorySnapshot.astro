---
import {
  compactAmount,
  signed,
  sparklinePoints,
  type HeroActivity,
  type HeroDirectoryStats,
} from '@lib/hero-stats';
import { registryDefinitions } from '@lib/registry-definitions';
interface DirectoryObservation {
  registered: number;
  apiFamilies: string[];
  observedAt: string;
  stats: HeroDirectoryStats;
}
interface Props {
  production: DirectoryObservation;
  sandbox: DirectoryObservation | null;
  activity?: HeroActivity | null;
}
const { production, sandbox, activity } = Astro.props;
const monthLabel = (ym: string) =>
  new Date(`${ym}-01T00:00:00Z`).toLocaleDateString('en-GB', {
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });
const pct = (n: number) => `${n > 0 ? '+' : n < 0 ? '−' : ''}${Math.abs(n).toFixed(0)}%`;
const environments = [
  { id: 'production', label: 'Production', data: production },
  ...(sandbox ? [{ id: 'sandbox', label: 'Sandbox directory', data: sandbox }] : []),
];
const monthYear = (value: string) =>
  new Date(value).toLocaleDateString('en-GB', { month: 'short', year: 'numeric', timeZone: 'UTC' });
const date = (value: string) =>
  new Date(value).toLocaleDateString('en-GB', {
    day: '2-digit',
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC',
  });
// One mark per registration; the last `added` marks (net growth since the first
// saved observation) are highlighted.
const marks = (total: number, added: number) =>
  Array.from({ length: total }, (_, i) => {
    const angle = (i / total) * Math.PI * 2 - Math.PI / 2;
    const point = (r: number) =>
      `${(62 + Math.cos(angle) * r).toFixed(2)} ${(62 + Math.sin(angle) * r).toFixed(2)}`;
    return { d: `M${point(51)}L${point(59)}`, added: i >= total - Math.max(0, added) };
  });
---

<div class="directory-snapshot" data-directory-snapshot>
  <div class="panel-label">
    <span>The ecosystem, at a glance</span>
    <span>UAE / Directory snapshot</span>
  </div>
  <section class="snapshot-card" aria-label="Directory snapshot preview">
    <div class="panel-top">
      <h2 class="panel-title">
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="9"></circle>
          <circle cx="12" cy="12" r="4"></circle>
          <circle cx="12" cy="12" r="1"></circle>
        </svg>
        Observatory
      </h2>
      <div class="directory-tabs" role="tablist" aria-label="Directory environment" hidden>
        {environments.map(({ id, label }, index) => (
          <button
            id={`directory-tab-${id}`}
            data-environment={id}
            role="tab"
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-controls={`directory-panel-${id}`}
            tabindex={index === 0 ? 0 : -1}
          >
            {label}
          </button>
        ))}
      </div>
    </div>
    <div class="panels">
      {environments.map(({ id, label, data }, index) => (
        <div
          id={`directory-panel-${id}`}
          role="tabpanel"
          aria-labelledby={`directory-tab-${id}`}
          hidden={index !== 0}
        >
          <div class="directory-art">
            <div class="network-grid" aria-hidden="true" />
            <div class="hero-stat">
              <svg class="dial" viewBox="0 0 124 124" aria-hidden="true">
                {marks(data.registered, data.stats.sinceFirst).map((m) => (
                  <path d={m.d} class={m.added ? 'added' : undefined} />
                ))}
              </svg>
              <strong>{data.registered}</strong>
              <span>{id} directory registrations</span>
              <small>
                Observed <time datetime={data.observedAt}>{date(data.observedAt)} UTC</time>
              </small>
            </div>
            <dl class="stat-list">
              <div class="stat-cell growth">
                <dt>Growth</dt>
                <dd>
                  <strong>{signed(data.stats.sinceFirst)}</strong>
                  <span>
                    since {monthYear(data.stats.firstDate)} ({data.stats.firstCount})
                  </span>
                  <svg
                    class="sparkline"
                    viewBox="0 0 96 18"
                    preserveAspectRatio="none"
                    role="img"
                    aria-label={`${label} registrations from ${data.stats.firstCount} to ${data.registered}`}
                  >
                    <polyline points={sparklinePoints(data.stats.series, 96, 18)} />
                  </svg>
                </dd>
              </div>
              {data.stats.recentChange !== null && (
                <div class="stat-cell">
                  <dt>Last {data.stats.windowDays} days</dt>
                  <dd>
                    <strong>{signed(data.stats.recentChange)}</strong>
                    <span>net new</span>
                  </dd>
                </div>
              )}
              <div class="stat-cell" title={registryDefinitions.hasAuthServer}>
                <dt>With issuer</dt>
                <dd>
                  <strong>
                    {data.stats.withIssuer}
                    <small>/ {data.registered}</small>
                  </strong>
                  <span>list an authorization server</span>
                </dd>
              </div>
            </dl>
          </div>
          <div class="family-section">
            <strong class="family-heading">API families</strong>
            <ul class="families" aria-label="Registrations per published API family">
              {data.stats.familyCoverage.map(({ family, count }) => (
                <li>
                  <span class="family-name">{family}</span>
                  <b>
                    {count}
                    <span class="sr-only"> registrations</span>
                  </b>
                </li>
              ))}
            </ul>
          </div>
          <p class="panel-foot">
            Directory registration does not establish operational status.{' '}
            <a href="/observatory/coverage">Source and evidence →</a>
          </p>
        </div>
      ))}
    </div>
    {activity && (
      <section class="activity" aria-labelledby="hero-activity-title">
        <div class="activity-heading">
          <h3 id="hero-activity-title">Activity on the rails</h3>
          <span>{monthLabel(activity.month)} · public API Hub logs</span>
        </div>
        <dl class="activity-row">
          <div>
            <dt>API calls</dt>
            <dd>
              <strong>{activity.calls.month.toLocaleString('en-GB')}</strong>
              <span>
                <em>{pct(activity.calls.momPct)}</em> on the month ·{' '}
                {compactAmount(activity.calls.twelveMonths)} in 12 months
              </span>
            </dd>
          </div>
          <div>
            <dt>Accepted payments</dt>
            <dd>
              <strong>
                <small>{activity.payments.currency}</small>
                {compactAmount(activity.payments.month)}
              </strong>
              <span>
                <em>{pct(activity.payments.momPct)}</em> on the month · {activity.payments.currency}{' '}
                {compactAmount(activity.payments.twelveMonths)} in 12 months
              </span>
            </dd>
          </div>
        </dl>
        <p class="activity-foot">
          Observed in public operational logs, not official statistics.{' '}
          <a href="/observatory/watch/">Ecosystem Watch →</a>
        </p>
      </section>
    )}
  </section>
  <div class="snapshot-caption">
    <span>Saved directory observations, with source context.</span>
    <a href="/observatory/data">
      Open data <span aria-hidden="true">↗</span>
    </a>
  </div>
</div>

<script>
  const snapshot = document.querySelector<HTMLElement>('[data-directory-snapshot]');
  if (snapshot) {
    const tabs = Array.from(snapshot.querySelectorAll<HTMLButtonElement>('[data-environment]'));
    const panels = Array.from(snapshot.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
    const select = (tab: HTMLButtonElement) => {
      tabs.forEach((item) => {
        item.setAttribute('aria-selected', String(item === tab));
        item.tabIndex = item === tab ? 0 : -1;
      });
      panels.forEach((panel) => {
        panel.hidden = panel.id !== tab.getAttribute('aria-controls');
      });
    };
    snapshot.querySelector<HTMLElement>('[role="tablist"]')!.hidden = false;
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (event) => {
        let next: HTMLButtonElement | undefined;
        if (event.key === 'ArrowRight') next = tabs[(index + 1) % tabs.length];
        if (event.key === 'ArrowLeft') next = tabs[(index - 1 + tabs.length) % tabs.length];
        if (event.key === 'Home') next = tabs[0];
        if (event.key === 'End') next = tabs[tabs.length - 1];
        if (next) {
          event.preventDefault();
          select(next);
          next.focus();
        }
      });
    });
  }
</script>

<style>
  .directory-snapshot {
    min-width: 0;
  }
  .panel-label {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    color: var(--color-text-secondary);
    font-size: 0.6875rem;
    margin-bottom: 10px;
  }
  .panel-label > :first-child {
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .snapshot-card {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    overflow: hidden;
    box-shadow: 0 22px 65px rgb(24 61 42 / 0.04);
  }
  .panel-top {
    padding: 11px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .panel-title {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0;
  }
  .panel-title svg {
    color: var(--color-brand-ink);
    flex-shrink: 0;
  }
  .directory-tabs {
    display: flex;
    gap: 2px;
    padding: 3px;
    background: var(--color-soft);
    border-radius: var(--radius-md);
  }
  .directory-tabs[hidden] {
    display: none;
  }
  /* Both environments share one grid cell, so the card keeps the height of the
     taller one and does not jump when the tab changes. */
  .panels {
    display: grid;
  }
  [role='tabpanel'] {
    grid-area: 1 / 1;
    min-width: 0;
    display: grid;
    grid-template-rows: 1fr auto auto;
  }
  [role='tabpanel'][hidden] {
    visibility: hidden;
  }
  .directory-tabs button {
    border: 0;
    background: transparent;
    color: var(--color-text-secondary);
    padding: 6px 10px;
    font-size: 0.6875rem;
    border-radius: 4px;
    cursor: pointer;
  }
  .directory-tabs button[aria-selected='true'] {
    background: var(--color-card);
    color: var(--color-text);
    box-shadow: 0 1px 4px rgb(0 0 0 / 0.05);
  }
  .directory-art {
    background: #0c3d3e;
    position: relative;
    overflow: hidden;
    color: #edf5ef;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
  }
  .network-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(#bfd7cd09 1px, transparent 1px),
      linear-gradient(90deg, #bfd7cd09 1px, transparent 1px);
    background-size: 32px 32px;
  }
  .hero-stat {
    position: relative;
    display: flex;
    align-items: center;
    flex-direction: column;
    text-align: center;
    gap: 2px;
    padding: 20px 12px;
  }
  .hero-stat strong {
    font-size: 3.75rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.06em;
  }
  .hero-stat span {
    font-size: 0.6875rem;
    color: #c6d9cf;
    max-width: 14ch;
    line-height: 1.35;
  }
  .hero-stat small {
    margin-top: 6px;
    font-size: 0.5625rem;
    color: #a9c3b7;
    white-space: nowrap;
  }
  .stat-list {
    position: relative;
    margin: 0;
    padding: 6px 20px 6px 0;
  }
  .stat-cell {
    display: grid;
    grid-template-columns: 84px minmax(0, 1fr);
    align-items: baseline;
    gap: 10px;
    padding: 9px 0;
  }
  .stat-cell + .stat-cell {
    border-top: 1px solid #bfd9cc22;
  }
  .stat-cell dt {
    font-size: 0.5625rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: #a9c3b7;
    white-space: nowrap;
  }
  .stat-cell dd {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 8px;
  }
  .stat-cell strong {
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }
  .stat-cell strong small {
    font-size: 0.6875rem;
    letter-spacing: 0;
    color: #c6d9cf;
    margin-left: 2px;
  }
  .stat-cell span {
    font-size: 0.6875rem;
    line-height: 1.35;
    color: #c6d9cf;
  }
  .sparkline {
    flex-basis: 100%;
    max-width: 120px;
    height: 16px;
    margin-top: 4px;
    overflow: visible;
  }
  .sparkline polyline {
    fill: none;
    stroke: #e8a85c;
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
    stroke-linejoin: round;
  }
  .family-section {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 20px;
  }
  .family-heading {
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--color-text);
    white-space: nowrap;
  }
  .families {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .families li {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    border: 1px solid var(--color-border);
    padding: 3px 4px 3px 7px;
    border-radius: 5px;
    font-size: 0.6875rem;
    color: var(--color-text-secondary);
  }
  .families b {
    font-weight: 600;
    color: var(--color-text);
    background: var(--color-soft);
    border-radius: 3px;
    padding: 0 4px;
    font-variant-numeric: tabular-nums;
  }
  .panel-foot {
    padding: 0 20px 11px;
    font-size: 0.6875rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
  }
  .panel-foot a,
  .activity-foot a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
    white-space: nowrap;
  }
  .activity {
    border-top: 1px solid var(--color-border);
    padding: 12px 20px 12px;
  }
  .activity-heading {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 8px;
  }
  .activity-heading h3 {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0;
  }
  .activity-heading span {
    font-size: 0.6875rem;
    color: var(--color-text-secondary);
    text-align: right;
  }
  .activity-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    margin: 0;
  }
  .activity-row dt {
    font-size: 0.5625rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--color-text-secondary);
    margin-bottom: 2px;
    white-space: nowrap;
  }
  .activity-row dd {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .activity-row strong {
    font-size: 1.625rem;
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
  }
  .activity-row strong small {
    font-size: 0.75rem;
    letter-spacing: 0;
    color: var(--color-text-secondary);
    margin-right: 4px;
  }
  .activity-row span {
    font-size: 0.6875rem;
    line-height: 1.4;
    color: var(--color-text-secondary);
  }
  .activity-row em {
    font-style: normal;
    font-weight: 600;
    color: var(--color-brand-ink);
  }
  .activity-foot {
    margin-top: 8px;
    font-size: 0.6875rem;
    color: var(--color-text-secondary);
  }
  .snapshot-caption {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 8px;
    font-size: 0.6875rem;
    color: var(--color-text-secondary);
  }
  .snapshot-caption a {
    color: inherit;
    white-space: nowrap;
  }
  /* Dial: one tick per registration, amber for the net number added since the
     first saved observation. */
  .dial path {
    fill: none;
    stroke: #bfd9cc;
    stroke-width: 2;
    stroke-linecap: round;
    opacity: 0.42;
  }
  .dial path.added {
    stroke: #e8a85c;
    opacity: 1;
  }
  .hero-stat {
    display: grid;
    grid-template-columns: 124px minmax(0, 1fr);
    grid-template-rows: 1fr auto auto 1fr;
    column-gap: 14px;
    text-align: left;
    justify-items: start;
    padding: 16px 12px 16px 20px;
  }
  .dial {
    display: block;
    width: 124px;
    height: 124px;
    grid-area: 1 / 1 / -1 / 2;
  }
  .hero-stat strong {
    grid-area: 1 / 1 / -1 / 2;
    place-self: center;
    font-size: 3rem;
  }
  .hero-stat > span {
    grid-area: 2 / 2;
    font-size: 0.75rem;
  }
  .hero-stat > small {
    grid-area: 3 / 2;
    white-space: normal;
  }
  @media (max-width: 900px) {
    .panel-top,
    .family-section,
    .activity {
      padding-inline: 15px;
    }
    .panel-foot {
      padding-inline: 15px;
    }
    .stat-list {
      padding-right: 15px;
    }
    .panel-label {
      font-size: 0.625rem;
    }
    .family-section {
      flex-direction: column;
      align-items: flex-start;
      gap: 7px;
    }
  }
  @media (max-width: 520px) {
    .hero-stat {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto auto auto;
      justify-items: center;
      text-align: center;
      row-gap: 4px;
      padding: 16px 8px 16px 12px;
    }
    .dial {
      width: 108px;
      height: 108px;
      grid-area: 1 / 1;
    }
    .hero-stat strong {
      grid-area: 1 / 1;
      font-size: 2.5rem;
    }
    .hero-stat > span {
      grid-area: 2 / 1;
      font-size: 0.6875rem;
    }
    .hero-stat > small {
      grid-area: 3 / 1;
      margin-top: 0;
    }
  }
  @media (max-width: 400px) {
    .panel-title {
      font-size: 0.75rem;
    }
    .directory-tabs button {
      padding: 6px 8px;
      font-size: 0.625rem;
    }
    .stat-cell {
      grid-template-columns: 1fr;
      gap: 2px;
    }
    .hero-stat strong {
      font-size: 3.25rem;
    }
  }
</style>
