---
const benefits = [
  {
    icon: 'eye',
    title: 'Visibility',
    description:
      'Track who is participating in the UAE Open Finance ecosystem. See real-time data on registered institutions, sandbox testing, and production deployments.',
    link: '/observatory',
    linkText: 'View Observatory',
  },
  {
    icon: 'book',
    title: 'Education',
    description:
      'Understand how Open Finance works in the UAE. Learn about APIs, regulations, and how financial data sharing benefits consumers and businesses.',
    link: '/learn',
    linkText: 'Start Learning',
  },
  {
    icon: 'users',
    title: 'Community',
    description:
      'Join a grassroots community of developers, fintech enthusiasts, and industry observers building transparency in UAE financial services.',
    link: 'https://github.com/organizations/openfinance-os/',
    linkText: 'Join on GitHub',
    external: true,
  },
];

const icons: Record<string, string> = {
  eye: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>`,
  book: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>`,
  users: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
};
---

<section class="value-proposition">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">What is Open Finance OS?</h2>
      <p class="section-description">
        A community-driven platform providing transparency and resources for the UAE Open Finance
        ecosystem. Not official, not affiliated — just contributors.
      </p>
    </div>

    <div class="benefits-grid">
      {
        benefits.map((benefit, index) => (
          <article class="benefit-card" style={`--delay: ${index * 0.1}s`}>
            <div class="benefit-icon" set:html={icons[benefit.icon]} />
            <h3 class="benefit-title">{benefit.title}</h3>
            <p class="benefit-description">{benefit.description}</p>
            <a
              href={benefit.link}
              class="benefit-link"
              target={benefit.external ? '_blank' : undefined}
              rel={benefit.external ? 'noopener noreferrer' : undefined}
            >
              {benefit.linkText}
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .value-proposition {
    padding: var(--space-16) var(--space-4);
    background: var(--color-gray-50);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto var(--space-12);
  }

  .section-title {
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 700;
    color: var(--color-gray-900);
    margin-bottom: var(--space-3);
  }

  .section-description {
    font-size: 1.0625rem;
    color: var(--color-gray-600);
    line-height: 1.6;
  }

  .benefits-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .benefits-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .benefit-card {
    background: white;
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast),
      transform var(--transition-fast);
  }

  .benefit-card:hover {
    border-color: var(--color-primary-200);
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }

  .benefit-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-primary-50);
    color: var(--color-primary-600);
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-4);
  }

  .benefit-icon :global(svg) {
    width: 24px;
    height: 24px;
  }

  .benefit-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-gray-900);
    margin-bottom: var(--space-2);
  }

  .benefit-description {
    font-size: 0.9375rem;
    color: var(--color-gray-600);
    line-height: 1.6;
    flex: 1;
    margin-bottom: var(--space-4);
  }

  .benefit-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-primary-600);
    text-decoration: none;
    transition: gap var(--transition-fast);
  }

  .benefit-link:hover {
    gap: var(--space-3);
    text-decoration: none;
  }

  .benefit-link:focus-visible {
    outline: 2px solid var(--color-primary-500);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  /* Dark mode */
  :global([data-theme='dark']) .value-proposition {
    background: var(--color-gray-100);
  }

  :global([data-theme='dark']) .section-title {
    color: var(--color-gray-50);
  }

  :global([data-theme='dark']) .section-description {
    color: var(--color-gray-400);
  }

  :global([data-theme='dark']) .benefit-card {
    background: var(--color-gray-200);
    border-color: var(--color-gray-300);
  }

  :global([data-theme='dark']) .benefit-card:hover {
    border-color: var(--color-primary-500);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  }

  :global([data-theme='dark']) .benefit-icon {
    background: rgba(20, 184, 166, 0.15);
    color: var(--color-primary-400);
  }

  :global([data-theme='dark']) .benefit-title {
    color: var(--color-gray-50);
  }

  :global([data-theme='dark']) .benefit-description {
    color: var(--color-gray-400);
  }

  :global([data-theme='dark']) .benefit-link {
    color: var(--color-primary-400);
  }
</style>
