---
interface EcosystemStats {
  totalUnique: number;
  production: {
    registered: number;
    live: number;
  };
  sandbox: {
    registered: number;
    live: number;
  };
  inBoth: number;
  productionOnly: number;
  sandboxOnly: number;
}

interface Props {
  stats: EcosystemStats;
}

const { stats } = Astro.props;

// Calculate percentages for the engagement funnel
const totalRegistered = stats.totalUnique;
const testingInSandbox = stats.sandbox.registered;
const liveInProduction = stats.production.live;

// Progress percentages (relative to total)
const sandboxPercent = totalRegistered > 0 ? (testingInSandbox / totalRegistered) * 100 : 0;
const productionPercent = totalRegistered > 0 ? (liveInProduction / totalRegistered) * 100 : 0;
---

<section class="observatory-preview">
  <div class="section-header">
    <div class="header-content">
      <h2 class="section-title">Ecosystem Engagement</h2>
      <p class="section-description">
        Track participation across the UAE Open Finance ecosystem, from sandbox testing to
        production deployment.
      </p>
    </div>
    <a href="/observatory" class="view-all-link">
      See the full dashboard
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M5 12h14M12 5l7 7-7 7"></path>
      </svg>
    </a>
  </div>

  <div class="preview-grid">
    <!-- Total Ecosystem Card -->
    <div class="preview-card ecosystem-card">
      <h3 class="card-title">
        <span class="title-icon">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M2 12h20"></path>
            <path
              d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
            ></path>
          </svg>
        </span>
        Total Ecosystem
      </h3>
      <div class="ecosystem-stat">
        <span class="stat-number">{stats.totalUnique}</span>
        <span class="stat-label">Organizations</span>
      </div>
      <div class="environment-breakdown">
        <div class="env-item">
          <span class="env-dot env-dot-both"></span>
          <span class="env-label">In both</span>
          <span class="env-value">{stats.inBoth}</span>
        </div>
        <div class="env-item">
          <span class="env-dot env-dot-production"></span>
          <span class="env-label">Production only</span>
          <span class="env-value">{stats.productionOnly}</span>
        </div>
        <div class="env-item">
          <span class="env-dot env-dot-sandbox"></span>
          <span class="env-label">Sandbox only</span>
          <span class="env-value">{stats.sandboxOnly}</span>
        </div>
      </div>
    </div>

    <!-- Engagement Pipeline Card -->
    <div class="preview-card pipeline-card">
      <h3 class="card-title">
        <span class="title-icon">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
          </svg>
        </span>
        Engagement Pipeline
      </h3>
      <div class="pipeline">
        <div class="pipeline-stage">
          <div class="stage-header">
            <span class="stage-label">Registered</span>
            <span class="stage-value">{totalRegistered}</span>
          </div>
          <div class="stage-bar">
            <div class="stage-fill stage-fill-registered" style="width: 100%"></div>
          </div>
        </div>
        <div class="pipeline-stage">
          <div class="stage-header">
            <span class="stage-label">Testing in Sandbox</span>
            <span class="stage-value">{testingInSandbox}</span>
          </div>
          <div class="stage-bar">
            <div class="stage-fill stage-fill-sandbox" style={`width: ${sandboxPercent}%`}></div>
          </div>
        </div>
        <div class="pipeline-stage">
          <div class="stage-header">
            <span class="stage-label">Live in Production</span>
            <span class="stage-value">{liveInProduction}</span>
          </div>
          <div class="stage-bar">
            <div class="stage-fill stage-fill-production" style={`width: ${productionPercent}%`}>
            </div>
          </div>
        </div>
      </div>
      <p class="pipeline-note">
        {Math.round(sandboxPercent)}% testing, {Math.round(productionPercent)}% live
      </p>
    </div>

    <!-- CTA Card -->
    <div class="preview-card preview-card-cta">
      <div class="cta-content">
        <h3 class="cta-title">Explore More</h3>
        <p class="cta-description">
          View detailed participant profiles, API coverage matrix, and historical trends.
        </p>
        <a href="/observatory" class="cta-button">
          Open Observatory
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14M12 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>
      <div class="cta-decoration" aria-hidden="true">
        <svg viewBox="0 0 100 100" fill="none">
          <circle
            cx="50"
            cy="50"
            r="40"
            stroke="var(--color-primary-300)"
            stroke-width="1"
            stroke-dasharray="4 4"></circle>
          <circle cx="50" cy="50" r="25" stroke="var(--color-primary-400)" stroke-width="1"
          ></circle>
          <circle cx="50" cy="50" r="10" fill="var(--color-primary-500)"></circle>
        </svg>
      </div>
    </div>
  </div>

  <p class="data-disclaimer">
    Data derived from public registry metadata. Not official statistics.
    <a href="/observatory/methodology">Learn how we calculate this →</a>
  </p>
</section>

<style>
  .observatory-preview {
    padding: var(--space-16) var(--space-4);
    background: white;
    border-top: 1px solid var(--color-gray-200);
    border-bottom: 1px solid var(--color-gray-200);
  }

  .section-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 1200px;
    margin: 0 auto var(--space-8);
  }

  @media (min-width: 768px) {
    .section-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }
  }

  .header-content {
    max-width: 500px;
  }

  .section-title {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-gray-900);
    margin-bottom: var(--space-2);
  }

  .section-description {
    color: var(--color-gray-600);
    font-size: 1rem;
  }

  .view-all-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 500;
    color: var(--color-primary-600);
    text-decoration: none;
    white-space: nowrap;
    transition: gap var(--transition-fast);
  }

  .view-all-link:hover {
    gap: var(--space-3);
    text-decoration: none;
  }

  .preview-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    max-width: 1200px;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .preview-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .preview-card {
    background: var(--color-gray-50);
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
  }

  .card-title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-gray-700);
    margin-bottom: var(--space-4);
  }

  .title-icon {
    display: flex;
    color: var(--color-primary-500);
  }

  /* Ecosystem Card Styles */
  .ecosystem-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: var(--space-4);
  }

  .stat-number {
    font-size: 3rem;
    font-weight: 700;
    color: var(--color-gray-900);
    line-height: 1;
  }

  .stat-label {
    font-size: 0.875rem;
    color: var(--color-gray-500);
    margin-top: var(--space-1);
  }

  .environment-breakdown {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-gray-200);
  }

  .env-item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.8125rem;
  }

  .env-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .env-dot-both {
    background: var(--color-primary-500);
  }

  .env-dot-production {
    background: var(--color-accent-500);
  }

  .env-dot-sandbox {
    background: #3b82f6;
  }

  .env-label {
    flex: 1;
    color: var(--color-gray-600);
  }

  .env-value {
    font-weight: 600;
    color: var(--color-gray-900);
  }

  /* Pipeline Card Styles */
  .pipeline {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .pipeline-stage {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .stage-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .stage-label {
    font-size: 0.8125rem;
    color: var(--color-gray-600);
  }

  .stage-value {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-gray-900);
  }

  .stage-bar {
    height: 8px;
    background: var(--color-gray-200);
    border-radius: 4px;
    overflow: hidden;
  }

  .stage-fill {
    height: 100%;
    border-radius: 4px;
    transition: width 0.6s ease-out;
  }

  .stage-fill-registered {
    background: var(--color-gray-400);
  }

  .stage-fill-sandbox {
    background: #3b82f6;
  }

  .stage-fill-production {
    background: var(--color-primary-500);
  }

  .pipeline-note {
    font-size: 0.75rem;
    color: var(--color-gray-500);
    text-align: center;
    margin-top: var(--space-2);
  }

  /* CTA Card Styles */
  .preview-card-cta {
    position: relative;
    background: linear-gradient(135deg, var(--color-primary-900) 0%, var(--color-primary-800) 100%);
    border-color: transparent;
    overflow: hidden;
  }

  .cta-content {
    position: relative;
    z-index: 1;
  }

  .cta-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: white;
    margin-bottom: var(--space-2);
  }

  .cta-description {
    font-size: 0.875rem;
    color: var(--color-primary-200);
    margin-bottom: var(--space-4);
    line-height: 1.5;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    background: white;
    color: var(--color-primary-700);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    border-radius: var(--radius-md);
    transition:
      background-color var(--transition-fast),
      gap var(--transition-fast);
  }

  .cta-button:hover {
    background: var(--color-gray-100);
    gap: var(--space-3);
    text-decoration: none;
  }

  .cta-button:focus-visible {
    outline: 2px solid var(--color-primary-500);
    outline-offset: 2px;
    box-shadow: 0 0 0 4px rgba(15, 118, 110, 0.2);
  }

  .cta-decoration {
    position: absolute;
    right: -20px;
    bottom: -20px;
    width: 140px;
    height: 140px;
    opacity: 0.3;
  }

  .cta-decoration svg {
    width: 100%;
    height: 100%;
    animation: spin 30s linear infinite;
  }

  @keyframes spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  .data-disclaimer {
    max-width: 1200px;
    margin: var(--space-6) auto 0;
    font-size: 0.8125rem;
    color: var(--color-gray-500);
    text-align: center;
  }

  .data-disclaimer a {
    color: var(--color-primary-600);
  }
</style>
