---
interface Props {
  participantCount: number;
  activeCount: number;
  productionCount: number;
}

const { participantCount, activeCount, productionCount } = Astro.props;
const activePercent = participantCount > 0 ? Math.round((activeCount / participantCount) * 100) : 0;
---

<section class="hero">
  <div class="hero-bg" aria-hidden="true">
    <div class="grid-overlay"></div>
    <div class="gradient-orb gradient-orb-1"></div>
    <div class="gradient-orb gradient-orb-2"></div>
  </div>

  <div class="hero-content">
    <div class="hero-badge">
      <span class="badge-dot"></span>
      <span class="badge-text">Independent · Open Source · Community-Led</span>
    </div>

    <h1 class="hero-title">
      <span class="title-main">Open Finance</span>
      <span class="title-suffix">-os</span>
    </h1>

    <p class="hero-tagline">
      Community-powered visibility into <span class="highlight">UAE's financial ecosystem</span>
    </p>

    <div class="hero-stats">
      <div class="stat-item">
        <span class="stat-number" data-count={participantCount}>{participantCount}</span>
        <span class="stat-label">Institutions</span>
      </div>
      <div class="stat-divider" aria-hidden="true"></div>
      <div class="stat-item">
        <span class="stat-number" data-count={productionCount}>{productionCount}</span>
        <span class="stat-label">In Production</span>
      </div>
      <div class="stat-divider" aria-hidden="true"></div>
      <div class="stat-item">
        <span class="stat-number">{activePercent}<span class="stat-unit">%</span></span>
        <span class="stat-label">Active</span>
      </div>
    </div>

    <div class="hero-cta">
      <a href="/observatory" class="btn btn-primary">
        Explore the Observatory
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14M12 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>

    <p class="hero-subtext">Live data from the UAE Open Finance registry</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-12) var(--space-4);
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .grid-overlay {
    position: absolute;
    inset: 0;
    background-image: var(--grid-pattern);
    opacity: 0.6;
  }

  .gradient-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.35;
  }

  .gradient-orb-1 {
    width: 500px;
    height: 500px;
    background: var(--color-primary-300);
    top: -150px;
    right: -50px;
    animation: float 20s ease-in-out infinite;
  }

  .gradient-orb-2 {
    width: 350px;
    height: 350px;
    background: var(--color-accent-300);
    bottom: -80px;
    left: -80px;
    animation: float 25s ease-in-out infinite reverse;
  }

  @keyframes float {
    0%,
    100% {
      transform: translate(0, 0);
    }
    25% {
      transform: translate(15px, -20px);
    }
    50% {
      transform: translate(-10px, 15px);
    }
    75% {
      transform: translate(10px, 8px);
    }
  }

  .hero-content {
    position: relative;
    max-width: 800px;
    text-align: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    background: white;
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-full);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-gray-600);
    margin-bottom: var(--space-8);
    animation: fadeInUp 0.5s ease-out;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    background: var(--color-success);
    border-radius: 50%;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }

  .hero-title {
    font-size: clamp(3rem, 12vw, 5.5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-gray-900);
    margin-bottom: var(--space-4);
    animation: fadeInUp 0.5s ease-out backwards;
    animation-delay: 0.1s;
  }

  .title-main {
    display: block;
    background: linear-gradient(135deg, var(--color-gray-900) 0%, var(--color-primary-700) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .title-suffix {
    font-family: var(--font-mono);
    font-size: 0.35em;
    font-weight: 500;
    color: var(--color-primary-500);
    letter-spacing: 0;
    vertical-align: super;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-tagline {
    font-size: clamp(1.125rem, 3vw, 1.5rem);
    color: var(--color-gray-600);
    margin-bottom: var(--space-10);
    animation: fadeInUp 0.5s ease-out backwards;
    animation-delay: 0.2s;
  }

  .highlight {
    color: var(--color-gray-900);
    font-weight: 500;
  }

  .hero-stats {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-6);
    margin-bottom: var(--space-10);
    animation: fadeInUp 0.5s ease-out backwards;
    animation-delay: 0.3s;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
  }

  .stat-number {
    font-family: var(--font-mono);
    font-size: clamp(2rem, 6vw, 3rem);
    font-weight: 700;
    color: var(--color-primary-600);
    line-height: 1;
  }

  .stat-unit {
    font-size: 0.6em;
    opacity: 0.8;
  }

  .stat-label {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-gray-500);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .stat-divider {
    width: 1px;
    height: 48px;
    background: var(--color-gray-300);
  }

  .hero-cta {
    margin-bottom: var(--space-6);
    animation: fadeInUp 0.5s ease-out backwards;
    animation-delay: 0.4s;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-8);
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--radius-lg);
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast),
      background-color var(--transition-fast),
      gap var(--transition-fast);
  }

  .btn:hover {
    text-decoration: none;
  }

  .btn-primary {
    background: var(--color-primary-600);
    color: white;
    box-shadow: 0 4px 14px 0 rgba(15, 118, 110, 0.35);
  }

  .btn-primary:hover {
    background: var(--color-primary-700);
    box-shadow: 0 6px 20px 0 rgba(15, 118, 110, 0.45);
    transform: translateY(-2px);
    gap: var(--space-3);
  }

  .btn:focus-visible {
    outline: 2px solid var(--color-primary-500);
    outline-offset: 2px;
  }

  .hero-subtext {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-gray-400);
    animation: fadeInUp 0.5s ease-out backwards;
    animation-delay: 0.5s;
  }

  @media (max-width: 640px) {
    .hero {
      min-height: 80vh;
      padding: var(--space-8) var(--space-4);
    }

    .hero-stats {
      flex-direction: column;
      gap: var(--space-4);
      padding: var(--space-6);
      background: white;
      border: 1px solid var(--color-gray-200);
      border-radius: var(--radius-xl);
      box-shadow: var(--shadow-md);
    }

    .stat-divider {
      width: 60px;
      height: 1px;
    }

    .btn {
      width: 100%;
      justify-content: center;
    }
  }

  /* Dark mode */
  :global([data-theme='dark']) .hero-badge {
    background: var(--color-gray-100);
    border-color: var(--color-gray-200);
    color: var(--color-gray-300);
  }

  :global([data-theme='dark']) .title-main {
    background: linear-gradient(135deg, var(--color-gray-50) 0%, var(--color-primary-400) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  :global([data-theme='dark']) .title-suffix {
    color: var(--color-primary-400);
  }

  :global([data-theme='dark']) .hero-tagline {
    color: var(--color-gray-400);
  }

  :global([data-theme='dark']) .highlight {
    color: var(--color-gray-200);
  }

  :global([data-theme='dark']) .stat-number {
    color: var(--color-primary-400);
  }

  :global([data-theme='dark']) .stat-label {
    color: var(--color-gray-400);
  }

  :global([data-theme='dark']) .stat-divider {
    background: var(--color-gray-600);
  }

  :global([data-theme='dark']) .hero-subtext {
    color: var(--color-gray-500);
  }

  :global([data-theme='dark']) .hero-stats {
    background: var(--color-gray-100);
    border-color: var(--color-gray-200);
  }

  :global([data-theme='dark']) .gradient-orb-1 {
    background: var(--color-primary-600);
    opacity: 0.2;
  }

  :global([data-theme='dark']) .gradient-orb-2 {
    background: var(--color-accent-500);
    opacity: 0.15;
  }
</style>
