---
import DirectorySnapshot from './DirectorySnapshot.astro';
import HeroFilm from './HeroFilm.astro';
interface DirectoryObservation {
  registered: number;
  apiFamilies: string[];
  observedAt: string;
}
interface Props {
  production: DirectoryObservation;
  sandbox: DirectoryObservation | null;
}
const { production, sandbox } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <HeroFilm />
  <div class="hero-inner">
    <div class="hero-content">
      <p class="hero-eyebrow">
        <span class="badge-dot" aria-hidden="true"></span>The independent view of UAE Open Finance
      </p>
      <h1 id="hero-title">
        Open finance.
        <br />
        <span>In full view.</span>
      </h1>
      <p class="hero-tagline">
        Learn what financial data and services shared with customer permission can enable.
        Understand what’s changing, see the evidence, and find your next step.
      </p>
      <div class="hero-actions">
        <a href="/observatory" class="hero-primary">
          Explore the Observatory <span aria-hidden="true">↗</span>
        </a>
        <a href="#starting-points" class="hero-secondary">
          Find your starting point <span aria-hidden="true">↓</span>
        </a>
      </div>
      <p class="hero-note">Open source. Community led. Independent by design.</p>
    </div>
    <DirectorySnapshot production={production} sandbox={sandbox} />
  </div>
</section>
<div class="principles">
  <div class="principles-inner">
    <p class="principle-lead">
      A shared resource.
      <br />A clearer picture.
    </p>
    <div class="principle">
      <span class="principle-icon" aria-hidden="true">
        ◎
      </span>
      <div>
        <strong>Evidence, in the open</strong>
        <span>Sources and limits alongside the data.</span>
      </div>
    </div>
    <div class="principle">
      <span class="principle-icon" aria-hidden="true">
        ⌘
      </span>
      <div>
        <strong>Useful before you build</strong>
        <span>Examples, guides, and practical tools.</span>
      </div>
    </div>
    <div class="principle">
      <span class="principle-icon" aria-hidden="true">
        ↗
      </span>
      <div>
        <strong>Community, at the core</strong>
        <span>A neutral, independent perspective.</span>
      </div>
    </div>
  </div>
</div>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 72px 24px 176px;
    background: var(--color-surface);
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 1224px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.08fr 1fr;
    gap: 80px;
    align-items: center;
  }
  .hero-content {
    min-width: 0;
  }
  .hero-inner :global(.panel-label),
  .hero-inner :global(.snapshot-caption) {
    background: color-mix(in srgb, var(--color-surface) 94%, transparent);
    border-radius: 4px;
  }
  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text);
  }
  .badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-accent);
    flex-shrink: 0;
  }
  h1 {
    font-size: clamp(3.5rem, 6.2vw, 5.625rem);
    font-weight: 500;
    letter-spacing: -0.065em;
    line-height: 1.02;
    margin: 30px 0 26px;
  }
  h1 span {
    color: var(--color-brand-ink);
  }
  .hero-tagline {
    max-width: 430px;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }
  .hero-actions {
    display: flex;
    align-items: center;
    gap: 22px;
    margin-top: 31px;
  }
  .hero-primary {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    background: var(--color-text);
    color: var(--color-card);
    padding: 17px 20px;
    font-size: 0.875rem;
    font-weight: 600;
    border-radius: var(--radius-lg);
    transition: transform var(--transition-fast);
  }
  .hero-primary:hover {
    color: var(--color-card);
    text-decoration: none;
    transform: translateY(-2px);
  }
  .hero-primary span {
    font-size: 1.375rem;
    line-height: 1;
  }
  .hero-secondary {
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--color-text);
    font-size: 0.8125rem;
    font-weight: 500;
  }
  .hero-note {
    margin-top: 27px;
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }
  .principles {
    border-block: 1px solid var(--color-border);
    margin-bottom: var(--space-12);
    background: var(--color-surface);
  }
  .principles-inner {
    max-width: 1224px;
    margin: 0 auto;
    padding: 27px 24px;
    display: grid;
    grid-template-columns: 1.05fr 1fr 1fr 1fr;
    gap: 34px;
    align-items: center;
  }
  .principle-lead {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }
  .principle {
    display: flex;
    gap: 12px;
    align-items: center;
  }
  .principle-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 35px;
    height: 35px;
    flex-shrink: 0;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    color: var(--color-brand-ink);
  }
  .principle strong {
    display: block;
    font-size: 0.8125rem;
    font-weight: 600;
    margin-bottom: 4px;
  }
  .principle span:not(.principle-icon) {
    display: block;
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }
  @media (max-width: 1150px) {
    .hero-inner {
      gap: 40px;
    }
    .hero-actions {
      flex-wrap: wrap;
      gap: 17px;
    }
  }
  @media (max-width: 900px) {
    .hero-inner {
      gap: 27px;
    }
    h1 {
      font-size: 3.875rem;
    }
    .hero-tagline {
      font-size: 0.9375rem;
    }
    .principles-inner {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
    }
    .principle-lead {
      display: none;
    }
  }
  @media (max-width: 700px) {
    .hero {
      padding: 44px 20px 130px;
    }
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .hero-eyebrow {
      font-size: 0.625rem;
    }
    h1 {
      font-size: clamp(2.875rem, 14vw, 3.5rem);
      letter-spacing: -0.055em;
      margin: 23px 0;
    }
    .hero-actions {
      flex-direction: column;
      align-items: flex-start;
      gap: 18px;
    }
    .hero-primary {
      padding: 15px;
      gap: 13px;
      font-size: 0.75rem;
    }
    .hero-secondary {
      font-size: 0.75rem;
    }
    .hero-note {
      font-size: 0.6875rem;
    }
    .principles {
      margin-bottom: 32px;
    }
    .principles-inner {
      grid-template-columns: 1fr;
      gap: 18px;
      padding: 25px 20px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-primary {
      transition: none;
    }
  }
</style>
