# Cloudflare Pages redirects — the source of truth for production redirects.
# Server-side 301s (fast, SEO-friendly). Keep in sync with the IA; do NOT also
# declare these in astro.config redirects (that generates conflicting
# meta-refresh pages that Cloudflare would serve instead).

# Canonical host: www -> non-www
https://www.openfinance-os.org/* https://openfinance-os.org/:splat 301

# Legacy URL patterns
/blog/* /updates 301
/articles/* /updates 301
/docs/* /learn/:splat 301
/dashboard/* /observatory/:splat 301

# News & Events consolidated into Updates (Updates is news-only; events removed)
/news /updates 301
/events /updates 301

# Links page dissolved into Learn
/links /learn 301

# Global promoted to a top-level section (was nested under /learn)
/learn/global /global 301
/learn/global/eu /global/eu 301
/learn/global/uk /global/uk 301
/learn/global/gcc /global/gcc 301
