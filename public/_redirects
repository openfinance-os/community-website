# Cloudflare Pages redirects — the source of truth for production redirects.
# Server-side 301s (fast, SEO-friendly). Keep in sync with the IA; do NOT also
# declare these in astro.config redirects (that generates conflicting
# meta-refresh pages that Cloudflare would serve instead).

# Canonical host: www -> non-www
https://www.openfinance-os.org/* https://openfinance-os.org/:splat 301

# Conventional sitemap URL. The file itself is the index generated by
# @astrojs/sitemap (sitemap-index.xml), which lists every included page.
/sitemap.xml /sitemap-index.xml 200

# Legacy URL patterns
/blog/* /updates 301
/articles/* /updates 301
/docs/* /learn/:splat 301
/dashboard/* /observatory/:splat 301

# News & Events consolidated into Updates (Updates is news-only; events removed).
# Match both with and without the trailing slash (Astro emits trailing slashes).
/news /updates 301
/news/ /updates 301
/events /updates 301
/events/ /updates 301

# Links page dissolved into Learn
/links /learn 301
/links/ /learn 301

# Global promoted to a top-level section (was nested under /learn).
# The splat covers /learn/global/, /learn/global/eu, /learn/global/eu/, etc.;
# the bare rule covers /learn/global with no trailing slash.
/learn/global /global 301
/learn/global/* /global/:splat 301

# News item re-dated to the actual CBUAE announcement date (was mis-dated 2024-09-15)
/news/2024-09-15-cbuae-open-finance-framework/* /news/2024-06-27-cbuae-open-finance-regulation/ 301
