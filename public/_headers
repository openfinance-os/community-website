# Security headers for every response.
# Cache-Control on this catch-all is the HTML policy. More specific rules below
# override it. Cloudflare does not cache HTML (or XML/JSON) from Cache-Control
# alone — see the cache rules documented in the pull request. Hashed /_astro
# and /fonts files are default-cached extensions, so their headers are enough.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://us-assets.i.posthog.com; connect-src 'self' https:; frame-ancestors 'none'
  Cache-Control: public, max-age=0, must-revalidate
  Cloudflare-CDN-Cache-Control: public, max-age=1800, stale-while-revalidate=86400

# Content-hashed build assets. The filename changes when the bytes change.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
  Cloudflare-CDN-Cache-Control: public, max-age=31536000

# Self-hosted fonts. Filenames are stable and the files are not personalized.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Cloudflare-CDN-Cache-Control: public, max-age=31536000
  Access-Control-Allow-Origin: *

# Brand and media files are not content-hashed. A week is long enough to
# absorb repeat views and short enough for a brand update to roll through.
/brand/*
  Cache-Control: public, max-age=604800
  Cloudflare-CDN-Cache-Control: public, max-age=604800

/media/*
  Cache-Control: public, max-age=604800
  Cloudflare-CDN-Cache-Control: public, max-age=604800

/og-image.png
  Cache-Control: public, max-age=604800
  Cloudflare-CDN-Cache-Control: public, max-age=604800

/favicon.svg
  Cache-Control: public, max-age=86400
  Cloudflare-CDN-Cache-Control: public, max-age=86400

# Analytics script changes more often than images.
/analytics/*
  Cache-Control: public, max-age=86400
  Cloudflare-CDN-Cache-Control: public, max-age=86400

# Observatory JSON is rebuilt with the site. Eligible for cache only after the
# dashboard rule that includes .json (documented in the pull request).
/observatory/data/*
  Cache-Control: public, max-age=300, must-revalidate
  Cloudflare-CDN-Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Discovery files. Short edge TTL so a publish shows up within the hour.
/sitemap*
  Cache-Control: public, max-age=3600
  Cloudflare-CDN-Cache-Control: public, max-age=3600

/rss.xml
  Cache-Control: public, max-age=3600
  Cloudflare-CDN-Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600
  Cloudflare-CDN-Cache-Control: public, max-age=3600

/llms.txt
  Cache-Control: public, max-age=3600
  Cloudflare-CDN-Cache-Control: public, max-age=3600
